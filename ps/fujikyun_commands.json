    "LOOP_START": {
      "title": "繰り返し",
      "icon": "🔁",
      "category": "flow",
      "format": "json",
      "help": "中のコマンドをくり返すキュン。「決めた回数」なら回数を（{{列名}} などの差し込みもOK）、「条件のあいだ」なら条件を決めてね。何回目かは {{$回数}} で使えるよ。途中で抜けるには「繰り返しを抜ける（BREAK）」を使ってね。終わらない繰り返しにならないよう、上限回数で必ず止まるよ。",
      "defaultVal": "{\"mode\":\"COUNT\",\"count\":\"3\",\"left\":\"\",\"op\":\"NOT_EMPTY\",\"right\":\"\",\"counter\":\"回数\",\"max\":\"1000\"}",
      "fields": [
        {
          "id": "mode",
          "label": "くり返し方",
          "type": "select",
          "options": [
            [
              "COUNT",
              "決めた回数くり返す（for）"
            ],
            [
              "WHILE",
              "条件を満たすあいだくり返す（while）"
            ]
          ]
        },
        {
          "id": "count",
          "label": "回数（「決めた回数」のとき・差し込み可）",
          "type": "text",
          "placeholder": "例: 5 / {{ページ数}}",
          "placeholders": true
        },
        {
          "id": "left",
          "label": "条件：調べる値（「条件のあいだ」のとき・差し込み可）",
          "type": "text",
          "placeholder": "例: {{$件名}}",
          "placeholders": true
        },
        {
          "id": "op",
          "label": "条件：くらべ方",
          "type": "select",
          "options": [
            [
              "EQ",
              "と等しい"
            ],
            [
              "NE",
              "と違う"
            ],
            [
              "CONTAINS",
              "を含む"
            ],
            [
              "NOT_CONTAINS",
              "を含まない"
            ],
            [
              "EMPTY",
              "が空っぽ（くらべる相手は使わない）"
            ],
            [
              "NOT_EMPTY",
              "が空っぽでない（くらべる相手は使わない）"
            ],
            [
              "GT",
              "より大きい（数）"
            ],
            [
              "GE",
              "以上（数）"
            ],
            [
              "LT",
              "より小さい（数）"
            ],
            [
              "LE",
              "以下（数）"
            ],
            [
              "REGEX",
              "が正規表現に一致する"
            ],
            [
              "WINDOW",
              "というウィンドウがある（調べる値にタイトル）"
