            ["GROUP_END", ""],
            ["GROUP_START", "入力"],
            ["KEY", "^a"],
            ["TEXT", "{{件名}}"],
            ["KEY", "{TAB}"],
            ["TEXT", "{{本文}}"],
            ["KEY", "{TAB}"],
            ["TEXT", "{{文書分類}}"],
            ["KEY", "{TAB}"],
            ["TEXT", "{{保存期間}}"],
            ["GROUP_END", ""],
            ["CONFIRM", "入力内容を確認してね。OKなら［▶ 続行］で「一時保存」するよ。\n件名：{{件名}}"],
            ["CLICK", "一時保存"],
            ["WAIT", "2000"],
            ["IF", "エラー,{ENTER},SKIP"],
            ["SCREENSHOT", "起案_{{ROW}}_{{件名}},WINDOW"]
        ]
    },
