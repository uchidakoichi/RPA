    {
        id: "shomu-shonin", category: "庶務事務システム", level: 3,
        name: "承認待ちの申請を1件ずつ確認して承認",
        summary: "管理職向け。申請番号で申請を開き、確認ポイントで内容を見てから承認します。承認しない申請は［⏭ この行をスキップ］で飛ばせば、結果CSVに「スキップ」として残ります。",
        useCase: "休暇・時間外勤務・出張などの承認がたまったとき。1件ずつ画面を開く手間をなくし、判断だけに集中できます。",
        prepare: SHOMU_PREPARE.concat(["承認待ち一覧の画面の開き方を確認し、CLICK_NAME「承認待ち一覧」「承認」を合わせる", "承認待ちの申請番号の一覧をCSVにする（一覧画面からCSV出力できるシステムならそれを使う）"]),
        customize: KIKAN_CUSTOMIZE.concat(["確認ポイントは無効化しないでください。承認の判断は必ず人が行う作りです"]),
        ideas: ["結果CSVで「スキップ」になった申請だけが、差し戻しや問い合わせが必要な申請の一覧になります"],
        targetWindow: "庶務事務", csvFile: "54_shomu_shonin.csv",
        csv: [
            ["申請番号", "申請者", "申請種類"],
            ["A2026-0101", "見本 太郎", "年次休暇"],
            ["A2026-0102", "試験 花子", "時間外勤務"],
            ["A2026-0103", "練習 一郎", "出張"]
        ],
        steps: [["CLICK_NAME", "承認待ち一覧"], ["WAIT", "2500"]]
            .concat(tplCursor("申請番号の検索欄にカーソルを置く", "申請番号の検索欄をクリックしてから［▶ 続行］を押してね（{{申請番号}}）"))
            .concat([
                ["KEY", "^a"], ["CSV", "1"], ["KEY", "{ENTER}"],
                ["WAIT", "2500"],
                ["WINDOW_CHECK", tplJ({ title: "該当なし", key: "{ENTER}", mode: "SKIP" })],
                ["CONFIRM", "{{申請者}}さんの{{申請種類}}（{{申請番号}}）の内容を画面で確認してね。\n承認してよければ［▶ 続行］、承認しないなら［⏭ この行をスキップ］を押してね"],
                ["CLICK_NAME", "承認"],
                ["WAIT", "1500"],
                ["WINDOW_CHECK", tplJ({ title: "確認", key: "{ENTER}", mode: "CONTINUE" })],
                ["WAIT", "1500"],
                ["WINDOW_CHECK", tplJ({ title: "エラー", key: "{ENTER}", mode: "SKIP" })],
                ["SCREENSHOT", tplJ({ name: "承認_{{申請番号}}", scope: "WINDOW" })]
            ])
    },
    // ============================================================= 変数・繰り返し・分岐
    {
        id: "ctl-normalize", category: "変数・繰り返し・分岐", level: 1,
        name: "全角・半角や桁数がバラバラな番号をそろえてから入力",
        summary: "「１２３」「45」のような番号を半角7桁（0000123）に、氏名の空白を全角1つに、電話番号を半角のハイフン区切りに整えてから入力します。メモ帳で動きを確かめられます。",
        useCase: "手入力のExcelや他課からもらったデータは、全角半角や桁数がそろっていないことがよくあります。システムに入れる前に整えると、検索で「該当なし」になりません。",
        prepare: ["特になし（メモ帳は自動で開きます）。動きを確かめたら、SWITCH と入力の部分を自分のシステムに合わせます"],
        customize: ["桁数は「ゼロ埋め」の設定A（7）を変えます", "整えた値は {{$番号7桁}} {{$氏名}} {{$電話}} で、TEXT や CSV の代わりにどこでも使えます"],
        ideas: ["「文字を加工する」は、置換・切り出し・和暦変換など14種類。データの前処理をExcelでやらなくてよくなります", "整えた値を RECORD で実行結果CSVに残せば、整形済みデータの一覧も同時にできます"],
        targetWindow: "", csvFile: "55_ctl_normalize.csv",
        csv: [
            ["宛名番号", "氏名", "電話番号"],
            ["１２３", "見本  太郎", "０９０－０１２３－４５６７"],
            ["45", "試験　 花子", "090-0000-1111"],
            ["0006789", "練習　一郎", "03 1234 5678"]
        ],
        steps: NOTEPAD_SETUP.concat([
            ["GROUP_START", "番号を半角7桁にそろえる"],
            ["STR_OP", tplJ({ name: "番号半角", src: "{{宛名番号}}", op: "ZEN2HAN", a: "", b: "" })],
            ["STR_OP", tplJ({ name: "番号7桁", src: "{{$番号半角}}", op: "PAD", a: "7", b: "0" })],
            ["GROUP_END", ""],
            ["GROUP_START", "氏名の空白を全角1つにそろえる"],
            ["STR_OP", tplJ({ name: "氏名", src: "{{氏名}}", op: "REGEX_REPLACE", a: "[ 　]+", b: "　" })],
            ["GROUP_END", ""],
            ["GROUP_START", "電話番号を半角・ハイフン区切りにそろえる"],
            ["STR_OP", tplJ({ name: "電話", src: "{{電話番号}}", op: "ZEN2HAN", a: "", b: "" })],
            ["STR_OP", tplJ({ name: "電話", src: "{{$電話}}", op: "REGEX_REPLACE", a: "[^0-9]+", b: "-" })],
            ["GROUP_END", ""],
            ["TEXT", "{{$番号7桁}}"], ["KEY", "{TAB}"],
            ["TEXT", "{{$氏名}}"], ["KEY", "{TAB}"],
            ["TEXT", "{{$電話}}"], ["KEY", "{ENTER}"],
            ["RECORD", tplJ({ name: "整えた宛名番号", value: "{{$番号7桁}}" })]
        ])
    },
    {
        id: "ctl-dates", category: "変数・繰り返し・分岐", level: 1,
        name: "受付日から期限日を計算して、和暦で通知文に差し込む",
        summary: "受付日（2026/10/01・2026-10-03・令和8年10月5日 などバラバラでもOK）から14日後の期限日を計算し、どちらも和暦にして通知文を作ります。",
        useCase: "「受付から○日以内」の期限を、人が暦を見て数えている作業。数え間違いがなくなります。",
        prepare: ["特になし（メモ帳は自動で開きます）"],
        customize: ["日数は「日付にA日を足す」の設定A（14）を変えます。マイナスにすると前の日になります", "通知文は TEXT の中身です"],
        ideas: ["期限日を EXCEL_WRITE で台帳に書き込めば、期限管理表が自動で埋まります", "「もし〜なら」と組み合わせて、期限日が今日より前の人だけ催告する、といった使い方もできます"],
        targetWindow: "", csvFile: "56_ctl_dates.csv",
        csv: [
            ["氏名", "受付日"],
            ["見本 太郎", "2026/10/01"],
            ["試験 花子", "2026-10-03"],
            ["練習 一郎", "令和8年10月5日"]
        ],
        steps: NOTEPAD_SETUP.concat([
            ["STR_OP", tplJ({ name: "期限日", src: "{{受付日}}", op: "DATE_ADD", a: "14", b: "" })],
            ["STR_OP", tplJ({ name: "受付日和暦", src: "{{受付日}}", op: "WAREKI", a: "", b: "" })],
            ["STR_OP", tplJ({ name: "期限日和暦", src: "{{$期限日}}", op: "WAREKI", a: "", b: "" })],
            ["TEXT", "{{氏名}} 様\r\n受付日：{{$受付日和暦}}\r\n提出期限：{{$期限日和暦}}（受付から14日後）\r\n----------\r\n"],
            ["RECORD", tplJ({ name: "期限日", value: "{{$期限日}}" })]
        ])
    },
    {
        id: "ctl-if-amount", category: "変数・繰り返し・分岐", level: 2,
        name: "金額で分岐：10万円以上だけ人が確認してから入力",
        summary: "「もし〜なら／そうでなければ」で、金額が10万円以上の行だけ確認ポイントで止まり、それ以外はそのまま進みます。判定結果は実行結果CSVにも残します。",
        useCase: "全件を目で確認するのは大変だけど、高額なものだけは確認したい、というとき。",
        prepare: ["特になし（メモ帳は自動で開きます）"],
        customize: ["基準の金額は「もし〜なら」の くらべる相手（100000）を変えます", "「１５０，０００」のような全角・カンマ付きの数も、数としてくらべます"],
        ideas: ["条件には「含む」「正規表現に一致」「ウィンドウがある」「ファイルがある」なども使えます", "WINDOW_CHECK（ウィンドウ検知）は「画面が出たら」、もし〜なら は「値が〜なら」と使い分けます"],
        targetWindow: "", csvFile: "57_ctl_if_amount.csv",
        csv: [
            ["申請番号", "金額"],
            ["A-001", "120000"],
            ["A-002", "50000"],
            ["A-003", "１５０，０００"]
        ],
        steps: NOTEPAD_SETUP.concat([
            ["IF_START", tplJ({ left: "{{金額}}", op: "GE", right: "100000" })],
            ["CONFIRM", "{{申請番号}} は {{金額}} 円です。高額なので内容を確認してね。OKなら［▶ 続行］"],
            ["SET_VAR", tplJ({ name: "区分", value: "高額（確認済み）", mode: "TEXT" })],
            ["ELSE", ""],
            ["SET_VAR", tplJ({ name: "区分", value: "通常", mode: "TEXT" })],
            ["IF_END", ""],
            ["TEXT", "{{申請番号}}"], ["KEY", "{TAB}"],
            ["TEXT", "{{金額}}"], ["KEY", "{TAB}"],
            ["TEXT", "{{$区分}}"], ["KEY", "{ENTER}"],
            ["RECORD", tplJ({ name: "区分", value: "{{$区分}}" })]
        ])
    },
    {
        id: "ctl-pages", category: "変数・繰り返し・分岐", level: 2,
        name: "ページ送りしながら全ページを撮影（回数を決めた繰り返し）",
        summary: "画面を先頭に戻してから「撮影 → PageDown」をページ数だけくり返し、全ページを画像で残します。ページ数はCSVで文書ごとに変えられます。",
        useCase: "PDFや照会画面の複数ページを証跡として残すとき、印刷できない画面を控えておくとき。",
        prepare: ["撮影したい文書や画面を開いておく", "CSVの「ウィンドウ名」をタイトルの先頭か末尾に合わせる（🔍一覧）"],
        customize: ["1ページずつ進むキーが違う画面では KEY {PGDN} を {DOWN 30} などに変えます"],
        ideas: ["何回目かは {{$ページ}} で使えるので、ファイル名が「報告書_p1」「報告書_p2」…と自動で付きます", "回数が分からないときは「条件のあいだくり返す」と「繰り返しを抜ける」を使います"],
        targetWindow: "", csvFile: "58_ctl_pages.csv",
        csv: [
            ["ウィンドウ名", "文書名", "ページ数"],
            ["見本の報告書", "報告書", "5"],
            ["見本の会議録", "会議録", "3"]
        ],
        steps: [
            ["SWITCH", "{{ウィンドウ名}}"],
            ["KEY", "^{HOME}"],
            ["WAIT", "800"],
            ["LOOP_START", tplJ({ mode: "COUNT", count: "{{ページ数}}", left: "", op: "NOT_EMPTY", right: "", counter: "ページ", max: "500" })],
            ["SCREENSHOT", tplJ({ name: "{{文書名}}_p{{$ページ}}", scope: "WINDOW" })],
            ["KEY", "{PGDN}"],
            ["WAIT", "800"],
            ["LOOP_END", ""]
        ]
    },
    {
        id: "ctl-excel-list", category: "変数・繰り返し・分岐", level: 2,
        name: "Excelのブックを開かずに、A列を最後まで読む（繰り返しを抜ける）",
        summary: "画面を使わずにブックのA列を1行目から読み、空のセルが出たら「繰り返しを抜ける」で終わります。読んだ件数と値の一覧を実行結果CSVに残します。",
        useCase: "台帳の件数を数える、名簿を読んで別のシステムに入力する前の確認など。",
        prepare: ["ブックのパスをCSVに書く（見本は C:\\RPA作業\\台帳.xlsx）", "ブックは閉じておく（開いていても読めますが、書き込みはできません）"],
        customize: ["読む列は「Excelのセルを読む」のセル番地 A{{$行}} の A を変えます", "上限は「繰り返し」の回数（1000）です"],
        ideas: ["読んだ値で「もし〜なら」を使えば、条件に合う行だけ処理するロボットになります", "EXCEL_WRITE と組み合わせれば、読んだ値を加工して別の列に書き戻せます"],
        targetWindow: "", csvFile: "59_ctl_excel_list.csv",
        csv: [
            ["ブックのパス", "シート"],
            ["C:\\RPA作業\\台帳.xlsx", "1"]
        ],
        steps: [
            ["SET_VAR", tplJ({ name: "一覧", value: "", mode: "TEXT" })],
            ["LOOP_START", tplJ({ mode: "COUNT", count: "1000", left: "", op: "NOT_EMPTY", right: "", counter: "行", max: "1000" })],
            ["EXCEL_READ", tplJ({ path: "{{ブックのパス}}", sheet: "{{シート}}", cell: "A{{$行}}", name: "値" })],
            ["IF_START", tplJ({ left: "{{$値}}", op: "EMPTY", right: "" })],
            ["BREAK", ""],
            ["IF_END", ""],
            ["SET_VAR", tplJ({ name: "一覧", value: "{{$一覧}}{{$値}}／", mode: "TEXT" })],
            ["LOOP_END", ""],
            ["SET_VAR", tplJ({ name: "件数", value: "{{$行}}-1", mode: "CALC" })],
            ["RECORD", tplJ({ name: "件数", value: "{{$件数}}" })],
            ["RECORD", tplJ({ name: "一覧", value: "{{$一覧}}" })]
        ]
    },
    {
        id: "ctl-try", category: "変数・繰り返し・分岐", level: 2,
        name: "エラーが出ても止めずに記録して次の行へ（エラー時の処理）",
        summary: "「エラー時の処理」の中でエラーが起きたら、止めずに「エラーのとき」へ進み、エラーの内容と画面を記録して次の行に進みます。見本CSVの2行目はわざと存在しない画面にしてあります。",
        useCase: "100件のうち数件だけエラーになる処理で、途中で止まらずに最後まで流し、エラーの行だけ後でまとめて直したいとき。",
        prepare: ["特になし（メモ帳は自動で開きます）"],
        customize: ["「エラー時の処理」の中に、止めたくない処理（登録ボタンのクリックなど）を入れます", "WINDOW_CHECK の STOP（緊急停止）と ⏹ 停止は受け止めないので、本当に止めたい異常はちゃんと止まります"],
        ideas: ["実行結果CSVの「結果」列でフィルターすれば、失敗した行だけの一覧になります", "「エラーのとき」に KEY {ESC} や CLICK_NAME「閉じる」を入れて、エラー画面を閉じてから次へ進むのが実用的です"],
        targetWindow: "", csvFile: "60_ctl_try.csv",
        csv: [
            ["ウィンドウ名", "内容"],
            ["メモ帳", "1行目のデータ"],
            ["存在しない画面", "2行目のデータ"],
            ["メモ帳", "3行目のデータ"]
        ],
        steps: [
