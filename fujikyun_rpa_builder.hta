        targetWindow: "庶務事務", csvFile: "51_shomu_ryoko.csv",
        csv: [
            ["出発日", "帰着日", "用務先", "用務内容", "交通手段"],
            ["2026/10/14", "2026/10/14", "見本県庁", "担当者会議への出席", "電車"],
