    // ----------------------------------------------------------------- 文書起案システム
    {
        id: "kian-draft", category: "文書起案システム", level: 2,
        name: "起案文書を一括作成して一時保存（確認つき）",
        summary: "文書起案システムの新規起案画面で、件名・本文・文書分類などを入力し、人が確認してから「一時保存」します。起案（決裁に回す）ボタンは押しません。",
        useCase: "定例の通知・照会文書を何件もまとめて起案するとき。最後の起案ボタンは人が押すので安心です。",
        prepare: ["対象ウィンドウをシステムの画面タイトルに合わせる（🔍一覧 で選べます）", "「新規起案」「一時保存」ボタンの表示名を、自分のシステムの表記に合わせる", "件名欄から TAB で本文・分類…と移動できるか、手で確認しておく"],
        customize: ["最初は「件名欄をクリック」の確認ポイント（CONFIRM）で手動クリックします。慣れたら無効化されている CLICK_POS を📍座標取得で合わせて有効化し、CONFIRMを無効化すると完全自動になります（⊘ 無効化 ボタン）", "TABの回数が違う欄は KEY {TAB 2} などに変えます"],
        ideas: ["件名に {{WAREKI_YEAR}} や {{ROW}} を入れると、年度や連番つきの件名を自動で作れます"],
        targetWindow: "文書管理", csvFile: "10_kian.csv",
        csv: [
            ["件名", "本文", "文書分類", "保存期間"],
            ["令和8年度 研修会の開催について（通知）", "標記について、下記のとおり開催しますので通知します。\n\n記\n1 日時 令和8年11月10日 午後2時から\n2 場所 第1会議室", "通知", "5年"],
            ["令和8年度 施設点検結果の報告について", "標記について、別添のとおり報告します。", "報告", "5年"],
            ["各課の備品調査について（照会）", "標記について、別紙様式により11月20日までに回答願います。", "照会", "1年"]
        ],
        steps: [
            ["COMMENT", "対象ウィンドウ名とボタン名（新規起案・一時保存）を自分のシステムに合わせてね"],
            ["CLICK_NAME", "新規起案"],
            ["WAIT", "3000"],
            ["GROUP_START", "件名欄にカーソルを置く"],
            ["CLICK_POS", tplPos(400, 250), { disabled: true }],
            ["CONFIRM", "件名の入力欄をクリックしてから［▶ 続行］を押してね。\n（件名：{{件名}}）"],
            ["GROUP_END", ""],
            ["GROUP_START", "入力"],
            ["KEY", "^a"],
            ["TEXT", "{{件名}}"],
            ["KEY", "{TAB}"],
            ["TEXT", "{{本文}}"],
            ["KEY", "{TAB}"],
            ["TEXT", "{{文書分類}}"],
            ["KEY", "{TAB}"],
            ["TEXT", "{{保存期間}}"],
            ["GROUP_END", ""],
            ["CONFIRM", "入力内容を確認してね。OKなら［▶ 続行］で「一時保存」するよ。\n件名：{{件名}}"],
            ["CLICK_NAME", "一時保存"],
            ["WAIT", "2000"],
            ["WINDOW_CHECK", tplJ({ title: "エラー", key: "{ENTER}", mode: "SKIP" })],
            ["SCREENSHOT", tplJ({ name: "起案_{{ROW}}_{{件名}}", scope: "WINDOW" })]
        ]
    },
