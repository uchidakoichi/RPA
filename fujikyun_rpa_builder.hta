        ],
        parse: function (val) { return jsonVal(val, { path: "", sheet: "1", cell: "A1", value: "" }); },
        compose: function (v) { return jsonCompose(v, ["path", "sheet", "cell", "value"]); },
        validate: function (v) { return trimText(v.path) === "" ? "ブックのパスを入れてね♡" : trimText(v.cell) === "" ? "セル番地を入れてね♡" : ""; },
        autoLabel: function (val) { var p = this.parse(val); return "📗 " + fileNameOf(p.path) + " の " + p.cell + " に " + truncateText(p.value, 20) + " を書く"; }
    },
    // ------------------------------------------------------------- organise
    GROUP_START: {
        title: "グループ", icon: "📁", defaultVal: "新しいグループ",
        help: "コマンドをまとめるグループだよ。追加すると「グループ開始〜グループ終了」がセットで入るキュン。左の▼/▶で折りたためるよ。「実行タイミング」を変えると、アプリ起動などの準備を最初の1行だけ、保存などの後片付けを最後の1行だけにできるよ。",
        fields: [
            { id: "name", label: "グループ表示名", type: "text", placeholder: "例: 基本情報の入力" },
            { id: "when", label: "実行タイミング", type: "select", prop: true, options: [["", "毎行（ふつう）"], ["first", "最初の1行だけ（準備・アプリ起動など）"], ["last", "最後の1行だけ（保存・後片付けなど）"]] }
        ],
        parse: function (val) { return { name: val }; },
