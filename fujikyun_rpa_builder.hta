            if ((v.op === "REGEX_REPLACE" || v.op === "REGEX_EXTRACT") && v.a !== "" && !/\{\{/.test(v.a)) {
                try { new RegExp(v.a); } catch (ex) { return "正規表現の書き方が正しくないみたい: " + errorText(ex); }
            }
            return "";
        },
        autoLabel: function (val) {
            var p = this.parse(val);
            return "✂ $" + p.name + " ← " + truncateText(p.src, 20) + " を" + strOpName(p.op);
        }
    },
    ASK: {
