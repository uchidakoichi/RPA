            ["COPY", "金額"],
            ["KEY", "{ESC}"],
            ["GROUP_END", ""],
            ["SWITCH", "メモ帳"],
            ["GROUP_START", "貼り付け先へ書く"],
            ["TEXT", "{{$氏名}}"],
            ["KEY", "{TAB}"],
            ["TEXT", "{{$金額}}"],
            ["KEY", "{ENTER}"],
            ["GROUP_END", ""]
        ]
