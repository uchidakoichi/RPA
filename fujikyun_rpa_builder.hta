        fields: [
            { id: "name", label: "結果を入れる変数名", type: "text", placeholder: "例: 番号7桁" },
            { id: "src", label: "元の文字（差し込み可）", type: "text", placeholder: "例: {{宛名番号}}", placeholders: true },
            { id: "op", label: "加工のしかた", type: "select", options: null },
            { id: "a", label: "設定A（加工のしかたの説明を見てね・差し込み可）", type: "text", placeholders: true },
            { id: "b", label: "設定B（加工のしかたの説明を見てね・差し込み可）", type: "text", placeholders: true }
        ],
        parse: function (val) { return jsonVal(val, { name: "", src: "", op: "REPLACE", a: "", b: "" }); },
