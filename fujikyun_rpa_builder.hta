        ],
        steps: [["CLICK_NAME", "出張申請"], ["WAIT", "2500"]]
            .concat(tplCursor("出発日欄にカーソルを置く", "出発日の入力欄をクリックしてから［▶ 続行］を押してね（{{用務先}}）"))
            .concat([
                ["KEY", "^a"], ["TEXT", "{{出発日}}"], ["KEY", "{TAB}"],
                ["KEY", "^a"], ["TEXT", "{{帰着日}}"], ["KEY", "{TAB}"],
                ["KEY", "^a"], ["TEXT", "{{用務先}}"], ["KEY", "{TAB}"],
                ["KEY", "^a"], ["TEXT", "{{用務内容}}"], ["KEY", "{TAB}"],
                ["TEXT", "{{交通手段}}"],
                ["CONFIRM", "{{出発日}}〜{{帰着日}} {{用務先}}（{{用務内容}}）で合っているか確認してね。OKなら［▶ 続行］で申請するよ"],
                ["CLICK_NAME", "申請"],
                ["WAIT", "2000"],
                ["WINDOW_CHECK", tplJ({ title: "エラー", key: "{ENTER}", mode: "SKIP" })],
                ["SCREENSHOT", tplJ({ name: "出張申請_{{出発日}}_{{用務先}}", scope: "WINDOW" })]
            ])
    },
    {
        id: "shomu-chokin-check", category: "庶務事務システム", level: 2,
        name: "時間外勤務時間の月累計・年累計を職員ごとに確認",
        summary: "庶務担当・管理職向け。職員番号と対象月で照会し、その月の時間外勤務時間と年間の累計を読み取ります。結果CSVを Excel で開けば、所属の目安を超えそうな人がすぐ分かります。",
        useCase: "毎月の時間外勤務の点検、働き方の見直しの資料づくり。",
        prepare: SHOMU_PREPARE.concat(["時間外勤務の集計（照会）画面を開いておく", "読み取りグループ「月の時間外勤務時間」「年の累計」を📍で合わせて有効化する"]),
        customize: KIKAN_CUSTOMIZE,
        ideas: ["Excel の条件付き書式で、所属で決めた目安の時間を超えたセルに色を付ければ、そのまま点検表になります", "毎月同じCSV（対象月だけ変える）を流せば、月ごとの推移表が作れます"],
        targetWindow: "庶務事務", csvFile: "52_shomu_chokin_check.csv",
        csv: [
            ["職員番号", "氏名", "対象月"],
            ["E0001", "見本 太郎", "2026/09"],
            ["E0002", "試験 花子", "2026/09"],
            ["E0003", "練習 一郎", "2026/09"]
        ],
        steps: tplCursor("職員番号欄にカーソルを置く", "職員番号の入力欄をクリックしてから［▶ 続行］を押してね（{{氏名}}）")
            .concat([
                ["KEY", "^a"], ["CSV", "1"], ["KEY", "{TAB}"],
                ["KEY", "^a"], ["TEXT", "{{対象月}}"],
                ["KEY", "{ENTER}"],
                ["WAIT", "2000"],
                ["WINDOW_CHECK", tplJ({ title: "該当なし", key: "{ENTER}", mode: "SKIP" })]
            ])
            .concat(tplRead("月の時間外勤務時間", 600, 250))
            .concat(tplRead("年の累計", 600, 280))
            .concat([["SCREENSHOT", tplJ({ name: "時間外集計_{{対象月}}_{{職員番号}}", scope: "WINDOW" })]])
    },
    {
        id: "shomu-shukkinbo", category: "庶務事務システム", level: 1,
