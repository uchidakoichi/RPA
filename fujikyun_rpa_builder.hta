<!DOCTYPE html>
<html lang="ja">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<meta http-equiv="x-ua-compatible" content="ie=edge">
<title>ふじキュン♡のRPAマクロビルダー</title>
<hta:application
    id="fujikyunRPABuilder"
    applicationname="FujikyunRPABuilder"
    border="dialog" innerborder="no" scroll="auto"
    singleinstance="yes" sysmenu="yes" maximizebutton="yes" windowstate="normal">
<style type="text/css">
/* ===== Base ===== */
html, body {
    height: 100%;
    margin: 0;
    padding: 0;
}
body {
    font-family: "Meiryo UI", "Yu Gothic UI", "Segoe UI", "Segoe UI Emoji", sans-serif;
    font-size: 13px;
    color: #3a3040;
    background: #fdf5f9;
    overflow: auto;
}
button, input, select, textarea {
    font-family: inherit;
    font-size: 12px;
}

/* ===== Flexible layout: only .macro-container stretches ===== */
.app {
    display: -ms-flexbox;
    display: flex;
    -ms-flex-direction: column;
    flex-direction: column;
    height: 100%;
    min-height: 560px;
}
.top-panel,
.bottom-panel {
    -ms-flex: 0 0 auto;
    flex: 0 0 auto;
}
.macro-container {
    -ms-flex: 1 1 0%;
    flex: 1 1 0%;
    position: relative;
    min-height: 120px;
    overflow-x: hidden;
    overflow-y: auto;
    margin: 0 8px;
    padding: 6px 8px 40px 8px;
    background: #ffffff;
    border: 1px solid #ead7e2;
    border-radius: 6px;
    -ms-user-select: none;
    -webkit-user-select: none;
    user-select: none;
    cursor: default;
}

/* ===== Title bar ===== */
.title-bar {
    display: -ms-flexbox;
    display: flex;
    -ms-flex-align: center;
    align-items: center;
    padding: 6px 10px;
    background: #f7a8c8;
    background: linear-gradient(90deg, #f48fb1 0%, #f7b6d2 55%, #b3d9ff 100%);
    color: #ffffff;
}
.app-title {
    font-size: 17px;
    font-weight: bold;
    letter-spacing: 1px;
    text-shadow: 0 1px 2px rgba(120, 30, 80, 0.35);
}
.save-state {
    margin-left: 14px;
    padding: 2px 8px;
    border-radius: 10px;
    font-size: 12px;
    background: rgba(255, 255, 255, 0.85);
    color: #2e7d32;
}
.save-state.dirty {
    color: #c62828;
}
.spacer {
    -ms-flex: 1 1 auto;
    flex: 1 1 auto;
}

/* ===== Toolbar rows ===== */
.toolbar-row {
    display: -ms-flexbox;
    display: flex;
    -ms-flex-wrap: wrap;
    flex-wrap: wrap;
    -ms-flex-align: center;
    align-items: center;
    padding: 3px 8px;
}
.toolbar-row > * {
    margin: 2px 4px 2px 0;
}
.field-label {
    font-weight: bold;
    color: #8e3b66;
    margin-left: 4px;
}
.chk {
    white-space: nowrap;
}
.input-xs { width: 48px; }
.input-md { width: 170px; }
.input-lg { width: 340px; }
input[type="text"], select, textarea {
    border: 1px solid #d9c3d1;
    border-radius: 3px;
    padding: 3px 4px;
    background: #ffffff;
}
.csv-info {
    color: #6d5a66;
    font-size: 12px;
}
.insert-hint {
    color: #1565c0;
    font-size: 12px;
}

/* ===== Buttons ===== */
.btn {
    border: 1px solid #d9c3d1;
    background: #ffffff;
    color: #3a3040;
    border-radius: 4px;
    padding: 3px 9px;
    cursor: pointer;
    white-space: nowrap;
}
.btn:hover { background: #fdeaf3; border-color: #f48fb1; }
.btn[disabled], .btn[disabled]:hover {
    color: #b8adb4;
    background: #f4f0f2;
    border-color: #e2d8de;
    cursor: default;
}
.btn-primary { background: #f06292; border-color: #e0457b; color: #ffffff; font-weight: bold; }
.btn-primary:hover { background: #ec407a; }
.btn-save { background: #ffffff; color: #c2185b; font-weight: bold; border-color: #ffffff; }
.btn-run { background: #43a047; border-color: #2e7d32; color: #ffffff; font-weight: bold; }
.btn-run:hover { background: #388e3c; border-color: #1b5e20; }
.btn-stop { color: #c62828; font-weight: bold; }
.btn-danger { background: #e53935; border-color: #c62828; color: #ffffff; }
.btn-danger:hover { background: #c62828; }
.btn-danger-lite { color: #c62828; }
.btn-cmd { border-left-width: 4px; font-weight: bold; }
.file-btn-wrap {
    position: relative;
    display: inline-block;
    overflow: hidden;
}
.file-btn-wrap input[type="file"] {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
    font-size: 60px;
}

/* ===== Command categories (palette + badges) ===== */
.cat-input  { border-left-color: #1e88e5; }
.cat-flow   { border-left-color: #fb8c00; }
.cat-window { border-left-color: #8e24aa; }
.cat-mouse  { border-left-color: #00897b; }
.cat-group  { border-left-color: #795548; }
.cat-note   { border-left-color: #43a047; }

/* ===== Macro blocks ===== */
.block {
    display: -ms-flexbox;
    display: flex;
    -ms-flex-align: center;
    align-items: center;
    min-height: 26px;
    margin: 2px 0;
    padding: 2px 4px;
    background: #fbf9fa;
    border: 2px solid transparent;
    border-left: 5px solid #cfc3ca;
    border-radius: 4px;
    -ms-user-select: none;
    -webkit-user-select: none;
    user-select: none;
}
.block:hover { background: #fff3f8; }
.block.cat-input  { border-left-color: #1e88e5; }
.block.cat-flow   { border-left-color: #fb8c00; }
.block.cat-window { border-left-color: #8e24aa; }
.block.cat-mouse  { border-left-color: #00897b; }
.block.cat-group  { border-left-color: #795548; background: #f6f1ee; }
.block.cat-note   { border-left-color: #43a047; background: #f5fbf5; }
.block.selected {
    border-top-color: #2196f3;
    border-right-color: #2196f3;
    border-bottom-color: #2196f3;
    background: #e8f3fe;
}
.block.running {
    background: #fff6c2;
    border-top-color: #fbc02d;
    border-right-color: #fbc02d;
    border-bottom-color: #fbc02d;
}
.block.dragging { opacity: 0.4; }
.block.drop-before { box-shadow: inset 0 4px 0 #2196f3; }
.block.drop-after { box-shadow: inset 0 -4px 0 #2196f3; }
.block.hidden { display: none; }
.toggle, .toggle-space {
    display: inline-block;
    width: 18px;
    text-align: center;
    color: #795548;
    -ms-flex: 0 0 auto;
    flex: 0 0 auto;
}
.toggle { cursor: pointer; font-size: 11px; }
.toggle:hover { color: #e91e63; }
.step-no {
    -ms-flex: 0 0 auto;
    flex: 0 0 auto;
    width: 30px;
    text-align: right;
    margin-right: 6px;
    color: #a2939c;
    font-size: 11px;
}
.badge {
    -ms-flex: 0 0 auto;
    flex: 0 0 auto;
    min-width: 74px;
    margin-right: 8px;
    padding: 1px 4px;
    border-radius: 3px;
    text-align: center;
    font-size: 11px;
    font-weight: bold;
    color: #ffffff;
    background: #9e9e9e;
}
.cat-input .badge  { background: #1e88e5; }
.cat-flow .badge   { background: #fb8c00; }
.cat-window .badge { background: #8e24aa; }
.cat-mouse .badge  { background: #00897b; }
.cat-group .badge  { background: #795548; }
.cat-note .badge   { background: #43a047; }
.step-main {
    -ms-flex: 1 1 auto;
    flex: 1 1 auto;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}
.step-label { font-weight: bold; }
.step-val {
    margin-left: 10px;
    color: #8a7d85;
    font-family: Consolas, "MS Gothic", monospace;
    font-size: 11px;
}
.comment-text { color: #2e7d32; font-style: italic; }
.group-name { font-weight: bold; color: #5d4037; }
.group-end-text { color: #8d6e63; font-size: 11px; }
.collapsed-count { margin-left: 8px; color: #a1887f; font-size: 11px; }
.actions {
    -ms-flex: 0 0 auto;
    flex: 0 0 auto;
    margin-left: 6px;
}
.icon-btn {
    border: 1px solid transparent;
    background: transparent;
    color: #8a7d85;
    border-radius: 3px;
    padding: 0 6px;
    cursor: pointer;
    font-size: 13px;
}
.icon-btn:hover { border-color: #90caf9; background: #ffffff; color: #1565c0; }
.icon-btn.icon-del:hover { border-color: #ef9a9a; color: #c62828; }
.empty-hint {
    margin: 40px auto;
    text-align: center;
    color: #b08aa0;
    line-height: 2;
}

/* ===== Bottom panel & log ===== */
.bottom-panel { padding-top: 4px; }
.run-row { background: #fff0f6; border-top: 1px solid #f3d3e2; }
.progress {
    font-weight: bold;
    color: #6a1b9a;
}
.log-area {
    height: 140px;
    overflow-y: auto;
    padding: 4px 8px;
    background: #2d2733;
    color: #ece6f0;
    font-family: Consolas, "MS Gothic", monospace;
    font-size: 12px;
    line-height: 1.45;
    -ms-user-select: text;
    user-select: text;
}
.log-line { white-space: pre-wrap; word-wrap: break-word; }
.log-info  { color: #ece6f0; }
.log-ok    { color: #a5e3a8; }
.log-warn  { color: #ffe082; }
.log-error { color: #ff8a9a; font-weight: bold; }
.log-run   { color: #8fd3ff; }

/* ===== Modal dialog ===== */
.modal-overlay {
    display: none;
    position: fixed;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 100;
    background: rgba(70, 30, 55, 0.35);
}
.modal {
    position: relative;
    width: 560px;
    max-width: 92%;
    margin: 50px auto 0 auto;
    background: #ffffff;
    border-radius: 8px;
    border: 1px solid #f0b8d0;
    box-shadow: 0 8px 28px rgba(80, 20, 60, 0.35);
}
.modal-title {
    padding: 9px 14px;
    border-radius: 8px 8px 0 0;
    background: #fce4ef;
    color: #ad1457;
    font-weight: bold;
    font-size: 14px;
}
.modal-body {
    max-height: 62vh;
    overflow-y: auto;
    padding: 10px 14px;
}
.modal-footer {
    padding: 8px 14px 12px 14px;
    text-align: right;
}
.modal-footer .btn { margin-left: 6px; padding: 5px 14px; }
.form-help {
    margin-bottom: 8px;
    padding: 6px 8px;
    background: #f3f8ff;
    border-left: 3px solid #64b5f6;
    color: #37474f;
    font-size: 12px;
    line-height: 1.6;
}
.form-row { margin: 8px 0; }
.form-label {
    display: block;
    margin-bottom: 3px;
    font-weight: bold;
    color: #6d3a58;
}
.form-input { width: 96%; }
.form-inline {
    display: -ms-flexbox;
    display: flex;
    -ms-flex-align: center;
    align-items: center;
}
.form-inline .form-input { -ms-flex: 1 1 auto; flex: 1 1 auto; width: auto; margin-right: 6px; }
.form-inline select.form-input { -ms-flex: 0 0 auto; flex: 0 0 auto; width: 190px; }
.form-hint { margin-top: 3px; color: #8a7d85; font-size: 11px; }
.form-error {
    display: none;
    margin-top: 8px;
    padding: 5px 8px;
    background: #ffebee;
    color: #c62828;
    border-radius: 3px;
}
.modal-message { line-height: 1.8; white-space: pre-wrap; }
.pick-list { margin: 0; padding: 0; list-style: none; }
.pick-list li {
    margin: 3px 0;
    padding: 5px 8px;
    border: 1px solid #eadde4;
    border-radius: 4px;
    cursor: pointer;
}
.pick-list li:hover { background: #e8f3fe; border-color: #2196f3; }
.block.disabled { opacity: 0.45; }
.block.disabled .step-label,
.block.disabled .group-name { text-decoration: line-through; }
.off-tag, .when-tag {
    margin: 0 6px 0 0;
    padding: 0 5px;
    border-radius: 3px;
    font-size: 11px;
    color: #ffffff;
    background: #9e9e9e;
}
.when-tag { margin-left: 8px; background: #7e57c2; }
.ph-select { margin-top: 3px; max-width: 96%; }
.modal.wide { width: 900px; }
.tpl-toolbar { margin-bottom: 6px; }
.tpl-cat {
    margin: 12px 0 4px 0;
    padding-bottom: 2px;
    border-bottom: 2px solid #f3d3e2;
    color: #ad1457;
    font-weight: bold;
    font-size: 14px;
}
.tpl-card {
    margin: 6px 0;
    padding: 6px 10px;
    border: 1px solid #eadde4;
    border-radius: 6px;
    background: #fffafd;
}
.tpl-head {
    display: -ms-flexbox;
    display: flex;
    -ms-flex-align: center;
    align-items: center;
}
.tpl-name { -ms-flex: 1 1 auto; flex: 1 1 auto; font-weight: bold; color: #4a2340; }
.tpl-level {
    margin-right: 6px;
    padding: 1px 7px;
    border-radius: 9px;
    font-size: 11px;
    background: #e3f2fd;
    color: #1565c0;
}
.tpl-level.lv2 { background: #fff3e0; color: #e65100; }
.tpl-level.lv3 { background: #fce4ec; color: #ad1457; }
.tpl-new { margin-right: 6px; padding: 1px 6px; border-radius: 9px; font-size: 11px; background: #fff59d; color: #6d4c00; }
.tpl-desc { margin-top: 3px; font-size: 12px; line-height: 1.6; color: #4a3f47; }
.tpl-meta { margin-top: 2px; font-size: 11px; color: #8a7d85; }
.diag-table { width: 100%; border-collapse: collapse; font-size: 12px; }
.diag-table td { padding: 4px 6px; border-bottom: 1px solid #f0e6ec; vertical-align: top; }
.diag-ok { color: #2e7d32; font-weight: bold; white-space: nowrap; }
.diag-ng { color: #c62828; font-weight: bold; white-space: nowrap; }
.diag-hint { margin-top: 8px; padding: 6px 8px; background: #fff8e1; border-left: 3px solid #ffb300; line-height: 1.7; white-space: pre-wrap; }
.img-capture-row { margin-top: 5px; }
.img-preview { margin-top: 4px; }
.img-preview img {
    max-width: 100%;
    max-height: 120px;
    border: 1px dashed #f48fb1;
    background: #ffffff;
}
</style>
</head>
<body>
<div class="app" id="app">

    <!-- ===== Top panel (fixed height) ===== -->
    <div class="top-panel">
        <div class="title-bar">
            <span class="app-title">ふじキュン♡のRPAマクロビルダー</span>
            <span class="save-state" id="saveState">✔ 保存済み</span>
            <span class="spacer"></span>
            <button class="btn btn-save" onclick="saveProduction()" title="gprime_macros.json に上書き保存します (Ctrl+S)">💾 本番ファイルに保存</button>
        </div>

        <div class="toolbar-row">
            <span class="field-label">マクロ</span>
            <select id="macroSelect" onchange="onMacroSelectChange()" style="min-width:220px"></select>
            <button class="btn" onclick="addMacro()">＋ 新規</button>
            <button class="btn" onclick="renameMacro()">✎ 名前変更</button>
            <button class="btn" onclick="duplicateMacro()">⧉ 複製</button>
            <button class="btn btn-danger-lite" onclick="deleteMacro()">🗑 削除</button>
            <button class="btn btn-primary" onclick="showTemplateGallery()" title="Excel・Word・起案・財務会計などのお手本マクロから作ります">📚 テンプレート</button>
            <button class="btn" onclick="exportMacro()" title="選択中のマクロを1つのJSONファイルに書き出します（同僚との共有に）">📤 書出</button>
            <span class="file-btn-wrap"><button class="btn" tabindex="-1" title="書き出したマクロJSONを取り込みます">📥 取込</button><input type="file" id="macroImportInput" accept=".json" onchange="importMacroFile(this)"></span>
            <span class="field-label">対象ウィンドウ</span>
            <input type="text" id="targetWindowInput" class="input-md" placeholder="例: GPRIME" onchange="onTargetWindowChange()"
                   title="タイトルバーの文字（完全一致→前方一致→後方一致の順で探します）">
            <button class="btn" onclick="showWindowList()" title="いま開いているウィンドウの一覧から選びます">🔍 一覧</button>
        </div>

        <div class="toolbar-row">
            <span class="field-label">CSV</span>
            <input type="text" id="csvPathInput" class="input-lg" placeholder="CSVファイルのフルパス（📂参照 でも選べるキュン）">
            <span class="file-btn-wrap"><button class="btn" tabindex="-1">📂 参照</button><input type="file" id="csvFileInput" accept=".csv,.txt" onchange="onCsvFileChosen(this)"></span>
            <button class="btn" onclick="loadCsvFromInput()">📥 読込</button>
            <label class="chk"><input type="checkbox" id="csvHeaderCheck" checked onclick="reparseCsv()"> 1行目は見出し</label>
            <select id="csvEncodingSelect" onchange="reloadCsvIfLoaded()" title="文字コード">
                <option value="auto">文字コード自動判定</option>
                <option value="shift_jis">Shift_JIS</option>
                <option value="utf-8">UTF-8</option>
                <option value="unicode">UTF-16</option>
            </select>
            <span class="csv-info" id="csvInfo">CSV未読込</span>
        </div>

        <div class="toolbar-row">
            <span class="field-label">追加</span>
            <span id="paletteButtons"></span>
        </div>

        <div class="toolbar-row">
            <span class="field-label">編集</span>
            <button class="btn" id="undoBtn" onclick="undo()" title="元に戻す (Ctrl+Z)">↩️</button>
            <button class="btn" id="redoBtn" onclick="redo()" title="やり直し (Ctrl+Y)">↪️</button>
            <select id="historySelect" onchange="jumpToHistory()" style="width:260px" title="履歴から好きな時点に戻せます（最大30件）"></select>
            <button class="btn" onclick="moveSelected(-1)" title="選択ブロックを上へ (Alt+↑)">▲</button>
            <button class="btn" onclick="moveSelected(1)" title="選択ブロックを下へ (Alt+↓)">▼</button>
            <button class="btn" onclick="duplicateSelected()" title="選択ブロックを複製 (Ctrl+D)">⧉ 複製</button>
            <button class="btn" onclick="toggleDisabledSelected()" title="選択ブロックを一時的に無効化／有効化（実行時に飛ばします） (Ctrl+/)">⊘ 無効化</button>
            <button class="btn" onclick="setAllCollapsed(false)" title="すべてのグループを展開">▼ 全展開</button>
            <button class="btn" onclick="setAllCollapsed(true)" title="すべてのグループを折りたたみ">▶ 全折りたたみ</button>
            <span class="insert-hint" id="insertHint"></span>
        </div>
    </div>

    <!-- ===== Macro command area (the only flexible area) ===== -->
    <div class="macro-container" id="macroContainer"></div>

    <!-- ===== Bottom panel (fixed height) ===== -->
    <div class="bottom-panel">
        <div class="toolbar-row run-row">
            <button class="btn btn-run" id="runBtn" onclick="startRun()">▶ 実行</button>
            <button class="btn" id="pauseBtn" onmousedown="togglePause()" disabled>⏸ 一時停止</button>
            <button class="btn btn-stop" id="stopBtn" onmousedown="stopRun('停止ボタン')" disabled title="Escキーでも止まります">⏹ 停止</button>
            <label>開始行 <input type="text" id="startRowInput" class="input-xs" value="1"></label>
            <label>終了行 <input type="text" id="endRowInput" class="input-xs" placeholder="最後"></label>
            <label>間隔 <input type="text" id="stepIntervalInput" class="input-xs" value="300"> ms</label>
            <label class="chk"><input type="checkbox" id="alarmCheck" checked> アラーム音</label>
            <button class="btn" onclick="playAlarm(true)" title="アラーム音をテスト再生">🔔</button>
            <label class="chk" title="ONにすると入力系コマンドの前に毎回、対象ウィンドウを前面化して確認します"><input type="checkbox" id="safeModeCheck"> 毎ステップ前面化</label>
            <label class="chk" title="全行おわったら完了の音を鳴らします"><input type="checkbox" id="notifyCheck" checked> 完了音</label>
            <button class="btn" id="exportErrorBtn" onclick="exportErrorRows()">↓ エラー行をCSV保存 (0)</button>
            <button class="btn" id="exportResultBtn" onclick="exportResultRows()" title="各行の実行結果と、COPY_SAVEで記録した値をCSVに保存します">↓ 実行結果CSV (0)</button>
            <button class="btn" onclick="runDiagnostics()" title="PowerShell・音・クリップボードなど、この端末で使える機能を調べます">🩺 環境チェック</button>
            <span class="spacer"></span>
            <span class="progress" id="progressText">待機中キュン♡</span>
        </div>
        <div class="log-area" id="logArea"></div>
    </div>
</div>

<!-- ===== Modal dialog ===== -->
<div class="modal-overlay" id="modalOverlay">
    <div class="modal" id="modalBox">
        <div class="modal-title" id="modalTitle"></div>
        <div class="modal-body" id="modalBody"></div>
        <div class="modal-footer" id="modalFooter"></div>
    </div>
</div>

<script type="text/javascript">
// =====================================================================
//  Fujikyun RPA Macro Builder  (HTA / ES5 only)
// =====================================================================

// ----- Constants -----
var DATA_VERSION = 24;
var MACRO_FILE_NAME = "gprime_macros.json";
var TEMP_FILE_NAME = "gprime_macros_temp.json";
var DISCARDED_TEMP_PREFIX = "gprime_macros_temp_discarded";   // + "_<timestamp>.json", one per discard
var BROKEN_FILE_PREFIX = "gprime_macros_broken";               // copy of a production file that could not be read
var BACKUP_FILE_NAME = "gprime_macros_backup.json";            // previous production version, kept by every save
var PASTE_SETTLE_MS = 250;                                     // let the target app take a paste before the clipboard changes
var ERROR_FILE_NAME = "gprime_error_list.csv";
var HISTORY_LIMIT = 30;
var INDENT_PX = 25;
var LOG_LIMIT = 500;
var ALARM_WAV_PATH = "C:\\Windows\\Media\\Alarm01.wav";
var WINDOW_RETRY_MAX = 3;
var WINDOW_RETRY_INTERVAL_MS = 1000;
var PS_TIMEOUT_SEC = 30;
var IMAGE_FOLDER_NAME = "rpa_images";
var IMG_DEFAULT_THRESHOLD = 0.9;
var IMG_COLOR_TOLERANCE = 24;   // per RGB channel (0-255)
var IMG_SEARCH_RETRY = 3;       // screen captures per CLICK_IMG (1 second apart)
var IMG_PS_TIMEOUT_SEC = 90;
var IMG_SEARCH_DEADLINE_SEC = 60;
var RESULT_FILE_NAME = "gprime_result.csv";
var SAMPLE_FOLDER_NAME = "samples";
var EVIDENCE_FOLDER_NAME = "evidence";
var EXPORT_FOLDER_NAME = "macro_export";
var NOTIFY_WAV_PATH = "C:\\Windows\\Media\\tada.wav";
var POWERSHELL_PATH = "%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe";
var COPY_WAIT_MS = 400;
var saveBlockReason = "";       // why saving over the production file needs an explicit confirmation
var startupNotices = [];        // problems found while loading, shown once the window is up
var csvParseWarnings = [];

// ----- Global state -----
var shell = null;
var fso = null;
var appDir = "";
var appData = { version: DATA_VERSION, macros: [] };
var currentMacroIndex = 0;
var selectedIndex = -1;
var selectedEl = null;
var historyStack = [];
var historyPos = -1;
var isDirty = false;
var csvState = { path: "", encoding: "", records: [], header: null, rows: [] };
var errorRows = [];
var runState = null;
var dragState = null;
var modalButtons = [];
var modalToken = 0;
var psSeq = 0;
var pendingTempFiles = [];
var lastWindowTitles = [];
var focusCheckTrusted = true;
var resultRows = [];
var resultColumns = [];
var alarmPlayer = null;
var notifyPlayer = null;
var alarmVoice = null;
var modalDismissFn = null;
var psPreferredLaunch = null;  // launch method confirmed to deliver a result this session
var psLaunchBlocked = false;    // every launch method threw: fail fast until the next diagnostics
var psLangRestricted = false;   // diagnostics found PowerShell in a restricted language mode
var psLastFailed = false;       // the latest PowerShell call did not come back (alarm skips straight to fallbacks)
var activePsJobs = {};          // base path -> job, for PowerShell calls whose files must not be cleaned up yet
var runHeader = null;           // CSV header snapshot taken at run start (used by the result/error CSV exports)
var SETTINGS_FILE_NAME = "fujikyun_settings.json";
var STOP_HOLD_POLLS = 8;        // Esc held for 8 polls x 120 ms (about 1 s) stops a run from any window

// =====================================================================
//  Utilities
// =====================================================================
function byId(id) {
    return document.getElementById(id);
}

function escapeHtml(s) {
    return String(s == null ? "" : s)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
}

function trimText(s) {
    return String(s == null ? "" : s).replace(/^\s+|\s+$/g, "");
}

function truncateText(s, n) {
    s = String(s == null ? "" : s).replace(/\r\n|\r|\n/g, "⏎");
    return s.length > n ? s.substring(0, n) + "…" : s;
}

function deepCopy(obj) {
    return JSON.parse(JSON.stringify(obj));
}

function toInt(v, def) {
    var n = parseInt(v, 10);
    return isNaN(n) ? def : n;
}

function pad2(n) {
    return (n < 10 ? "0" : "") + n;
}

function timeText(d) {
    d = d || new Date();
    return pad2(d.getHours()) + ":" + pad2(d.getMinutes()) + ":" + pad2(d.getSeconds());
}

function dateTimeText(d) {
    d = d || new Date();
    return d.getFullYear() + "/" + pad2(d.getMonth() + 1) + "/" + pad2(d.getDate()) + " " + timeText(d);
}

function hasClass(el, cls) {
    return !!el && (" " + el.className + " ").indexOf(" " + cls + " ") >= 0;
}

function addClass(el, cls) {
    if (el && !hasClass(el, cls)) {
        el.className = el.className ? el.className + " " + cls : cls;
    }
}

function removeClass(el, cls) {
    if (!el || !el.className) {
        return;
    }
    el.className = trimText((" " + el.className + " ").split(" " + cls + " ").join(" "));
}

function preventEvent(e) {
    if (!e) {
        return false;
    }
    if (e.preventDefault) {
        e.preventDefault();
    }
    e.returnValue = false;
    return false;
}

function generateId() {
    var t = ("0000" + (new Date().getTime() % 65536).toString(16)).slice(-4);
    var r = ("0000" + Math.floor(Math.random() * 65536).toString(16)).slice(-4);
    return t + r;
}

function uniqueMacroId() {
    var id, i, used;
    do {
        id = generateId();
        used = false;
        for (i = 0; i < appData.macros.length; i++) {
            if (appData.macros[i].id === id) {
                used = true;
            }
        }
    } while (used);
    return id;
}

// Quote a string as a PowerShell single-quoted literal (smart quotes are also quote chars in PS)
function psQuote(s) {
    return "'" + String(s == null ? "" : s).replace(/['\u2018\u2019\u201A\u201B]/g, "$&$&") + "'";
}

// Split "a,b,c" from the right so that the first parameter (window title) may contain commas
function splitParams(val, count) {
    var parts = String(val == null ? "" : val).split(",");
    var tail = [];
    while (tail.length < count - 1 && parts.length > 1) {
        tail.unshift(parts.pop());
    }
    var result = [parts.join(",")].concat(tail);
    while (result.length < count) {
        result.push("");
    }
    for (var i = 0; i < result.length; i++) {
        result[i] = trimText(result[i]);
    }
    return result;
}

// WScript.Shell.SendKeys has no {SPACE} code, so translate it to a literal space
function normalizeSendKeys(keys) {
    return String(keys == null ? "" : keys).replace(/\{SPACE(?:\s+(\d+))?\}/gi, function (m, count) {
        var n = count ? parseInt(count, 10) : 1;
        return new Array(n + 1).join(" ");
    });
}

// COM errors may come with an empty message: always show the HRESULT too
function errorText(e) {
    if (!e) {
        return "不明なエラー";
    }
    var msg = e["message"] || e["description"] || "";
    var code = typeof e.number === "number" && e.number !== 0 ? " [0x" + (e.number >>> 0).toString(16).toUpperCase() + "]" : "";
    return (msg || "詳細不明") + code;
}

function safeFileName(s) {
    var name = trimText(String(s == null ? "" : s).replace(/[\\\/:*?"<>|\r\n\t]/g, "_"));
    return name.length > 80 ? name.substring(0, 80) : name;
}

function dateStamp(d) {
    d = d || new Date();
    return d.getFullYear() + pad2(d.getMonth() + 1) + pad2(d.getDate());
}

function timeStamp(d) {
    d = d || new Date();
    return dateStamp(d) + "_" + pad2(d.getHours()) + pad2(d.getMinutes()) + pad2(d.getSeconds());
}

function ensureFolder(path) {
    if (!fso.FolderExists(path)) {
        var parent = fso.GetParentFolderName(path);
        if (parent && !fso.FolderExists(parent)) {
            ensureFolder(parent);
        }
        fso.CreateFolder(path);
    }
    return path;
}

// Japanese era (only the eras a clerk will meet in practice)
function warekiOf(d) {
    var y = d.getFullYear();
    var m = d.getMonth() + 1;
    var era;
    var ey;
    if (y > 2019 || (y === 2019 && m >= 5)) {
        era = "令和"; ey = y - 2018;
    } else if (y > 1989 || (y === 1989 && (m > 1 || d.getDate() >= 8))) {
        era = "平成"; ey = y - 1988;
    } else {
        era = "昭和"; ey = y - 1925;
    }
    return era + (ey === 1 ? "元" : String(ey)) + "年";
}

function fileNameOf(path) {
    return String(path == null ? "" : path).replace(/^.*[\\\/]/, "");
}

// "path,threshold" - the threshold is optional and the path itself may contain commas
function parseImageParams(val) {
    var s = String(val == null ? "" : val);
    var m = s.match(/^([\s\S]*),\s*(\d*\.?\d+)\s*$/);
    return m ? { path: trimText(m[1]), threshold: m[2] } : { path: trimText(s), threshold: String(IMG_DEFAULT_THRESHOLD) };
}

function clampThreshold(v) {
    var n = parseFloat(v);
    if (isNaN(n)) {
        return IMG_DEFAULT_THRESHOLD;
    }
    return Math.min(1, Math.max(0.5, n));
}

// Relative image paths are resolved against the HTA folder
function resolveImagePath(p) {
    p = trimText(p).replace(/^"+|"+$/g, "");
    if (p === "") {
        return "";
    }
    if (/^[A-Za-z]:[\\\/]/.test(p) || /^\\\\/.test(p)) {
        return p;
    }
    return appFilePath(p.replace(/\//g, "\\"));
}

// =====================================================================
//  Log
// =====================================================================
function log(message, level) {
    var area = byId("logArea");
    if (!area) {
        return;
    }
    var line = document.createElement("div");
    line.className = "log-line log-" + (level || "info");
    line.appendChild(document.createTextNode("[" + timeText() + "] " + message));
    area.appendChild(line);
    while (area.childNodes.length > LOG_LIMIT) {
        area.removeChild(area.firstChild);
    }
    area.scrollTop = area.scrollHeight;
}

// =====================================================================
//  ActiveX / file system
// =====================================================================
function initActiveX() {
    try {
        shell = new ActiveXObject("WScript.Shell");
    } catch (e1) {
        shell = null;
    }
    try {
        fso = new ActiveXObject("Scripting.FileSystemObject");
    } catch (e2) {
        fso = null;
    }
    return !!(shell && fso);
}

function resolveAppDir() {
    var path = "";
    var m;
    try {
        var hta = byId("fujikyunRPABuilder");
        var cmdLine = hta && hta.commandLine ? String(hta.commandLine) : "";
        m = cmdLine.match(/"([^"]+\.hta)"/i) || cmdLine.match(/(\S+\.hta)/i);
        if (m) {
            path = m[1];
        }
    } catch (e1) {
        path = "";
    }
    if (!path) {
        var href = String(location.href).replace(/[?#].*$/, "");
        try {
            href = decodeURIComponent(href);
        } catch (e2) {
            try { href = unescape(href); } catch (e3) { /* keep raw */ }
        }
        if (/^file:\/\/\/[A-Za-z]:/i.test(href)) {
            path = href.replace(/^file:\/\/\//i, "");
        } else if (/^file:\/\//i.test(href)) {
            path = "//" + href.replace(/^file:\/\/+/i, "");
        } else {
            path = href;
        }
        path = path.replace(/\//g, "\\");
    }
    var dir = "";
    try {
        dir = fso.GetParentFolderName(path);
    } catch (e4) {
        dir = "";
    }
    if (!dir || !fso.FolderExists(dir)) {
        try { dir = shell.CurrentDirectory; } catch (e5) { dir = ""; }
    }
    return dir;
}

function appFilePath(name) {
    return appDir ? appDir.replace(/\\+$/, "") + "\\" + name : name;
}

function readTextFile(path, charset) {
    var text = "";
    try {
        var st = new ActiveXObject("ADODB.Stream");
        st.Type = 2; // adTypeText
        st.Charset = charset || "utf-8";
        st.Open();
        st.LoadFromFile(path);
        text = st.ReadText(-1); // adReadAll
        st.Close();
    } catch (e) {
        // Fallback without ADODB.Stream. writeTextFile's own fallback writes UTF-16 with a BOM, so try
        // Unicode first and keep it when it looks like such a file; otherwise read as system ANSI
        text = readWithFso(path, -1);
        if (charset !== "unicode" && !(text.charCodeAt(0) === 0xFEFF || /^\s*[\[{]/.test(text))) {
            text = readWithFso(path, 0);
        }
    }
    if (text.charCodeAt(0) === 0xFEFF) {
        text = text.substring(1);
    }
    return text;
}

function readWithFso(path, format) {
    var ts = fso.OpenTextFile(path, 1, false, format); // -1 = Unicode, 0 = system ANSI
    var text = ts.AtEndOfStream ? "" : ts.ReadAll();
    ts.Close();
    return text;
}

// The only good copy of the macros is never overwritten in place: write a sibling file, read it
// back, keep the previous version as backupPath, then replace the target
function writeFileSafely(path, text, backupPath) {
    var tmp = path + ".saving";
    writeTextFile(tmp, text, false);
    if (readTextFile(tmp, "utf-8") !== text) {
        deleteFileQuietly(tmp);
        throw new Error("書き込んだ内容を読み直したら一致しなかった（ディスクやネットワークを確認してね）");
    }
    if (backupPath && fso.FileExists(path)) {
        fso.CopyFile(path, backupPath, true);
    }
    fso.CopyFile(tmp, path, true);
    fso.DeleteFile(tmp, true);
}

// Write UTF-8 (BOM is kept only when withBom is true, e.g. CSV for Excel)
function writeTextFile(path, text, withBom) {
    try {
        var st = new ActiveXObject("ADODB.Stream");
        st.Type = 2;
        st.Charset = "utf-8";
        st.Open();
        st.WriteText(text);
        if (withBom) {
            st.SaveToFile(path, 2); // adSaveCreateOverWrite
            st.Close();
            return;
        }
        st.Position = 0;
        st.Type = 1; // adTypeBinary
        st.Position = 3; // skip BOM
        var bin = new ActiveXObject("ADODB.Stream");
        bin.Type = 1;
        bin.Open();
        st.CopyTo(bin);
        bin.SaveToFile(path, 2);
        bin.Close();
        st.Close();
    } catch (e) {
        var ts = fso.CreateTextFile(path, true, true); // Unicode fallback
        ts.Write(text);
        ts.Close();
    }
}

function deleteFileQuietly(path) {
    try {
        if (fso && fso.FileExists(path)) {
            fso.DeleteFile(path, true);
        }
    } catch (e) {
        /* ignore */
    }
}

// Files of PowerShell calls still in flight are kept: deleting their .ps1 or .cancel would break them
function isActivePsFile(path) {
    for (var base in activePsJobs) {
        if (activePsJobs.hasOwnProperty(base) && path.indexOf(base) === 0) {
            return true;
        }
    }
    return false;
}

function cleanupTempFiles() {
    var remain = [];
    for (var i = 0; i < pendingTempFiles.length; i++) {
        if (isActivePsFile(pendingTempFiles[i])) {
            remain.push(pendingTempFiles[i]);
            continue;
        }
        deleteFileQuietly(pendingTempFiles[i]);
        if (fso && fso.FileExists(pendingTempFiles[i])) {
            remain.push(pendingTempFiles[i]);
        }
    }
    pendingTempFiles = remain;
}

// =====================================================================
//  CSV
// =====================================================================
// Like Excel / RFC 4180: a quote opens a quoted field only as the field's first character
// (12"モニタ stays text). Blank lines inside the data keep their place so row numbers match the
// file (they are skipped at run time); only trailing blank lines are dropped.
function parseCsv(text) {
    var records = [];
    var row = [];
    var field = "";
    var inQuotes = false;
    var atFieldStart = true;
    var quoteRecord = 0;
    var i = 0;
    var len = text.length;
    var c;
    csvParseWarnings = [];
    for (; i < len; i++) {
        c = text.charAt(i);
        if (inQuotes) {
            if (c === '"') {
                if (text.charAt(i + 1) === '"') {
                    field += '"';
                    i++;
                } else {
                    inQuotes = false;
                }
            } else {
                field += c;
            }
        } else if (c === '"' && atFieldStart) {
            inQuotes = true;
            atFieldStart = false;
            quoteRecord = records.length + 1;
        } else if (c === ",") {
            row.push(field);
            field = "";
            atFieldStart = true;
        } else if (c === "\r" || c === "\n") {
            row.push(field);
            field = "";
            records.push(row);
            row = [];
            atFieldStart = true;
            if (c === "\r" && text.charAt(i + 1) === "\n") {
                i++;
            }
        } else {
            field += c;
            atFieldStart = false;
        }
    }
    if (inQuotes) {
        csvParseWarnings.push(quoteRecord + "件目のレコードで始まった \" が閉じられていないから、ファイルの最後までを1つの値として読んじゃったキュン。CSVを確認してね");
    }
    if (field !== "" || row.length > 0) {
        row.push(field);
        records.push(row);
    }
    while (records.length && isBlankRow(records[records.length - 1])) {
        records.pop();
    }
    return records;
}

function isBlankRow(row) {
    for (var i = 0; i < row.length; i++) {
        if (row[i] !== "") {
            return false;
        }
    }
    return true;
}

function toHalfWidthDigits(s) {
    return String(s == null ? "" : s).replace(/[０-９]/g, function (ch) {
        return String.fromCharCode(ch.charCodeAt(0) - 0xFEE0);
    });
}

function toCsvField(v) {
    v = v == null ? "" : String(v);
    return /[",\r\n]/.test(v) ? '"' + v.replace(/"/g, '""') + '"' : v;
}

function readCsvText(path, encoding) {
    if (encoding && encoding !== "auto") {
        return { text: readTextFile(path, encoding), encoding: encoding };
    }
    var text = readTextFile(path, "utf-8");
    if (text.indexOf("\uFFFD") < 0) {
        return { text: text, encoding: "utf-8" };
    }
    return { text: readTextFile(path, "shift_jis"), encoding: "shift_jis" };
}

function encodingLabel(enc) {
    var map = { "utf-8": "UTF-8", "shift_jis": "Shift_JIS", "unicode": "UTF-16", "auto": "自動" };
    return map[enc] || enc;
}

function csvMaxColumns() {
    var max = csvState.header ? csvState.header.length : 0;
    var limit = Math.min(csvState.rows.length, 200);
    for (var i = 0; i < limit; i++) {
        if (csvState.rows[i].length > max) {
            max = csvState.rows[i].length;
        }
    }
    return max;
}

function csvHeaderName(col) {
    return csvState.header && col >= 1 && col <= csvState.header.length ? trimText(csvState.header[col - 1]) : "";
}

// =====================================================================
//  Placeholders  {{1}} {{列名}} {{ROW}} {{ROW+1}} {{TODAY}} {{WAREKI}} {{COPY:項目}} ...
// =====================================================================
var PLACEHOLDER_HELP = [
    ["{{ROW}}", "CSVの行番号（1始まり）"],
    ["{{ROW+1}}", "行番号＋1（Excelの見出し行ぶんずらす時に）"],
    ["{{TODAY}}", "今日 2026/09/30 形式"],
    ["{{TODAY_JP}}", "今日 2026年9月30日 形式"],
    ["{{WAREKI}}", "今日 令和8年9月30日 形式"],
    ["{{WAREKI_YEAR}}", "令和8年 形式"],
    ["{{YYYYMMDD}}", "今日 20260930 形式"],
    ["{{NOW}}", "いまの時刻 14:05 形式"],
    ["{{TIMESTAMP}}", "20260930_140512 形式（ファイル名向け）"],
    ["{{YEAR}}", "西暦の年"],
    ["{{MONTH}}", "月"],
    ["{{DAY}}", "日"]
];

function currentRowForPlaceholders(rs) {
    return rs && rs.rows && rs.rows[rs.rowPos] ? rs.rows[rs.rowPos] : { no: 0, data: [] };
}

function placeholderValue(key, rs) {
    var d = new Date();
    var row = currentRowForPlaceholders(rs);
    var up = key.toUpperCase();
    var m;
    var i;
    if (/^\d+$/.test(key)) {
        var col = toInt(key, 0);
        return col >= 1 && col <= row.data.length ? String(row.data[col - 1]) : "";
    }
    // An exact CSV header wins over the built-in names, so a column called "ROW" or "DAY" works as offered
    if (csvState.header) {
        for (i = 0; i < csvState.header.length; i++) {
            if (trimText(csvState.header[i]) === key) {
                return i < row.data.length ? String(row.data[i]) : "";
            }
        }
    }
    if ((m = up.match(/^ROW\s*([+\-])\s*(\d+)$/))) {
        return String(row.no + (m[1] === "+" ? 1 : -1) * toInt(m[2], 0));
    }
    if (up.indexOf("COPY:") === 0) {
        var name = trimText(key.substring(5));
        return rs && rs.captured && rs.captured.hasOwnProperty(name) ? rs.captured[name] : "";
    }
    switch (up) {
    case "ROW": return String(row.no);
    case "TODAY": return d.getFullYear() + "/" + pad2(d.getMonth() + 1) + "/" + pad2(d.getDate());
    case "TODAY_JP": return d.getFullYear() + "年" + (d.getMonth() + 1) + "月" + d.getDate() + "日";
    case "WAREKI": return warekiOf(d) + (d.getMonth() + 1) + "月" + d.getDate() + "日";
    case "WAREKI_YEAR": return warekiOf(d);
    case "YYYYMMDD": return dateStamp(d);
    case "NOW": return pad2(d.getHours()) + ":" + pad2(d.getMinutes());
    case "TIMESTAMP": return timeStamp(d);
    case "YEAR": return String(d.getFullYear());
    case "MONTH": return String(d.getMonth() + 1);
    case "DAY": return String(d.getDate());
    }
    return null;
}

// unsafe (optional array): collects substituted values that contain characters with a meaning in
// a command line (RUN goes through cmd.exe / ShellExecute), so data can never become a command
var COMMAND_UNSAFE_RE = /["&|<>^%\r\n]/;

function expandPlaceholders(text, rs, unsafe) {
    return String(text == null ? "" : text).replace(/\{\{([^{}]+)\}\}/g, function (all, rawKey) {
        var v = placeholderValue(trimText(rawKey), rs);
        if (v === null) {
            log("⚠ 差し込み " + all + " が何か分からなかったから、そのままにしたキュン（列名のつづりを確認してね）", "warn");
            return all;
        }
        if (unsafe && COMMAND_UNSAFE_RE.test(v)) {
            unsafe.push(all + "＝「" + truncateText(v, 20) + "」");
        }
        return v;
    });
}

// Choices for the "差し込み ▼" helper in the editor
function placeholderChoices() {
    var list = [];
    var cols = csvMaxColumns();
    var i;
    for (i = 1; i <= cols; i++) {
        var name = csvHeaderName(i);
        // An all-digit header would be read as a column number, and braces cannot be inside a placeholder
        var byName = name && !/^\d+$/.test(name) && !/[{}]/.test(name);
        list.push([byName ? "{{" + name + "}}" : "{{" + i + "}}", "CSV " + i + "列目" + (name ? "「" + name + "」" : "")]);
    }
    if (cols === 0) {
        list.push(["{{1}}", "CSV 1列目（{{2}}なら2列目…／見出し名 {{氏名}} でもOK）"]);
    }
    var steps = currentSteps();
    var seen = {};
    for (i = 0; i < steps.length; i++) {
        if (steps[i].cmd === "COPY_SAVE" && !seen[steps[i].val]) {
            seen[steps[i].val] = true;
            list.push(["{{COPY:" + steps[i].val + "}}", "コピーした値「" + steps[i].val + "」"]);
        }
    }
    return list.concat(PLACEHOLDER_HELP);
}

function insertPlaceholder(select, inputId) {
    var el = byId(inputId);
    if (el && select.value !== "") {
        el.value += select.value;
        try { el.focus(); } catch (e) { /* ignore */ }
    }
    select.selectedIndex = 0;
}

// =====================================================================
//  Command definitions
// =====================================================================
var KEY_PRESETS = [
    ["{TAB}", "Tab移動"],
    ["+{TAB}", "Shift+Tabで戻る"],
    ["{ENTER}", "Enterキー"],
    ["{SPACE}", "スペースキー"],
    ["{ESC}", "Escキー"],
    ["{UP}", "↑キー"],
    ["{DOWN}", "↓キー"],
    ["{LEFT}", "←キー"],
    ["{RIGHT}", "→キー"],
    ["{BS}", "BackSpaceキー"],
    ["{DELETE}", "Deleteキー"],
    ["{HOME}", "Homeキー"],
    ["{END}", "Endキー"],
    ["{PGUP}", "PageUpキー"],
    ["{PGDN}", "PageDownキー"],
    ["{F5}", "F5キー"],
    ["{F12}", "名前を付けて保存 (F12)"],
    ["^{HOME}", "先頭へ (Ctrl+Home)"],
    ["^{END}", "末尾へ (Ctrl+End)"],
    ["^g", "ジャンプ (Ctrl+G)"],
    ["^h", "置換 (Ctrl+H)"],
    ["^n", "新規作成 (Ctrl+N)"],
    ["^w", "閉じる (Ctrl+W)"],
    ["^l", "アドレスバーへ (Ctrl+L)"],
    ["^a", "全選択 (Ctrl+A)"],
    ["^c", "コピー (Ctrl+C)"],
    ["^v", "貼り付け (Ctrl+V)"],
    ["^s", "保存 (Ctrl+S)"],
    ["%{F4}", "閉じる (Alt+F4)"],
    ["%y", "はい (Alt+Y)"],
    ["%n", "いいえ (Alt+N)"]
];

function keyDisplayName(key) {
    for (var i = 0; i < KEY_PRESETS.length; i++) {
        if (KEY_PRESETS[i][0].toLowerCase() === String(key).toLowerCase()) {
            return KEY_PRESETS[i][1];
        }
    }
    return String(key);
}

var COMMAND_ORDER = ["KEY", "TEXT", "CSV", "COPY_SAVE", "WAIT", "WAIT_FOR", "IF", "CONFIRM", "SWITCH", "RUN", "CLICK", "CLICK_POS", "CLICK_IMG", "SCREENSHOT", "GROUP_START", "COMMENT"];

var COMMAND_DEFS = {
    KEY: {
        title: "キー送信", icon: "⌨", category: "input", defaultVal: "{TAB}",
        help: "SendKeys形式でキーを送るキュン♡ 例: {TAB} / +{TAB}(Shift+Tab) / {ENTER} / {SPACE} / ^c(Ctrl+C) / ^v(Ctrl+V) / %{F4}(Alt+F4) / {TAB 3}(3回)",
        fields: [{ id: "key", label: "送信キー", type: "keypreset", placeholder: "{TAB}" }],
        parse: function (val) { return { key: val }; },
        compose: function (v) { return v.key; },
        validate: function (v) { return v.key === "" ? "送信キーを入力してね♡" : ""; },
        autoLabel: function (val) { return keyDisplayName(val) === val ? "キー送信 " + val : keyDisplayName(val); }
    },
    TEXT: {
        title: "文字列貼付", icon: "📝", category: "input", defaultVal: "",
        help: "文字列をクリップボード経由で貼り付けるよ（Ctrl+V）。日本語入力(IME)がONでも化けないキュン。{{氏名}} や {{1}} でCSVの値、{{WAREKI}} で今日の和暦…みたいに「差し込み」もできるよ♡",
        fields: [{ id: "text", label: "入力する文字列（差し込み可）", type: "textarea", raw: true, placeholders: true }],
        parse: function (val) { return { text: val }; },
        compose: function (v) { return v.text; },
        validate: function (v) { return v.text === "" ? "文字列を入力してね♡" : ""; },
        autoLabel: function (val) { return "文字列「" + truncateText(val, 20) + "」を貼付"; }
    },
    CSV: {
        title: "CSV列を貼付", icon: "📄", category: "input", defaultVal: "1",
        help: "実行中のCSV行から、指定した列のデータをクリップボード経由で貼り付けるキュン。列番号は1始まりだよ。",
        fields: [{ id: "col", label: "CSV列番号（1始まり）", type: "csvcol", placeholder: "1" }],
        parse: function (val) { return { col: val }; },
        compose: function (v) { return String(toInt(v.col, 1)); },
        validate: function (v) { return !/^\d+$/.test(v.col) || toInt(v.col, 0) < 1 ? "列番号は1以上の数字で入れてね♡" : ""; },
        autoLabel: function (val) {
            var name = csvHeaderName(toInt(val, 0));
            return "CSV " + val + "列目" + (name ? "「" + name + "」" : "") + "を貼付";
        }
    },
    WAIT: {
        title: "待機", icon: "⏳", category: "flow", defaultVal: "1000",
        help: "指定したミリ秒だけロボットをお休みさせるキュン。1000ミリ秒 = 1秒だよ。",
        fields: [{ id: "ms", label: "待機時間（ミリ秒）", type: "text", placeholder: "1000" }],
        parse: function (val) { return { ms: val }; },
        compose: function (v) { return String(toInt(v.ms, 0)); },
        validate: function (v) { return !/^\d+$/.test(v.ms) ? "待機時間は0以上の数字（ミリ秒）で入れてね♡" : ""; },
        autoLabel: function (val) { return val + "ミリ秒待機"; }
    },
    WAIT_FOR: {
        title: "ウィンドウ出現待ち", icon: "👀", category: "flow", defaultVal: ",{ENTER},30",
        help: "指定タイトルのウィンドウがアクティブにできるか1秒ごとに見張るよ。出てきたらキーを押して次へ。タイムアウトしたら安全停止＋アラームだキュン。",
        fields: [
            { id: "title", label: "待つウィンドウのタイトル（一部）", type: "text", placeholder: "例: 確認" },
            { id: "key", label: "出現したら押すキー（空欄なら押さない）", type: "keypreset", placeholder: "{ENTER}" },
            { id: "timeout", label: "タイムアウト（秒）", type: "text", placeholder: "30" }
        ],
        parse: function (val) { var p = splitParams(val, 3); return { title: p[0], key: p[1], timeout: p[2] }; },
        compose: function (v) { return v.title + "," + v.key + "," + toInt(v.timeout, 30); },
        validate: function (v) {
            if (v.title === "") { return "待つウィンドウのタイトルを入れてね♡"; }
            return !/^\d+$/.test(v.timeout) || toInt(v.timeout, 0) < 1 ? "タイムアウトは1以上の秒数で入れてね♡" : "";
        },
        autoLabel: function (val) {
            var p = splitParams(val, 3);
            return "「" + p[0] + "」を最大" + p[2] + "秒待つ" + (p[1] ? " → " + keyDisplayName(p[1]) : "");
        }
    },
    IF: {
        title: "条件分岐（異常検知）", icon: "⚠", category: "flow", defaultVal: ",{ENTER},STOP",
        help: "指定タイトルのウィンドウが今出ているか即チェック！出ていたらキーを押して、STOPなら大音量アラームで緊急停止、SKIPならこのCSV行を打ち切って次の行へ、CONTINUEならそのまま続行（ときどき出るお知らせを閉じるのに便利）だキュン。",
        fields: [
            { id: "title", label: "検知するウィンドウのタイトル（一部）", type: "text", placeholder: "例: エラー" },
            { id: "key", label: "検知したら押すキー（空欄なら押さない）", type: "keypreset", placeholder: "{ENTER}" },
            { id: "mode", label: "検知したときの動き", type: "select", options: [["STOP", "STOP：アラーム＋緊急停止"], ["SKIP", "SKIP：この行を打ち切って次の行へ"], ["CONTINUE", "CONTINUE：キーを押して、そのまま続行"]] }
        ],
        parse: function (val) { var p = splitParams(val, 3); return { title: p[0], key: p[1], mode: normalizeIfMode(p[2]) }; },
        compose: function (v) { return v.title + "," + v.key + "," + normalizeIfMode(v.mode); },
        validate: function (v) { return v.title === "" ? "検知するウィンドウのタイトルを入れてね♡" : ""; },
        autoLabel: function (val) {
            var p = splitParams(val, 3);
            var mode = normalizeIfMode(p[2]);
            return "もし「" + p[0] + "」が出たら" + (p[1] ? keyDisplayName(p[1]) + "→" : "") +
                (mode === "SKIP" ? "行スキップ" : mode === "CONTINUE" ? "そのまま続行" : "緊急停止");
        }
    },
    CONFIRM: {
        title: "確認ポイント（人が確認）", icon: "✋", category: "flow", defaultVal: "内容を確認してね。よければ［▶ 続行］を押してね♡",
        help: "ロボットをいったん止めて、メッセージを出して人の確認を待つキュン。［続行］［この行をスキップ］［停止］を選べるよ。登録ボタンを押す前の最終チェックや、カーソル位置を手で合わせたい時に使ってね。{{氏名}} などの差し込みもできるよ。",
        fields: [{ id: "message", label: "表示するメッセージ（差し込み可）", type: "textarea", raw: true, placeholders: true }],
        parse: function (val) { return { message: val }; },
        compose: function (v) { return v.message; },
        validate: function (v) { return trimText(v.message) === "" ? "メッセージを入れてね♡" : ""; },
        autoLabel: function (val) { return "確認: " + truncateText(val, 30); }
    },
    COPY_SAVE: {
        title: "値をコピーして記録", icon: "📋", category: "input", defaultVal: "取得値",
        help: "いま選択されている文字を Ctrl+C でコピーして、「項目名」で記録するキュン。記録した値は［↓ 実行結果CSV］に列として出るし、あとのTEXTで {{COPY:項目名}} として貼り付けもできるよ。直前に KEY ^a（全選択）を入れると確実だよ。",
        fields: [{ id: "name", label: "項目名（実行結果CSVの列名になるよ）", type: "text", placeholder: "例: 伝票番号" }],
        parse: function (val) { return { name: val }; },
        compose: function (v) { return v.name; },
        validate: function (v) { return v.name === "" ? "項目名を入れてね♡" : /[{}:,]/.test(v.name) ? "項目名に { } : , は使えないキュン" : ""; },
        autoLabel: function (val) { return "コピーして「" + val + "」に記録"; }
    },
    SCREENSHOT: {
        title: "画面を撮影して保存", icon: "📸", category: "window", defaultVal: "証跡_{{ROW}},WINDOW",
        help: "画面をPNGで保存するキュン（証跡・エビデンス用）。保存先は HTAのフォルダ\\" + EVIDENCE_FOLDER_NAME + "\\日付\\ だよ。ファイル名には {{ROW}} や {{氏名}} を差し込めて、最後に時刻が自動で付くよ。",
