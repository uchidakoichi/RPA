// @@TEMPLATE_DATA_END

var TEMPLATE_LEVELS = { 1: "初級", 2: "中級", 3: "上級" };

function templateCsvText(tpl) {
    var lines = [];
    for (var i = 0; i < tpl.csv.length; i++) {
        lines.push(tpl.csv[i].map(toCsvField).join(","));
    }
    return lines.join("\r\n") + "\r\n";
}

function templateSteps(tpl) {
    var out = [];
    for (var i = 0; i < tpl.steps.length; i++) {
        var item = tpl.steps[i];
        var step = { cmd: item[0], val: item[1] == null ? "" : String(item[1]), label: "" };
        var props = item[2] || {};
        for (var k in props) {
            if (props.hasOwnProperty(k)) {
                step[k] = props[k];
            }
        }
        if (!step.label) {
            step.label = autoLabelFor(step);
        }
        out.push(step);
    }
    return out;
}

function showTemplateGallery() {
    if (guardRunning()) {
        return;
    }
    var html = '<div class="form-help">お手本マクロから始めよう♡ 「✨ 作る」を押すと新しいマクロとして追加されて、見本のCSVも samples フォルダに用意されるよ。' +
        "中身の説明は docs\\templates.html にもあるキュン。</div>" +
        '<div class="tpl-toolbar">分類: <select id="tplFilter" onchange="filterTemplates()"><option value="">すべて</option>';
    var c;
    var i;
    for (c = 0; c < TEMPLATE_CATEGORIES.length; c++) {
        html += '<option value="' + escapeHtml(TEMPLATE_CATEGORIES[c]) + '">' + escapeHtml(TEMPLATE_CATEGORIES[c]) + "</option>";
    }
    html += "</select></div>";
    for (c = 0; c < TEMPLATE_CATEGORIES.length; c++) {
        var cat = TEMPLATE_CATEGORIES[c];
        html += '<div class="tpl-section" data-cat="' + escapeHtml(cat) + '"><div class="tpl-cat">' + escapeHtml(cat) + "</div>";
        for (i = 0; i < TEMPLATES.length; i++) {
            var t = TEMPLATES[i];
            if (t.category !== cat) {
                continue;
            }
            html += '<div class="tpl-card"><div class="tpl-head">' +
                '<span class="tpl-level lv' + t.level + '">' + TEMPLATE_LEVELS[t.level] + "</span>" +
                '<span class="tpl-name">' + escapeHtml(t.name) + "</span>" +
                '<button class="btn btn-primary" onclick="createFromTemplate(' + i + ')">✨ 作る</button></div>' +
                '<div class="tpl-desc">' + escapeHtml(t.summary) + "</div>" +
                '<div class="tpl-desc">💡 こんな時に: ' + escapeHtml(t.useCase) + "</div>" +
                '<div class="tpl-meta">準備: ' + escapeHtml(t.prepare.join(" ／ ")) + "</div>" +
                '<div class="tpl-meta">対象ウィンドウ: ' + escapeHtml(t.targetWindow || "（なし・マクロの中で切替）") +
                " ／ 見本CSV: " + escapeHtml(t.csvFile) + " ／ " + t.steps.length + "ステップ</div></div>";
        }
        html += "</div>";
    }
    openModal("📚 テンプレート（" + TEMPLATES.length + "種類）", html, [{ text: "閉じる", fn: null }], { wide: true });
}

function filterTemplates() {
    var value = byId("tplFilter").value;
    var sections = byId("modalBody").getElementsByTagName("div");
    for (var i = 0; i < sections.length; i++) {
        if (hasClass(sections[i], "tpl-section")) {
            sections[i].style.display = value === "" || sections[i].getAttribute("data-cat") === value ? "" : "none";
        }
    }
}

// Writes samples\<csvFile> (keeps an existing file so user edits survive) and returns its path
function writeTemplateCsv(tpl) {
    if (!fso || !appDir || !tpl.csvFile) {
        return "";
    }
    var folder = ensureFolder(appFilePath(SAMPLE_FOLDER_NAME));
    var path = folder + "\\" + tpl.csvFile;
    if (!fso.FileExists(path)) {
        writeTextFile(path, templateCsvText(tpl), true);
        log("📄 見本CSVを作ったキュン: " + path, "ok");
    }
    return path;
}

function createFromTemplate(index) {
    var tpl = TEMPLATES[index];
    if (!tpl || guardRunning()) {
        return;
    }
    closeModal();
    var name = tpl.name;
    var n = 2;
    var exists = function (nm) {
        for (var j = 0; j < appData.macros.length; j++) {
            if (appData.macros[j].name === nm) {
                return true;
            }
        }
        return false;
    };
    while (exists(name)) {
        name = tpl.name + " (" + n + ")";
        n++;
    }
    appData.macros.push({ id: uniqueMacroId(), name: name, targetWindow: tpl.targetWindow, steps: templateSteps(tpl) });
    currentMacroIndex = appData.macros.length - 1;
    selectedIndex = -1;
    renderSteps();
    byId("macroContainer").scrollTop = 0;
    commitChange("テンプレートから作成: " + name);
    log("✨ テンプレート「" + tpl.name + "」からマクロを作ったキュン♡", "ok");
    try {
        var csvPath = writeTemplateCsv(tpl);
        if (csvPath) {
            byId("csvPathInput").value = csvPath;
            byId("csvHeaderCheck").checked = true;
            byId("csvEncodingSelect").value = "auto";
            loadCsvFromInput();
            log("（見本CSVに合わせて「1行目は見出し」をON・文字コードを自動判定にしたよ）", "info");
        }
    } catch (e) {
        log("見本CSVを用意できなかったキュン…（" + errorText(e) + "）", "warn");
    }
    showMessage("✨ テンプレートから作成", "「" + name + "」を作ったよ♡\n\n【準備】\n・" + tpl.prepare.join("\n・") +
        "\n\n【カスタマイズのポイント】\n・" + tpl.customize.join("\n・") +
        "\n\n見本CSVも読み込んでおいたよ。まずは開始行・終了行を「1」にして1件だけ試してね！");
}

// =====================================================================
//  Keyboard shortcuts
// =====================================================================
function onKeyDown(e) {
    e = e || window.event;
    var key = e.keyCode;
    var target = e.target || e.srcElement;
    var tag = target && target.tagName ? target.tagName.toUpperCase() : "";
    var inField = tag === "INPUT" || tag === "TEXTAREA" || tag === "SELECT";

    if (key === 116) { // F5 would reload the HTA
        return preventEvent(e);
    }
    if (isModalOpen()) {
        if (key === 27) {
            dismissModal();
            return preventEvent(e);
        }
        if (key === 13 && tag !== "TEXTAREA" && tag !== "BUTTON" && tag !== "SELECT") {
            triggerDefaultModalButton();
            return preventEvent(e);
        }
        return true;
    }
    if (key === 27) {
        if (isRunning()) {
            stopRun("Escキー");
        } else {
            selectBlock(-1);
        }
        return preventEvent(e);
    }
    if (e.ctrlKey && key === 83) { // Ctrl+S
        saveProduction();
        return preventEvent(e);
    }
    if (inField) {
        return true;
    }
    if (e.ctrlKey && key === 90) { // Ctrl+Z
        undo();
        return preventEvent(e);
    }
    if (e.ctrlKey && key === 89) { // Ctrl+Y
        redo();
        return preventEvent(e);
    }
    if (e.ctrlKey && key === 68) { // Ctrl+D
        duplicateSelected();
        return preventEvent(e);
    }
    if (e.ctrlKey && (key === 191 || key === 111)) { // Ctrl+/
        toggleDisabledSelected();
        return preventEvent(e);
    }
    if (key === 46 && selectedIndex >= 0) { // Delete
        deleteStep(selectedIndex);
        return preventEvent(e);
    }
    if (key === 13 && selectedIndex >= 0 && tag !== "BUTTON") { // Enter
        editStep(selectedIndex);
        return preventEvent(e);
    }
    if (key === 38 || key === 40) { // Up / Down
        if (e.altKey) {
            moveSelected(key === 38 ? -1 : 1);
        } else {
            selectNeighbor(key === 38 ? -1 : 1);
        }
        return preventEvent(e);
    }
    return true;
}

// =====================================================================
//  Startup
// =====================================================================
function fitWindow() {
    try {
        var w = Math.min(1220, screen.availWidth);
        var h = Math.min(900, screen.availHeight);
        window.resizeTo(w, h);
        window.moveTo(Math.max(0, Math.floor((screen.availWidth - w) / 2)), Math.max(0, Math.floor((screen.availHeight - h) / 2)));
    } catch (e) {
        /* not an HTA (browser preview) */
    }
}

function bindContainerEvents() {
    var container = byId("macroContainer");
    container.onclick = onContainerClick;
    container.ondblclick = onContainerDblClick;
    container.ondragstart = onDragStart;
    container.ondragenter = onDragEnter;
    container.ondragover = onDragOver;
    container.ondrop = onDrop;
    container.ondragend = onDragEnd;
    container.onselectstart = function () { return false; };
}

window.onload = function () {
    fitWindow();
    buildPalette();
    bindContainerEvents();
    document.onkeydown = onKeyDown;
    var ok = initActiveX();
    if (ok) {
        appDir = resolveAppDir();
        loadSettings();
        log("📁 作業フォルダ: " + appDir, "info");
    } else {
        log("⚠ ActiveXが使えない環境だキュン（ブラウザで開いてる？）。今はお試し表示モードだよ。.hta をダブルクリックして起動してね", "error");
    }
    loadInitialData();
    refreshMacroSelect();
    renderSteps();
    recordHistory("起動時の状態");
    updateSaveState();
    updateErrorButton();
    log("ふじキュン♡のRPAマクロビルダーへようこそキュン♡ 今日もいっしょにがんばろうね！", "ok");
    if (startupNotices.length) {
        showMessage("⚠ 起動時のお知らせ", startupNotices.join("\n\n"));
    }
    if (ok) {
        updateScheduleState();
        scheduleTimer = setInterval(checkSchedules, 20000);
        checkAutoRunArgument();
    }
};

// Cancelling here would be irreversible even if the user chooses to stay, so it waits for onunload
window.onunload = function () {
    if (runState) {
        closeExcel(runState);
    }
    if (runState && runState.running) {
        if (runState.psJob) {
            runState.psJob.cancel();
        }
        if (runState.stopWatcher) {
            runState.stopWatcher.cancel();
        }
    }
};

window.onbeforeunload = function () {
    cleanupTempFiles();
    if (isRunning()) {
        return "実行中だキュン！閉じるとロボットが止まっちゃうよ";
    }
    if (isDirty) {
        return "本番ファイルに保存していない変更があるキュン（一時ファイルには自動保存済みだから、次回起動時に復元できるよ）";
    }
};
</script>
</body>
</html>

