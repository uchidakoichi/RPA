        help: "グループの終わりの目印だよ。設定する項目はないキュン。",
        fields: [],
        parse: function () { return {}; },
        compose: function () { return ""; },
        validate: function () { return ""; },
        autoLabel: function () { return "グループ終了"; }
    },
    COMMENT: {
        title: "コメント", icon: "💬", defaultVal: "",
        help: "実行時は無視されるメモだよ。手順の説明を書いておくと後で助かるキュン♡",
        fields: [{ id: "memo", label: "メモ", type: "textarea", raw: true }],
        parse: function (val) { return { memo: val }; },
        compose: function (v) { return v.memo; },
        validate: function (v) { return v.memo === "" ? "メモを入力してね♡" : ""; },
        autoLabel: function (val) { return truncateText(val, 40); }
    }
};

COMMAND_DEFS.LOOP_START.fields[3].options = COND_OPS;
COMMAND_DEFS.IF_START.fields[1].options = COND_OPS;
COMMAND_DEFS.STR_OP.fields[2].options = STR_OPS;

// The palette is the single place that sorts commands into categories: the category drives the
// palette row, the block colour and the badge colour. Block ends and CATCH take their block's category.
var PALETTE_GROUPS = [
    { category: "input", label: "入力", cmds: ["KEY", "TEXT", "CSV", "COPY"] },
    { category: "wait", label: "待つ・確かめる", cmds: ["WAIT", "WAIT_FOR", "WINDOW_CHECK", "CONFIRM"] },
    { category: "mouse", label: "クリック・読み取り", cmds: ["CLICK_NAME", "CLICK_TEXT", "CLICK_IMG", "CLICK_POS", "READ_TEXT"] },
    { category: "window", label: "アプリ・画面", cmds: ["SWITCH", "RUN", "SCREENSHOT", "MAIL"] },
    { category: "flow", label: "流れ", cmds: ["LOOP_START", "BREAK", "CONTINUE", "IF_START", "ELSE", "TRY_START", "CALL_MACRO", "RETURN"] },
    { category: "var", label: "変数・データ", cmds: ["SET_VAR", "STR_OP", "ASK", "RECORD", "EXCEL_READ", "EXCEL_WRITE"] },
    { category: "group", label: "整理", cmds: ["GROUP_START", "COMMENT"] }
];

(function assignCategories() {
    var g, i, cmd;
    for (g = 0; g < PALETTE_GROUPS.length; g++) {
        for (i = 0; i < PALETTE_GROUPS[g].cmds.length; i++) {
            COMMAND_DEFS[PALETTE_GROUPS[g].cmds[i]].category = PALETTE_GROUPS[g].category;
        }
    }
    COMMAND_DEFS.COMMENT.category = "note";
    for (cmd in BLOCK_ENDS) {
        if (BLOCK_ENDS.hasOwnProperty(cmd)) {
            COMMAND_DEFS[cmd].category = COMMAND_DEFS[BLOCK_ENDS[cmd]].category;
        }
    }
    COMMAND_DEFS.CATCH.category = COMMAND_DEFS.TRY_START.category;
    // A one-setting command whose field takes placeholders has its whole value expanded at run time
    for (cmd in COMMAND_DEFS) {
        if (COMMAND_DEFS.hasOwnProperty(cmd)) {
            var def = COMMAND_DEFS[cmd];
            def.expandVal = !def.hideVal && def.fields.length === 1 && !!def.fields[0].placeholders;
        }
    }
})();

function autoLabelFor(step) {
    var def = COMMAND_DEFS[step.cmd];
    return def ? def.autoLabel(step.val == null ? "" : String(step.val)) : String(step.val);
}

function isExecutableStep(step) {
    return !step.disabled && step.cmd !== "COMMENT" && !isBlockStart(step.cmd) && !isBlockEnd(step.cmd) && !isBlockMiddle(step.cmd);
}

function normalizeCheckMode(mode) {
    mode = String(mode || "").toUpperCase();
    return mode === "SKIP" || mode === "CONTINUE" ? mode : "STOP";
}

// Extra per-step properties stored beside cmd/val/label
function propFields(def) {
    var list = [];
    for (var i = 0; i < def.fields.length; i++) {
        if (def.fields[i].prop) {
            list.push(def.fields[i]);
        }
    }
    return list;
}

// =====================================================================
//  Data model
// =====================================================================
function currentMacro() {
    return appData.macros[currentMacroIndex] || null;
}

function currentSteps() {
    var m = currentMacro();
    return m ? m.steps : [];
}

function normalizeData(obj) {
    var data = { version: DATA_VERSION, macros: [] };
    var list = obj && obj.macros instanceof Array ? obj.macros : [];
    var usedIds = {};
    for (var i = 0; i < list.length; i++) {
        var m = list[i] || {};
        var steps = [];
        var src = m.steps instanceof Array ? m.steps : [];
        for (var j = 0; j < src.length; j++) {
            var s = src[j];
            if (!s || !s.cmd) {
                continue;
            }
            var cmd = String(s.cmd).toUpperCase();
            var val = s.val == null ? "" : String(s.val);
            if (!COMMAND_DEFS[cmd]) {
                val = "[不明なコマンド " + cmd + "] " + val;
                cmd = "COMMENT";
            }
            var step = { cmd: cmd, val: val, label: s.label == null ? "" : String(s.label) };
            if (cmd === "GROUP_START" && (s.when === "first" || s.when === "last")) {
                step.when = s.when;
            }
            if (s.disabled === true) {
                step.disabled = true;
            }
            if (!step.label) {
                step.label = autoLabelFor(step);
            }
            steps.push(step);
        }
        var id = m.id ? String(m.id) : generateId();
        while (usedIds[id]) {
            id = generateId();
        }
        usedIds[id] = true;
        data.macros.push({
            id: id,
            name: m.name ? String(m.name) : "名称未設定マクロ",
            targetWindow: m.targetWindow ? String(m.targetWindow) : "",
            steps: steps
        });
    }
    return data;
}

function createSampleData() {
    return {
        version: DATA_VERSION,
        macros: [{
            id: generateId(),
            name: "サンプル：メモ帳にCSVを入力",
            targetWindow: "メモ帳",
            steps: [
                { cmd: "COMMENT", val: "はじめてのマクロだキュン♡ メモ帳を開いてからCSVを読み込んで▶実行してね", label: "" },
                { cmd: "GROUP_START", val: "1行ぶんの入力", label: "" },
                { cmd: "CSV", val: "1", label: "" },
                { cmd: "KEY", val: "{TAB}", label: "" },
                { cmd: "CSV", val: "2", label: "" },
                { cmd: "KEY", val: "{ENTER}", label: "" },
                { cmd: "GROUP_END", val: "", label: "" },
                { cmd: "WAIT", val: "500", label: "" }
            ]
        }]
    };
}

function ensureMacroExists() {
    if (appData.macros.length === 0) {
        appData.macros.push({ id: uniqueMacroId(), name: "新しいマクロ", targetWindow: "", steps: [] });
    }
    if (currentMacroIndex < 0 || currentMacroIndex >= appData.macros.length) {
        currentMacroIndex = 0;
    }
}

function serializeData() {
    return JSON.stringify({ version: DATA_VERSION, macros: appData.macros }, function (key, value) {
        return key === "collapsed" ? undefined : value;
    }, 2);
}

function loadJsonFile(path) {
    try {
        return JSON.parse(readTextFile(path, "utf-8"));
    } catch (e) {
        log("「" + path + "」を読めなかったキュン…（" + errorText(e) + "）", "error");
        return null;
    }
}

// Moves the temp file aside under a timestamped name (one per discard, never overwritten).
// Returns false when it could not be moved: the caller must not let autosave overwrite it.
function discardTempFile() {
    var name = DISCARDED_TEMP_PREFIX + "_" + timeStamp() + ".json";
    try {
        fso.MoveFile(appFilePath(TEMP_FILE_NAME), appFilePath(name));
        log("一時ファイルは「" + name + "」に退避しておいたキュン", "info");
        return true;
    } catch (e) {
        log("一時ファイルの退避に失敗…（" + errorText(e) + "）", "warn");
        return false;
    }
}

function backupUnreadableFile(path) {
    var name = BROKEN_FILE_PREFIX + "_" + timeStamp() + ".json";
    try {
        fso.CopyFile(path, appFilePath(name), false);
        return name;
    } catch (e) {
        return "";
    }
}

function checkDataVersion(obj, what) {
    var v = obj && typeof obj.version === "number" ? obj.version : 0;
    if (v > DATA_VERSION) {
        saveBlockReason = what + "は新しい版のふじキュン（データ版 " + v + "）で作られているキュン。この版（データ版 " + DATA_VERSION + "）で保存すると、知らないコマンドがコメントに変わって動かなくなるよ。新しい版のふじキュンを使ってね。";
        startupNotices.push(saveBlockReason);
    }
}

function loadInitialData() {
    var loaded = null;
    var tempPath = appFilePath(TEMP_FILE_NAME);
    var mainPath = appFilePath(MACRO_FILE_NAME);
    if (fso && fso.FileExists(tempPath)) {
        var restore = confirm("前回の編集中データ（未保存の一時ファイル）が見つかったキュン♡\n\n" +
            "［OK］一時ファイルから復元する\n" +
            "［キャンセル］本番ファイル（" + MACRO_FILE_NAME + "）を読み込む\n" +
            "　　　　　　 ※一時ファイルは " + DISCARDED_TEMP_PREFIX + "_日時.json に退避します");
        if (restore) {
            loaded = loadJsonFile(tempPath);
            if (loaded) {
                isDirty = true;
                checkDataVersion(loaded, "一時ファイル");
                log("♻ 一時ファイルから未保存データを復元したキュン♡", "ok");
            }
        } else if (!discardTempFile()) {
            // It could not be moved aside: open it rather than let the next autosave overwrite it unseen
            loaded = loadJsonFile(tempPath);
            if (loaded) {
                isDirty = true;
                checkDataVersion(loaded, "一時ファイル");
                startupNotices.push("一時ファイルを退避できなかったから、上書きされないように一時ファイルの内容を開いたキュン。本番ファイルの内容が必要なら、" + MACRO_FILE_NAME + " を［📥 取込］してね。");
            }
        }
    }
    if (!loaded && fso && fso.FileExists(mainPath)) {
        loaded = loadJsonFile(mainPath);
        if (loaded) {
            checkDataVersion(loaded, "本番ファイル");
            log("📂 本番ファイル「" + MACRO_FILE_NAME + "」を読み込んだキュン♡", "ok");
        } else {
            // Never treat an existing but unreadable file like a missing one: keep a copy and guard the next save
            var copy = backupUnreadableFile(mainPath);
            saveBlockReason = "起動時に本番ファイル「" + MACRO_FILE_NAME + "」を読み込めなかったキュン（壊れている・ほかの人が開いている など）。" +
                (copy ? "元のファイルは「" + copy + "」に控えを取ってあるよ。" : "控えも取れなかったよ。");
            startupNotices.push(saveBlockReason + "\n\nいま表示しているのはサンプルマクロだよ。" +
                (fso.FileExists(appFilePath(BACKUP_FILE_NAME)) ? "1つ前に保存した版「" + BACKUP_FILE_NAME + "」もあるから、［📥 取込］で戻せるよ。" : "") +
                "\nこのまま本番ファイルに保存しようとすると、確認が出るよ。");
        }
    }
    if (!loaded) {
        loaded = createSampleData();
        if (saveBlockReason) {
            log("本番ファイルを読めなかったから、とりあえずサンプルマクロを表示してるキュン（本番ファイルはそのままだよ）", "error");
        } else {
            log("マクロファイルがまだ無いから、サンプルマクロを用意したキュン♡", "info");
        }
    }
    appData = normalizeData(loaded);
    currentMacroIndex = 0;
    ensureMacroExists();
}

function autoSaveTemp() {
    if (!fso || !appDir) {
        return;
    }
    try {
        writeTextFile(appFilePath(TEMP_FILE_NAME), serializeData(), false);
    } catch (e) {
        log("一時ファイルへの自動保存に失敗したキュン…（" + errorText(e) + "）", "error");
    }
}

function saveProduction() {
    if (!fso) {
        showMessage("保存できないキュン", "ActiveXが使えない環境なのでファイルに保存できないよ。HTAとして起動してね♡");
        return;
    }
    if (saveBlockReason) {
        showChoice("💾 本番ファイルに保存", saveBlockReason + "\n\nそれでも、いま表示している内容で本番ファイルを上書きする？", [
            { text: "キャンセル", cls: "btn-primary", fn: null },
            { text: "上書きして保存", cls: "btn-danger", fn: function () {
                saveBlockReason = "";
                doSaveProduction();
            } }
        ]);
        return;
    }
    doSaveProduction();
}

function doSaveProduction() {
    try {
        writeFileSafely(appFilePath(MACRO_FILE_NAME), serializeData(), appFilePath(BACKUP_FILE_NAME));
        deleteFileQuietly(appFilePath(TEMP_FILE_NAME));
        isDirty = false;
        updateSaveState();
        log("💾 本番ファイル「" + MACRO_FILE_NAME + "」に保存したキュン♡（1つ前の版は " + BACKUP_FILE_NAME + " に残したよ・一時ファイルは削除したよ）", "ok");
    } catch (e) {
        log("本番ファイルの保存に失敗したキュン…（" + errorText(e) + "）", "error");
        showMessage("保存エラー", "本番ファイルに保存できなかったキュン…\n" + errorText(e));
    }
}

function updateSaveState() {
    var el = byId("saveState");
    if (isDirty) {
        el.innerHTML = "● 未保存の変更あり（一時ファイルに自動保存中）";
        addClass(el, "dirty");
    } else {
        el.innerHTML = "✔ 本番ファイルと同じ内容";
        removeClass(el, "dirty");
    }
}

// =====================================================================
//  UNDO / REDO history
// =====================================================================
function recordHistory(desc) {
    if (historyPos < historyStack.length - 1) {
        historyStack.splice(historyPos + 1, historyStack.length - historyPos - 1);
    }
    historyStack.push({
        desc: desc,
        time: timeText(),
        macroIndex: currentMacroIndex,
        selectedIndex: selectedIndex,
        data: deepCopy(appData)
    });
    while (historyStack.length > HISTORY_LIMIT) {
        historyStack.shift();
    }
    historyPos = historyStack.length - 1;
    updateHistoryUi();
}

// Call after every data change (add / edit / delete / move ...)
function commitChange(desc) {
    recordHistory(desc);
    isDirty = true;
    updateSaveState();
    autoSaveTemp();
    refreshMacroSelect();
}

// showMacroIndex: macro to display (undo shows the macro whose change is being undone)
function restoreHistory(pos, showMacroIndex, undoneDesc) {
    if (pos < 0 || pos >= historyStack.length || pos === historyPos) {
        updateHistoryUi();
        return;
    }
    if (guardRunning()) {
        updateHistoryUi();
        return;
    }
    var h = historyStack[pos];
    appData = deepCopy(h.data);
    historyPos = pos;
    var target = showMacroIndex == null ? h.macroIndex : showMacroIndex;
    currentMacroIndex = Math.min(target, appData.macros.length - 1);
    ensureMacroExists();
    selectedIndex = target === h.macroIndex ? Math.min(h.selectedIndex, currentSteps().length - 1) : -1;
    isDirty = true;
    updateSaveState();
    autoSaveTemp();
    refreshMacroSelect();
    renderSteps();
    scrollToSelected();
    updateHistoryUi();
    log(undoneDesc ? "↩ 「" + undoneDesc + "」を元に戻したキュン" : "↩ 履歴 #" + (pos + 1) + "「" + h.desc + "」の状態にしたキュン", "info");
}

function undo() {
    var current = historyStack[historyPos];
    restoreHistory(historyPos - 1, current ? current.macroIndex : null, current ? current.desc : "");
}

function redo() {
    restoreHistory(historyPos + 1);
}

function jumpToHistory() {
    restoreHistory(toInt(byId("historySelect").value, historyPos));
}

function updateHistoryUi() {
    var sel = byId("historySelect");
    sel.options.length = 0;
    for (var i = historyStack.length - 1; i >= 0; i--) {
        var h = historyStack[i];
        var opt = document.createElement("option");
        opt.text = (i === historyPos ? "▶ " : "　 ") + "#" + (i + 1) + " " + h.time + " " + h.desc;
        opt.value = String(i);
        sel.options.add(opt);
        if (i === historyPos) {
            opt.selected = true;
        }
    }
    byId("undoBtn").disabled = historyPos <= 0;
    byId("redoBtn").disabled = historyPos >= historyStack.length - 1;
}

// =====================================================================
//  Macro management
// =====================================================================
function refreshMacroSelect() {
    var sel = byId("macroSelect");
    sel.options.length = 0;
    for (var i = 0; i < appData.macros.length; i++) {
        var m = appData.macros[i];
        var opt = document.createElement("option");
        opt.text = (i + 1) + ". " + m.name + "（" + m.steps.length + "件）";
        opt.value = String(i);
        sel.options.add(opt);
    }
    sel.selectedIndex = currentMacroIndex;
    var macro = currentMacro();
    byId("targetWindowInput").value = macro ? macro.targetWindow : "";
}

function onMacroSelectChange() {
    if (isRunning()) {
        byId("macroSelect").selectedIndex = currentMacroIndex;
        guardRunning();
        return;
    }
    currentMacroIndex = byId("macroSelect").selectedIndex;
    selectedIndex = -1;
    refreshMacroSelect();
    renderSteps();
    byId("macroContainer").scrollTop = 0;
}

function onTargetWindowChange() {
    var macro = currentMacro();
    var value = trimText(byId("targetWindowInput").value);
    if (!macro || macro.targetWindow === value) {
        return;
    }
    if (guardRunning()) {
        byId("targetWindowInput").value = macro.targetWindow;
        return;
    }
    macro.targetWindow = value;
    commitChange("対象ウィンドウ変更: " + (value || "（なし）"));
    log("🎯 対象ウィンドウを「" + (value || "（未設定）") + "」にしたキュン", "info");
}

function addMacro() {
    if (guardRunning()) {
        return;
    }
    showInputDialog("＋ 新しいマクロ", "マクロの名前", "新しいマクロ", function (name) {
        appData.macros.push({ id: uniqueMacroId(), name: name, targetWindow: "", steps: [] });
        currentMacroIndex = appData.macros.length - 1;
        selectedIndex = -1;
        renderSteps();
        commitChange("マクロ追加: " + name);
        log("✨ マクロ「" + name + "」を作ったキュン♡", "ok");
    });
}

function renameMacro() {
    var macro = currentMacro();
    if (!macro || guardRunning()) {
        return;
    }
    showInputDialog("✎ マクロ名の変更", "新しい名前", macro.name, function (name) {
        macro.name = name;
        commitChange("マクロ名変更: " + name);
    });
}

function duplicateMacro() {
    var macro = currentMacro();
    if (!macro || guardRunning()) {
        return;
    }
    var copy = deepCopy(macro);
    copy.id = uniqueMacroId();
    copy.name = macro.name + " のコピー";
    appData.macros.splice(currentMacroIndex + 1, 0, copy);
    currentMacroIndex++;
    selectedIndex = -1;
    renderSteps();
    commitChange("マクロ複製: " + copy.name);
    log("⧉ マクロ「" + copy.name + "」を作ったキュン", "ok");
}

function deleteMacro() {
    var macro = currentMacro();
    if (!macro || guardRunning()) {
        return;
    }
    showChoice("🗑 マクロの削除", "マクロ「" + macro.name + "」（" + macro.steps.length + "件）を削除する？\n※ ↩️ で元に戻せるよ", [
        { text: "削除する", cls: "btn-danger", fn: function () {
            appData.macros.splice(currentMacroIndex, 1);
            ensureMacroExists();
            if (currentMacroIndex >= appData.macros.length) {
                currentMacroIndex = appData.macros.length - 1;
            }
            selectedIndex = -1;
            renderSteps();
            commitChange("マクロ削除: " + macro.name);
            log("🗑 マクロ「" + macro.name + "」を削除したキュン", "warn");
        } },
        { text: "キャンセル", fn: null }
    ]);
}

// =====================================================================
//  Group helpers
// =====================================================================
// Indent of every step: block contents one level in; ELSE / CATCH at the level of their block
function computeDepths(steps) {
    var depths = [];
    var depth = 0;
    for (var i = 0; i < steps.length; i++) {
        if (isBlockEnd(steps[i].cmd)) {
            depth = Math.max(0, depth - 1);
            depths.push(depth);
        } else if (isBlockMiddle(steps[i].cmd)) {
            depths.push(Math.max(0, depth - 1));
        } else {
            depths.push(depth);
            if (isBlockStart(steps[i].cmd)) {
                depth++;
            }
        }
    }
    return depths;
}

// Matching end of the block that starts at startIndex (any block type; blocks are kept balanced)
function findGroupEnd(steps, startIndex) {
    var depth = 0;
    for (var i = startIndex; i < steps.length; i++) {
        if (isBlockStart(steps[i].cmd)) {
            depth++;
        } else if (isBlockEnd(steps[i].cmd)) {
            depth--;
            if (depth === 0) {
                return i;
            }
        }
    }
    return -1;
}

function findGroupStart(steps, endIndex) {
    var depth = 0;
    for (var i = endIndex; i >= 0; i--) {
        if (isBlockEnd(steps[i].cmd)) {
            depth++;
        } else if (isBlockStart(steps[i].cmd)) {
            depth--;
            if (depth === 0) {
                return i;
            }
        }
    }
    return -1;
}

// Range [from, to] that moves together (a block start carries its whole block)
function blockRange(steps, index) {
    var to = index;
    if (steps[index] && isBlockStart(steps[index].cmd)) {
        var end = findGroupEnd(steps, index);
        if (end > index) {
            to = end;
        }
    }
    return { from: index, to: to };
}

// Expand every collapsed group that contains the given index
function expandAncestors(steps, index) {
    var stack = [];
    for (var i = 0; i < index && i < steps.length; i++) {
        if (isBlockStart(steps[i].cmd)) {
            stack.push(i);
        } else if (isBlockEnd(steps[i].cmd) && stack.length) {
            stack.pop();
        }
    }
    for (var j = 0; j < stack.length; j++) {
        steps[stack[j]].collapsed = false;
    }
}

function toggleGroup(index) {
    var steps = currentSteps();
    var step = steps[index];
    if (!step || !isBlockStart(step.cmd)) {
        return;
    }
    step.collapsed = !step.collapsed;
    if (step.collapsed && selectedIndex > index) {
        var end = findGroupEnd(steps, index);
        if (end < 0 || selectedIndex <= end) {
            selectedIndex = index;
        }
    }
    renderSteps();
}

function setAllCollapsed(collapsed) {
    var steps = currentSteps();
    for (var i = 0; i < steps.length; i++) {
        if (isBlockStart(steps[i].cmd)) {
            steps[i].collapsed = collapsed;
        }
    }
    if (collapsed) {
        selectedIndex = -1;
    }
    renderSteps();
}

// =====================================================================
//  Rendering
// =====================================================================
function buildBlockHtml(step, index, depth, hidden, hiddenCount) {
    var def = COMMAND_DEFS[step.cmd] || COMMAND_DEFS.COMMENT;
    var cls = "block cat-" + def.category + (hidden ? " hidden" : "") + (step.disabled ? " disabled" : "");
    var whenTag = step.when === "first" ? '<span class="when-tag">最初の1行だけ</span>' :
        step.when === "last" ? '<span class="when-tag">最後の1行だけ</span>' : "";
    var offTag = step.disabled ? '<span class="off-tag">無効</span>' : "";
    var toggle = isBlockStart(step.cmd) ?
        '<span class="toggle" data-act="toggle" title="折りたたみ／展開">' + (step.collapsed ? "▶" : "▼") + "</span>" :
        '<span class="toggle-space"></span>';
    var main;
    if (step.cmd === "COMMENT") {
        main = '<span class="comment-text">// ' + escapeHtml(truncateText(step.val, 120)) + "</span>";
    } else if (step.cmd === "GROUP_START") {
        main = '<span class="group-name">📁 ' + escapeHtml(step.val) + "</span>" + whenTag +
            (step.collapsed ? '<span class="collapsed-count">（' + hiddenCount + "件を折りたたみ中）</span>" : "");
    } else if (isBlockEnd(step.cmd)) {
        main = '<span class="group-end-text">└ ' + escapeHtml(def.title) + "</span>";
    } else if (isBlockMiddle(step.cmd)) {
        main = '<span class="group-name">' + def.icon + " " + escapeHtml(def.title) + "</span>";
    } else if (isBlockStart(step.cmd) || def.hideVal) {
        main = '<span class="step-label">' + escapeHtml(step.label || autoLabelFor(step)) + "</span>" +
            (step.collapsed ? '<span class="collapsed-count">（' + hiddenCount + "件を折りたたみ中）</span>" : "");
    } else {
        main = '<span class="step-label">' + escapeHtml(step.label || autoLabelFor(step)) + "</span>" +
            '<span class="step-val">' + escapeHtml(truncateText(step.val, 60)) + "</span>";
    }
    return '<div class="' + cls + '" draggable="true" data-index="' + index + '" style="margin-left:' + (depth * INDENT_PX) + 'px">' +
        toggle +
        '<span class="step-no">' + (index + 1) + "</span>" +
        '<span class="badge">' + def.icon + " " + escapeHtml(step.cmd) + "</span>" +
        '<span class="step-main">' + offTag + main + "</span>" +
        '<span class="actions">' +
        '<button class="icon-btn" data-act="edit" title="編集（ダブルクリックでもOK）">✎</button>' +
        '<button class="icon-btn icon-del" data-act="delete" title="削除 (Delete)">✕</button>' +
        "</span></div>";
}

function renderSteps() {
    var container = byId("macroContainer");
    var steps = currentSteps();
    var scrollTop = container.scrollTop;
    selectedEl = null;
    if (steps.length === 0) {
        selectedIndex = -1;
        container.innerHTML = '<div class="empty-hint">まだコマンドがないキュン♡<br>上の「追加」ボタンからコマンドを入れてみてね！<br>' +
            "ブロックはクリックで選択（挿入位置）、ダブルクリックで編集、ドラッグで並べ替えできるよ</div>";
        updateInsertHint();
        return;
    }
    var depths = computeDepths(steps);
    var html = [];
    var hideUntil = -1;
    var hiddenAt = [];
    for (var i = 0; i < steps.length; i++) {
        var hidden = i <= hideUntil;
        hiddenAt.push(hidden);
        var hiddenCount = 0;
        if (!hidden && isBlockStart(steps[i].cmd) && steps[i].collapsed) {
            var end = findGroupEnd(steps, i);
            hideUntil = end < 0 ? steps.length - 1 : end;
            hiddenCount = Math.max(0, (end < 0 ? steps.length : end) - i - 1);
        }
        html.push(buildBlockHtml(steps[i], i, depths[i], hidden, hiddenCount));
    }
    container.innerHTML = html.join("");
    if (selectedIndex >= steps.length) {
        selectedIndex = steps.length - 1;
    }
    // Keyboard actions work on the selected index, so it must never be a block inside a collapsed group
    while (selectedIndex > 0 && hiddenAt[selectedIndex]) {
        selectedIndex--;
    }
    if (selectedIndex >= 0) {
        selectedEl = container.children[selectedIndex];
        addClass(selectedEl, "selected");
    }
    container.scrollTop = scrollTop;
    if (isRunning() && runState.macro === currentMacro()) {
        highlightRunning(runState.stepIndex);
    }
    updateInsertHint();
}

function updateInsertHint() {
    var steps = currentSteps();
    var hint = byId("insertHint");
    if (selectedIndex >= 0 && selectedIndex < steps.length) {
        hint.innerHTML = "📌 挿入位置: #" + (insertionIndex()) + " の後ろ";
    } else {
        hint.innerHTML = "📌 挿入位置: 末尾（ブロックをクリックで指定）";
    }
}

function scrollIntoContainer(el) {
    var container = byId("macroContainer");
    if (!el || hasClass(el, "hidden")) {
        return;
    }
    var top = el.offsetTop;
    var bottom = top + el.offsetHeight;
    if (top < container.scrollTop || bottom > container.scrollTop + container.clientHeight) {
        container.scrollTop = Math.max(0, top - Math.floor(container.clientHeight / 3));
    }
}

function scrollToSelected() {
    scrollIntoContainer(selectedEl);
}

// =====================================================================
//  Selection (class swap only - no re-render)
// =====================================================================
function selectBlock(index) {
    var container = byId("macroContainer");
    if (selectedEl) {
        removeClass(selectedEl, "selected");
    }
    selectedEl = null;
    selectedIndex = -1;
    if (index >= 0 && index < container.children.length) {
        var el = container.children[index];
        if (hasClass(el, "block")) {
            selectedEl = el;
            selectedIndex = index;
            addClass(el, "selected");
        }
    }
    updateInsertHint();
}

function selectNeighbor(dir) {
    var container = byId("macroContainer");
    var i = selectedIndex < 0 ? (dir > 0 ? -1 : container.children.length) : selectedIndex;
    for (i += dir; i >= 0 && i < container.children.length; i += dir) {
        if (hasClass(container.children[i], "block") && !hasClass(container.children[i], "hidden")) {
            selectBlock(i);
            scrollToSelected();
            return;
        }
    }
}

// New commands go right after the selected block (after the whole group if it is collapsed)
function insertionIndex() {
    var steps = currentSteps();
    if (selectedIndex < 0 || selectedIndex >= steps.length) {
        return steps.length;
    }
    var step = steps[selectedIndex];
    if (step.cmd === "GROUP_START" && step.collapsed) {
        var end = findGroupEnd(steps, selectedIndex);
        if (end >= 0) {
            return end + 1;
        }
    }
    return selectedIndex + 1;
}

function findBlockElement(el) {
    while (el && el.id !== "macroContainer" && el !== document.body) {
        if (el.nodeType === 1 && hasClass(el, "block")) {
            return el;
        }
        el = el.parentNode;
    }
    return null;
}

function findAction(el) {
    while (el && el.id !== "macroContainer" && el !== document.body) {
        var act = el.getAttribute ? el.getAttribute("data-act") : null;
        if (act) {
            return act;
        }
        if (hasClass(el, "block")) {
            return null;
        }
        el = el.parentNode;
    }
    return null;
}

function blockIndexOf(el) {
    return el ? toInt(el.getAttribute("data-index"), -1) : -1;
}

function onContainerClick(e) {
    e = e || window.event;
    var target = e.target || e.srcElement;
    var block = findBlockElement(target);
    if (!block) {
        selectBlock(-1);
        return;
    }
    var index = blockIndexOf(block);
    var act = findAction(target);
    if (act === "toggle") {
        toggleGroup(index);
        return;
    }
    selectBlock(index);
    if (act === "edit") {
        editStep(index);
    } else if (act === "delete") {
        deleteStep(index);
    }
}

function onContainerDblClick(e) {
    e = e || window.event;
    var target = e.target || e.srcElement;
    if (findAction(target)) {
        return;
    }
    var block = findBlockElement(target);
    if (block) {
        editStep(blockIndexOf(block));
    }
}

// =====================================================================
//  Drag & Drop (with blue inset guide line)
// =====================================================================
function clearDropIndicator() {
    if (dragState && dragState.overEl) {
        removeClass(dragState.overEl, "drop-before");
        removeClass(dragState.overEl, "drop-after");
        dragState.overEl = null;
    }
}

function endDrag() {
    if (!dragState) {
        return;
    }
    clearDropIndicator();
    var container = byId("macroContainer");
    for (var i = dragState.from; i <= dragState.to; i++) {
        removeClass(container.children[i], "dragging");
    }
    dragState = null;
}

function onDragStart(e) {
    e = e || window.event;
    var block = findBlockElement(e.target || e.srcElement);
    if (!block || isRunning() || isModalOpen()) {
        return preventEvent(e);
    }
    var index = blockIndexOf(block);
    var range = blockRange(currentSteps(), index);
    dragState = { from: range.from, to: range.to, overEl: null, overIndex: -1, before: false };
    var container = byId("macroContainer");
    for (var i = range.from; i <= range.to; i++) {
        addClass(container.children[i], "dragging");
    }
    try {
        e.dataTransfer.effectAllowed = "move";
        e.dataTransfer.setData("Text", String(index));
    } catch (ex) {
        /* IE requires "Text" format; ignore other failures */
    }
    return true;
}

function onDragEnter(e) {
    if (dragState) {
        return preventEvent(e || window.event);
    }
    return true;
}

function lastVisibleBlock() {
    var container = byId("macroContainer");
    for (var i = container.children.length - 1; i >= 0; i--) {
        if (hasClass(container.children[i], "block") && !hasClass(container.children[i], "hidden")) {
            return container.children[i];
        }
    }
    return null;
}

// When the pointer is in a gap between blocks, pick the nearest visible block
function nearestBlockByY(y) {
    var container = byId("macroContainer");
    for (var i = 0; i < container.children.length; i++) {
        var el = container.children[i];
        if (!hasClass(el, "block") || hasClass(el, "hidden")) {
            continue;
        }
        var rect = el.getBoundingClientRect();
        if (y < rect.bottom) {
            return el;
        }
    }
    return lastVisibleBlock();
}

function onDragOver(e) {
    e = e || window.event;
    if (!dragState) {
        return true;
    }
    preventEvent(e);
    try {
        e.dataTransfer.dropEffect = "move";
    } catch (ex) {
        /* ignore */
    }
    var container = byId("macroContainer");
    var crect = container.getBoundingClientRect();
    if (e.clientY < crect.top + 30) {
        container.scrollTop -= 12;
    } else if (e.clientY > crect.bottom - 30) {
        container.scrollTop += 12;
    }
    var block = findBlockElement(e.target || e.srcElement) || nearestBlockByY(e.clientY);
    if (!block) {
        return false;
    }
    var rect = block.getBoundingClientRect();
    var before = e.clientY < rect.top + (rect.bottom - rect.top) / 2;
    if (dragState.overEl === block && dragState.before === before) {
        return false;
    }
    clearDropIndicator();
    addClass(block, before ? "drop-before" : "drop-after");
    dragState.overEl = block;
    dragState.overIndex = blockIndexOf(block);
    dragState.before = before;
    return false;
}

function onDrop(e) {
    e = e || window.event;
    if (!dragState) {
        return true;
    }
    preventEvent(e);
    var ds = dragState;
    var steps = currentSteps();
    var insertAt = steps.length;
    if (ds.overIndex >= 0) {
        if (ds.before) {
            insertAt = ds.overIndex;
        } else {
            insertAt = ds.overIndex + 1;
            var over = steps[ds.overIndex];
            if (over && over.cmd === "GROUP_START" && over.collapsed) {
                var end = findGroupEnd(steps, ds.overIndex);
                if (end >= 0) {
                    insertAt = end + 1;
                }
            }
        }
    }
    endDrag();
    moveSteps(ds.from, ds.to, insertAt, "ドラッグで移動");
    return false;
}

function onDragEnd() {
    endDrag();
}

// =====================================================================
//  Step operations
// =====================================================================
function guardRunning() {
    if (isRunning()) {
        log("実行中は編集できないキュン。⏹停止してからね♡", "warn");
        return true;
    }
    return false;
}

// Every block closed by its own kind of end; ELSE only directly inside an if-block, CATCH only
// directly inside a try-block, at most one each
function groupsBalanced(steps) {
    var stack = [];
    for (var i = 0; i < steps.length; i++) {
        var c = steps[i].cmd;
        if (isBlockStart(c)) {
            stack.push({ cmd: c, middles: {} });
        } else if (isBlockEnd(c)) {
            if (!stack.length || stack[stack.length - 1].cmd !== BLOCK_ENDS[c]) {
                return false;
            }
            stack.pop();
        } else if (isBlockMiddle(c)) {
            var top = stack[stack.length - 1];
            if (!top || top.cmd !== BLOCK_MIDDLES[c] || top.middles[c]) {
                return false;
            }
            top.middles[c] = true;
        }
    }
    return stack.length === 0;
}

function moveSteps(from, to, insertAt, desc) {
    var steps = currentSteps();
    var count = to - from + 1;
    if (insertAt >= from && insertAt <= to + 1) {
        return; // dropped onto itself: nothing to do
    }
    // Try the move on a copy first: a group end moved above its own start would leave an
    // unclosed group whose disabled / first / last setting is silently ignored at run time
    var trial = steps.slice(0);
    var moved = trial.splice(from, count);
    if (insertAt > from) {
        insertAt -= count;
    }
    for (var i = 0; i < moved.length; i++) {
        trial.splice(insertAt + i, 0, moved[i]);
    }
    if (groupsBalanced(steps) && !groupsBalanced(trial)) {
        log("ブロックの終わりを、そのブロックの始まりより上には動かせないキュン（ブロックが閉じなくなっちゃう）", "warn");
        return;
    }
    steps.splice(0, steps.length);
    for (i = 0; i < trial.length; i++) {
        steps.push(trial[i]);
    }
    expandAncestors(steps, insertAt);
    selectedIndex = insertAt;
    renderSteps();
    scrollToSelected();
    commitChange(desc + ": " + (moved[0].label || moved[0].cmd));
}

function moveSelected(dir) {
    var steps = currentSteps();
    if (guardRunning() || selectedIndex < 0 || selectedIndex >= steps.length) {
        return;
    }
    var range = blockRange(steps, selectedIndex);
    if (dir < 0) {
        if (range.from > 0) {
            moveSteps(range.from, range.to, range.from - 1, "上へ移動");
        }
    } else if (range.to < steps.length - 1) {
        moveSteps(range.from, range.to, range.to + 2, "下へ移動");
    }
}

function addCommand(cmd) {
    if (guardRunning()) {
        return;
    }
    var def = COMMAND_DEFS[cmd];
    openStepEditor(cmd, null, function (step) {
        var steps = currentSteps();
        var at = insertionIndex();
        var pieces = [step];
        if (cmd === "TRY_START") {
            pieces.push({ cmd: "CATCH", val: "", label: COMMAND_DEFS.CATCH.title });
        }
        if (isBlockStart(cmd)) {
            pieces.push({ cmd: BLOCK_PAIRS[cmd], val: "", label: COMMAND_DEFS[BLOCK_PAIRS[cmd]].title });
        }
        var trial = steps.slice(0, at).concat(pieces).concat(steps.slice(at));
        if (isBlockMiddle(cmd) && !groupsBalanced(trial)) {
            log("「" + def.title + "」は「" + COMMAND_DEFS[BLOCK_MIDDLES[cmd]].title + "」の中（1つのブロックに1つだけ）に入れてね。入れたい場所のすぐ上のブロックを選んでから追加してね", "warn");
            return;
        }
        for (var k = pieces.length - 1; k >= 0; k--) {
            steps.splice(at, 0, pieces[k]);
        }
        expandAncestors(steps, at);
        selectedIndex = at;
        renderSteps();
        scrollToSelected();
        commitChange("追加: " + def.title + " " + truncateText(step.label, 20));
    });
}

function editStep(index) {
    if (guardRunning()) {
        return;
    }
    var step = currentSteps()[index];
    if (!step) {
        return;
    }
    if (COMMAND_DEFS[step.cmd] && COMMAND_DEFS[step.cmd].marker) {
        showMessage(COMMAND_DEFS[step.cmd].icon + " " + COMMAND_DEFS[step.cmd].title, "このコマンドには設定する項目がないキュン♡" +
            (isBlockEnd(step.cmd) || isBlockMiddle(step.cmd) ? "\n設定はブロックの最初の行の方で編集してね。" : ""));
        return;
    }
    openStepEditor(step.cmd, step, function (updated) {
        step.val = updated.val;
        step.label = updated.label;
        var props = propFields(COMMAND_DEFS[step.cmd]);
        for (var i = 0; i < props.length; i++) {
            if (updated[props[i].id]) {
                step[props[i].id] = updated[props[i].id];
            } else {
                delete step[props[i].id];
            }
        }
        renderSteps();
        commitChange("編集: " + truncateText(updated.label, 24));
    });
}

function afterDelete(index, desc) {
    var steps = currentSteps();
    selectedIndex = steps.length === 0 ? -1 : Math.min(index, steps.length - 1);
    renderSteps();
    commitChange(desc);
}

function deleteStep(index) {
    if (guardRunning()) {
        return;
    }
    var steps = currentSteps();
    var step = steps[index];
    if (!step) {
        return;
    }
    var start = -1;
    var end = -1;
    if (isBlockStart(step.cmd)) {
        start = index;
        end = findGroupEnd(steps, index);
    } else if (isBlockEnd(step.cmd)) {
        end = index;
        start = findGroupStart(steps, index);
    }
    if (start >= 0 && end >= 0) {
        var name = steps[start].label || autoLabelFor(steps[start]);
        var kind = COMMAND_DEFS[steps[start].cmd].title;
        showChoice("🗑 " + kind + "の削除", kind + "「" + name + "」をどうする？", [
            { text: "🗑 中身ごと削除", cls: "btn-danger", fn: function () {
                steps.splice(start, end - start + 1);
                afterDelete(start, kind + "削除(中身ごと): " + name);
            } },
            { text: "📤 枠だけ解除", fn: function () {
                // The block's own ELSE / CATCH go with the frame
                var remove = [start, end].concat(blockMiddles(steps, start, end)).sort(function (a, b) { return b - a; });
                for (var r = 0; r < remove.length; r++) {
                    steps.splice(remove[r], 1);
                }
                afterDelete(start, kind + "解除: " + name);
            } },
            { text: "キャンセル", fn: null }
        ]);
        return;
    }
    steps.splice(index, 1);
    afterDelete(index, "削除: " + truncateText(step.label || step.cmd, 24));
}

function duplicateSelected() {
    var steps = currentSteps();
    if (guardRunning() || selectedIndex < 0 || selectedIndex >= steps.length) {
        return;
    }
    var range = blockRange(steps, selectedIndex);
    if (isBlockMiddle(steps[selectedIndex].cmd)) {
        log("「" + COMMAND_DEFS[steps[selectedIndex].cmd].title + "」は1つのブロックに1つだけだから、複製できないキュン", "warn");
        return;
    }
    if (isBlockEnd(steps[selectedIndex].cmd)) {
        // A lone block end would close the enclosing block early: copy the whole block instead
        var start = findGroupStart(steps, selectedIndex);
        if (start < 0) {
            return;
        }
        range = { from: start, to: selectedIndex };
    }
    var copies = deepCopy(steps.slice(range.from, range.to + 1));
    for (var i = 0; i < copies.length; i++) {
        steps.splice(range.to + 1 + i, 0, copies[i]);
    }
    selectedIndex = range.to + 1;
    renderSteps();
    scrollToSelected();
    commitChange("複製: " + truncateText(copies[0].label || copies[0].cmd, 24));
}

// A disabled step is kept but skipped at run time (a disabled GROUP_START skips the whole group)
function toggleDisabledSelected() {
    var steps = currentSteps();
    if (guardRunning() || selectedIndex < 0 || selectedIndex >= steps.length) {
        return;
    }
    var step = steps[selectedIndex];
    if (isBlockEnd(step.cmd) || isBlockMiddle(step.cmd)) {
        log("「" + COMMAND_DEFS[step.cmd].title + "」は無効化できないキュン。ブロックの最初の行を無効化すると、ブロックまるごと止まるよ", "warn");
        return;
    }
    if (step.disabled) {
        delete step.disabled;
    } else {
        step.disabled = true;
    }
    renderSteps();
    commitChange((step.disabled ? "無効化: " : "有効化: ") + truncateText(step.label || step.cmd, 24));
}

// =====================================================================
//  Modal dialog
// =====================================================================
function isModalOpen() {
    return byId("modalOverlay").style.display === "block";
}

// buttons: [{ text, cls, fn }]  fn returning false keeps the dialog open
// opts: { wide: true, onDismiss: fn }  onDismiss runs when the dialog is closed with Esc
function openModal(title, bodyHtml, buttons, opts) {
    opts = opts || {};
    modalToken++;
    var token = modalToken;
    modalDismissFn = opts.onDismiss || null;
    byId("modalBox").className = opts.wide ? "modal wide" : "modal";
    byId("modalTitle").innerHTML = escapeHtml(title);
    byId("modalBody").innerHTML = bodyHtml;
    var footer = byId("modalFooter");
    footer.innerHTML = "";
    modalButtons = buttons || [{ text: "OK", cls: "btn-primary", fn: null }];
    for (var i = 0; i < modalButtons.length; i++) {
        var b = document.createElement("button");
        b.className = "btn " + (modalButtons[i].cls || "");
        b.innerHTML = escapeHtml(modalButtons[i].text);
        b.onclick = makeModalHandler(i, token);
        footer.appendChild(b);
    }
    byId("modalOverlay").style.display = "block";
    var inputs = byId("modalBody").getElementsByTagName("input");
    var areas = byId("modalBody").getElementsByTagName("textarea");
    var first = inputs.length ? inputs[0] : (areas.length ? areas[0] : footer.getElementsByTagName("button")[0]);
    try {
        first.focus();
        if (first.select) {
            first.select();
        }
    } catch (e) {
        /* ignore */
    }
}

function makeModalHandler(i, token) {
    return function () {
        var btn = modalButtons[i];
        var result = btn && btn.fn ? btn.fn() : true;
        if (result !== false && token === modalToken) {
            closeModal();
        }
    };
}

function dismissModal() {
    var fn = modalDismissFn;
    closeModal();
    if (fn) {
        fn();
    }
}

function closeModal() {
    modalToken++;
    modalDismissFn = null;
    byId("modalOverlay").style.display = "none";
    byId("modalBody").innerHTML = "";
    modalButtons = [];
}

function triggerDefaultModalButton() {
    var buttons = byId("modalFooter").getElementsByTagName("button");
    if (buttons.length) {
        buttons[0].click();
    }
}

function showMessage(title, message) {
    openModal(title, '<div class="modal-message">' + escapeHtml(message) + "</div>", [{ text: "OK", cls: "btn-primary", fn: null }]);
}

function showChoice(title, message, buttons) {
    openModal(title, '<div class="modal-message">' + escapeHtml(message) + "</div>", buttons);
}

function showInputDialog(title, label, defaultValue, onOk) {
    var html = '<div class="form-row"><label class="form-label" for="dlgInput">' + escapeHtml(label) + "</label>" +
        '<input type="text" id="dlgInput" class="form-input" value="' + escapeHtml(defaultValue) + '"></div>' +
        '<div class="form-error" id="formError"></div>';
    openModal(title, html, [
        { text: "OK", cls: "btn-primary", fn: function () {
            var value = trimText(byId("dlgInput").value);
            if (value === "") {
                showFormError("空っぽはダメだキュン♡");
                return false;
            }
            onOk(value);
            return true;
        } },
        { text: "キャンセル", fn: null }
    ]);
}

function showFormError(message) {
    var el = byId("formError");
    if (el) {
        el.innerHTML = escapeHtml(message);
        el.style.display = "block";
    }
}

// =====================================================================
//  Step editor dialog
// =====================================================================
function buildFieldHtml(field, value) {
    var id = "fld_" + field.id;
    var v = escapeHtml(value == null ? "" : value);
    var ph = field.placeholder ? ' placeholder="' + escapeHtml(field.placeholder) + '"' : "";
    var html = '<div class="form-row"><label class="form-label" for="' + id + '">' + escapeHtml(field.label) + "</label>";
    var i;
    if (field.type === "textarea") {
        html += '<textarea id="' + id + '" class="form-input" rows="4">' + v + "</textarea>";
    } else if (field.type === "select") {
        html += '<select id="' + id + '" class="form-input">';
        for (i = 0; i < field.options.length; i++) {
            html += '<option value="' + escapeHtml(field.options[i][0]) + '"' + (field.options[i][0] === value ? " selected" : "") + ">" +
                escapeHtml(field.options[i][1]) + "</option>";
        }
        html += "</select>";
    } else if (field.type === "keypreset") {
        html += '<div class="form-inline"><input type="text" id="' + id + '" class="form-input" value="' + v + '"' + ph + ">" +
            '<select class="form-input" onchange="applyPreset(this, \'' + id + '\')"><option value="">よく使うキー ▼</option>';
        for (i = 0; i < KEY_PRESETS.length; i++) {
            html += '<option value="' + escapeHtml(KEY_PRESETS[i][0]) + '">' + escapeHtml(KEY_PRESETS[i][0] + "  " + KEY_PRESETS[i][1]) + "</option>";
        }
        html += "</select></div>";
    } else if (field.type === "csvcol") {
        html += '<div class="form-inline"><input type="text" id="' + id + '" class="form-input" value="' + v + '"' + ph + ">";
        var cols = csvMaxColumns();
        if (cols > 0) {
            html += '<select class="form-input" onchange="applyPreset(this, \'' + id + '\')"><option value="">読込中のCSV列 ▼</option>';
            for (i = 1; i <= cols; i++) {
                var sample = csvState.rows.length && csvState.rows[0][i - 1] != null ? csvState.rows[0][i - 1] : "";
                html += '<option value="' + i + '">' + escapeHtml(i + ": " + (csvHeaderName(i) || "(見出しなし)") + "  例: " + truncateText(sample, 14)) + "</option>";
            }
            html += "</select>";
        }
        html += "</div>";
        if (cols === 0) {
            html += '<div class="form-hint">CSVを読み込んでおくと、ここで列名から選べるようになるキュン♡</div>';
        }
    } else if (field.type === "imgpath") {
        html += '<input type="text" id="' + id + '" class="form-input" value="' + v + '"' + ph + ' onchange="updateImagePreview()">' +
            '<div class="img-capture-row"><button type="button" class="btn" onclick="captureImageAroundCursor()">📷 5秒後のマウス周辺を切り取り</button>' +
            ' 幅 <input type="text" id="imgCapW" class="input-xs" value="60"> × 高さ <input type="text" id="imgCapH" class="input-xs" value="30"> px</div>' +
            '<div id="imgCaptureStatus" class="form-hint"></div>' +
            '<div id="imgPreview" class="img-preview"></div>';
    } else if (field.type === "rectcapture") {
        html += '<button type="button" class="btn" onclick="captureRectPositions()">📍 範囲を取得（左上→右下の順にマウスを置く）</button>' +
            ' <span id="rectCaptureStatus" class="form-hint"></span>';
    } else if (field.type === "macroselect") {
        html += '<select id="' + id + '" class="form-input"><option value="">（マクロを選んでね）</option>';
        for (i = 0; i < appData.macros.length; i++) {
            html += '<option value="' + escapeHtml(appData.macros[i].id) + '"' + (appData.macros[i].id === value ? " selected" : "") + ">" +
                escapeHtml(appData.macros[i].name) + (i === currentMacroIndex ? "（このマクロ）" : "") + "</option>";
        }
        html += "</select>";
    } else if (field.type === "capture") {
        html += '<button type="button" class="btn" onclick="captureCursorPosition()">📍 数秒後のマウス位置を取得</button>' +
            ' <span id="captureStatus" class="form-hint"></span>';
    } else {
        html += '<input type="text" id="' + id + '" class="form-input" value="' + v + '"' + ph + ">";
    }
    if (field.placeholders) {
        var choices = placeholderChoices();
        html += '<select class="ph-select" onchange="insertPlaceholder(this, \'' + id + '\')"><option value="">＋ 差し込みを追加 ▼</option>';
        for (i = 0; i < choices.length; i++) {
            html += '<option value="' + escapeHtml(choices[i][0]) + '">' + escapeHtml(choices[i][0] + "  " + choices[i][1]) + "</option>";
        }
        html += "</select>";
    }
    if (field.hint) {
        html += '<div class="form-hint">' + escapeHtml(field.hint) + "</div>";
    }
    return html + "</div>";
}

function applyPreset(select, inputId) {
    if (select.value !== "") {
        byId(inputId).value = select.value;
    }
    select.selectedIndex = 0;
}

function openStepEditor(cmd, step, onSave) {
    var def = COMMAND_DEFS[cmd];
    if (!def) {
        return;
    }
    var currentVal = step ? String(step.val) : def.defaultVal;
    var values = def.parse(currentVal);
    var props = propFields(def);
    for (var p = 0; p < props.length; p++) {
        values[props[p].id] = step && step[props[p].id] ? step[props[p].id] : "";
    }
    var customLabel = step && step.label && step.label !== def.autoLabel(currentVal) ? step.label : "";
    var html = '<div class="form-help">' + escapeHtml(def.help) + "</div>";
    for (var i = 0; i < def.fields.length; i++) {
        html += buildFieldHtml(def.fields[i], values[def.fields[i].id]);
    }
    html += buildFieldHtml({ id: "label", label: "表示ラベル（空欄なら自動で付けるキュン）", type: "text" }, customLabel);
    html += '<div class="form-error" id="formError"></div>';
    openModal((step ? "✎ 編集: " : "＋ 追加: ") + def.icon + " " + def.title + "（" + cmd + "）", html, [
        { text: step ? "更新する" : "追加する", cls: "btn-primary", fn: function () {
            var v = {};
            for (var j = 0; j < def.fields.length; j++) {
                var f = def.fields[j];
                if (f.type === "capture" || f.type === "rectcapture") {
                    continue;
                }
                var raw = byId("fld_" + f.id).value;
                v[f.id] = f.raw ? raw : trimText(raw);
            }
            var err = def.validate(v);
            if (err) {
                showFormError(err);
                return false;
            }
            var val = def.compose(v);
            var label = trimText(byId("fld_label").value);
            var result = { cmd: cmd, val: val, label: label || def.autoLabel(val) };
            for (var q = 0; q < props.length; q++) {
                if (v[props[q].id]) {
                    result[props[q].id] = v[props[q].id];
                }
            }
            onSave(result);
            return true;
        } },
        { text: "キャンセル", fn: null }
    ]);
    if (cmd === "CLICK_IMG") {
        updateImagePreview();
    }
}

function buildPalette() {
    var html = [];
    for (var g = 0; g < PALETTE_GROUPS.length; g++) {
        html.push('<span class="palette-group"><span class="palette-label">' + escapeHtml(PALETTE_GROUPS[g].label) + "</span>");
        for (var i = 0; i < PALETTE_GROUPS[g].cmds.length; i++) {
            var cmd = PALETTE_GROUPS[g].cmds[i];
            var def = COMMAND_DEFS[cmd];
            html.push('<button class="btn btn-cmd cat-' + def.category + '" onclick="addCommand(\'' + cmd + '\')" title="' +
                escapeHtml(cmd + "：" + def.help) + '">' + def.icon + " " + escapeHtml(def.title) + "</button>");
        }
        html.push("</span>");
    }
    byId("paletteButtons").innerHTML = html.join("");
}

// =====================================================================
//  CSV loading (UI)
// =====================================================================
// IE fires onchange only when the value changes and a file input's value is read-only,
// so swap in a fresh copy (inline onchange attribute included) to allow picking the same file again
function resetFileInput(input) {
    try {
        var fresh = input.cloneNode(false);
        input.parentNode.replaceChild(fresh, input);
    } catch (e) {
        /* ignore */
    }
}

function onCsvFileChosen(input) {
    var path = input.value || "";
    resetFileInput(input);
    if (!path || /fakepath/i.test(path)) {
        log("ファイルのフルパスが取れなかったキュン…パス欄に直接入力して📥読込してね", "warn");
        return;
    }
    byId("csvPathInput").value = path;
    loadCsvFromInput();
}

function loadCsvFromInput() {
    if (guardRunning()) {
        return;
    }
    var path = trimText(byId("csvPathInput").value).replace(/^"+|"+$/g, "");
    if (!path) {
        log("CSVのパスを入れてね♡", "warn");
        return;
    }
    if (!fso) {
        log("ActiveXが使えないのでCSVを読めないキュン…", "error");
        return;
    }
    if (!fso.FileExists(path)) {
        log("CSVファイルが見つからないキュン: " + path, "error");
        return;
    }
    try {
        var res = readCsvText(path, byId("csvEncodingSelect").value);
        csvState.path = path;
        csvState.encoding = res.encoding;
        csvState.records = parseCsv(res.text);
        var first = csvState.records[0] || [];
        for (var k = 0; k < first.length; k++) {
            if (trimText(first[k]) === "元データ行No" && !byId("csvHeaderCheck").checked) {
                byId("csvHeaderCheck").checked = true;
                log("（エラー行／実行結果のCSVだから「1行目は見出し」をONにしたよ）", "info");
            }
        }
        applyCsvHeaderOption();
        log("📥 CSVを読み込んだキュン♡ データ " + csvState.rows.length + "行（" + encodingLabel(res.encoding) + "）: " + path, "ok");
        warnCsvShape();
    } catch (e) {
        log("CSVの読み込みに失敗したキュン…（" + errorText(e) + "）", "error");
    }
}

function warnCsvShape() {
    var i;
    for (i = 0; i < csvParseWarnings.length; i++) {
        log("⚠ " + csvParseWarnings[i], "warn");
    }
    var rows = csvState.rows;
    var expected = csvState.header ? csvState.header.length : (rows.length ? rows[0].length : 0);
    var odd = [];
    var blank = 0;
    for (i = 0; i < rows.length; i++) {
        if (isBlankRow(rows[i])) {
            blank++;
        } else if (rows[i].length !== expected) {
            odd.push(i + 1);
        }
    }
    if (odd.length) {
        log("⚠ 列の数がほかと違う行があるキュン（データ " + odd.slice(0, 5).join("・") + (odd.length > 5 ? " ほか" + (odd.length - 5) + "行" : "") + "行目）。\" の閉じ忘れや余分なカンマがないか確認してね", "warn");
    }
    if (blank) {
        log("（空の行が " + blank + " 行あるよ。行番号はそのままで、実行のときは飛ばすね）", "info");
    }
}

function applyCsvHeaderOption() {
    var hasHeader = byId("csvHeaderCheck").checked;
    var records = csvState.records;
    csvState.header = hasHeader && records.length > 0 ? records[0] : null;
    csvState.rows = hasHeader ? records.slice(1) : records.slice(0);
    byId("endRowInput").placeholder = "最後(" + csvState.rows.length + ")";
    updateCsvInfo();
}

function reparseCsv() {
    if (csvState.records.length) {
        applyCsvHeaderOption();
        log("見出し設定を切り替えたよ。データ " + csvState.rows.length + "行", "info");
    }
}

function reloadCsvIfLoaded() {
    if (csvState.path) {
        loadCsvFromInput();
    }
}

function updateCsvInfo() {
    var info = byId("csvInfo");
    if (!csvState.path) {
        info.innerHTML = "CSV未読込";
        return;
    }
    var text = "✔ " + csvState.rows.length + "行 × " + csvMaxColumns() + "列 [" + encodingLabel(csvState.encoding) + "]";
    if (csvState.header) {
        text += " 見出し: " + truncateText(csvState.header.join(", "), 60);
    }
    info.innerHTML = escapeHtml(text);
    info.title = csvState.path;
}

// =====================================================================
//  Window list / cursor capture helpers (PowerShell)
// =====================================================================
function showWindowList() {
    if (!shell) {
        log("ActiveXが使えないのでウィンドウ一覧は取れないキュン…", "error");
        return;
    }
    log("🔍 開いているウィンドウを調べてるキュン…", "info");
    runPowerShellAsync([
        "$titles = @(Get-Process | Where-Object { $_.MainWindowTitle -ne '' } | ForEach-Object { $_.MainWindowTitle } | Sort-Object -Unique)",
        "Set-FujiResult ('OK:' + ($titles -join \"`n\"))"
    ], PS_TIMEOUT_SEC, function (ok, payload) {
        if (!ok) {
            log("ウィンドウ一覧の取得に失敗…（" + payload + "）", "error");
            return;
        }
        lastWindowTitles = [];
        var lines = String(payload).split(/\r?\n/);
        if (!canOpenAsyncDialog(-1)) {
            log("🔍 ウィンドウ一覧は取れたけど、いま別の画面が開いているから表示しなかったキュン。閉じてからもう一度🔍を押してね", "warn");
            return;
        }
        for (var i = 0; i < lines.length; i++) {
            if (trimText(lines[i]) !== "") {
                lastWindowTitles.push(trimText(lines[i]));
            }
        }
        var html = '<div class="form-help">クリックすると「対象ウィンドウ」に設定するキュン♡（タイトルの一部だけ残して使ってもOK）</div><ul class="pick-list">';
        for (var j = 0; j < lastWindowTitles.length; j++) {
            html += '<li onclick="pickWindowTitle(' + j + ')">🪟 ' + escapeHtml(lastWindowTitles[j]) + "</li>";
        }
        html += "</ul>";
        if (!lastWindowTitles.length) {
            html += '<div class="modal-message">ウィンドウが見つからなかったキュン…</div>';
        }
        openModal("🔍 開いているウィンドウ一覧", html, [{ text: "閉じる", fn: null }]);
    });
}

function pickWindowTitle(i) {
    var title = lastWindowTitles[i];
    closeModal();
    if (title != null) {
        byId("targetWindowInput").value = title;
        onTargetWindowChange();
    }
}

function captureCursorPosition() {
    var status = byId("captureStatus");
    if (!shell) {
        if (status) { status.innerHTML = "ActiveXが使えないキュン…"; }
        return;
    }
    if (status) {
        status.innerHTML = "マウスを目的の場所に置いて、そのまま待っててね…（約3〜5秒）";
    }
    var token = modalToken;
    runPowerShellAsync([
        "Add-Type -TypeDefinition @\"",
        "using System;",
        "using System.Runtime.InteropServices;",
        "public struct FujiPoint { public int X; public int Y; }",
        "public static class FujiCursor {",
        "    [DllImport(\"user32.dll\")] public static extern bool SetProcessDPIAware();",
        "    [DllImport(\"user32.dll\")] public static extern bool GetCursorPos(out FujiPoint p);",
        "}",
        "\"@",
        "[void][FujiCursor]::SetProcessDPIAware()",
        "Start-Sleep -Seconds 3",
        "$pt = New-Object FujiPoint",
        "[void][FujiCursor]::GetCursorPos([ref]$pt)",
        "Set-FujiResult ('OK:' + $pt.X + ',' + $pt.Y)"
    ], PS_TIMEOUT_SEC, function (ok, payload) {
        if (modalToken !== token) {
            // The editor that asked was closed or replaced: never write into another dialog's fields
            log(ok ? "📍 マウス位置は (" + payload + ") だったキュン（編集画面が閉じられたので入力はしなかったよ）" : "📍 マウス位置の取得に失敗…（" + payload + "）", ok ? "info" : "warn");
            return;
        }
        var st = byId("captureStatus");
        if (!ok) {
            if (st) { st.innerHTML = escapeHtml("取得失敗…" + payload); }
            return;
        }
        var p = String(payload).split(",");
        if (byId("fld_x") && byId("fld_y")) {
            byId("fld_x").value = trimText(p[0]);
            byId("fld_y").value = trimText(p[1]);
        }
        if (st) {
            st.innerHTML = escapeHtml("取得できたキュン♡ (" + payload + ")");
        }
    });
}

function updateImagePreview() {
    var input = byId("fld_path");
    var box = byId("imgPreview");
    if (!input || !box) {
        return;
    }
    var full = resolveImagePath(input.value);
    if (full === "") {
        box.innerHTML = "";
    } else if (fso && fso.FileExists(full)) {
        box.innerHTML = '<img src="' + escapeHtml(full) + '" alt="">';
    } else {
        box.innerHTML = '<span class="form-hint">⚠ 画像ファイルが見つからないキュン… ' + escapeHtml(full) + "</span>";
    }
}

function captureImageAroundCursor() {
    var status = byId("imgCaptureStatus");
    if (!shell || !fso || !appDir) {
        if (status) { status.innerHTML = "ActiveXが使えないキュン…"; }
        return;
    }
    var w = Math.min(400, Math.max(8, toInt(byId("imgCapW").value, 60)));
    var h = Math.min(400, Math.max(8, toInt(byId("imgCapH").value, 30)));
    var folder = appFilePath(IMAGE_FOLDER_NAME);
    try {
        if (!fso.FolderExists(folder)) {
            fso.CreateFolder(folder);
        }
    } catch (e) {
        if (status) { status.innerHTML = escapeHtml("保存フォルダを作れなかった…" + errorText(e)); }
        return;
    }
    var d = new Date();
    var name = "img_" + d.getFullYear() + pad2(d.getMonth() + 1) + pad2(d.getDate()) + "_" +
        pad2(d.getHours()) + pad2(d.getMinutes()) + pad2(d.getSeconds()) + ".png";
    var relative = IMAGE_FOLDER_NAME + "\\" + name;
    if (status) {
        status.innerHTML = "対象の画面を前に出して、押したいボタンの真ん中にマウスを置いたまま待っててね…（5秒）";
    }
    var token = modalToken;
    runPowerShellAsync(buildImageCaptureScript(folder + "\\" + name, w, h), PS_TIMEOUT_SEC, function (ok, payload) {
        if (modalToken !== token) {
            log(ok ? "📷 参照画像は " + relative + " に保存したキュン（編集画面が閉じられたので、パスは入れなかったよ）" : "📷 切り取りに失敗…（" + payload + "）", ok ? "ok" : "warn");
            return;
        }
        var st = byId("imgCaptureStatus");
        if (!ok) {
            if (st) { st.innerHTML = escapeHtml("切り取り失敗…" + payload); }
            return;
        }
        if (byId("fld_path")) {
            byId("fld_path").value = relative;
            updateImagePreview();
        }
        if (st) {
            var cap = String(payload).split(",");
            var cw = toInt(cap[2], w);
            var ch = toInt(cap[3], h);
            st.innerHTML = escapeHtml("切り取れたキュン♡ マウス位置(" + cap[0] + "," + cap[1] + ") の周り " + cw + "×" + ch + "px → " + relative +
                (cw < w - 1 || ch < h - 1 ? "（画面の端に近かったから小さめに切り取ったよ）" : ""));
        }
        log("📷 参照画像を保存したキュン: " + relative, "ok");
    });
}

// Two cursor positions, 3 seconds apart: top-left, then bottom-right of the region
function captureRectPositions() {
    var status = byId("rectCaptureStatus");
    if (!shell) {
        if (status) { status.innerHTML = "ActiveXが使えないキュン…"; }
        return;
    }
    var token = modalToken;
    if (status) {
        status.innerHTML = "3秒以内に読み取りたい範囲の【左上】にマウスを置いてね。そのあと3秒で【右下】に動かしてね";
    }
    runPowerShellAsync([
        "Add-Type -TypeDefinition @\"",
        "using System;",
        "using System.Runtime.InteropServices;",
        "public struct FujiRectPoint { public int X; public int Y; }",
        "public static class FujiRectCursor {",
        "    [DllImport(\"user32.dll\")] public static extern bool SetProcessDPIAware();",
        "    [DllImport(\"user32.dll\")] public static extern bool GetCursorPos(out FujiRectPoint p);",
        "}",
        "\"@",
        "[void][FujiRectCursor]::SetProcessDPIAware()",
        "Start-Sleep -Seconds 3",
        "$a = New-Object FujiRectPoint; [void][FujiRectCursor]::GetCursorPos([ref]$a)",
        "[console]::Beep(880, 150)",
        "Start-Sleep -Seconds 3",
        "$b = New-Object FujiRectPoint; [void][FujiRectCursor]::GetCursorPos([ref]$b)",
        "Set-FujiResult ('OK:' + $a.X + ',' + $a.Y + ',' + $b.X + ',' + $b.Y)"
    ], PS_TIMEOUT_SEC, function (ok, payload) {
        if (modalToken !== token) {
            log(ok ? "📍 範囲は (" + payload + ") だったキュン（編集画面が閉じられたので入力はしなかったよ）" : "📍 範囲の取得に失敗…（" + payload + "）", ok ? "info" : "warn");
            return;
        }
        var st = byId("rectCaptureStatus");
        if (!ok) {
            if (st) { st.innerHTML = escapeHtml("取得失敗…" + payload); }
            return;
        }
        var q = String(payload).split(",");
        var x1 = toInt(q[0], 0), y1 = toInt(q[1], 0), x2 = toInt(q[2], 0), y2 = toInt(q[3], 0);
        if (byId("fld_x")) {
            byId("fld_x").value = String(Math.min(x1, x2));
            byId("fld_y").value = String(Math.min(y1, y2));
            byId("fld_w").value = String(Math.abs(x2 - x1));
            byId("fld_h").value = String(Math.abs(y2 - y1));
            byId("fld_area").value = "RECT";
        }
        if (st) {
            st.innerHTML = escapeHtml("取得できたキュン♡ (" + Math.min(x1, x2) + "," + Math.min(y1, y2) + ") から 幅" + Math.abs(x2 - x1) + "×高さ" + Math.abs(y2 - y1));
        }
    });
}

// =====================================================================
//  PowerShell bridge (asynchronous: hidden window + result file polling)
// =====================================================================
function tempFolder() {
    try {
        return shell.ExpandEnvironmentStrings("%TEMP%");
    } catch (e) {
        return appDir;
    }
}

var LAUNCH_METHOD_NAMES = { run: "WScript.Shell.Run", cmd: "cmd.exe経由（非表示）", exec: "WScript.Shell.Exec", shell: "Shell.Application.ShellExecute" };

function expandEnv(s) {
    try {
        return shell.ExpandEnvironmentStrings(s);
    } catch (e) {
        return s;
    }
}

// Full paths first (a bare "powershell.exe" fails when PATH is trimmed); Sysnative reaches
// the 64-bit PowerShell from a 32-bit mshta.exe
function powershellCandidates() {
    var list = [];
    var paths = [POWERSHELL_PATH, "%SystemRoot%\\Sysnative\\WindowsPowerShell\\v1.0\\powershell.exe"];
    for (var i = 0; i < paths.length; i++) {
        var p = expandEnv(paths[i]);
        if (p && fso && fso.FileExists(p)) {
            list.push(p);
        }
    }
    list.push("powershell.exe");
    return list;
}

function quoteExe(exe) {
    return /[\\ ]/.test(exe) ? '"' + exe + '"' : exe;
}

// markerPath: the cmd route writes it when cmd.exe could not start PowerShell
function startProcessHidden(method, exe, args, markerPath) {
    if (method === "run") {
        shell.Run(quoteExe(exe) + " " + args, 0, false);
    } else if (method === "cmd") {
        // /s strips only the outermost quotes, so the inner quoting of args survives
        shell.Run(quoteExe(expandEnv("%ComSpec%")) + " /s /c \"" + quoteExe(exe) + " " + args + " || echo NG>\"" + markerPath + "\"\"", 0, false);
    } else if (method === "exec") {
        shell.Exec(quoteExe(exe) + " " + args); // a console window flashes briefly
    } else {
        new ActiveXObject("Shell.Application").ShellExecute(exe, args, "", "open", 0);
    }
}

// Some security products refuse WScript.Shell.Run of powershell.exe from mshta.exe (seen as
// 0xFFFFFFFF) while still allowing other routes, so walk through them in order of how quietly
// they run: hidden Run, hidden cmd.exe, Exec (console flashes), ShellExecute.
// silentOnly: background jobs (the Esc watcher) must never fall back to Exec, whose console
// window would flash at run start
function createPsLauncher(args, markerPath, silentOnly) {
    var exes = powershellCandidates();
    var attempts = [];
    var seen = {};
    var i;
    function add(method, exe) {
        if (silentOnly && method !== "run" && method !== "cmd") {
            return;
        }
        if (!seen[method + "|" + exe]) {
            seen[method + "|" + exe] = true;
            attempts.push({ method: method, exe: exe });
        }
    }
    if (psPreferredLaunch) {
        add(psPreferredLaunch.method, psPreferredLaunch.exe);
    }
    for (i = 0; i < exes.length; i++) {
        add("run", exes[i]);
    }
    add("cmd", exes[0]);
    for (i = 0; i < exes.length; i++) {
        add("exec", exes[i]);
    }
    add("shell", exes[0]);
    var launcher = {
        current: null,
        errors: [],
        // Starts the next route; false when every route has been refused
        next: function () {
            while (attempts.length) {
                var a = attempts.shift();
                try {
                    startProcessHidden(a.method, a.exe, args, markerPath);
                    launcher.current = a;
                    return true;
                } catch (e) {
                    launcher.errors.push(LAUNCH_METHOD_NAMES[a.method] + "(" + fileNameOf(a.exe) + "): " + errorText(e));
                }
            }
            launcher.current = null;
            return false;
        }
    };
    return launcher;
}

function launchDescription(a) {
    return LAUNCH_METHOD_NAMES[a.method] + "（" + a.exe + "）";
}

// Start any command line; falls back to ShellExecute when WScript.Shell.Run is refused
function splitCommandLine(cmd) {
    cmd = trimText(cmd);
    var m = cmd.match(/^"([^"]*)"\s*([\s\S]*)$/) || cmd.match(/^(\S+)\s*([\s\S]*)$/);
    return m ? { file: m[1], args: m[2] } : { file: cmd, args: "" };
}

function runCommand(cmd, windowStyle) {
    try {
        shell.Run(cmd, windowStyle, false);
        return "run";
    } catch (e1) {
        var parts = splitCommandLine(cmd);
        try {
            new ActiveXObject("Shell.Application").ShellExecute(parts.file, parts.args, "", "open", windowStyle);
            return "shell";
        } catch (e2) {
            throw new Error("Run: " + errorText(e1) + " / ShellExecute: " + errorText(e2));
        }
    }
}

function openFolderSelect(path) {
    try {
        runCommand("explorer.exe /select,\"" + path + "\"", 1);
    } catch (e) {
        log("フォルダを開けなかったキュン…（" + errorText(e) + "）", "warn");
    }
}

// onDone(ok, payload): script must call  Set-FujiResult 'OK[:payload]'  or  'NG:message'
// opts.forRun: the call is a step of the running macro, so its polling goes through the run's
// single timer (stop/pause apply to it). Every other caller polls with its own setTimeout so it can
// never replace the run's pending timer.
// Returns a job whose cancel() creates a marker file the script checks before acting
// (Test-FujiCancel), because stopping the HTA side does not kill powershell.exe.
function runPowerShellAsync(bodyLines, timeoutSec, onDone, opts) {
    opts = opts || {};
    psSeq++;
    var base = tempFolder() + "\\fujikyun_rpa_" + new Date().getTime() + "_" + psSeq;
    var ps1 = base + ".ps1";
    var resultPath = base + ".result";
    var cancelPath = base + ".cancel";
    var startedPath = base + ".started";
    // A detached run job (the run ended while it was in flight) keeps polling on its own timer
    // only to clean up; its onDone is never called, so it cannot touch a later run.
    function later(fn, ms) {
        if (opts.forRun && !job.detached) {
            schedule(fn, ms);
        } else {
            setTimeout(fn, ms);
        }
    }
    var job = {
        finished: false,
        detached: false,
        detach: function () {
            if (job.finished || job.detached) {
                return;
            }
            job.detached = true;
            job.cancel();
            if (job.poll) {
                setTimeout(job.poll, 200);
            }
        },
        cancel: function () {
            if (job.finished) {
                return;
            }
            try {
                if (fso && !fso.FileExists(cancelPath)) {
                    fso.CreateTextFile(cancelPath, true).Close();
                }
            } catch (e) {
                /* ignore */
            }
        }
    };
    var lines = [
        "$ErrorActionPreference = 'Stop'",
        "$fujiResultPath = " + psQuote(resultPath),
        "$fujiCancelPath = " + psQuote(cancelPath),
        "function Test-FujiCancel { return (Test-Path -LiteralPath $fujiCancelPath) }",
        // Proof of life for long-running jobs: under restricted PowerShell this line fails and no file appears
        opts.startTimeoutSec ? "try { [System.IO.File]::WriteAllText(" + psQuote(startedPath) + ", '1') } catch { }" : "",
        "function Set-FujiResult([string]$text) {",
        "    $tmp = $fujiResultPath + '.part'",
        "    [System.IO.File]::WriteAllText($tmp, $text, [System.Text.Encoding]::Unicode)",
        "    Move-Item -LiteralPath $tmp -Destination $fujiResultPath -Force",
        "}",
        "try {"
    ].concat(bodyLines).concat([
        "} catch {",
        "    if (-not (Test-Path -LiteralPath $fujiResultPath)) { Set-FujiResult ('NG:' + $_.Exception.Message) }",
        "}"
    ]);
    try {
        var ts = fso.CreateTextFile(ps1, true, true); // UTF-16LE with BOM (PowerShell reads it correctly)
        ts.Write(lines.join("\r\n"));
        ts.Close();
    } catch (e1) {
        onDone(false, "PowerShellスクリプトを書き出せなかった（" + errorText(e1) + "）");
        return;
    }
    pendingTempFiles.push(ps1, resultPath, resultPath + ".part", cancelPath, startedPath);
    // iex reads the script text, so a restricted execution policy for .ps1 files does not block it
    if (psLaunchBlocked) {
        job.finished = true;
        onDone(false, "この端末ではPowerShellを起動できないみたい（さっき全部の方法で失敗したよ。🩺環境チェックでもう一度確かめられるよ）");
        return job;
    }
    var args = "-NoProfile -NonInteractive -ExecutionPolicy Bypass -WindowStyle Hidden -Command \"iex ([System.IO.File]::ReadAllText(" + psQuote(ps1) + "))\"";
    var markerPath = base + ".launchfail";
    pendingTempFiles.push(markerPath);
    var launcher = createPsLauncher(args, markerPath, !!opts.silentOnly);
    function giveUp() {
        psLaunchBlocked = true;
        psLastFailed = true;
        job.finished = true;
        delete activePsJobs[base];
        onDone(false, "PowerShellを起動できなかった（" + launcher.errors.join(" / ") + "）");
    }
    if (!launcher.next()) {
        giveUp();
        return job;
    }
    activePsJobs[base] = job;
    var waited = 0;
    var limit = timeoutSec * 1000;
    function poll() {
        if (fso.FileExists(resultPath)) {
            var text = "";
            try {
                var rs = fso.OpenTextFile(resultPath, 1, false, -1);
                text = rs.AtEndOfStream ? "" : rs.ReadAll();
                rs.Close();
            } catch (e3) {
                waited += 200;
                later(poll, 200);
                return;
            }
            if (text.charCodeAt(0) === 0xFEFF) {
                text = text.substring(1);
            }
            job.finished = true;
            delete activePsJobs[base];
            deleteFileQuietly(ps1);
            deleteFileQuietly(resultPath);
            deleteFileQuietly(markerPath);
            deleteFileQuietly(cancelPath);
            deleteFileQuietly(startedPath);
            if (launcher.errors.length && (!psPreferredLaunch || psPreferredLaunch.method !== launcher.current.method || psPreferredLaunch.exe !== launcher.current.exe)) {
                log("PowerShellは " + launchDescription(launcher.current) + " で起動できたキュン。この後もこの方法を使うね（使えなかった方法: " + launcher.errors.join(" / ") + "）", "warn");
            }
            if (!psPreferredLaunch || psPreferredLaunch.method !== launcher.current.method || psPreferredLaunch.exe !== launcher.current.exe) {
                psPreferredLaunch = launcher.current;
                saveSettings();
            }
            psLastFailed = false;
            if (job.detached) {
                return;
            }
            if (text.indexOf("OK") === 0) {
                onDone(true, text.substring(3));
            } else {
                onDone(false, text.replace(/^NG:/, ""));
            }
            return;
        }
        if (launcher.current.method === "cmd" && fso.FileExists(markerPath)) {
            deleteFileQuietly(markerPath);
            launcher.errors.push(LAUNCH_METHOD_NAMES.cmd + ": PowerShellの起動を断られた");
            if (!launcher.next()) {
                giveUp();
                return;
            }
            waited = 0;
            later(poll, 300);
            return;
        }
        waited += 200;
        var notStarted = opts.startTimeoutSec && !fso.FileExists(startedPath) && waited >= opts.startTimeoutSec * 1000;
        if (waited >= limit || notStarted) {
            psLastFailed = true;
            // The process may still be alive: make sure it will not act (click) after we gave up.
            // The .cancel marker stays; the script itself is removed so a late start cannot run it.
            job.cancel();
            job.finished = true;
            delete activePsJobs[base];
            deleteFileQuietly(ps1);
            if (!job.detached) {
                onDone(false, notStarted ? "PowerShellが動き出さなかった（制限モードやセキュリティ設定の可能性）" : "PowerShellの応答が" + timeoutSec + "秒以内に返ってこなかった");
            }
            return;
        }
        later(poll, 200);
    }
    job.poll = poll;
    later(poll, 300);
    return job;
}

function buildUiaClickScript(name, windowHint) {
    return [
        "Add-Type -AssemblyName UIAutomationClient",
        "Add-Type -AssemblyName UIAutomationTypes",
        "$AE = [System.Windows.Automation.AutomationElement]",
        "$targetName = " + psQuote(name),
        "$windowHint = " + psQuote(windowHint || ""),
        "$cond = New-Object System.Windows.Automation.PropertyCondition($AE::NameProperty, $targetName)",
        "$scopes = New-Object System.Collections.ArrayList",
        "$focused = $null",
        "try { $focused = $AE::FocusedElement } catch { $focused = $null }",
        "if ($focused -ne $null) {",
        "    $walker = [System.Windows.Automation.TreeWalker]::ControlViewWalker",
        "    $node = $focused",
        "    $top = $focused",
        "    while ($node -ne $null -and -not [System.Windows.Automation.Automation]::Compare($node, $AE::RootElement)) {",
        "        $top = $node",
        "        $node = $walker.GetParent($node)",
        "    }",
        "    [void]$scopes.Add($top)",
        "}",
        "if ($windowHint -ne '') {",
        "    $wins = $AE::RootElement.FindAll([System.Windows.Automation.TreeScope]::Children, [System.Windows.Automation.Condition]::TrueCondition)",
        "    foreach ($w in $wins) {",
        "        $wn = $w.Current.Name",
        "        if ($wn -ne $null -and $wn.Contains($windowHint)) { [void]$scopes.Add($w) }",
        "    }",
        "}",
        "$el = $null",
        "foreach ($s in $scopes) {",
        "    $el = $s.FindFirst([System.Windows.Automation.TreeScope]::Descendants, $cond)",
        "    if ($el -ne $null) { break }",
        "}",
        "if (Test-FujiCancel) {",
        "    Set-FujiResult 'NG:停止されたので押さなかった'",
        "} elseif ($el -eq $null) {",
        "    Set-FujiResult ('NG:「' + $targetName + '」という名前のオブジェクトが見つからなかった')",
        "} else {",
        "    $p = $null",
        // Result is written BEFORE Invoke: a button that opens a modal dialog can block Invoke() until it closes
        "    if ($el.TryGetCurrentPattern([System.Windows.Automation.InvokePattern]::Pattern, [ref]$p)) { Set-FujiResult 'OK:Invoke'; $p.Invoke() }",
        "    elseif ($el.TryGetCurrentPattern([System.Windows.Automation.TogglePattern]::Pattern, [ref]$p)) { Set-FujiResult 'OK:Toggle'; $p.Toggle() }",
        "    elseif ($el.TryGetCurrentPattern([System.Windows.Automation.SelectionItemPattern]::Pattern, [ref]$p)) { Set-FujiResult 'OK:Select'; $p.Select() }",
        "    elseif ($el.TryGetCurrentPattern([System.Windows.Automation.ExpandCollapsePattern]::Pattern, [ref]$p)) { Set-FujiResult 'OK:Expand'; $p.Expand() }",
        "    else { Set-FujiResult 'NG:見つけたけど押下(Invoke)に対応していないオブジェクトだった' }",
        "}"
    ];
}

function buildClickPosScript(x, y, kind) {
    var down = kind === "RIGHT" ? "0x0008" : "0x0002";
    var up = kind === "RIGHT" ? "0x0010" : "0x0004";
    return [
        "Add-Type -TypeDefinition @\"",
        "using System;",
        "using System.Runtime.InteropServices;",
        "public static class FujiMouse {",
        "    [DllImport(\"user32.dll\")] public static extern bool SetProcessDPIAware();",
        "    [DllImport(\"user32.dll\")] public static extern bool SetCursorPos(int x, int y);",
        "    [DllImport(\"user32.dll\")] public static extern void mouse_event(uint dwFlags, uint dx, uint dy, uint dwData, UIntPtr dwExtraInfo);",
        "}",
        "\"@",
        "[void][FujiMouse]::SetProcessDPIAware()",
        "if (Test-FujiCancel) {",
        "    Set-FujiResult 'NG:停止されたのでクリックしなかった'",
        "} else {",
        "    [void][FujiMouse]::SetCursorPos(" + x + ", " + y + ")",
        "    Start-Sleep -Milliseconds 80",
        "    [FujiMouse]::mouse_event(" + down + ", 0, 0, 0, [UIntPtr]::Zero)",
        "    Start-Sleep -Milliseconds 40",
        "    [FujiMouse]::mouse_event(" + up + ", 0, 0, 0, [UIntPtr]::Zero)",
        kind === "DOUBLE" ? "    Start-Sleep -Milliseconds 60; [FujiMouse]::mouse_event(0x0002, 0, 0, 0, [UIntPtr]::Zero); Start-Sleep -Milliseconds 40; [FujiMouse]::mouse_event(0x0004, 0, 0, 0, [UIntPtr]::Zero)" : "",
        "    Set-FujiResult 'OK'",
        "}"
    ];
}

// C# template matcher on System.Drawing.Bitmap (compiled on the fly by Add-Type; no Python/OpenCV)
function imageEngineScript() {
    return [
        "Add-Type -AssemblyName System.Drawing",
        "Add-Type -ReferencedAssemblies System.Drawing -TypeDefinition @\"",
        "using System;",
        "using System.Collections.Generic;",
        "using System.Drawing;",
        "using System.Drawing.Imaging;",
        "using System.Runtime.InteropServices;",
        "public struct FujiImagePoint { public int X; public int Y; }",
        "public struct FujiImageRect { public int Left; public int Top; public int Right; public int Bottom; }",
        "public static class FujiImage {",
        "    [DllImport(\"user32.dll\")] public static extern bool SetProcessDPIAware();",
        "    [DllImport(\"user32.dll\")] public static extern int GetSystemMetrics(int index);",
        "    [DllImport(\"user32.dll\")] public static extern bool GetCursorPos(out FujiImagePoint p);",
        "    [DllImport(\"user32.dll\")] public static extern bool SetCursorPos(int x, int y);",
        "    [DllImport(\"user32.dll\")] public static extern void mouse_event(uint dwFlags, uint dx, uint dy, uint dwData, UIntPtr dwExtraInfo);",
        "    [DllImport(\"user32.dll\")] public static extern IntPtr GetForegroundWindow();",
        "    [DllImport(\"user32.dll\")] public static extern bool GetWindowRect(IntPtr hWnd, out FujiImageRect r);",
        "    static int[] ReadPixels(Bitmap bmp) {",
        "        int w = bmp.Width, h = bmp.Height;",
        "        int[] px = new int[w * h];",
        "        BitmapData d = bmp.LockBits(new Rectangle(0, 0, w, h), ImageLockMode.ReadOnly, PixelFormat.Format32bppArgb);",
        "        try {",
        "            for (int y = 0; y < h; y++) {",
        "                Marshal.Copy(new IntPtr(d.Scan0.ToInt64() + (long)y * d.Stride), px, y * w, w);",
        "            }",
        "        } finally {",
        "            bmp.UnlockBits(d);",
        "        }",
        "        return px;",
        "    }",
        "    static bool Near(int a, int b, int tol) {",
        "        int d = ((a >> 16) & 255) - ((b >> 16) & 255);",
        "        if (d > tol || d < -tol) { return false; }",
        "        d = ((a >> 8) & 255) - ((b >> 8) & 255);",
        "        if (d > tol || d < -tol) { return false; }",
        "        d = (a & 255) - (b & 255);",
        "        return d <= tol && d >= -tol;",
        "    }",
        "    static Bitmap CaptureRect(int x, int y, int w, int h) {",
        "        Bitmap bmp = new Bitmap(w, h, PixelFormat.Format32bppArgb);",
        "        using (Graphics g = Graphics.FromImage(bmp)) {",
        "            g.CopyFromScreen(x, y, 0, 0, new Size(w, h), CopyPixelOperation.SourceCopy);",
        "        }",
        "        return bmp;",
        "    }",
        // Returns "centerX,centerY,score(0-1000)" in screen coordinates, or "" when nothing reaches the threshold
        "    public static string Find(string path, double threshold, int tol, int maxMillis) {",
        "        System.Diagnostics.Stopwatch watch = System.Diagnostics.Stopwatch.StartNew();",
        "        int tw, th;",
        "        int[] tpx;",
        "        using (Bitmap src = new Bitmap(path)) {",
        "            tw = src.Width;",
        "            th = src.Height;",
        "            tpx = ReadPixels(src);",
        "        }",
        "        int left = GetSystemMetrics(76), top = GetSystemMetrics(77);",
        "        int sw = GetSystemMetrics(78), sh = GetSystemMetrics(79);",
        "        if (tw > sw || th > sh) { return \"\"; }",
        "        List<int> offList = new List<int>();",
        "        List<int> colList = new List<int>();",
        "        for (int ty = 0; ty < th; ty++) {",
        "            for (int tx = 0; tx < tw; tx++) {",
        "                int c = tpx[ty * tw + tx];",
        "                if (((c >> 24) & 255) < 128) { continue; }",
        "                offList.Add(ty * sw + tx);",
        "                colList.Add(c);",
        "            }",
        "        }",
        "        int n = offList.Count;",
        "        if (n == 0) { return \"\"; }",
        "        int[] off = offList.ToArray();",
        "        int[] col = colList.ToArray();",
        // Shuffle the pixel order so that wrong positions are rejected after only a few comparisons
        "        Random rnd = new Random(20240601);",
        "        for (int i = n - 1; i > 0; i--) {",
        "            int j = rnd.Next(i + 1);",
        "            int t = off[i]; off[i] = off[j]; off[j] = t;",
        "            t = col[i]; col[i] = col[j]; col[j] = t;",
        "        }",
        "        int[] spx;",
        "        using (Bitmap screen = CaptureRect(left, top, sw, sh)) {",
        "            spx = ReadPixels(screen);",
        "        }",
        "        int sampleN = Math.Min(n, 64);",
        "        int sampleAllowed = Math.Min(sampleN - 1, (int)Math.Floor((1.0 - threshold) * sampleN * 2.0 + 1e-9) + 1);",
        "        int allowed = (int)Math.Floor((1.0 - threshold) * n + 1e-9);",
        "        int bestMiss = allowed + 1, bestX = -1, bestY = -1;",
        "        for (int y = 0; y <= sh - th && bestMiss > 0; y++) {",
        "            if (watch.ElapsedMilliseconds > maxMillis) { if (bestX >= 0) { break; } return \"TIMEOUT\"; }",
        "            int row = y * sw;",
        "            for (int x = 0; x <= sw - tw; x++) {",
        "                int b = row + x;",
        "                int miss = 0;",
        "                int k;",
        "                for (k = 0; k < sampleN; k++) {",
        "                    if (!Near(spx[b + off[k]], col[k], tol) && ++miss > sampleAllowed) { break; }",
        "                }",
        "                if (miss > sampleAllowed) { continue; }",
        "                int limit = bestMiss - 1;",
        "                miss = 0;",
        "                for (k = 0; k < n; k++) {",
        "                    if (!Near(spx[b + off[k]], col[k], tol) && ++miss > limit) { break; }",
        "                }",
        "                if (miss <= limit) {",
        "                    bestMiss = miss;",
        "                    bestX = x;",
        "                    bestY = y;",
        "                    if (miss == 0) { break; }",
        "                }",
        "            }",
        "        }",
        "        if (bestX < 0) { return \"\"; }",
        "        int score = (int)Math.Round((1.0 - (double)bestMiss / n) * 1000.0);",
        "        return (left + bestX + tw / 2) + \",\" + (top + bestY + th / 2) + \",\" + score;",
        "    }",
        "    public static void Click(int x, int y) {",
        "        SetCursorPos(x, y);",
        "        System.Threading.Thread.Sleep(80);",
        "        mouse_event(0x0002, 0, 0, 0, UIntPtr.Zero);",
        "        System.Threading.Thread.Sleep(40);",
        "        mouse_event(0x0004, 0, 0, 0, UIntPtr.Zero);",
        "    }",
        "    public static string CaptureAroundCursor(string savePath, int w, int h) {",
        "        FujiImagePoint p;",
        "        GetCursorPos(out p);",
        // Keep the rectangle on the desktop (off-screen parts would be saved as black pixels that never
        // match) and keep the cursor at its centre (CLICK_IMG clicks the centre of the match): near an
        // edge the rectangle shrinks symmetrically instead of sliding away from the cursor
        "        int left = GetSystemMetrics(76), top = GetSystemMetrics(77);",
        "        int sw = GetSystemMetrics(78), sh = GetSystemMetrics(79);",
        "        int hw = Math.Max(1, Math.Min(w / 2, Math.Min(p.X - left, left + sw - 1 - p.X)));",
        "        int hh = Math.Max(1, Math.Min(h / 2, Math.Min(p.Y - top, top + sh - 1 - p.Y)));",
        "        using (Bitmap bmp = CaptureRect(p.X - hw, p.Y - hh, hw * 2, hh * 2)) {",
        "            bmp.Save(savePath, ImageFormat.Png);",
        "        }",
        "        return p.X + \",\" + p.Y + \",\" + (hw * 2) + \",\" + (hh * 2);",
        "    }",
        "    public static string ScreenRect() {",
        "        return GetSystemMetrics(76) + \",\" + GetSystemMetrics(77) + \",\" + GetSystemMetrics(78) + \",\" + GetSystemMetrics(79);",
        "    }",
        "    public static string ForegroundRect() {",
        "        FujiImageRect r;",
        "        IntPtr hWnd = GetForegroundWindow();",
        "        if (hWnd != IntPtr.Zero && GetWindowRect(hWnd, out r) && r.Right > r.Left && r.Bottom > r.Top) {",
        "            return r.Left + \",\" + r.Top + \",\" + (r.Right - r.Left) + \",\" + (r.Bottom - r.Top);",
        "        }",
        "        return ScreenRect();",
        "    }",
        // Region enlarged (or shrunk) by `scale` so small text is readable by OCR
        "    public static void SaveRegion(string savePath, int x, int y, int w, int h, double scale) {",
        "        using (Bitmap src = CaptureRect(x, y, w, h)) {",
        "            int dw = Math.Max(1, (int)(w * scale)), dh = Math.Max(1, (int)(h * scale));",
        "            using (Bitmap dst = new Bitmap(dw, dh, PixelFormat.Format32bppArgb)) {",
        "                using (Graphics g = Graphics.FromImage(dst)) {",
        "                    g.InterpolationMode = System.Drawing.Drawing2D.InterpolationMode.HighQualityBicubic;",
        "                    g.DrawImage(src, 0, 0, dw, dh);",
        "                }",
        "                dst.Save(savePath, ImageFormat.Png);",
        "            }",
        "        }",
        "    }",
        "    public static string SaveScreenshot(string savePath, bool activeWindowOnly) {",
        "        int x = GetSystemMetrics(76), y = GetSystemMetrics(77);",
        "        int w = GetSystemMetrics(78), h = GetSystemMetrics(79);",
        "        if (activeWindowOnly) {",
        "            FujiImageRect r;",
        "            IntPtr hWnd = GetForegroundWindow();",
        "            if (hWnd != IntPtr.Zero && GetWindowRect(hWnd, out r) && r.Right > r.Left && r.Bottom > r.Top) {",
        "                x = r.Left; y = r.Top; w = r.Right - r.Left; h = r.Bottom - r.Top;",
        "            }",
        "        }",
        "        using (Bitmap bmp = CaptureRect(x, y, w, h)) {",
        "            bmp.Save(savePath, ImageFormat.Png);",
        "        }",
        "        return w + \"x\" + h;",
        "    }",
        "}",
        "\"@",
        // Physical pixels for both the screenshot and SetCursorPos (high-DPI safe)
        "[void][FujiImage]::SetProcessDPIAware()"
    ];
}

function buildClickImgScript(path, threshold) {
    return imageEngineScript().concat([
        "$imgPath = " + psQuote(path),
        "if (-not (Test-Path -LiteralPath $imgPath)) { throw ('参照画像が見つからない: ' + $imgPath) }",
        // Own deadline (shorter than the HTA's timeout, which also leaves room for Add-Type)
        "$deadline = (Get-Date).AddSeconds(" + IMG_SEARCH_DEADLINE_SEC + ")",
        "$found = ''",
        "for ($i = 0; $i -lt " + IMG_SEARCH_RETRY + "; $i++) {",
        "    if (Test-FujiCancel) { break }",
        "    $left = [int](($deadline - (Get-Date)).TotalMilliseconds)",
        "    if ($left -le 0) { $found = 'TIMEOUT'; break }",
        "    $found = [FujiImage]::Find($imgPath, " + threshold + ", " + IMG_COLOR_TOLERANCE + ", $left)",
        "    if ($found -ne '') { break }",
        "    Start-Sleep -Milliseconds 1000",
        "}",
        "if (Test-FujiCancel) {",
        "    Set-FujiResult 'NG:停止されたのでクリックしなかった'",
        "} elseif ($found -eq 'TIMEOUT') {",
        "    Set-FujiResult 'NG:画像を探すのに時間がかかりすぎたから中止した（画像を小さく切り取り直すか、しきい値を上げてみてね）'",
        "} elseif ($found -eq '') {",
        "    Set-FujiResult ('NG:画面内に一致率" + Math.round(threshold * 100) + "%以上の場所が見つからなかった（" + IMG_SEARCH_RETRY + "回探索）')",
        "} else {",
        "    $p = $found.Split(',')",
        "    [FujiImage]::Click([int]$p[0], [int]$p[1])",
        "    Set-FujiResult ('OK:' + $found)",
        "}"
    ]);
}

function buildScreenshotScript(savePath, fullScreen) {
    return imageEngineScript().concat([
        "$size = [FujiImage]::SaveScreenshot(" + psQuote(savePath) + ", $" + (fullScreen ? "false" : "true") + ")",
        "Set-FujiResult ('OK:' + $size)"
    ]);
}

function buildImageCaptureScript(savePath, w, h) {
    return imageEngineScript().concat([
        "Start-Sleep -Seconds 5",
        "$pos = [FujiImage]::CaptureAroundCursor(" + psQuote(savePath) + ", " + w + ", " + h + ")",
        "Set-FujiResult ('OK:' + $pos)"
    ]);
}

// ----- OCR (Windows.Media.Ocr, offline)
// The region is captured by the image engine, enlarged for small text, and recognised by the OCR
// engine that ships with Windows for the user's languages. Lines come back as "text<TAB>x<TAB>y<TAB>w<TAB>h".
function ocrScript(p, rs, findText, nth) {
    var area = p.area || "WINDOW";
    var rect = area === "RECT" ? [p.x, p.y, p.w, p.h].map(function (s) { return toInt(toHalfWidthDigits(s), 0); }).join(",") : "";
    return imageEngineScript().concat([
        "Add-Type -AssemblyName System.Runtime.WindowsRuntime",
        "$asTask = ([System.WindowsRuntimeSystemExtensions].GetMethods() | Where-Object { $_.Name -eq 'AsTask' -and $_.GetParameters().Count -eq 1 -and $_.GetParameters()[0].ParameterType.Name -eq 'IAsyncOperation`1' })[0]",
        "function Wait-Fuji($op, [Type]$type) { $t = $asTask.MakeGenericMethod($type).Invoke($null, @($op)); [void]$t.Wait(-1); $t.Result }",
        "$null = [Windows.Storage.StorageFile, Windows.Storage, ContentType = WindowsRuntime]",
        "$null = [Windows.Media.Ocr.OcrEngine, Windows.Foundation, ContentType = WindowsRuntime]",
        "$null = [Windows.Graphics.Imaging.BitmapDecoder, Windows.Graphics, ContentType = WindowsRuntime]",
        "$null = [Windows.Storage.Streams.IRandomAccessStream, Windows.Storage.Streams, ContentType = WindowsRuntime]",
        "$engine = [Windows.Media.Ocr.OcrEngine]::TryCreateFromUserProfileLanguages()",
        "if ($engine -eq $null) { throw 'Windowsの文字認識（OCR）に使える言語が入っていない' }",
        "function Join-FujiWords($words) {",
        "    $s = ''; $prev = ''",
        "    foreach ($w in $words) {",
        "        $t = $w.Text",
        "        if ($s -ne '' -and -not ($prev -match '[^\\x00-\\x7F]$' -and $t -match '^[^\\x00-\\x7F]')) { $s += ' ' }",
        "        $s += $t; $prev = $t",
        "    }",
        "    $s",
        "}",
        "function Get-FujiNorm([string]$s) {",
        "    $s = [regex]::Replace($s, '[\\uFF01-\\uFF5E]', { param($m) [string][char]([int][char]$m.Value - 0xFEE0) })",
        "    $s -replace '[\\s\\u3000]', ''",
        "}",
        "function Read-FujiScreen {",
        "    $area = " + psQuote(area),
        "    if ($area -eq 'RECT') { $r = " + psQuote(rect) + " } elseif ($area -eq 'FULL') { $r = [FujiImage]::ScreenRect() } else { $r = [FujiImage]::ForegroundRect() }",
        "    $q = $r.Split(',') | ForEach-Object { [int]$_ }",
        "    $max = [Windows.Media.Ocr.OcrEngine]::MaxImageDimension",
        "    $scale = [Math]::Min(2.0, $max / [Math]::Max($q[2], $q[3]))",
        "    $png = $fujiResultPath + '.ocr.png'",
        "    [FujiImage]::SaveRegion($png, $q[0], $q[1], $q[2], $q[3], $scale)",
        "    $file = Wait-Fuji ([Windows.Storage.StorageFile]::GetFileFromPathAsync($png)) ([Windows.Storage.StorageFile])",
        "    $stream = Wait-Fuji ($file.OpenAsync([Windows.Storage.FileAccessMode]::Read)) ([Windows.Storage.Streams.IRandomAccessStream])",
        "    $decoder = Wait-Fuji ([Windows.Graphics.Imaging.BitmapDecoder]::CreateAsync($stream)) ([Windows.Graphics.Imaging.BitmapDecoder])",
        "    $bmp = Wait-Fuji ($decoder.GetSoftwareBitmapAsync()) ([Windows.Graphics.Imaging.SoftwareBitmap])",
        "    $res = Wait-Fuji ($engine.RecognizeAsync($bmp)) ([Windows.Media.Ocr.OcrResult])",
        "    $stream.Dispose()",
        "    Remove-Item -LiteralPath $png -ErrorAction SilentlyContinue",
        "    @{ Result = $res; X = $q[0]; Y = $q[1]; Scale = $scale }",
        "}"
    ]).concat(findText === null ? [
        "$o = Read-FujiScreen",
        "$text = ($o.Result.Lines | ForEach-Object { Join-FujiWords $_.Words }) -join \"`r`n\"",
        "Set-FujiResult ('OK:' + $text)"
    ] : [
        "$target = Get-FujiNorm " + psQuote(findText),
        "$nth = " + nth,
        "$hit = $null",
        "for ($try = 0; $try -lt " + OCR_RETRY + " -and $hit -eq $null; $try++) {",
        "    if (Test-FujiCancel) { break }",
        "    if ($try -gt 0) { Start-Sleep -Milliseconds 1000 }",
        "    $o = Read-FujiScreen",
        "    $found = 0",
        "    foreach ($line in $o.Result.Lines) {",
        "        $chars = ''; $owner = New-Object System.Collections.ArrayList",
        "        for ($k = 0; $k -lt $line.Words.Count; $k++) {",
        "            $wt = Get-FujiNorm $line.Words[$k].Text",
        "            $chars += $wt",
        "            for ($c = 0; $c -lt $wt.Length; $c++) { [void]$owner.Add($k) }",
        "        }",
        "        $pos = $chars.IndexOf($target)",
        "        while ($pos -ge 0 -and $hit -eq $null) {",
        "            $found++",
        "            if ($found -eq $nth) {",
        "                $first = $owner[$pos]; $last = $owner[$pos + $target.Length - 1]",
        "                $l = 1e9; $t = 1e9; $r = -1e9; $b = -1e9",
        "                for ($k = $first; $k -le $last; $k++) {",
        "                    $br = $line.Words[$k].BoundingRect",
        "                    $l = [Math]::Min($l, $br.X); $t = [Math]::Min($t, $br.Y); $r = [Math]::Max($r, $br.X + $br.Width); $b = [Math]::Max($b, $br.Y + $br.Height)",
        "                }",
        "                $hit = @([int]($o.X + ($l + $r) / 2 / $o.Scale), [int]($o.Y + ($t + $b) / 2 / $o.Scale))",
        "            }",
        "            $pos = $chars.IndexOf($target, $pos + 1)",
        "        }",
        "        if ($hit -ne $null) { break }",
        "    }",
        "}",
        "if (Test-FujiCancel) {",
        "    Set-FujiResult 'NG:停止されたのでクリックしなかった'",
        "} elseif ($hit -eq $null) {",
        "    Set-FujiResult ('NG:画面に「' + " + psQuote(findText) + " + '」の文字が見つからなかった（" + OCR_RETRY + "回探索）')",
        "} else {",
        "    [FujiImage]::Click($hit[0], $hit[1])",
        "    Set-FujiResult ('OK:' + $hit[0] + ',' + $hit[1])",
        "}"
    ]);
}

// =====================================================================
//  Alarm
// =====================================================================
function playAlarm(force) {
    if (!force && !byId("alarmCheck").checked) {
        return;
    }
    if (!shell) {
        log("ActiveXが使えないのでアラームを鳴らせないキュン…", "error");
        return;
    }
    log("🔔 アラームを鳴らすキュン！", "warn");
    if (psLastFailed || psLaunchBlocked) {
        playAlarmFallback();
        return;
    }
    // 1st choice (spec): PowerShell SoundPlayer. 'OK' is reported once the WAV is loaded, then it plays 3 times.
    runPowerShellAsync([
        "$wav = " + psQuote(ALARM_WAV_PATH),
        "if (-not (Test-Path -LiteralPath $wav)) { throw ('WAVファイルが無い: ' + $wav) }",
        "$player = New-Object System.Media.SoundPlayer $wav",
        "$player.Load()",
        "Set-FujiResult 'OK'",
        "for ($i = 0; $i -lt 3; $i++) { $player.PlaySync() }"
    ], 15, function (ok, payload) {
        if (!ok) {
            log("PowerShellでは鳴らせなかったから、別の方法で鳴らすね（" + payload + "）", "warn");
            playAlarmFallback();
        }
    });
}

// Fallbacks that need no child process: Windows Media Player control, then speech
function playAlarmFallback() {
    try {
        if (!alarmPlayer) {
            alarmPlayer = new ActiveXObject("WMPlayer.OCX");
        }
        alarmPlayer.settings.volume = 100;
        alarmPlayer.settings.playCount = 3;
        alarmPlayer.URL = ALARM_WAV_PATH;
        alarmPlayer.controls.play();
        log("🔔 Windows Media Player部品でアラームを鳴らしたキュン", "warn");
        return;
    } catch (e1) {
        log("WMPlayer.OCX も使えなかった（" + errorText(e1) + "）", "warn");
    }
    try {
        if (!alarmVoice) {
            alarmVoice = new ActiveXObject("SAPI.SpVoice");
        }
        alarmVoice.Volume = 100;
        alarmVoice.Speak("エラーが発生しました。ロボットを停止しました。確認してください。", 1); // 1 = SVSFlagsAsync
        log("🔔 音声でお知らせしたキュン", "warn");
        return;
    } catch (e2) {
        log("音声合成も使えなかった（" + errorText(e2) + "）", "warn");
    }
    log("🚨 この端末では音を鳴らす方法が見つからなかったキュン…🩺環境チェックで原因を確認してね", "error");
}

function playNotify() {
    if (!byId("notifyCheck").checked) {
        return;
    }
    try {
        if (!notifyPlayer) {
            notifyPlayer = new ActiveXObject("WMPlayer.OCX");
        }
        notifyPlayer.settings.volume = 80;
        notifyPlayer.URL = NOTIFY_WAV_PATH;
        notifyPlayer.controls.play();
    } catch (e) {
        /* the completion sound is a nicety; silence is fine */
    }
}

// =====================================================================
//  Environment diagnostics
// =====================================================================
function runDiagnostics() {
    var items = [];
    var hints = [];
    function add(ok, name, detail) {
        items.push({ ok: ok, name: name, detail: detail || "" });
    }
    function tryActiveX(progId, name) {
        try {
            new ActiveXObject(progId);
            add(true, name, progId);
            return true;
        } catch (e) {
            add(false, name, progId + " … " + errorText(e));
            return false;
        }
    }
    add(!!shell, "WScript.Shell（キー送信・起動）", shell ? "OK" : "作成できない");
    add(!!fso, "FileSystemObject（ファイル読み書き）", fso ? "OK" : "作成できない");
    if (!shell || !fso) {
        hints.push("ActiveXが使えないよ。.hta をダブルクリックしてHTAとして起動してね（ブラウザで開くと動かない）。");
    }
    tryActiveX("ADODB.Stream", "ADODB.Stream（UTF-8の読み書き）");
    if (fso && appDir) {
        try {
            var testPath = appFilePath("_fujikyun_write_test.tmp");
            writeTextFile(testPath, "test", false);
            fso.DeleteFile(testPath, true);
            add(true, "作業フォルダへの書き込み", appDir);
        } catch (e1) {
            add(false, "作業フォルダへの書き込み", appDir + " … " + errorText(e1));
            hints.push("HTAのあるフォルダに書き込めないよ。デスクトップやドキュメントなど、書き込めるフォルダにHTAを置いてね。");
        }
    }
    try {
        window.clipboardData.setData("Text", "fujikyun");
        var clip = window.clipboardData.getData("Text");
        add(clip === "fujikyun", "クリップボード（TEXT・CSV・COPY）", clip === "fujikyun" ? "OK" : "読み書きの結果が一致しない");
    } catch (e2) {
        add(false, "クリップボード（TEXT・CSV・COPY）", errorText(e2));
    }
    add(!!(fso && fso.FileExists(ALARM_WAV_PATH)), "アラーム音ファイル", ALARM_WAV_PATH);
    var wmpOk = tryActiveX("WMPlayer.OCX", "Windows Media Player部品（音の予備手段）");
    var sapiOk = tryActiveX("SAPI.SpVoice", "音声合成（音の予備手段）");
    try {
        shell.RegRead("HKCR\\Outlook.Application\\CLSID\\");
        add(true, "Outlook（メールの Outlook 送信）", "Outlook.Application が登録されている");
    } catch (eOl) {
        add(false, "Outlook（メールの Outlook 送信）", "見つからない（SMTP か mailto を使ってね）");
    }
    try {
        // Starting Excel launches EXCEL.EXE: quit it right away
        var xl = new ActiveXObject("Excel.Application");
        add(true, "Excel（EXCEL_READ・EXCEL_WRITE）", "Excel.Application " + xl.Version);
        xl.Quit();
    } catch (eXl) {
        add(false, "Excel（EXCEL_READ・EXCEL_WRITE）", "Excel.Application … " + errorText(eXl));
    }
    if (!wmpOk && !sapiOk) {
        hints.push("PowerShellが使えない場合、アラームを鳴らす予備手段がないよ。画面のログで異常を確認してね。");
    }
    if (shell && fso) {
        // Start from scratch: a remembered launch route may be stale (folder copied, policy changed)
        psLaunchBlocked = false;
        psLastFailed = false;
        psLangRestricted = false;
        psPreferredLaunch = null;
        saveSettings();
        var exes = powershellCandidates();
        add(exes.length > 1, "PowerShell本体", exes.join(" ／ "));
        add(true, "HTA（mshta.exe）の種類", fso.FolderExists(expandEnv("%SystemRoot%\\Sysnative")) ? "32ビット版で動作中" : "64ビット版で動作中");
        try {
            shell.Run(quoteExe(expandEnv("%ComSpec%")) + " /c exit", 0, false);
            add(true, "プログラムの起動（WScript.Shell.Run）", "cmd.exe を起動できた");
        } catch (eRun) {
            add(false, "プログラムの起動（WScript.Shell.Run）", "cmd.exe … " + errorText(eRun));
            hints.push("WScript.Shell.Run でプログラムを起動できないよ（" + errorText(eRun) + "）。ウイルス対策・EDRなどのセキュリティ製品や組織のポリシーが、HTA（mshta.exe）からのプログラム起動を止めている可能性があるキュン。\n" +
                "→ ふじキュンは Exec・ShellExecute でも起動を試すよ。下の「PowerShellの起動・実行」の結果を見てね。\n" +
                "→ RUN コマンドも ShellExecute で代わりに起動を試すよ。");
        }
    }
    var pendingToken = showDiagnostics(items, hints, "⏳ PowerShellで使える機能を確認中…（最大80秒）");
    if (!shell || !fso) {
        showDiagnostics(items, hints, "");
        return;
    }
    runPowerShellAsync([
        "$lines = New-Object System.Collections.ArrayList",
        "[void]$lines.Add('PSVERSION=' + $PSVersionTable.PSVersion.ToString())",
        "[void]$lines.Add('LANGMODE=' + $ExecutionContext.SessionState.LanguageMode)",
        "try { Add-Type -AssemblyName UIAutomationClient; Add-Type -AssemblyName UIAutomationTypes; [void]$lines.Add('UIA=OK') } catch { [void]$lines.Add('UIA=NG ' + $_.Exception.Message) }",
        "try { Add-Type -AssemblyName System.Drawing; [void]$lines.Add('DRAWING=OK') } catch { [void]$lines.Add('DRAWING=NG ' + $_.Exception.Message) }",
        "try { Add-Type -TypeDefinition 'public static class FujiDiag { public static int Two() { return 2; } }'; [void]$lines.Add('CSHARP=OK ' + [FujiDiag]::Two()) } catch { [void]$lines.Add('CSHARP=NG ' + $_.Exception.Message) }",
        "try { $p = New-Object System.Media.SoundPlayer; [void]$lines.Add('SOUND=OK') } catch { [void]$lines.Add('SOUND=NG ' + $_.Exception.Message) }",
        "try { Add-Type -AssemblyName System.Runtime.WindowsRuntime; $null = [Windows.Media.Ocr.OcrEngine, Windows.Foundation, ContentType = WindowsRuntime]; $oe = [Windows.Media.Ocr.OcrEngine]::TryCreateFromUserProfileLanguages(); if ($oe -eq $null) { [void]$lines.Add('OCR=NG 文字認識の言語が入っていない') } else { [void]$lines.Add('OCR=OK ' + $oe.RecognizerLanguage.DisplayName) } } catch { [void]$lines.Add('OCR=NG ' + $_.Exception.Message) }",
        "Set-FujiResult ('OK:' + ($lines -join \"`n\"))"
    ], 60, function (ok, payload) {
        if (!ok) {
            add(false, "PowerShellの起動・実行", payload);
            hints.push("PowerShellが起動できない／結果を返せないよ。グループポリシーやAppLockerでPowerShellが止められている可能性があるキュン。\n" +
                "→ 使えなくなる機能: CLICK_NAME・CLICK_TEXT・CLICK_IMG・CLICK_POS・READ_TEXT・SCREENSHOT・MAIL(SMTP)・座標/画像の取得・ウィンドウ一覧・記録・アラーム(PowerShell版)\n" +
                "→ 使える機能: KEY・TEXT・CSV・COPY・WAIT・WAIT_FOR・WINDOW_CHECK・CONFIRM・SWITCH・RUN・流れ・変数（キーボード操作中心のマクロは大丈夫）");
            // In ConstrainedLanguage the bootstrap itself ([System.IO.File]) is refused, so ask PowerShell
            // for its language mode with cmdlets only
            probeLanguageMode(function (mode) {
                if (mode) {
                    add(mode === "FullLanguage", "PowerShellの言語モード", mode);
                    psLangRestricted = mode !== "FullLanguage";
                    if (mode !== "FullLanguage") {
                        hints.push("PowerShellが制限モード（" + mode + "）で動いているよ（組織の AppLocker / WDAC の設定）。このモードではふじキュンのPowerShell機能は動かないキュン。キーボード操作（KEY・TEXT・CSV）中心で組んでね。");
                    }
                }
                finishDiagnostics(items, hints, pendingToken);
            });
            return;
        }
        var map = {};
        var lines = String(payload).split(/\r?\n/);
        for (var i = 0; i < lines.length; i++) {
            var pos = lines[i].indexOf("=");
            if (pos > 0) {
                map[lines[i].substring(0, pos)] = lines[i].substring(pos + 1);
            }
        }
        add(true, "PowerShellの起動・実行", "バージョン " + (map.PSVERSION || "?") +
            (psPreferredLaunch ? " ／ 起動方法: " + launchDescription(psPreferredLaunch) : ""));
        if (psPreferredLaunch && psPreferredLaunch.method === "exec") {
            hints.push("PowerShellは Exec で起動しているので、実行のたびに黒い画面が一瞬出るよ。入力先のウィンドウがずれて見えたら、クリック系の前に SWITCH を入れておくと安心だキュン。");
        }
        add(map.LANGMODE === "FullLanguage", "PowerShellの言語モード", map.LANGMODE || "?");
        psLangRestricted = !!map.LANGMODE && map.LANGMODE !== "FullLanguage";
        if (map.LANGMODE && map.LANGMODE !== "FullLanguage") {
            hints.push("PowerShellが制限モード（" + map.LANGMODE + "）だよ。C#を使う CLICK_POS・CLICK_IMG・SCREENSHOT は動かない可能性が高いキュン。キーボード操作（KEY・TEXT・CSV）中心で組んでね。");
        }
        add(String(map.UIA).indexOf("OK") === 0, "名前でクリック CLICK_NAME（UIAutomation）", map.UIA || "?");
        add(String(map.DRAWING).indexOf("OK") === 0, "画像処理（System.Drawing）", map.DRAWING || "?");
        add(String(map.CSHARP).indexOf("OK") === 0, "C#のその場コンパイル（CLICK_POS・CLICK_IMG・SCREENSHOT）", map.CSHARP || "?");
        add(String(map.SOUND).indexOf("OK") === 0, "PowerShellでの音再生（アラーム）", map.SOUND || "?");
        add(String(map.OCR).indexOf("OK") === 0, "文字認識（READ_TEXT・CLICK_TEXT）", map.OCR || "?");
        if (String(map.CSHARP).indexOf("OK") !== 0) {
            hints.push("C#のコンパイルができないよ。CLICK_POS・CLICK_IMG・SCREENSHOT・座標/画像の取得が使えないキュン。");
        }
        finishDiagnostics(items, hints, pendingToken);
    });
}

// An asynchronous result may only take over the dialog area when nobody else is using it
// (never on top of a CONFIRM during a run, never over a dialog the user opened meanwhile)
function canOpenAsyncDialog(ownToken) {
    if (runState && runState.confirmOpen) {
        return false;
    }
    return !isModalOpen() || modalToken === ownToken;
}

function logDiagnostics(items) {
    for (var j = 0; j < items.length; j++) {
        log("🩺 " + (items[j].ok ? "OK " : "NG ") + items[j].name + " … " + items[j].detail, items[j].ok ? "info" : "warn");
    }
}

function finishDiagnostics(items, hints, pendingToken) {
    if (canOpenAsyncDialog(pendingToken)) {
        showDiagnostics(items, hints, "");
    } else {
        logDiagnostics(items);
        log("🩺 環境チェックが終わったよ。別の画面が開いていたから、結果はログに出したキュン", "warn");
    }
}

function probeLanguageMode(done) {
    var base = tempFolder() + "\\fujikyun_lang_" + new Date().getTime();
    var out = base + ".txt";
    var marker = base + ".launchfail";
    pendingTempFiles.push(out, marker);
    var args = "-NoProfile -NonInteractive -ExecutionPolicy Bypass -WindowStyle Hidden -Command \"$ExecutionContext.SessionState.LanguageMode | Out-File -FilePath " + psQuote(out) + " -Encoding unicode\"";
    var launcher = createPsLauncher(args, marker);
    if (!launcher.next()) {
        done("");
        return;
    }
    var waited = 0;
    function poll() {
        if (fso.FileExists(out)) {
            var text = "";
            try {
                var ts = fso.OpenTextFile(out, 1, false, -1);
                text = ts.AtEndOfStream ? "" : ts.ReadAll();
                ts.Close();
            } catch (e) {
                text = "";
            }
            text = trimText(text.replace(/^﻿/, ""));
            if (text !== "") {
                deleteFileQuietly(out);
                done(text);
                return;
            }
        }
        if (launcher.current.method === "cmd" && fso.FileExists(marker)) {
            deleteFileQuietly(marker);
            if (!launcher.next()) {
                done("");
                return;
            }
            waited = 0;
        }
        waited += 250;
        if (waited > 20000) {
            done("");
            return;
        }
        setTimeout(poll, 250);
    }
    setTimeout(poll, 300);
}

// Returns the modal token so asynchronous updates can tell whether this dialog is still showing
function showDiagnostics(items, hints, pending) {
    var html = '<div class="form-help">この端末でふじキュンが使える機能を調べたよ♡ ❌ がある機能はこの端末では動かないかも。</div><table class="diag-table">';
    for (var i = 0; i < items.length; i++) {
        html += "<tr><td class=\"" + (items[i].ok ? "diag-ok\">✅ OK" : "diag-ng\">❌ NG") + "</td><td>" + escapeHtml(items[i].name) +
            '</td><td class="form-hint">' + escapeHtml(items[i].detail) + "</td></tr>";
    }
    html += "</table>";
    if (pending) {
        html += '<div class="form-hint" style="margin-top:8px">' + escapeHtml(pending) + "</div>";
    }
    if (hints.length) {
        html += '<div class="diag-hint">' + escapeHtml("💡 " + hints.join("\n\n💡 ")) + "</div>";
    }
    openModal("🩺 環境チェック", html, [
        { text: "結果をログにコピー", fn: function () {
            logDiagnostics(items);
        } },
        { text: "閉じる", cls: "btn-primary", fn: null }
    ], { wide: true });
    return modalToken;
}

// =====================================================================
//  Error rows
// =====================================================================
function recordErrorRow(reason) {
    var rs = runState;
    if (!rs || rs.rowPos >= rs.rows.length) {
        return;
    }
    var row = rs.rows[rs.rowPos];
    if (row.no <= 0 || rs.finalOnly) {
        return; // test run without CSV / the skipped last row was already recorded
    }
    errorRows.push({ no: row.no, data: row.data.slice(0), reason: reason, time: dateTimeText() });
    updateErrorButton();
}

function updateErrorButton() {
    byId("exportErrorBtn").innerHTML = "↓ エラー行をCSV保存 (" + errorRows.length + ")";
}

function exportErrorRows() {
    if (errorRows.length === 0) {
        showMessage("↓ エラー行のCSV保存", "エラー行はまだ無いキュン♡ 平和だね！");
        return;
    }
    if (!fso) {
        log("ActiveXが使えないので保存できないキュン…", "error");
        return;
    }
    var maxCols = 0;
    var i;
    for (i = 0; i < errorRows.length; i++) {
        maxCols = Math.max(maxCols, errorRows[i].data.length);
    }
    var lines = [];
    // Always a heading line (列1.. when the run had none), so re-running it with
    // 「1行目は見出し」 ON finds 元データ行No and never loses the first error row
    var header = runHeader ? runHeader.slice(0) : [];
    maxCols = Math.max(maxCols, header.length);
    while (header.length < maxCols) {
        header.push(runHeader ? "" : "列" + (header.length + 1));
    }
    lines.push(header.concat(["元データ行No", "エラー内容", "発生日時"]).map(toCsvField).join(","));
    for (i = 0; i < errorRows.length; i++) {
        var cols = errorRows[i].data.slice(0);
        while (cols.length < maxCols) {
            cols.push("");
        }
        cols.push(String(errorRows[i].no), errorRows[i].reason, errorRows[i].time);
        lines.push(cols.map(toCsvField).join(","));
    }
    var path = appFilePath(ERROR_FILE_NAME);
    try {
        writeTextFile(path, lines.join("\r\n") + "\r\n", true);
        log("↓ エラー行 " + errorRows.length + "件を「" + path + "」に保存したキュン♡", "ok");
        showChoice("↓ エラー行のCSV保存", "保存したキュン♡\n" + path + "\n\n元データの列はそのままの並びで、右端に「元データ行No・エラー内容・発生日時」を付けたよ。\nこのCSVを読み込めば、エラー行だけ再実行できるキュン。", [
            { text: "📂 フォルダを開く", cls: "btn-primary", fn: function () {
                openFolderSelect(path);
            } },
            { text: "閉じる", fn: null }
        ]);
    } catch (e) {
        log("エラー行CSVの保存に失敗…（" + errorText(e) + "）", "error");
    }
}

// =====================================================================
//  Run results (one record per processed row + values recorded by COPY / RECORD)
// =====================================================================
function beginResultRow(row) {
    var r = { no: row.no, data: row.data.slice(0), values: {}, status: "実行中", note: "", time: dateTimeText() };
    resultRows.push(r);
    updateResultButton();
    return r;
}

function setRowResult(status, note) {
    var r = runState && runState.currentResult;
    if (r && r.status === "実行中") {
        r.status = status;
        r.note = note || "";
    }
}

function addResultValue(name, value) {
    var r = runState && runState.currentResult;
    if (!r) {
        return;
    }
    var known = false;
    for (var i = 0; i < resultColumns.length; i++) {
        if (resultColumns[i] === name) {
            known = true;
        }
    }
    if (!known) {
        resultColumns.push(name);
    }
    r.values[name] = value;
}

function updateResultButton() {
    byId("exportResultBtn").innerHTML = "↓ 実行結果CSV (" + resultRows.length + ")";
}

function exportResultRows() {
    if (resultRows.length === 0) {
        showMessage("↓ 実行結果CSV", "まだ実行結果がないキュン。▶実行すると、1行ごとの結果（完了／スキップ／エラー）と COPY・RECORD で記録した値がたまっていくよ♡");
        return;
    }
    if (!fso) {
        log("ActiveXが使えないので保存できないキュン…", "error");
        return;
    }
    var i;
    var maxCols = runHeader ? runHeader.length : 0;
    for (i = 0; i < resultRows.length; i++) {
        maxCols = Math.max(maxCols, resultRows[i].data.length);
    }
    var header = [];
    for (i = 0; i < maxCols; i++) {
        header.push(runHeader && i < runHeader.length ? runHeader[i] : "列" + (i + 1));
    }
    header = header.concat(resultColumns).concat(["実行結果", "備考", "元データ行No", "開始日時"]);
    var lines = [header.map(toCsvField).join(",")];
    for (i = 0; i < resultRows.length; i++) {
        var r = resultRows[i];
        var cols = r.data.slice(0);
        while (cols.length < maxCols) {
            cols.push("");
        }
        for (var c = 0; c < resultColumns.length; c++) {
            cols.push(r.values.hasOwnProperty(resultColumns[c]) ? r.values[resultColumns[c]] : "");
        }
        cols.push(r.status, r.note, r.no > 0 ? String(r.no) : "テスト", r.time);
        lines.push(cols.map(toCsvField).join(","));
    }
    var path = appFilePath(RESULT_FILE_NAME);
    try {
        writeTextFile(path, lines.join("\r\n") + "\r\n", true);
        log("↓ 実行結果 " + resultRows.length + "件を「" + path + "」に保存したキュン♡", "ok");
        showChoice("↓ 実行結果CSV", "保存したキュン♡\n" + path + "\n\n元データの右に、COPY・RECORD で記録した値・実行結果（完了／スキップ／エラー／中断）・備考を付けたよ。Excelで開いてフィルターすると便利だよ。", [
            { text: "📂 フォルダを開く", cls: "btn-primary", fn: function () {
                openFolderSelect(path);
            } },
            { text: "閉じる", fn: null }
        ]);
    } catch (e) {
        log("実行結果CSVの保存に失敗…（" + errorText(e) + "）", "error");
    }
}

// =====================================================================
//  Macro export / import (share one macro as a JSON file)
// =====================================================================
function exportMacro() {
    var macro = currentMacro();
    if (!macro || !fso || !appDir) {
        log("書き出せないキュン（ActiveXが使えない環境かも）", "error");
        return;
    }
    try {
        var folder = ensureFolder(appFilePath(EXPORT_FOLDER_NAME));
        var stem = folder + "\\" + (safeFileName(macro.name) || "macro");
        var path = stem + ".json";
        for (var n = 2; fso.FileExists(path); n++) {
            path = stem + " (" + n + ").json";
        }
        var json = JSON.stringify({ version: DATA_VERSION, macros: [macro] }, function (key, value) {
            return key === "collapsed" ? undefined : value;
        }, 2);
        writeTextFile(path, json, false);
        log("📤 マクロ「" + macro.name + "」を書き出したキュン: " + path, "ok");
        showChoice("📤 マクロの書き出し", "書き出したキュン♡\n" + path + "\n\nこのファイルを同僚に渡して［📥 取込］してもらえば、同じマクロが使えるよ。", [
            { text: "📂 フォルダを開く", cls: "btn-primary", fn: function () {
                openFolderSelect(path);
            } },
            { text: "閉じる", fn: null }
        ]);
    } catch (e1) {
        log("書き出しに失敗したキュン…（" + errorText(e1) + "）", "error");
    }
}

function importMacroFile(input) {
    var path = input.value || "";
    resetFileInput(input);
    if (guardRunning()) {
        return;
    }
    if (!path || /fakepath/i.test(path) || !fso || !fso.FileExists(path)) {
        log("取り込むファイルのパスが取れなかったキュン…", "warn");
        return;
    }
    var obj = loadJsonFile(path);
    if (!obj) {
        return;
    }
    if (typeof obj.version === "number" && obj.version > DATA_VERSION) {
        showMessage("📥 取り込めないキュン", "このファイルは新しい版のふじキュン（データ版 " + obj.version + "）で作られているよ。\nこの版（データ版 " + DATA_VERSION + "）で取り込むと、知らないコマンドがコメントに変わって動かなくなるから、取り込まなかったよ。");
        return;
    }
    var data = normalizeData(obj);
    if (data.macros.length === 0) {
        log("このファイルにはマクロが入っていなかったキュン: " + path, "warn");
        return;
    }
    for (var i = 0; i < data.macros.length; i++) {
        data.macros[i].id = uniqueMacroId();
        appData.macros.push(data.macros[i]);
    }
    currentMacroIndex = appData.macros.length - 1;
    selectedIndex = -1;
    renderSteps();
    commitChange("マクロ取込: " + data.macros[0].name);
    log("📥 " + data.macros.length + "個のマクロを取り込んだキュン♡（" + path + "）", "ok");
}

// =====================================================================
//  Runner (setTimeout driven state machine)
// =====================================================================
function isRunning() {
    return !!(runState && runState.running);
}

// Single timer per run: pause/stop always take effect before the next action
function schedule(fn, ms) {
    var rs = runState;
    if (!rs || !rs.running) {
        return;
    }
    if (rs.timer) {
        clearTimeout(rs.timer);
    }
    rs.timer = setTimeout(function () {
        rs.timer = null;
        if (runState !== rs || !rs.running) {
            return;
        }
        if (rs.paused) {
            rs.resumeFn = fn;
            return;
        }
        try {
            fn();
        } catch (e) {
            stopWithError("想定外のエラーで止まったキュン…（" + errorText(e) + "）", true);
        }
    }, Math.max(0, ms || 0));
}

function setRunUi(running) {
    byId("runBtn").disabled = running;
    byId("pauseBtn").disabled = !running;
    byId("stopBtn").disabled = !running;
    byId("pauseBtn").innerHTML = "⏸ 一時停止";
    byId("macroSelect").disabled = running;
}

function rowCaption(row) {
    return row.no > 0 ? "データ行 " + row.no : "テスト実行（CSVなし）";
}

function updateProgress(extra) {
    var rs = runState;
    if (!rs) {
        return;
    }
    var row = rs.rows[rs.rowPos];
    var step = rs.steps[rs.stepIndex];
    var text = (rs.paused ? "⏸ 一時停止中: " : "▶ 実行中: ") + (row ? rowCaption(row) : "") +
        "（" + Math.min(rs.rowPos + 1, rs.rows.length) + "/" + rs.rows.length + "件目）";
    if (step) {
        text += " ・ ステップ " + (rs.stepIndex + 1) + "/" + rs.steps.length + " [" + step.cmd + "]";
    }
    byId("progressText").innerHTML = escapeHtml(text + (extra || ""));
}

function clearRunningHighlight() {
    if (runState && runState.highlightEl) {
        removeClass(runState.highlightEl, "running");
        runState.highlightEl = null;
    }
}

function highlightRunning(index) {
    clearRunningHighlight();
    if (!runState || runState.macro !== currentMacro()) {
        return;
    }
    var el = byId("macroContainer").children[index];
    if (el && hasClass(el, "block")) {
        addClass(el, "running");
        runState.highlightEl = el;
        scrollIntoContainer(el);
    }
}

// opts.unattended: started by a schedule, so never ask (a question would wait forever)
function startRun(opts) {
    opts = opts || {};
    if (isRunning()) {
        return;
    }
    if (recState) {
        log("⏺ 記録中は実行できないキュン。先に［⏹ 記録終了］を押してね", "warn");
        return;
    }
    if (!shell) {
        showMessage("実行できないキュン", "ActiveX（WScript.Shell）が使えない環境だよ。\n.hta ファイルをダブルクリックしてHTAとして起動してね♡");
        return;
    }
    if (isModalOpen()) {
        return;
    }
    var macro = currentMacro();
    var steps = macro ? macro.steps : [];
    var executable = 0;
    var usesCsv = false;
    for (var i = 0; i < steps.length; i++) {
        if (isExecutableStep(steps[i])) {
            executable++;
        }
        if (steps[i].cmd === "CSV") {
            usesCsv = true;
        }
    }
    if (executable === 0) {
        log("実行できるコマンドがないキュン。まずはコマンドを追加してね♡", "warn");
        return;
    }
    if (!groupsBalanced(steps)) {
        showMessage("ブロックの形がおかしいキュン", "グループ・繰り返し・もし〜なら・エラー時の処理の「始まり」と「終わり（ここまで）」の数や順番が合っていないよ。\n（そうでなければ・エラーのとき は、それぞれのブロックの中に1つだけ置けるよ）\n正しく動かないから、実行はやめておいたよ。終わりの位置を直してから実行してね。");
        return;
    }
    var list = [];
    var rangeText = "";
    var rows = csvState.rows;
    if (rows.length === 0) {
        if (usesCsv && opts.unattended) {
            log("⏰ CSVを使うマクロなのに、CSVが読み込まれていないから実行しなかったキュン", "error");
            return;
        }
        if (usesCsv && !confirm("CSVが読み込まれていないキュン。\nCSVコマンドは空欄扱い（貼り付けスキップ）で1回だけテスト実行する？")) {
            return;
        }
        list.push({ no: 0, data: [] });
    } else {
        var startText = toHalfWidthDigits(trimText(byId("startRowInput").value));
        var endText = toHalfWidthDigits(trimText(byId("endRowInput").value));
        if ((startText !== "" && !/^\d+$/.test(startText)) || (endText !== "" && !/^\d+$/.test(endText))) {
            // Never fall back to "all rows" on a typo: that would enter rows twice
            showMessage("開始行・終了行", "開始行・終了行は数字で入れてね（いま: 開始「" + byId("startRowInput").value + "」 終了「" + byId("endRowInput").value + "」）。\n終了行は空欄なら最後の行までだよ。");
            return;
        }
        var start = Math.max(1, startText === "" ? 1 : parseInt(startText, 10));
        var end = Math.min(rows.length, endText === "" ? rows.length : parseInt(endText, 10));
        if (start > end) {
            log("開始行と終了行の指定がおかしいキュン（" + start + "〜" + end + "）", "warn");
            return;
        }
        var origCol = originalRowNoColumn();
        var origUsed = 0;
        var blankSkipped = 0;
        for (var r = start; r <= end; r++) {
            if (isBlankRow(rows[r - 1])) {
                blankSkipped++;
                continue;
            }
            var origText = origCol >= 0 ? trimText(rows[r - 1][origCol]) : "";
            var orig = /^[1-9]\d*$/.test(origText) ? toInt(origText, r) : r;
            if (orig !== r || /^[1-9]\d*$/.test(origText)) {
                origUsed++;
            }
            list.push({ no: orig, data: rows[r - 1] });
        }
        if (origUsed > 0) {
            log("この CSV には「元データ行No」列があるから、{{ROW}} と行番号は元のCSVの番号を使うキュン（エラー行の再実行用）", "info");
        }
        if (blankSkipped) {
            log("（空の行 " + blankSkipped + " 行は飛ばすね）", "info");
        }
        if (list.length === 0) {
            log("実行する行がないキュン（指定した範囲が全部空の行だったよ）", "warn");
            return;
        }
        rangeText = "（" + start + "〜" + end + "行目）";
    }
    cleanupTempFiles();
    runHeader = csvState.header ? csvState.header.slice(0) : null;
    errorRows = [];
    updateErrorButton();
    resultRows = [];
    resultColumns = [];
    updateResultButton();
    runState = {
        running: true,
        paused: false,
        macro: macro,
        steps: deepCopy(steps),
        rootSteps: null,
        callStack: [],
        targetWindow: macro.targetWindow,
        activeTitle: macro.targetWindow,
        rows: list,
        rowPos: 0,
        stepIndex: 0,
        interval: Math.max(0, toInt(toHalfWidthDigits(byId("stepIntervalInput").value), 300)),
        timer: null,
        resumeFn: null,
        highlightEl: null,
        doneRows: 0,
        skippedRows: 0,
        vars: {},
        loopStack: [],
        tryStack: [],
        excel: null,
        currentResult: null,
        confirmOpen: false,
        startTime: new Date()
    };
    setRunUi(true);
    startStopWatcher(runState);
    log("▶ 実行開始するキュン♡ マクロ「" + macro.name + "」 対象 " + list.length + "行" + rangeText + " / 間隔 " + runState.interval + "ms", "run");
    if (!macro.targetWindow) {
        log("対象ウィンドウが未設定だから3秒後に開始するよ。入力先の画面をクリックしておいてね♡（マクロの中でRUN・SWITCHしているならそのままでOK）", "warn");
        schedule(startRow, 3000);
    } else {
        schedule(startRow, 100);
    }
}

// Error-row / result CSVs carry the original row number; re-running them keeps {{ROW}} pointing at the same rows
function originalRowNoColumn() {
    if (csvState.header) {
        for (var i = 0; i < csvState.header.length; i++) {
            if (trimText(csvState.header[i]) === "元データ行No") {
                return i;
            }
        }
    }
    return -1;
}

// Esc only reaches the HTA while it has focus, but during a run the target app is in front.
// A small PowerShell watcher reads the global key state: holding Esc ~1 s stops the run from any
// window. A macro's own KEY {ESC} is a single instant press, so it never counts as "held".
function startStopWatcher(rs) {
    if (!shell || !fso || psLaunchBlocked || psLastFailed || psLangRestricted) {
        // Keyboard-only macros must stay PowerShell-free on PCs where PowerShell does not work
        log("（Esc長押しでの緊急停止はこの端末では使えないよ。止めるときは、ふじキュンの画面で Esc か ⏹ を押してね）", "info");
        return;
    }
    rs.stopWatcher = runPowerShellAsync([
        "Add-Type -TypeDefinition @\"",
        "using System;",
        "using System.Runtime.InteropServices;",
        "public static class FujiKeys {",
        "    [DllImport(\"user32.dll\")] public static extern short GetAsyncKeyState(int vKey);",
        "}",
        "\"@",
        "$held = 0",
        "$tick = 0",
        "while ($true) {",
        "    if (Test-FujiCancel) { Set-FujiResult 'OK:END'; break }",
        "    $tick++",
        "    if (($tick % 40) -eq 0 -and @(Get-Process -Name mshta -ErrorAction SilentlyContinue).Count -eq 0) { Set-FujiResult 'OK:END'; break }",
        "    if (([FujiKeys]::GetAsyncKeyState(0x1B) -band 0x8000) -ne 0) { $held++ } else { $held = 0 }",
        "    if ($held -ge " + STOP_HOLD_POLLS + ") { Set-FujiResult 'OK:STOP'; break }",
        "    Start-Sleep -Milliseconds 120",
        "}"
    ], 7 * 24 * 3600, function (ok, payload) {
        if (ok && payload === "STOP" && runState === rs && rs.running) {
            stopRun("Esc長押し");
            try {
                shell.AppActivate(document.title);
            } catch (e) {
                /* ignore */
            }
        } else if (!ok && runState === rs && rs.running) {
            log("（Esc長押しでの緊急停止は使えない状態だよ。止めるときは、ふじキュンの画面で Esc か ⏹ を押してね）", "warn");
        }
    }, { silentOnly: true, startTimeoutSec: PS_TIMEOUT_SEC });
}

function startRow() {
    var rs = runState;
    if (rs.rowPos >= rs.rows.length) {
        finishRun();
        return;
    }
    var row = rs.rows[rs.rowPos];
    rs.stepIndex = 0;
    rs.activeTitle = rs.targetWindow;
    if (!rs.rootSteps) {
        rs.rootSteps = rs.steps;
    }
    rs.steps = rs.rootSteps;
    rs.callStack = [];
    rs.loopStack = [];
    rs.tryStack = [];
    rs.currentResult = beginResultRow(row);
    updateProgress();
    log("── " + rowCaption(row) + " 開始（" + (rs.rowPos + 1) + "/" + rs.rows.length + "件目）", "run");
    if (rs.activeTitle) {
        activateWithRetry(rs.activeTitle, function () {
            schedule(runCurrentStep, 150);
        }, function () {
            stopWithError("🚨 対象ウィンドウ「" + rs.activeTitle + "」が見つからないキュン…" + WINDOW_RETRY_MAX + "回探してもダメだったから止めたよ", true);
        });
    } else {
        schedule(runCurrentStep, 0);
    }
}

// skipFirstOnly: true when the current row is not the first one, so "first row only" groups are closed
function nextFinalGroupIndex(steps, from, skipFirstOnly) {
    for (var i = Math.max(0, from); i < steps.length; i++) {
        if (!isBlockStart(steps[i].cmd)) {
            continue;
        }
        if (steps[i].disabled || (skipFirstOnly && steps[i].when === "first")) {
            // Never descend into a group that would not run: a "last" group inside it stays skipped
            var end = findGroupEnd(steps, i);
            if (end > i) {
                i = end;
            }
            continue;
        }
        if (steps[i].when === "last") {
            return i;
        }
    }
    return -1;
}

function runCurrentStep() {
    var rs = runState;
    if (rs.finalOnly && rs.stepIndex > rs.finalGroupEnd) {
        // Only "last row only" groups run for a skipped last row
        var g = nextFinalGroupIndex(rs.steps, rs.stepIndex, rs.rowPos !== 0);
        rs.stepIndex = g >= 0 ? g : rs.steps.length;
        rs.finalGroupEnd = g >= 0 ? findGroupEnd(rs.steps, g) : -1;
    }
    if (rs.stepIndex >= rs.steps.length && !rs.finalOnly && returnFromCall(rs)) {
        rs.stepIndex++; // continue after the CALL_MACRO step
        schedule(runCurrentStep, rs.interval);
        return;
    }
    if (rs.stepIndex >= rs.steps.length) {
        if (rs.finalOnly) {
            rs.finalOnly = false;
        } else {
            rs.doneRows++;
            setRowResult("完了");
            log("✔ " + rowCaption(rs.rows[rs.rowPos]) + " 完了", "ok");
        }
        nextRow();
        return;
    }
    pruneFrames(rs);
    var step = rs.steps[rs.stepIndex];
    highlightRunning(rs.callStack.length ? rs.callStack[0].index : rs.stepIndex);
    updateProgress();
    updateVarPanel();
    executeStep(step, function (action, delay) {
        if (runState !== rs || !rs.running) {
            return;
        }
        if (action === "skipRow") {
            if (rs.finalOnly) {
                // A skip inside the final-only pass: the row was already counted and recorded
                rs.finalOnly = false;
                nextRow();
                return;
            }
            rs.skippedRows++;
            setRowResult("スキップ");
            while (returnFromCall(rs)) {
                // a skip inside a called macro ends the whole row: unwind to the top-level macro
            }
            if (rs.rowPos === rs.rows.length - 1) {
                // The last row was skipped: still run the "last row only" groups (save / clean-up)
                var g = nextFinalGroupIndex(rs.steps, rs.stepIndex + 1, rs.rowPos !== 0);
                if (g >= 0) {
                    rs.finalOnly = true;
                    rs.stepIndex = g;
                    rs.finalGroupEnd = findGroupEnd(rs.steps, g);
                    log("最後の行はスキップしたけど、「最後の1行だけ」のグループは実行するキュン", "info");
                    schedule(runCurrentStep, rs.interval);
                    return;
                }
            }
            nextRow();
            return;
        }
        rs.stepIndex++;
        schedule(runCurrentStep, delay == null ? rs.interval : delay);
    });
}

function nextRow() {
    var rs = runState;
    rs.rowPos++;
    schedule(startRow, Math.max(rs.interval, 300));
}

function htaHasFocus() {
    if (!focusCheckTrusted) {
        return false;
    }
    try {
        return document.hasFocus();
    } catch (e) {
        return false;
    }
}

// Same rule as AppActivate: exact match, then prefix, then suffix
function titleMatchesSelf(title) {
    var own = document.title;
    return own === title || own.indexOf(title) === 0 ||
        (own.length >= title.length && own.substring(own.length - title.length) === title);
}

function activateWithRetry(title, onOk, onFail) {
    var attempt = 0;
    function tryOnce() {
        attempt++;
        var ok = false;
        try {
            ok = shell.AppActivate(title);
        } catch (e) {
            ok = false;
        }
        if (ok) {
            schedule(function () {
                if (!htaHasFocus()) {
                    onOk();
                } else if (titleMatchesSelf(title)) {
                    log("⚠ 「" + title + "」だと、ふじキュン自身のウィンドウにマッチしちゃうキュン", "warn");
                    retry();
                } else {
                    // AppActivate succeeded on another window but focus is still reported here:
                    // do not trust document.hasFocus() from now on and re-activate before every input
                    focusCheckTrusted = false;
                    log("⚠ この環境ではフォーカス判定が使えないみたい。以降は入力のたびに対象ウィンドウを前面化して進めるキュン", "warn");
                    onOk();
                }
            }, 250);
            return;
        }
        retry();
    }
    function retry() {
        if (attempt >= WINDOW_RETRY_MAX) {
            onFail();
            return;
        }
        log("🔎 ウィンドウ「" + title + "」を探してるキュン…（" + attempt + "/" + WINDOW_RETRY_MAX + "回目 失敗）", "warn");
        schedule(tryOnce, WINDOW_RETRY_INTERVAL_MS);
    }
    tryOnce();
}

// Make sure keystrokes never land in this HTA itself
function ensureInputTarget(fn) {
    var rs = runState;
    var htaFocused = htaHasFocus();
    var safeMode = byId("safeModeCheck").checked || !focusCheckTrusted;
    if (!htaFocused && !safeMode) {
        fn();
        return;
    }
    if (!rs.activeTitle) {
        if (htaFocused) {
            stopWithError("🚨 このままだと入力先がふじキュン自身になっちゃうから止めたキュン！ 対象ウィンドウ名を設定するか、SWITCHコマンドを入れてね", true);
            return;
        }
        fn();
        return;
    }
    if (htaFocused) {
        log("ふじキュンに操作が移っていたから「" + rs.activeTitle + "」を前面に戻すキュン", "warn");
    }
    activateWithRetry(rs.activeTitle, fn, function () {
        stopWithError("🚨 対象ウィンドウ「" + rs.activeTitle + "」を見失ったキュン…安全のため止めたよ", true);
    });
}

function pasteText(text, what, next) {
    if (text === "") {
        log("（" + what + " は空欄なので貼り付けはスキップ）", "info");
        next("next");
        return;
    }
    // The clipboard is written right before Ctrl+V (a pause in between must not paste whatever the
    // user copied meanwhile), and the next step waits until the target app has taken the paste
    schedule(function () {
        if (!setClipboardText(text)) {
            stopWithError("🚨 クリップボードに書き込めなかったキュン…", true);
            return;
        }
        shell.SendKeys("^v");
        log("📋 " + what + "「" + truncateText(text, 30) + "」を貼り付けたよ", "info");
        next("next", Math.max(runState.interval, PASTE_SETTLE_MS));
    }, 80);
}

function setClipboardText(text) {
    for (var attempt = 0; attempt < 2; attempt++) {
        try {
            if (window.clipboardData.setData("Text", text) !== false) {
                return true;
            }
        } catch (e) {
            /* retry once */
        }
    }
    return false;
}

function executeStep(step, next) {
    var rs = runState;
    var val = step.val == null ? "" : String(step.val);
    if (step.disabled) {
        if (isBlockStart(step.cmd)) {
            skipGroupBody(rs, "（無効化された「" + (step.label || autoLabelFor(step)) + "」は飛ばすよ）");
        }
        next("next", 0);
        return;
    }
    var unsafe = step.cmd === "RUN" ? [] : null;
    if (COMMAND_DEFS[step.cmd] && COMMAND_DEFS[step.cmd].expandVal) {
        val = expandPlaceholders(val, rs, unsafe);
    }
    switch (step.cmd) {
    case "GROUP_START":
        if (step.when === "first" && rs.rowPos !== 0) {
            skipGroupBody(rs, "");
        } else if (step.when === "last" && rs.rowPos !== rs.rows.length - 1) {
            skipGroupBody(rs, "");
        }
        next("next", 0);
        return;
    case "COMMENT":
    case "GROUP_END":
    case "IF_END":
        next("next", 0);
        return;
    case "READ_TEXT":
    case "CLICK_TEXT":
        runOcr(step, next);
        return;
    case "MAIL":
        runMail(step, next);
        return;
    case "CALL_MACRO":
        runCallMacro(step, next);
        return;
    case "RETURN":
        runReturn(next);
        return;
    case "LOOP_START":
        runLoopStart(step, next);
        return;
    case "LOOP_END":
        runLoopEnd(next);
        return;
    case "BREAK":
    case "CONTINUE":
        runBreakOrContinue(step.cmd, next);
        return;
    case "IF_START":
        runIfStart(step, next);
        return;
    case "ELSE":
    case "CATCH":
        runMiddleReached(next);
        return;
    case "TRY_START":
        runTryStart(next);
        return;
    case "TRY_END":
        runTryEnd(next);
        return;
    case "SET_VAR":
        runSetVar(step, next);
        return;
    case "STR_OP":
        runStrOp(step, next);
        return;
    case "ASK":
        runAsk(step, next);
        return;
    case "RECORD":
        runRecord(step, next);
        return;
    case "EXCEL_READ":
    case "EXCEL_WRITE":
        runExcel(step, next);
        return;
    case "KEY":
        ensureInputTarget(function () {
            shell.SendKeys(normalizeSendKeys(val));
            log("⌨ キー送信 " + val + "（" + keyDisplayName(val) + "）", "info");
            next("next");
        });
        return;
    case "TEXT":
        ensureInputTarget(function () {
            pasteText(val, "文字列", next);
        });
        return;
    case "CSV":
        var col = toInt(val, 0);
        var data = rs.rows[rs.rowPos].data;
        if (rs.rows[rs.rowPos].no > 0 && (col < 1 || col > data.length)) {
            log("⚠ CSVの" + col + "列目がこの行には無いキュン（" + data.length + "列しかないよ）", "warn");
        }
        var cellText = col >= 1 && col <= data.length ? String(data[col - 1]) : "";
        ensureInputTarget(function () {
            pasteText(cellText, "CSV " + col + "列目", next);
        });
        return;
    case "WAIT":
        var ms = Math.max(0, toInt(val, 0));
        log("⏳ " + ms + "ミリ秒待機", "info");
        next("next", ms);
        return;
    case "WAIT_FOR":
        runWaitFor(step, next);
        return;
    case "WINDOW_CHECK":
        runWindowCheck(step, next);
        return;
    case "SWITCH":
        activateWithRetry(val, function () {
            rs.activeTitle = val;
            log("🪟 「" + val + "」に切り替えたキュン", "info");
            next("next");
        }, function () {
            stopWithError("🚨 切替先ウィンドウ「" + val + "」が見つからないキュン…", true);
        });
        return;
    case "RUN":
        if (unsafe && unsafe.length) {
            var why = "RUN の差し込みに、コマンドで特別な意味を持つ文字（\" & | < > ^ % 改行）が入っていたから、この行は実行しなかったキュン: " + unsafe.join("、");
            log("⚠ " + why, "error");
            recordErrorRow(why);
            setRowResult("スキップ", why);
            next("skipRow");
            return;
        }
        try {
            var how = runCommand(val, 1);
            log("🚀 起動: " + val + (how === "shell" ? "（ShellExecuteで起動）" : ""), "info");
            next("next");
        } catch (e) {
            stopWithError("🚨 起動できなかったキュン: " + val + "（" + errorText(e) + "）", true);
        }
        return;
    case "CLICK_NAME":
        ensureInputTarget(function () {
            log("👆 「" + val + "」をUIAutomationで探してるキュン…", "info");
            rs.psJob = runPowerShellAsync(buildUiaClickScript(val, rs.activeTitle), PS_TIMEOUT_SEC, function (ok, payload) {
                if (ok) {
                    log("👆 「" + val + "」をクリック（" + payload + "）", "info");
                    next("next");
                } else {
                    stopWithError("🚨 名前でクリックできなかったキュン: " + payload, true);
                }
            }, { forRun: true });
        });
        return;
    case "CLICK_POS":
        var xy = COMMAND_DEFS.CLICK_POS.parse(val);
        var x = toInt(xy.x, 0);
        var y = toInt(xy.y, 0);
        ensureInputTarget(function () {
            rs.psJob = runPowerShellAsync(buildClickPosScript(x, y, xy.kind), PS_TIMEOUT_SEC, function (ok, payload) {
                if (ok) {
                    log("🎯 座標(" + x + ", " + y + ")をクリック", "info");
                    next("next");
                } else {
                    stopWithError("🚨 座標クリック失敗: " + payload, true);
                }
            }, { forRun: true });
        });
        return;
    case "CLICK_IMG":
        var img = COMMAND_DEFS.CLICK_IMG.parse(val);
        var imgPath = resolveImagePath(img.path);
        var threshold = clampThreshold(img.threshold);
        if (imgPath === "" || !fso.FileExists(imgPath)) {
            stopWithError("🚨 参照画像が見つからないキュン: " + (imgPath || "（未指定）"), true);
            return;
        }
        ensureInputTarget(function () {
            log("🖼 画像「" + fileNameOf(imgPath) + "」を画面から探してるキュン…（一致" + Math.round(threshold * 100) + "%以上）", "info");
            rs.psJob = runPowerShellAsync(buildClickImgScript(imgPath, threshold), IMG_PS_TIMEOUT_SEC, function (ok, payload) {
                if (ok) {
                    var r = String(payload).split(",");
                    log("🖼 見つけたキュン♡ 一致率 " + (toInt(r[2], 0) / 10) + "% → 座標(" + r[0] + ", " + r[1] + ")をクリック", "info");
                    next("next");
                } else {
                    stopWithError("🚨 画像認識クリック失敗: " + payload, true);
                }
            }, { forRun: true });
        });
        return;
    case "CONFIRM":
        askConfirm(val, next);
        return;
    case "COPY":
        ensureInputTarget(function () {
            copyToVariable(trimText(val), next);
        });
        return;
    case "SCREENSHOT":
        var shot = COMMAND_DEFS.SCREENSHOT.parse(val);
        if (shot.scope === "FULL") {
            saveScreenshot(shot, next);
        } else {
            ensureInputTarget(function () {
                saveScreenshot(shot, next);
            });
        }
        return;
    default:
        log("不明なコマンド " + step.cmd + " はスキップするね", "warn");
        next("next", 0);
    }
}

function runWaitFor(step, next) {
    var p = COMMAND_DEFS.WAIT_FOR.parse(step.val);
    var title = expandPlaceholders(p.title, runState);
    var key = p.key;
    var timeout = Math.max(1, toInt(toHalfWidthDigits(p.timeout), 30));
    var count = 0;
    if (!title) {
        stopWithError("🚨 待つウィンドウのタイトルが空っぽキュン", true);
        return;
    }
    log("👀 「" + title + "」の出現を待つよ（最大" + timeout + "秒）", "info");
    function poll() {
        var found = false;
        try {
            found = shell.AppActivate(title);
        } catch (e) {
            found = false;
        }
        if (found) {
            log("✨ 「" + title + "」が出てきたキュン！", "ok");
            if (key) {
                schedule(function () {
                    shell.SendKeys(normalizeSendKeys(key));
                    log("⌨ " + key + " を押したよ", "info");
                    next("next");
                }, 300);
            } else {
                next("next");
            }
            return;
        }
        count++;
        if (count >= timeout) {
            stopWithError("⏰ タイムアウト！「" + title + "」が" + timeout + "秒たっても出てこなかったから安全停止したキュン", true);
            return;
        }
        updateProgress("（待機 " + count + "/" + timeout + "秒）");
        schedule(poll, 1000);
    }
    poll();
}

function runWindowCheck(step, next) {
    var p = COMMAND_DEFS.WINDOW_CHECK.parse(step.val);
    var title = expandPlaceholders(p.title, runState);
    var key = p.key;
    var mode = p.mode;
    var found = false;
    try {
        found = title ? shell.AppActivate(title) : false;
    } catch (e) {
        found = false;
    }
    if (!found) {
        log("🔍 「" + title + "」は出ていないから続行", "info");
        next("next", 0);
        return;
    }
    log("⚠ 「" + title + "」を検知したキュン！", "warn");
    schedule(function () {
        if (key) {
            shell.SendKeys(normalizeSendKeys(key));
            log("⌨ " + key + " を押したよ", "info");
        }
        if (mode === "CONTINUE") {
            log("▶ ポップアップを処理したから、そのまま続けるキュン", "info");
            schedule(function () {
                next("next");
            }, 500);
        } else if (mode === "SKIP") {
            recordErrorRow("ウィンドウ検知(SKIP): 「" + title + "」");
            setRowResult("スキップ", "ウィンドウ検知: 「" + title + "」");
            log("⏭ この行は打ち切って次の行へ進むキュン", "warn");
            schedule(function () {
                next("skipRow");
            }, 500);
        } else {
            stopWithError("🚨 ウィンドウ検知(STOP): 「" + title + "」が出たから緊急停止したキュン！", true, true);
        }
    }, 300);
}

// Jump to the matching GROUP_END (the runner then continues after it)
function skipGroupBody(rs, message) {
    var end = findGroupEnd(rs.steps, rs.stepIndex);
    if (end > rs.stepIndex) {
        rs.stepIndex = end;
    }
    if (message) {
        log(message, "info");
    }
}

// Human-in-the-loop: pause and let the operator continue / skip the row / stop
function askConfirm(message, next) {
    var rs = runState;
    var row = rs.rows[rs.rowPos];
    try {
        shell.AppActivate(document.title);
    } catch (e) {
        /* ignore */
    }
    rs.confirmOpen = true;
    updateProgress("（✋ 確認待ち）");
    log("✋ 確認ポイント: あなたの確認を待ってるキュン", "warn");
    openModal("✋ 確認ポイント（" + rowCaption(row) + "）", '<div class="modal-message">' + escapeHtml(message) + "</div>", [
        { text: "▶ 続行", cls: "btn-run", fn: function () {
            rs.confirmOpen = false;
            if (runState !== rs || !rs.running) {
                return true;
            }
            log("▶ 確認OK、続けるキュン♡", "run");
            if (rs.activeTitle) {
                activateWithRetry(rs.activeTitle, function () {
                    next("next", 300);
                }, function () {
                    stopWithError("🚨 確認のあと「" + rs.activeTitle + "」に戻れなかったキュン…", true);
                });
            } else {
                log("対象ウィンドウ未設定だから1.5秒後に続けるよ。入力先をクリックしておいてね", "warn");
                schedule(function () {
                    next("next", 0);
                }, 1500);
            }
            return true;
        } },
        { text: "⏭ この行をスキップ", fn: function () {
            rs.confirmOpen = false;
            if (runState === rs && rs.running) {
                setRowResult("スキップ", "確認ポイントでスキップ");
                log("⏭ この行はスキップするキュン", "warn");
                next("skipRow");
            }
            return true;
        } },
        { text: "⏹ 停止", cls: "btn-danger", fn: function () {
            rs.confirmOpen = false;
            stopRun("確認ポイントで停止");
            return true;
        } }
    ], { onDismiss: function () {
        rs.confirmOpen = false;
        stopRun("確認ポイントでEsc");
    } });
}

function copyToVariable(name, next) {
    var rs = runState;
    try {
        window.clipboardData.setData("Text", "");
    } catch (e1) {
        /* ignore */
    }
    shell.SendKeys("^c");
    schedule(function () {
        var text = "";
        try {
            text = window.clipboardData.getData("Text") || "";
        } catch (e2) {
            text = "";
        }
        text = String(text).replace(/(\r\n|\n|\r)+$/, "");
        rs.vars[name] = text;
        addResultValue(name, text);
        updateVarPanel();
        if (text === "") {
            log("⚠ $" + name + " は空っぽだったキュン（文字が選択されていなかったかも。直前に KEY ^a を入れてみてね）", "warn");
        } else {
            log("📋 $" + name + " = " + truncateText(text, 40), "info");
        }
        next("next");
    }, COPY_WAIT_MS);
}

function saveScreenshot(p, next) {
    var full = p.scope === "FULL";
    var name = expandPlaceholders(p.name, runState);
    var path;
    try {
        var folder = ensureFolder(appFilePath(EVIDENCE_FOLDER_NAME) + "\\" + dateStamp());
        var d = new Date();
        path = folder + "\\" + (safeFileName(name) || "screen") + "_" + pad2(d.getHours()) + pad2(d.getMinutes()) + pad2(d.getSeconds()) + ".png";
    } catch (e) {
        stopWithError("🚨 証跡フォルダを作れなかったキュン…（" + errorText(e) + "）", true);
        return;
    }
    runState.psJob = runPowerShellAsync(buildScreenshotScript(path, full), PS_TIMEOUT_SEC, function (ok, payload) {
        if (ok) {
            log("📸 画面を保存したキュン（" + payload + "）: " + path, "info");
            addResultValue("証跡ファイル", path);
            next("next");
        } else {
            stopWithError("🚨 画面の撮影に失敗: " + payload, true);
        }
    }, { forRun: true });
}

// uncatchable: an intentional emergency stop (WINDOW_CHECK ... STOP) that "エラー時の処理" must not swallow
function stopWithError(message, recordRow, uncatchable) {
    if (!isRunning()) {
        return;
    }
    if (!uncatchable && catchRunError(message)) {
        var held = runState.currentResult;
        if (held) {
            held.note = (held.note ? held.note + " / " : "") + "受け止めたエラー: " + String(message).replace(/^🚨\s*/, "");
        }
        return;
    }
    log(message, "error");
    if (recordRow) {
        recordErrorRow(message);
    }
    if (runState && runState.finalOnly && runState.currentResult) {
        // The skipped last row already has its status: keep the error visible in its note
        var r = runState.currentResult;
        r.note = (r.note ? r.note + " / " : "") + "最後の1行だけのグループでエラー: " + message;
    }
    setRowResult("エラー", message);
    endRun("異常停止");
    playAlarm(false);
    try {
        shell.AppActivate(document.title);
    } catch (e) {
        /* ignore */
    }
}

function togglePause() {
    var rs = runState;
    if (!rs || !rs.running) {
        return;
    }
    if (!rs.paused) {
        rs.paused = true;
        byId("pauseBtn").innerHTML = "▶ 再開";
        updateProgress();
        log("⏸ 一時停止中だキュン。「▶ 再開」で続きからね", "warn");
        return;
    }
    rs.paused = false;
    byId("pauseBtn").innerHTML = "⏸ 一時停止";
    log("▶ 再開するキュン♡", "run");
    var fn = rs.resumeFn;
    rs.resumeFn = null;
    if (!fn) {
        return; // a timer is still pending and will continue by itself
    }
    if (rs.activeTitle) {
        activateWithRetry(rs.activeTitle, function () {
            schedule(fn, 300);
        }, function () {
            stopWithError("🚨 再開しようとしたけど「" + rs.activeTitle + "」が見つからないキュン…", true);
        });
    } else {
        log("対象ウィンドウ未設定だから1.5秒後に再開するよ。入力先をクリックしておいてね", "warn");
        schedule(fn, 1500);
    }
}

function stopRun(reason) {
    if (!isRunning()) {
        return;
    }
    log("⏹ 停止したキュン（" + reason + "）", "warn");
    setRowResult("中断", reason);
    endRun("停止");
}

function finishRun() {
    log("🎉 全部おわったキュン♡ おつかれさま！", "ok");
    endRun("完了");
    playNotify();
    if (autoRunScheduleId && autoRunCloseWhenDone) {
        autoRunScheduleId = "";
        log("🗓 予定どおり完了したから、10秒後にふじキュンを閉じるよ（閉じたくないときは何かボタンを押してね）", "warn");
        var closeTimer = setTimeout(function () {
            if (!isRunning() && !isDirty) {
                window.close();
            }
        }, 10000);
        document.attachEvent ? document.attachEvent("onmousedown", function () { clearTimeout(closeTimer); }) : document.addEventListener("mousedown", function () { clearTimeout(closeTimer); });
    }
}

function endRun(status) {
    var rs = runState;
    if (!rs) {
        return;
    }
    rs.running = false;
    closeExcel(rs);
    if (rs.timer) {
        clearTimeout(rs.timer);
        rs.timer = null;
    }
    // powershell.exe keeps running after the HTA stops polling: tell it not to click
    if (rs.psJob) {
        rs.psJob.detach();
    }
    if (rs.stopWatcher) {
        rs.stopWatcher.cancel();
    }
    if (rs.confirmOpen) {
        rs.confirmOpen = false;
        closeModal();
    }
    updateResultButton();
    clearRunningHighlight();
    setRunUi(false);
    var sec = Math.round((new Date().getTime() - rs.startTime.getTime()) / 1000);
    var summary = status + "：完了 " + rs.doneRows + "行 / スキップ " + rs.skippedRows + "行 / エラー記録 " + errorRows.length + "件（" + sec + "秒）";
    log("■ " + summary, status === "完了" ? "ok" : "warn");
    byId("progressText").innerHTML = escapeHtml("■ " + summary);
}

// =====================================================================
//  Run-time commands: control flow, variables, Excel, OCR, mail, subroutines
// =====================================================================
// Loop / try frames outside the current position are dropped (left by a jump, a skip or BREAK)
function pruneFrames(rs) {
    var i = rs.stepIndex;
    rs.loopStack = (rs.loopStack || []).filter(function (f) { return i >= f.start && i <= f.end; });
    rs.tryStack = (rs.tryStack || []).filter(function (f) { return i >= f.start && i <= f.end; });
}

// Moves to `index` so that the runner's next() continues right after it
function jumpTo(rs, index) {
    rs.stepIndex = index;
}

function runLoopStart(step, next) {
    var rs = runState;
    var p = COMMAND_DEFS.LOOP_START.parse(step.val);
    var top = rs.loopStack.length ? rs.loopStack[rs.loopStack.length - 1] : null;
    var frame = top && top.start === rs.stepIndex ? top : null;
    if (!frame) {
        var end = findGroupEnd(rs.steps, rs.stepIndex);
        if (end < 0) {
            stopWithError("🚨 「繰り返しここまで」が見つからないキュン", true);
            return;
        }
        frame = { start: rs.stepIndex, end: end, iter: 0, count: -1, max: toInt(toHalfWidthDigits(p.max), 1000), counter: trimText(p.counter) || "回数" };
        if (p.mode === "COUNT") {
            var countText = toHalfWidthDigits(trimText(expandPlaceholders(p.count, rs)));
            if (!/^\d+$/.test(countText)) {
                stopWithError("🚨 繰り返しの回数「" + countText + "」が数字じゃないキュン", true);
                return;
            }
            frame.count = parseInt(countText, 10);
        }
        rs.loopStack.push(frame);
    }
    var go;
    try {
        go = p.mode === "COUNT" ? frame.iter < frame.count : evalCondition(p, rs);
    } catch (e) {
        stopWithError("🚨 繰り返しの条件を調べられなかったキュン（" + errorText(e) + "）", true);
        return;
    }
    if (go && frame.iter >= frame.max) {
        stopWithError("🚨 繰り返しが上限の " + frame.max + " 回に達したから止めたキュン（終わらない繰り返しの防止）。条件か上限回数を見直してね", true);
        return;
    }
    if (go) {
        frame.iter++;
        rs.vars[frame.counter] = String(frame.iter);
        log("🔁 繰り返し " + frame.iter + " 回目", "info");
        next("next", 0);
        return;
    }
    rs.loopStack.pop();
    log("🔁 繰り返しおわり（" + frame.iter + " 回）", "info");
    jumpTo(rs, frame.end);
    next("next", 0);
}

function innermostLoop(rs) {
    return rs.loopStack.length ? rs.loopStack[rs.loopStack.length - 1] : null;
}

function runLoopEnd(next) {
    var rs = runState;
    var frame = innermostLoop(rs);
    if (frame && frame.end === rs.stepIndex) {
        jumpTo(rs, frame.start - 1); // next() lands on LOOP_START, which decides whether to go round again
    }
    next("next", 0);
}

function runBreakOrContinue(cmd, next) {
    var rs = runState;
    var frame = innermostLoop(rs);
    if (!frame) {
        log("⚠ 「" + COMMAND_DEFS[cmd].title + "」が繰り返しの外にあるから、何もしないで進むね", "warn");
        next("next", 0);
        return;
    }
    if (cmd === "BREAK") {
        rs.loopStack.pop();
        log("⤴ 繰り返しを抜けるよ", "info");
        jumpTo(rs, frame.end);
    } else {
        log("↪ 次の繰り返しへ", "info");
        jumpTo(rs, frame.end - 1);
    }
    next("next", 0);
}

function runIfStart(step, next) {
    var rs = runState;
    var p = COMMAND_DEFS.IF_START.parse(step.val);
    var ok;
    try {
        ok = evalCondition(p, rs);
    } catch (e) {
        stopWithError("🚨 「もし〜なら」の条件を調べられなかったキュン（" + errorText(e) + "）", true);
        return;
    }
    log("❓ もし " + describeCondition(p) + " → " + (ok ? "はい" : "いいえ"), "info");
    if (!ok) {
        var elseIndex = findMiddle(rs.steps, rs.stepIndex, "ELSE");
        jumpTo(rs, elseIndex >= 0 ? elseIndex : findGroupEnd(rs.steps, rs.stepIndex));
    }
    next("next", 0);
}

// ELSE / CATCH reached by finishing the previous section: skip to the end of the block
function runMiddleReached(next) {
    var rs = runState;
    var owner = findBlockOwner(rs.steps, rs.stepIndex);
    var end = owner >= 0 ? findGroupEnd(rs.steps, owner) : -1;
    if (rs.steps[rs.stepIndex].cmd === "CATCH") {
        rs.tryStack = rs.tryStack.filter(function (f) { return f.start !== owner; });
    }
    if (end >= 0) {
        jumpTo(rs, end);
    }
    next("next", 0);
}

function runTryStart(next) {
    var rs = runState;
    var end = findGroupEnd(rs.steps, rs.stepIndex);
    rs.tryStack.push({ start: rs.stepIndex, end: end, catchIndex: findMiddle(rs.steps, rs.stepIndex, "CATCH") });
    next("next", 0);
}

function runTryEnd(next) {
    var rs = runState;
    var idx = rs.stepIndex;
    rs.tryStack = rs.tryStack.filter(function (f) { return f.end !== idx; });
    next("next", 0);
}

// Called by stopWithError: an error inside "エラー時の処理" goes to its CATCH section instead of
// stopping the run. Returns true when the error was handled.
function catchRunError(message) {
    var rs = runState;
    if (!rs || !rs.running || !rs.tryStack) {
        return false;
    }
    pruneFrames(rs);
    while (rs.tryStack.length || (rs.callStack && rs.callStack.length)) {
        if (!rs.tryStack.length) {
            // No handler in the called macro: look for one around the CALL_MACRO step in the caller
            returnFromCall(rs);
            pruneFrames(rs);
            continue;
        }
        var f = rs.tryStack[rs.tryStack.length - 1];
        if (f.catchIndex >= 0 && rs.stepIndex > f.catchIndex) {
            rs.tryStack.pop(); // the error happened inside the CATCH section itself: pass it outward
            continue;
        }
        rs.vars["エラー内容"] = String(message).replace(/^🚨\s*/, "");
        log("🧯 エラーを受け止めたキュン: " + rs.vars["エラー内容"] + (f.catchIndex >= 0 ? "（「エラーのとき」へ進むよ）" : ""), "warn");
        if (rs.confirmOpen) {
            rs.confirmOpen = false;
            closeModal();
        }
        if (f.catchIndex >= 0) {
            rs.stepIndex = f.catchIndex + 1;
        } else {
            rs.tryStack.pop();
            rs.stepIndex = f.end + 1;
        }
        updateVarPanel();
        schedule(runCurrentStep, rs.interval);
        return true;
    }
    return false;
}

function runSetVar(step, next) {
    var rs = runState;
    var p = COMMAND_DEFS.SET_VAR.parse(step.val);
    var value = expandPlaceholders(p.value, rs);
    if (p.mode === "CALC") {
        try {
            value = calcExpression(value);
        } catch (e) {
            stopWithError("🚨 計算できなかったキュン: " + value + "（" + errorText(e) + "）", true);
            return;
        }
    }
    rs.vars[trimText(p.name)] = value;
    log("📦 $" + p.name + " = " + truncateText(value, 40), "info");
    updateVarPanel();
    next("next", 0);
}

function runStrOp(step, next) {
    var rs = runState;
    var p = COMMAND_DEFS.STR_OP.parse(step.val);
    var result;
    try {
        result = strOp(p.op, expandPlaceholders(p.src, rs), expandPlaceholders(p.a, rs), expandPlaceholders(p.b, rs));
    } catch (e) {
        stopWithError("🚨 文字の加工（" + strOpName(p.op) + "）ができなかったキュン（" + errorText(e) + "）", true);
        return;
    }
    rs.vars[trimText(p.name)] = result;
    log("✂ $" + p.name + " = " + truncateText(result, 40), "info");
    updateVarPanel();
    next("next", 0);
}

function runRecord(step, next) {
    var rs = runState;
    var p = COMMAND_DEFS.RECORD.parse(step.val);
    var value = expandPlaceholders(p.value, rs);
    addResultValue(trimText(p.name), value);
    log("📝 結果の「" + p.name + "」に記録: " + truncateText(value, 40), "info");
    next("next", 0);
}

function runAsk(step, next) {
    var rs = runState;
    var p = COMMAND_DEFS.ASK.parse(step.val);
    var name = trimText(p.name);
    var message = expandPlaceholders(p.message, rs);
    var initial = expandPlaceholders(p.defaultValue, rs);
    try {
        shell.AppActivate(document.title);
    } catch (e) {
        /* ignore */
    }
    rs.confirmOpen = true;
    updateProgress("（✍ 入力待ち）");
    log("✍ 「" + name + "」の入力を待ってるキュン", "warn");
    openModal("✍ 入力してね（" + rowCaption(rs.rows[rs.rowPos]) + "）",
        '<div class="modal-message">' + escapeHtml(message) + '</div><div class="form-row"><input type="text" id="askInput" class="form-input" value="' + escapeHtml(initial) + '"></div>', [
            { text: "▶ 続行", cls: "btn-run", fn: function () {
                var value = byId("askInput") ? byId("askInput").value : initial;
                rs.confirmOpen = false;
                if (runState !== rs || !rs.running) {
                    return true;
                }
                rs.vars[name] = value;
                log("✍ $" + name + " = " + truncateText(value, 40), "info");
                updateVarPanel();
                resumeAfterDialog(rs, next);
                return true;
            } },
            { text: "⏭ この行をスキップ", fn: function () {
                rs.confirmOpen = false;
                if (runState === rs && rs.running) {
                    setRowResult("スキップ", "入力でスキップ");
                    next("skipRow");
                }
                return true;
            } },
            { text: "⏹ 停止", cls: "btn-danger", fn: function () {
                rs.confirmOpen = false;
                stopRun("入力で停止");
                return true;
            } }
        ], { onDismiss: function () {
            rs.confirmOpen = false;
            stopRun("入力でEsc");
        } });
}

// After a dialog the HTA has the focus: give it back to the input target before continuing
function resumeAfterDialog(rs, next) {
    if (rs.activeTitle) {
        activateWithRetry(rs.activeTitle, function () {
            next("next", 300);
        }, function () {
            stopWithError("🚨 入力のあと「" + rs.activeTitle + "」に戻れなかったキュン…", true);
        });
    } else {
        log("対象ウィンドウ未設定だから1.5秒後に続けるよ。入力先をクリックしておいてね", "warn");
        schedule(function () {
            next("next", 0);
        }, 1500);
    }
}

// ----- Excel (no GUI): one hidden Excel per run, books stay open until the run ends -----
function excelSheet(rs, path, sheet, forWrite) {
    if (!rs.excel) {
        var app = new ActiveXObject("Excel.Application");
        app.Visible = false;
        app.DisplayAlerts = false;
        rs.excel = { app: app, books: {} };
    }
    var key = path.toLowerCase();
    var wb = rs.excel.books[key];
    if (!wb) {
        if (!fso.FileExists(path)) {
            throw new Error("ブックが見つからない: " + path);
        }
        wb = rs.excel.app.Workbooks.Open(path, 0, false);
        rs.excel.books[key] = wb;
    }
    if (forWrite && wb.ReadOnly) {
        throw new Error("ほかで開かれているから書き込めない（ブックを閉じてからもう一度）: " + path);
    }
    var s = trimText(sheet) === "" ? "1" : toHalfWidthDigits(trimText(sheet));
    return wb.Worksheets.Item(/^\d+$/.test(s) ? parseInt(s, 10) : s);
}

function closeExcel(rs) {
    if (!rs || !rs.excel) {
        return;
    }
    try {
        for (var k in rs.excel.books) {
            if (rs.excel.books.hasOwnProperty(k)) {
                try { rs.excel.books[k].Close(false); } catch (e1) { /* ignore */ }
            }
        }
        rs.excel.app.Quit();
    } catch (e2) {
        /* ignore */
    }
    rs.excel = null;
}

function runExcel(step, next) {
    var rs = runState;
    var write = step.cmd === "EXCEL_WRITE";
    var p = COMMAND_DEFS[step.cmd].parse(step.val);
    var path = trimText(expandPlaceholders(p.path, rs)).replace(/^"+|"+$/g, "");
    var cell = trimText(expandPlaceholders(p.cell, rs));
    try {
        var sh = excelSheet(rs, path, expandPlaceholders(p.sheet, rs), write);
        if (write) {
            var value = expandPlaceholders(p.value, rs);
            sh.Range(cell).Value = value;
            sh.Parent.Save();
            log("📗 " + fileNameOf(path) + " の " + cell + " に「" + truncateText(value, 30) + "」を書いて保存したよ", "info");
        } else {
            var text = String(sh.Range(cell).Text);
            rs.vars[trimText(p.name)] = text;
            log("📗 " + fileNameOf(path) + " の " + cell + " = " + truncateText(text, 40), "info");
            updateVarPanel();
        }
    } catch (e) {
        stopWithError("🚨 Excelの" + (write ? "書き込み" : "読み取り") + "に失敗したキュン（" + errorText(e) + "）", true);
        return;
    }
    next("next", 0);
}

// ----- OCR
function runOcr(step, next) {
    var rs = runState;
    var p = COMMAND_DEFS[step.cmd].parse(step.val);
    var isClick = step.cmd === "CLICK_TEXT";
    var find = isClick ? expandPlaceholders(p.text, rs) : null;
    var run = function () {
        log(isClick ? "🔎 「" + find + "」を文字認識で探してるキュン…" : "🔤 " + ocrAreaName(p) + " の文字を読んでるキュン…", "info");
        rs.psJob = runPowerShellAsync(ocrScript(p, rs, find, Math.max(1, toInt(toHalfWidthDigits(p.nth || "1"), 1))), IMG_PS_TIMEOUT_SEC, function (ok, payload) {
            if (!ok) {
                stopWithError("🚨 文字認識（OCR）に失敗: " + payload, true);
                return;
            }
            if (isClick) {
                log("🔎 「" + find + "」をクリック（" + payload + "）", "info");
            } else {
                var text = String(payload).replace(/\r\n/g, "\n").replace(/\n+$/, "").replace(/\n/g, "\r\n");
                rs.vars[trimText(p.name)] = text;
                log("🔤 $" + p.name + " = " + truncateText(text, 60), "info");
                updateVarPanel();
            }
            next("next");
        }, { forRun: true });
    };
    if (p.area === "WINDOW" || isClick) {
        ensureInputTarget(run);
    } else {
        run();
    }
}

// ----- Mail
function splitAddresses(s) {
    var list = String(s || "").split(/[;,；、\s]+/);
    var out = [];
    for (var i = 0; i < list.length; i++) {
        if (trimText(list[i]) !== "") {
            out.push(trimText(list[i]));
        }
    }
    return out;
}

function runMail(step, next) {
    var rs = runState;
    var p = COMMAND_DEFS.MAIL.parse(step.val);
    var m = {};
    var keys = ["to", "cc", "subject", "body", "attach", "from"];
    for (var i = 0; i < keys.length; i++) {
        m[keys[i]] = expandPlaceholders(p[keys[i]], rs);
    }
    var attachments = splitPathList(m.attach);
    for (i = 0; i < attachments.length; i++) {
        if (!fso.FileExists(attachments[i])) {
            stopWithError("🚨 添付ファイルが見つからないキュン: " + attachments[i], true);
            return;
        }
    }
    var to = splitAddresses(m.to);
    if (!to.length) {
        stopWithError("🚨 宛先が空っぽだったキュン", true);
        return;
    }
    if (p.method === "MAILTO") {
        if (attachments.length) {
            log("⚠ メールアプリを開く方法（mailto）では添付できないから、添付は手で付けてね", "warn");
        }
        var url = "mailto:" + to.join(",") + "?subject=" + encodeURIComponent(m.subject) + "&body=" + encodeURIComponent(m.body.replace(/\r?\n/g, "\r\n")) +
            (trimText(m.cc) ? "&cc=" + encodeURIComponent(splitAddresses(m.cc).join(",")) : "");
        try {
            new ActiveXObject("Shell.Application").ShellExecute(url, "", "", "open", 1);
            log("✉ メールアプリで作成画面を開いたよ: " + to.join(", "), "info");
            next("next", 1500);
        } catch (e) {
            stopWithError("🚨 メールアプリを開けなかったキュン（" + errorText(e) + "）", true);
        }
        return;
    }
    if (p.method === "SMTP") {
        var lines = [
            "$msg = New-Object System.Net.Mail.MailMessage",
            "$msg.From = New-Object System.Net.Mail.MailAddress(" + psQuote(m.from) + ")",
            "$msg.SubjectEncoding = [System.Text.Encoding]::UTF8",
            "$msg.BodyEncoding = [System.Text.Encoding]::UTF8",
            "$msg.Subject = " + psQuote(m.subject),
            "$msg.Body = " + psQuote(m.body)
        ];
        for (i = 0; i < to.length; i++) {
            lines.push("$msg.To.Add(" + psQuote(to[i]) + ")");
        }
        var cc = splitAddresses(m.cc);
        for (i = 0; i < cc.length; i++) {
            lines.push("$msg.CC.Add(" + psQuote(cc[i]) + ")");
        }
        for (i = 0; i < attachments.length; i++) {
            lines.push("$msg.Attachments.Add((New-Object System.Net.Mail.Attachment(" + psQuote(attachments[i]) + ")))");
        }
        lines.push(
            "$smtp = New-Object System.Net.Mail.SmtpClient(" + psQuote(trimText(p.server)) + ", " + toInt(toHalfWidthDigits(p.port), 25) + ")",
            "$smtp.EnableSsl = $" + (p.ssl === "YES" ? "true" : "false"),
            // No password is ever stored: the Windows logon is used when the server asks for authentication
            "$smtp.UseDefaultCredentials = $true",
            "if (Test-FujiCancel) { Set-FujiResult 'NG:停止されたので送信しなかった' } else { $smtp.Send($msg); $msg.Dispose(); Set-FujiResult 'OK' }"
        );
        log("✉ メールサーバーから送信するよ: " + to.join(", "), "info");
        rs.psJob = runPowerShellAsync(lines, PS_TIMEOUT_SEC, function (ok, payload) {
            if (!ok) {
                stopWithError("🚨 メールを送信できなかったキュン（" + payload + "）", true);
                return;
            }
            log("✉ 送信したよ: 「" + truncateText(m.subject, 30) + "」", "ok");
            addResultValue("メール", "送信済み");
            next("next");
        }, { forRun: true });
        return;
    }
    try {
        var ol = new ActiveXObject("Outlook.Application");
        var item = ol.CreateItem(0); // olMailItem
        item.To = to.join("; ");
        item.CC = splitAddresses(m.cc).join("; ");
        item.Subject = m.subject;
        item.Body = m.body;
        for (i = 0; i < attachments.length; i++) {
            item.Attachments.Add(attachments[i]);
        }
        if (p.mode === "SEND") {
            item.Send();
            log("✉ Outlookで送信したよ: 「" + truncateText(m.subject, 30) + "」→ " + to.join(", "), "ok");
            addResultValue("メール", "送信済み");
        } else if (p.mode === "DISPLAY") {
            item.Display(false);
            log("✉ Outlookで作成画面を開いたよ（送信は人が押してね）", "info");
            addResultValue("メール", "作成画面を表示");
        } else {
            item.Save();
            log("✉ Outlookの下書きに保存したよ: 「" + truncateText(m.subject, 30) + "」", "ok");
            addResultValue("メール", "下書き保存");
        }
        next("next", 500);
    } catch (e2) {
        stopWithError("🚨 Outlookでメールを作れなかったキュン（Outlookが入っていない・設定されていない かも）（" + errorText(e2) + "）", true);
    }
}

function splitPathList(s) {
    var list = String(s || "").split(/[;；]/);
    var out = [];
    for (var i = 0; i < list.length; i++) {
        var t = trimText(list[i]).replace(/^"+|"+$/g, "");
        if (t !== "") {
            out.push(t);
        }
    }
    return out;
}

// ----- Subroutines (CALL_MACRO / RETURN)
function findMacroForCall(p) {
    for (var i = 0; i < appData.macros.length; i++) {
        if (p.id && appData.macros[i].id === p.id) {
            return appData.macros[i];
        }
    }
    for (i = 0; i < appData.macros.length; i++) {
        if (p.name && appData.macros[i].name === p.name) {
            return appData.macros[i];
        }
    }
    return null;
}

function runCallMacro(step, next) {
    var rs = runState;
    var p = COMMAND_DEFS.CALL_MACRO.parse(step.val);
    var target = findMacroForCall(p);
    if (!target) {
        stopWithError("🚨 呼び出すマクロ「" + (p.name || p.id) + "」が見つからないキュン", true);
        return;
    }
    if (rs.callStack.length >= CALL_DEPTH_MAX) {
        stopWithError("🚨 マクロの呼び出しが " + CALL_DEPTH_MAX + " 段より深くなったから止めたキュン（自分自身を呼び出していない？）", true);
        return;
    }
    if (!groupsBalanced(target.steps)) {
        stopWithError("🚨 呼び出すマクロ「" + target.name + "」のブロックの形がおかしいキュン", true);
        return;
    }
    rs.callStack.push({ steps: rs.steps, index: rs.stepIndex, loopStack: rs.loopStack, tryStack: rs.tryStack, name: target.name });
    rs.steps = deepCopy(target.steps);
    rs.loopStack = [];
    rs.tryStack = [];
    log("📞 マクロ「" + target.name + "」を呼び出すよ", "info");
    rs.stepIndex = -1;
    next("next", 0);
}

// Back to the caller (end of a called macro, or RETURN). Returns false at the top level.
function returnFromCall(rs) {
    if (!rs.callStack.length) {
        return false;
    }
    var f = rs.callStack.pop();
    log("📞 マクロ「" + f.name + "」から戻ったよ", "info");
    rs.steps = f.steps;
    rs.stepIndex = f.index;
    rs.loopStack = f.loopStack;
    rs.tryStack = f.tryStack;
    return true;
}

function runReturn(next) {
    var rs = runState;
    rs.stepIndex = rs.steps.length - 1; // the runner then reaches the end of this macro
    log("↩ 呼び出し元に戻るよ", "info");
    next("next", 0);
}

// =====================================================================
//  Variable watch panel
// =====================================================================
function toggleVarPanel() {
    var panel = byId("varPanel");
    panel.style.display = panel.style.display === "none" ? "" : "none";
    updateVarPanel();
}

function varTableHtml(title, rows) {
    var html = '<div class="var-title">' + escapeHtml(title) + "</div>";
    if (!rows.length) {
        return html + '<div class="var-empty">（なし）</div>';
    }
    html += '<table class="var-table">';
    for (var i = 0; i < rows.length; i++) {
        html += "<tr><th>" + escapeHtml(rows[i][0]) + "</th><td>" + escapeHtml(truncateText(rows[i][1], 60)) + "</td></tr>";
    }
    return html + "</table>";
}

function updateVarPanel() {
    var panel = byId("varPanel");
    if (!panel || panel.style.display === "none") {
        return;
    }
    var rs = runState;
    if (!rs) {
        panel.innerHTML = '<div class="var-empty">▶ 実行すると、ここに変数・繰り返しの回数・この行のCSVの値がリアルタイムで表示されるよ</div>';
        return;
    }
    var vars = [];
    for (var k in rs.vars) {
        if (rs.vars.hasOwnProperty(k)) {
            vars.push(["$" + k, rs.vars[k]]);
        }
    }
    var csvRows = [];
    var row = rs.rows[Math.min(rs.rowPos, rs.rows.length - 1)];
    if (row && row.no > 0) {
        csvRows.push(["ROW", String(row.no)]);
        for (var i = 0; i < row.data.length && i < 30; i++) {
            csvRows.push([(runHeader && runHeader[i]) ? runHeader[i] : String(i + 1), row.data[i]]);
        }
    }
    var loops = [];
    for (var j = 0; j < (rs.loopStack || []).length; j++) {
        loops.push(["繰り返し" + (j + 1), rs.loopStack[j].iter + " 回目" + (rs.loopStack[j].count >= 0 ? " / " + rs.loopStack[j].count : "")]);
    }
    panel.innerHTML = varTableHtml("変数 {{$名前}}", vars) + (loops.length ? varTableHtml("繰り返し", loops) : "") +
        varTableHtml("この行のCSV", csvRows);
}

// =====================================================================
//  Screen recording (operations -> steps)
// =====================================================================
var recState = null;

function recorderScript(ignoreTitle, progressPath) {
    return [
        "Add-Type -AssemblyName UIAutomationClient",
        "Add-Type -AssemblyName UIAutomationTypes",
        "Add-Type -AssemblyName WindowsBase",
        "$refs = @([System.Windows.Automation.AutomationElement].Assembly.Location, [System.Windows.Automation.ControlType].Assembly.Location, [System.Windows.Point].Assembly.Location)",
        "Add-Type -ReferencedAssemblies $refs -TypeDefinition @\"",
        "using System;",
        "using System.Collections.Generic;",
        "using System.IO;",
        "using System.Text;",
        "using System.Threading;",
        "using System.Runtime.InteropServices;",
        "using System.Windows.Automation;",
        "public struct FujiRecPoint { public int X; public int Y; }",
        "public class FujiRecorder {",
        "    [DllImport(\"user32.dll\")] static extern short GetAsyncKeyState(int vKey);",
        "    [DllImport(\"user32.dll\")] static extern IntPtr GetForegroundWindow();",
        "    [DllImport(\"user32.dll\", CharSet = CharSet.Unicode)] static extern int GetWindowText(IntPtr h, StringBuilder s, int n);",
        "    [DllImport(\"user32.dll\")] static extern bool GetCursorPos(out FujiRecPoint p);",
        "    [DllImport(\"user32.dll\")] static extern bool SetProcessDPIAware();",
        "    [DllImport(\"user32.dll\")] static extern IntPtr GetKeyboardLayout(uint thread);",
        "    [DllImport(\"user32.dll\")] static extern uint GetWindowThreadProcessId(IntPtr h, IntPtr pid);",
        "    [DllImport(\"user32.dll\")] static extern uint MapVirtualKey(uint code, uint type);",
        "    [DllImport(\"user32.dll\", CharSet = CharSet.Unicode)] static extern int ToUnicodeEx(uint vk, uint scan, byte[] state, StringBuilder buf, int size, uint flags, IntPtr hkl);",
        "    List<string> ev = new List<string>();",
        "    StringBuilder text = new StringBuilder();",
        "    int lastTick = Environment.TickCount;",
        "    int lastClickTick = 0, lastClickX = -9999, lastClickY = -9999, lastClickIndex = -1;",
        "    bool imeNoted = false;",
        "    static string Clean(string s) { return (s ?? \"\").Replace(\"\\t\", \" \").Replace(\"\\r\", \" \").Replace(\"\\n\", \" \"); }",
        "    static string Title(IntPtr h) { StringBuilder sb = new StringBuilder(512); GetWindowText(h, sb, 512); return sb.ToString(); }",
        "    int textStart = 0;",
        "    void Add(string line) { AddAt(line, Environment.TickCount); }",
        "    void AddAt(string line, int when) {",
        "        int gap = when - lastTick;",
        "        if (gap > 1200 && ev.Count > 0) { ev.Add(\"W\\t\" + Math.Min(10000, (gap / 100) * 100)); }",
        "        ev.Add(line); lastTick = Environment.TickCount;",
        "    }",
        "    void FlushText() { if (text.Length > 0) { AddAt(\"T\\t\" + Clean(text.ToString()), textStart); text.Length = 0; } }",
        "    static string Named(int vk) {",
        "        switch (vk) {",
        "            case 8: return \"{BS}\"; case 9: return \"{TAB}\"; case 13: return \"{ENTER}\"; case 27: return \"{ESC}\";",
        "            case 33: return \"{PGUP}\"; case 34: return \"{PGDN}\"; case 35: return \"{END}\"; case 36: return \"{HOME}\";",
        "            case 37: return \"{LEFT}\"; case 38: return \"{UP}\"; case 39: return \"{RIGHT}\"; case 40: return \"{DOWN}\";",
        "            case 45: return \"{INSERT}\"; case 46: return \"{DELETE}\";",
        "        }",
        "        if (vk >= 112 && vk <= 123) { return \"{F\" + (vk - 111) + \"}\"; }",
        "        return null;",
        "    }",
        "    static string InvokableName(int x, int y) {",
        "        try {",
        "            AutomationElement el = AutomationElement.FromPoint(new System.Windows.Point(x, y));",
        "            if (el == null) { return \"\"; }",
        "            object p;",
        "            if (!el.TryGetCurrentPattern(InvokePattern.Pattern, out p)) { return \"\"; }",
        "            string n = el.Current.Name;",
        "            return string.IsNullOrEmpty(n) || n.Length > 40 ? \"\" : Clean(n);",
        "        } catch { return \"\"; }",
        "    }",
        "    void Click(bool right) {",
        "        FujiRecPoint p; GetCursorPos(out p);",
        "        FlushText(); imeNoted = false;",
        "        int now = Environment.TickCount;",
        "        if (!right && now - lastClickTick < 500 && Math.Abs(p.X - lastClickX) < 5 && Math.Abs(p.Y - lastClickY) < 5 && lastClickIndex == ev.Count - 1) {",
        "            ev[lastClickIndex] = \"C\\t\" + lastClickX + \"\\t\" + lastClickY + \"\\tDOUBLE\"; lastClickTick = 0; return;",
        "        }",
        "        string name = right ? \"\" : InvokableName(p.X, p.Y);",
        "        Add(name != \"\" ? \"N\\t\" + name + \"\\t\" + p.X + \"\\t\" + p.Y : \"C\\t\" + p.X + \"\\t\" + p.Y + \"\\t\" + (right ? \"RIGHT\" : \"LEFT\"));",
        "        lastClickTick = now; lastClickX = p.X; lastClickY = p.Y; lastClickIndex = ev.Count - 1;",
        "    }",
        "    void Key(int vk, IntPtr fg) {",
        "        bool shift = (GetAsyncKeyState(0x10) & 0x8000) != 0, ctrl = (GetAsyncKeyState(0x11) & 0x8000) != 0, alt = (GetAsyncKeyState(0x12) & 0x8000) != 0;",
        "        if (vk == 229) { if (!imeNoted) { FlushText(); Add(\"J\"); imeNoted = true; } return; }",
        "        string named = Named(vk);",
        "        if (ctrl || alt) {",
        "            string k = named;",
        "            if (k == null && vk >= 65 && vk <= 90) { k = ((char)(vk + 32)).ToString(); }",
        "            if (k == null && vk >= 48 && vk <= 57) { k = ((char)vk).ToString(); }",
        "            if (k == null && vk == 32) { k = \" \"; }",
        "            if (k == null) { return; }",
        "            FlushText(); imeNoted = false;",
        "            Add(\"K\\t\" + (ctrl ? \"^\" : \"\") + (alt ? \"%\" : \"\") + (shift ? \"+\" : \"\") + k);",
        "            return;",
        "        }",
        "        if (named != null) { FlushText(); imeNoted = false; Add(\"K\\t\" + (shift ? \"+\" : \"\") + named); return; }",
        "        byte[] state = new byte[256];",
        "        if (shift) { state[0x10] = 0x80; state[0xA0] = 0x80; }",
        "        StringBuilder buf = new StringBuilder(8);",
        "        IntPtr hkl = GetKeyboardLayout(GetWindowThreadProcessId(fg, IntPtr.Zero));",
        "        int n = ToUnicodeEx((uint)vk, MapVirtualKey((uint)vk, 0), state, buf, 8, 0, hkl);",
        "        if (n > 0) { string s = buf.ToString(0, n); if (s[0] >= ' ') { if (text.Length == 0) { textStart = Environment.TickCount; } text.Append(s); imeNoted = false; } }",
        "    }",
        "    public static string Run(string cancelPath, string progressPath, string ignoreTitle, int maxMinutes) {",
        "        SetProcessDPIAware();",
        "        FujiRecorder r = new FujiRecorder();",
        "        bool[] down = new bool[256];",
        "        IntPtr lastWin = IntPtr.Zero;",
        "        DateTime start = DateTime.Now;",
        "        for (int vk = 1; vk < 255; vk++) { down[vk] = (GetAsyncKeyState(vk) & 0x8000) != 0; }",
        "        for (int tick = 0; ; tick++) {",
        "            if (tick % 20 == 0) {",
        "                if (File.Exists(cancelPath) || (DateTime.Now - start).TotalMinutes > maxMinutes) { break; }",
        "                try { File.WriteAllText(progressPath, r.ev.Count.ToString()); } catch { }",
        "            }",
        "            IntPtr fg = GetForegroundWindow();",
        "            string title = Title(fg);",
        "            bool ignore = title.IndexOf(ignoreTitle, StringComparison.Ordinal) >= 0;",
        "            if (fg != lastWin && !ignore && title.Length > 0) { r.FlushText(); r.imeNoted = false; r.Add(\"S\\t\" + Clean(title)); lastWin = fg; }",
        "            for (int vk = 1; vk < 255; vk++) {",
        "                bool now = (GetAsyncKeyState(vk) & 0x8000) != 0;",
        "                if (now && !down[vk] && !ignore) {",
        "                    if (vk == 1) { r.Click(false); }",
        "                    else if (vk == 2) { r.Click(true); }",
        "                    else if (vk < 7 || (vk >= 16 && vk <= 18) || vk == 20 || vk == 91 || vk == 92 || (vk >= 160 && vk <= 165)) { }",
        "                    else { r.Key(vk, fg); }",
        "                }",
        "                down[vk] = now;",
        "            }",
        "            Thread.Sleep(15);",
        "        }",
        "        r.FlushText();",
        "        return string.Join(\"\\n\", r.ev.ToArray());",
        "    }",
        "}",
        "\"@",
        "$events = [FujiRecorder]::Run($fujiCancelPath, " + psQuote(progressPath) + ", " + psQuote(ignoreTitle) + ", 240)",
        "Set-FujiResult ('OK:' + $events)"
    ];
}

function toggleRecording() {
    if (recState) {
        stopRecording();
        return;
    }
    if (guardRunning() || !shell || !fso) {
        return;
    }
    var progress = tempFolder() + "\\fujikyun_rec_" + new Date().getTime() + ".count";
    pendingTempFiles.push(progress);
    var at = insertionIndex();
    var macro = currentMacro();
    recState = { job: null, progress: progress, at: at, macroId: macro.id, timer: null };
    var job = runPowerShellAsync(recorderScript(document.title, progress), 4 * 3600, function (ok, payload) {
        var rec = recState;
        recState = null;
        updateRecordUi();
        if (rec && rec.timer) {
            clearInterval(rec.timer);
        }
        if (!ok) {
            log("⏺ 記録に失敗したキュン（" + payload + "）", "error");
            return;
        }
        insertRecordedSteps(rec, String(payload));
    });
    if (!recState) {
        return; // PowerShell could not start: already reported
    }
    recState.job = job;
    recState.timer = setInterval(function () {
        var n = "";
        try {
            if (fso.FileExists(progress)) {
                n = trimText(readTextFile(progress, "utf-8"));
            }
        } catch (e) {
            n = "";
        }
        byId("recordBtn").innerHTML = "⏹ 記録終了" + (n ? "（" + n + "件）" : "");
    }, 1000);
    updateRecordUi();
    log("⏺ 記録を始めたキュン。ふつうに操作してね（ふじキュンの画面での操作は記録しないよ）。終わったら［⏹ 記録終了］を押してね", "run");
}

function stopRecording() {
    if (recState && recState.job) {
        log("⏹ 記録を終わるよ。少し待ってね…", "info");
        recState.job.cancel();
    }
}

function updateRecordUi() {
    var btn = byId("recordBtn");
    if (btn) {
        btn.innerHTML = recState ? "⏹ 記録終了" : "⏺ 記録";
        btn.className = recState ? "btn btn-danger" : "btn";
    }
    byId("runBtn").disabled = !!recState || isRunning();
}

// Recorder lines -> steps. S=window, W=wait, C=coordinate click, N=named click, K=keys, T=text, J=IME typing
function recordedToSteps(payload) {
    var lines = String(payload).split("\n");
    var steps = [];
    var lastSwitch = "";
    for (var i = 0; i < lines.length; i++) {
        var f = lines[i].split("\t");
        var step = null;
        if (f[0] === "S") {
            var title = trimText(f[1]);
            var parts = title.split(" - ");
            var target = parts.length > 1 ? trimText(parts[parts.length - 1]) : title;
            if (target !== "" && target !== lastSwitch) {
                step = { cmd: "SWITCH", val: target };
                lastSwitch = target;
            }
        } else if (f[0] === "W") {
            step = { cmd: "WAIT", val: String(toInt(f[1], 1000)) };
        } else if (f[0] === "C") {
            step = { cmd: "CLICK_POS", val: COMMAND_DEFS.CLICK_POS.compose({ x: f[1], y: f[2], kind: f[3] || "LEFT" }) };
        } else if (f[0] === "N") {
            step = { cmd: "CLICK_NAME", val: f[1] };
        } else if (f[0] === "K") {
            var prev = steps.length ? steps[steps.length - 1] : null;
            var m = prev && prev.cmd === "KEY" ? /^(\{[A-Z0-9]+)( (\d+))?\}$/.exec(prev.val) : null;
            if (m && f[1] === m[1] + "}") {
                prev.val = m[1] + " " + (toInt(m[3], 1) + 1) + "}"; // {TAB}{TAB} -> {TAB 2}
                continue;
            }
            step = { cmd: "KEY", val: f[1] };
        } else if (f[0] === "T") {
            step = { cmd: "TEXT", val: f[1] || "" };
        } else if (f[0] === "J") {
            step = { cmd: "COMMENT", val: "⏺ ここで日本語を入力（変換）していたよ。TEXT か CSV に置き換えてね" };
        }
        if (step) {
            step.label = autoLabelFor(step);
            steps.push(step);
        }
    }
    while (steps.length && steps[steps.length - 1].cmd === "WAIT") {
        steps.pop();
    }
    return steps;
}

function insertRecordedSteps(rec, payload) {
    var steps = recordedToSteps(payload);
    if (!steps.length) {
        log("⏺ 記録できた操作がなかったキュン", "warn");
        return;
    }
    var macroIndex = -1;
    for (var i = 0; i < appData.macros.length; i++) {
        if (appData.macros[i].id === rec.macroId) {
            macroIndex = i;
        }
    }
    if (macroIndex < 0) {
        log("⏺ 記録先のマクロが見つからなかったキュン", "error");
        return;
    }
    currentMacroIndex = macroIndex;
    var target = currentSteps();
    var at = Math.min(rec.at, target.length);
    var block = [{ cmd: "GROUP_START", val: "⏺ 記録した操作 " + dateTimeText(), label: "" }].concat(steps).concat([{ cmd: "GROUP_END", val: "", label: "グループ終了" }]);
    block[0].label = autoLabelFor(block[0]);
    for (var k = block.length - 1; k >= 0; k--) {
        target.splice(at, 0, block[k]);
    }
    selectedIndex = at;
    refreshMacroSelect();
    renderSteps();
    scrollToSelected();
    commitChange("記録: " + steps.length + "件");
    log("⏺ " + steps.length + " 件の操作をマクロに入れたキュン♡ 文字の入力は TEXT や CSV に、座標クリックは CLICK_NAME や画像・文字認識に置き換えるとさらに安定するよ", "ok");
}

// =====================================================================
//  Schedules (run by this window, or by Windows Task Scheduler)
// =====================================================================
var SCHEDULE_REPEATS = [["DAILY", "毎日"], ["WEEKDAYS", "平日（月〜金）"], ["ONCE", "指定した日に1回"]];

function scheduleRepeatName(r) {
    for (var i = 0; i < SCHEDULE_REPEATS.length; i++) {
        if (SCHEDULE_REPEATS[i][0] === r) {
            return SCHEDULE_REPEATS[i][1];
        }
    }
    return r;
}

function scheduleAppliesOn(s, d) {
    if (s.repeat === "WEEKDAYS") {
        return d.getDay() >= 1 && d.getDay() <= 5;
    }
    if (s.repeat === "ONCE") {
        return s.date === formatDate(d);
    }
    return true;
}

function scheduleMinutes(s) {
    var m = /^(\d{1,2}):(\d{2})$/.exec(toHalfWidthDigits(trimText(s.time)));
    return m ? parseInt(m[1], 10) * 60 + parseInt(m[2], 10) : -1;
}

// Due when today is a run day, the time passed less than 10 minutes ago and it has not run today
function scheduleDue(s, now) {
    var mins = scheduleMinutes(s);
    var nowMins = now.getHours() * 60 + now.getMinutes();
    return s.enabled && mins >= 0 && scheduleAppliesOn(s, now) && nowMins >= mins && nowMins - mins < 10 && s.lastRun !== formatDate(now);
}

function nextScheduleText() {
    var best = null;
    var now = new Date();
    for (var dayOffset = 0; dayOffset < 8 && !best; dayOffset++) {
        var d = new Date(now.getFullYear(), now.getMonth(), now.getDate() + dayOffset);
        for (var i = 0; i < schedules.length; i++) {
            var s = schedules[i];
            var mins = scheduleMinutes(s);
            if (!s.enabled || mins < 0 || !scheduleAppliesOn(s, d)) {
                continue;
            }
            if (dayOffset === 0 && (mins <= now.getHours() * 60 + now.getMinutes() - 10 || s.lastRun === formatDate(now))) {
                continue;
            }
            if (!best || mins < best.mins) {
                best = { mins: mins, s: s, day: d };
            }
        }
    }
    return best ? "⏰ 次の予定: " + (best.day.getDate() === now.getDate() ? "今日" : (best.day.getMonth() + 1) + "/" + best.day.getDate()) + " " + best.s.time + " " + truncateText(macroNameById(best.s.macroId) || best.s.macroName, 16) : "";
}

function updateScheduleState() {
    var el = byId("scheduleState");
    if (el) {
        var text = nextScheduleText();
        el.innerHTML = escapeHtml(text);
        el.style.display = text ? "" : "none";
    }
}

function checkSchedules() {
    updateScheduleState();
    if (isRunning() || recState) {
        return;
    }
    var now = new Date();
    for (var i = 0; i < schedules.length; i++) {
        if (scheduleDue(schedules[i], now)) {
            if (isModalOpen()) {
                log("⏰ 予定の時刻だけど、画面でダイアログが開いているから待ってるキュン（閉じたら始めるよ）", "warn");
                return;
            }
            runSchedule(schedules[i]);
            return;
        }
    }
}

function runSchedule(s) {
    s.lastRun = formatDate(new Date());
    saveSettings();
    var macro = findMacroForCall({ id: s.macroId, name: s.macroName });
    if (!macro) {
        log("⏰ 予定のマクロ「" + s.macroName + "」が見つからなかったキュン", "error");
        return;
    }
    for (var i = 0; i < appData.macros.length; i++) {
        if (appData.macros[i] === macro) {
            currentMacroIndex = i;
        }
    }
    selectedIndex = -1;
    refreshMacroSelect();
    renderSteps();
    if (trimText(s.csvPath)) {
        byId("csvPathInput").value = s.csvPath;
        byId("csvHeaderCheck").checked = s.header !== false;
        loadCsvFromInput();
        if (csvState.path !== s.csvPath) {
            log("⏰ 予定のCSV「" + s.csvPath + "」を読めなかったから、実行しなかったキュン", "error");
            return;
        }
    } else {
        csvState = { path: "", encoding: "", records: [], header: null, rows: [] };
        updateCsvInfo();
    }
    byId("startRowInput").value = "1";
    byId("endRowInput").value = "";
    log("⏰ 予定の時刻になったから「" + macro.name + "」を実行するキュン", "run");
    startRun({ unattended: true });
    updateScheduleState();
}

function addScheduleFromDialog() {
    var macroId = byId("schMacro").value;
    var time = toHalfWidthDigits(trimText(byId("schTime").value)).replace("：", ":");
    var tm = /^(\d{1,2}):(\d{2})$/.exec(time);
    if (tm) {
        time = pad2(parseInt(tm[1], 10)) + ":" + tm[2];
    }
    var repeat = byId("schRepeat").value;
    var date = trimText(byId("schDate").value);
    if (!/^\d{1,2}:\d{2}$/.test(time) || scheduleMinutes({ time: time }) >= 24 * 60) {
        showFormError("時刻は 18:30 のように入れてね♡");
        return false;
    }
    if (repeat === "ONCE" && !parseDateText(date)) {
        showFormError("「指定した日に1回」のときは、日付を 2026/10/31 のように入れてね♡");
        return false;
    }
    schedules.push({
        id: generateId(), macroId: macroId, macroName: macroNameById(macroId), csvPath: trimText(byId("schCsv").value).replace(/^"+|"+$/g, ""),
        header: byId("schHeader").checked, time: time, repeat: repeat, date: repeat === "ONCE" ? formatDate(parseDateText(date)) : "",
        enabled: true, closeAfter: byId("schClose").checked, lastRun: ""
    });
    saveSettings();
    updateScheduleState();
    log("⏰ 予定を追加したキュン: " + scheduleRepeatName(repeat) + " " + time + " 「" + macroNameById(macroId) + "」", "ok");
    setTimeout(showSchedules, 0);
    return true;
}

function showSchedules() {
    var html = '<div class="form-help">決まった時刻にマクロを自動で実行するキュン。<br>' +
        "・ふじキュンを開いている間は、ふじキュンが自分で時刻を見て実行するよ。<br>" +
        "・［🗓 Windowsに登録］すると、ふじキュンを閉じていても Windows が時刻にふじキュンを起動して実行するよ（PCの電源が入っていて、ログインしたままのときだけ）。<br>" +
        "・ロボットは画面を操作するので、実行する時刻は画面ロックしない・席を外しても大丈夫な時間にしてね。</div>";
    if (schedules.length) {
        html += '<table class="diag-table"><tr><th>時刻</th><th>くり返し</th><th>マクロ / CSV</th><th>状態</th><th></th></tr>';
        for (var i = 0; i < schedules.length; i++) {
            var s = schedules[i];
            html += "<tr><td>" + escapeHtml(s.time) + "</td><td>" + escapeHtml(scheduleRepeatName(s.repeat) + (s.date ? " " + s.date : "")) + "</td><td>" +
                escapeHtml(macroNameById(s.macroId) || s.macroName + "（見つからない）") + '<div class="form-hint">' + escapeHtml(s.csvPath || "（CSVなし・1回だけ実行）") + "</div></td><td>" +
                (s.enabled ? "✅ 有効" : "⏸ 停止中") + (s.taskName ? "<br>🗓 Windows登録済み" : "") + "</td><td>" +
                '<button class="btn" onclick="toggleSchedule(' + i + ')">' + (s.enabled ? "⏸ 止める" : "▶ 有効にする") + "</button> " +
                '<button class="btn" onclick="registerScheduleTask(' + i + ')">🗓 Windowsに登録</button> ' +
                (s.taskName ? '<button class="btn" onclick="unregisterScheduleTask(' + i + ')">登録を解除</button> ' : "") +
                '<button class="btn btn-danger-lite" onclick="deleteSchedule(' + i + ')">🗑</button></td></tr>';
        }
        html += "</table>";
    } else {
        html += '<div class="modal-message">まだ予定はないキュン。下で追加してね。</div>';
    }
    var options = "";
    for (var m = 0; m < appData.macros.length; m++) {
        options += '<option value="' + escapeHtml(appData.macros[m].id) + '"' + (m === currentMacroIndex ? " selected" : "") + ">" + escapeHtml(appData.macros[m].name) + "</option>";
    }
    var repeats = "";
    for (var r = 0; r < SCHEDULE_REPEATS.length; r++) {
        repeats += '<option value="' + SCHEDULE_REPEATS[r][0] + '">' + SCHEDULE_REPEATS[r][1] + "</option>";
    }
    html += '<div class="tpl-cat">＋ 予定を追加</div>' +
        '<div class="form-row"><label class="form-label">マクロ</label><select id="schMacro" class="form-input">' + options + "</select></div>" +
        '<div class="form-row"><label class="form-label">CSV（空欄なら1回だけ実行）</label><input type="text" id="schCsv" class="form-input" value="' + escapeHtml(csvState.path || "") + '"></div>' +
        '<div class="form-row"><label class="chk"><input type="checkbox" id="schHeader" checked> CSVの1行目は見出し</label></div>' +
        '<div class="form-row"><label class="form-label">時刻（24時間）</label><input type="text" id="schTime" class="input-md" placeholder="例: 18:30"> ' +
        '<select id="schRepeat">' + repeats + '</select> 日付 <input type="text" id="schDate" class="input-md" placeholder="1回のとき 2026/10/31"></div>' +
        '<div class="form-row"><label class="chk"><input type="checkbox" id="schClose"> Windowsから起動したときは、最後まで完了したら ふじキュンを閉じる</label></div>' +
        '<div class="form-error" id="formError"></div>';
    openModal("⏰ スケジュール（決まった時刻に自動で実行）", html, [
        { text: "＋ この内容で追加", cls: "btn-primary", fn: function () { return addScheduleFromDialog() ? true : false; } },
        { text: "閉じる", fn: null }
    ], { wide: true });
}

function toggleSchedule(i) {
    schedules[i].enabled = !schedules[i].enabled;
    saveSettings();
    updateScheduleState();
    showSchedules();
}

function deleteSchedule(i) {
    var s = schedules[i];
    if (s.taskName) {
        runSchtasks("/Delete /TN \"" + s.taskName + "\" /F", "Windowsの登録を解除");
    }
    schedules.splice(i, 1);
    saveSettings();
    updateScheduleState();
    showSchedules();
}

function htaFilePath() {
    try {
        var cmdLine = String(byId("fujikyunRPABuilder").commandLine || "");
        var m = cmdLine.match(/"([^"]+\.hta)"/i) || cmdLine.match(/(\S+\.hta)/i);
        if (m) {
            return m[1];
        }
    } catch (e) {
        /* ignore */
    }
    return "";
}

// schtasks output goes to a file so the result can be shown (Run is hidden and returns at once)
function runSchtasks(args, what, done) {
    var out = tempFolder() + "\\fujikyun_schtasks_" + new Date().getTime() + ".txt";
    pendingTempFiles.push(out);
    try {
        runCommand(quoteExe(expandEnv("%ComSpec%")) + " /c schtasks " + args + " > \"" + out + "\" 2>&1", 0);
    } catch (e) {
        log("🗓 " + what + "に失敗したキュン（" + errorText(e) + "）", "error");
        return;
    }
    var waited = 0;
    var poll = function () {
        waited += 500;
        var text = "";
        try {
            if (fso.FileExists(out)) {
                text = trimText(readTextFile(out, "shift_jis"));
            }
        } catch (e2) {
            text = "";
        }
        if (text === "" && waited < 10000) {
            setTimeout(poll, 500);
            return;
        }
        var ok = /成功|SUCCESS/i.test(text);
        log("🗓 " + what + (ok ? "したキュン" : "の結果: " + (text || "（返事がなかった）")), ok ? "ok" : "warn");
        if (done) {
            done(ok);
        }
    };
    setTimeout(poll, 800);
}

function registerScheduleTask(i) {
    var s = schedules[i];
    var hta = htaFilePath();
    if (!hta) {
        log("🗓 ふじキュン本体（.hta）の場所が分からなかったキュン", "error");
        return;
    }
    var name = "FujikyunRPA_" + s.id;
    var sc = s.repeat === "WEEKDAYS" ? "/SC WEEKLY /D MON,TUE,WED,THU,FRI" : s.repeat === "ONCE" ? "/SC ONCE /SD " + s.date : "/SC DAILY";
    var time = s.time;
    var tr = "\\\"" + expandEnv("%SystemRoot%") + "\\System32\\mshta.exe\\\" \\\"" + hta + "\\\" /fujikyun-auto:" + s.id;
    runSchtasks("/Create /F /TN \"" + name + "\" " + sc + " /ST " + time + " /TR \"" + tr + "\"", "Windowsのタスクに登録", function (ok) {
        if (ok) {
            s.taskName = name;
            saveSettings();
            if (isModalOpen()) {
                showSchedules();
            }
        }
    });
}

function unregisterScheduleTask(i) {
    var s = schedules[i];
    runSchtasks("/Delete /TN \"" + s.taskName + "\" /F", "Windowsの登録を解除", function () {
        delete s.taskName;
        saveSettings();
        if (isModalOpen()) {
            showSchedules();
        }
    });
}

// Started by Windows Task Scheduler: mshta "<hta>" /fujikyun-auto:<id>
function checkAutoRunArgument() {
    var cmdLine = "";
    try {
        cmdLine = String(byId("fujikyunRPABuilder").commandLine || "");
    } catch (e) {
        cmdLine = "";
    }
    var m = /\/fujikyun-auto:([0-9a-z]+)/i.exec(cmdLine);
    if (!m) {
        return;
    }
    for (var i = 0; i < schedules.length; i++) {
        if (schedules[i].id === m[1]) {
            autoRunScheduleId = m[1];
            autoRunCloseWhenDone = !!schedules[i].closeAfter;
            log("🗓 Windowsのタスクから起動されたキュン。5秒後に予定のマクロを実行するよ", "run");
            var s = schedules[i];
            setTimeout(function () {
                if (!isRunning() && !isModalOpen()) {
                    runSchedule(s);
                } else {
                    log("🗓 画面でダイアログが開いていたから、自動実行はやめたキュン", "warn");
                }
            }, 5000);
            return;
        }
    }
    log("🗓 起動時に指定された予定が見つからなかったキュン（" + m[1] + "）", "warn");
}

// =====================================================================
//  Built-in templates
//  steps: [cmd, val, props]  (props: { when: "first"|"last", disabled: true, label: "..." })
//  csv:   array of rows (first row = header). Written to samples\<csvFile> on demand.
// =====================================================================
// @@TEMPLATE_DATA_BEGIN
// Values of multi-setting commands are JSON (see COMMAND_DEFS)
function tplJ(o) {
    return JSON.stringify(o);
}

function tplPos(x, y) {
    return tplJ({ x: String(x), y: String(y), kind: "LEFT" });
}

// Screen labels (menus, buttons, field order) are examples: every site customises its screens,
// so each template starts semi-automatic (CONFIRM: the clerk clicks the field) and carries
// disabled CLICK_POS / read groups to switch to full automation after calibration.
function tplCursor(title, message) {
    return [
        ["GROUP_START", title],
        ["CLICK_POS", tplPos(300, 200), { disabled: true }],
        ["CONFIRM", message],
        ["GROUP_END", ""]
    ];
}

function tplRead(item, x, y) {
    return [
        ["GROUP_START", "「" + item + "」を読み取る（📍で座標を合わせてから有効化）", { disabled: true }],
        ["CLICK_POS", tplPos(x, y)],
        ["KEY", "^a"],
        ["COPY", item],
        ["GROUP_END", ""]
    ];
}

// notFoundMode: SKIP (default) drops the row when the person is not found; CONTINUE moves on
// (used when several businesses are checked for one person and "not enrolled" is a valid answer)
function tplSearch(csvCol, notFoundMode) {
    return [
        ["KEY", "^a"],
        ["CSV", String(csvCol)],
        ["KEY", "{ENTER}"],
        ["WAIT", "2000"],
        ["WINDOW_CHECK", tplJ({ title: "該当なし", key: "{ENTER}", mode: notFoundMode || "SKIP" })],
        ["WINDOW_CHECK", tplJ({ title: "エラー", key: "{ENTER}", mode: "SKIP" })]
    ];
}

