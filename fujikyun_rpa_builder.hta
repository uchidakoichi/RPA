        validate: function (v) { return trimText(v.path) === "" ? "ブックのパスを入れてね♡" : trimText(v.cell) === "" ? "セル番地を入れてね♡" : varNameError(v.name); },
        autoLabel: function (val) { var p = this.parse(val); return "📗 " + fileNameOf(p.path) + " の " + p.cell + " を読む → $" + p.name; }
    },
    EXCEL_WRITE: {
