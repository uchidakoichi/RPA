<!DOCTYPE html>
<html lang="ja">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<meta http-equiv="x-ua-compatible" content="ie=edge">
<title>ふじキュン♡のRPAマクロビルダー</title>
<hta:application
    id="fujikyunRPABuilder"
    applicationname="FujikyunRPABuilder"
    border="dialog" innerborder="no" scroll="auto"
    singleinstance="yes" sysmenu="yes" maximizebutton="yes" windowstate="normal">
<style type="text/css">
/* ===== Base ===== */
html, body {
    height: 100%;
    margin: 0;
    padding: 0;
}
body {
    font-family: "Meiryo UI", "Yu Gothic UI", "Segoe UI", "Segoe UI Emoji", sans-serif;
    font-size: 13px;
    color: #3a3040;
    background: #fdf5f9;
    overflow: auto;
}
button, input, select, textarea {
    font-family: inherit;
    font-size: 12px;
}

/* ===== Flexible layout: only .macro-container stretches ===== */
.app {
    display: -ms-flexbox;
    display: flex;
    -ms-flex-direction: column;
    flex-direction: column;
    height: 100%;
    min-height: 560px;
}
.top-panel,
.bottom-panel {
    -ms-flex: 0 0 auto;
    flex: 0 0 auto;
}
.macro-container {
    -ms-flex: 1 1 0%;
    flex: 1 1 0%;
    position: relative;
    min-height: 120px;
    overflow-x: hidden;
    overflow-y: auto;
    margin: 0 8px;
    padding: 6px 8px 40px 8px;
    background: #ffffff;
    border: 1px solid #ead7e2;
    border-radius: 6px;
    -ms-user-select: none;
    -webkit-user-select: none;
    user-select: none;
    cursor: default;
}

/* ===== Title bar ===== */
.title-bar {
    display: -ms-flexbox;
    display: flex;
    -ms-flex-align: center;
    align-items: center;
    padding: 6px 10px;
    background: #f7a8c8;
    background: linear-gradient(90deg, #f48fb1 0%, #f7b6d2 55%, #b3d9ff 100%);
    color: #ffffff;
}
.app-title {
    font-size: 17px;
    font-weight: bold;
    letter-spacing: 1px;
    text-shadow: 0 1px 2px rgba(120, 30, 80, 0.35);
}
.save-state {
    margin-left: 14px;
    padding: 2px 8px;
    border-radius: 10px;
    font-size: 12px;
    background: rgba(255, 255, 255, 0.85);
    color: #2e7d32;
}
.save-state.dirty {
    color: #c62828;
}
.spacer {
    -ms-flex: 1 1 auto;
    flex: 1 1 auto;
}

/* ===== Toolbar rows ===== */
.toolbar-row {
    display: -ms-flexbox;
    display: flex;
    -ms-flex-wrap: wrap;
    flex-wrap: wrap;
    -ms-flex-align: center;
    align-items: center;
    padding: 3px 8px;
}
.toolbar-row > * {
    margin: 2px 4px 2px 0;
}
.field-label {
    font-weight: bold;
    color: #8e3b66;
    margin-left: 4px;
}
.chk {
    white-space: nowrap;
}
.input-xs { width: 48px; }
.input-md { width: 170px; }
.input-lg { width: 340px; }
input[type="text"], select, textarea {
    border: 1px solid #d9c3d1;
    border-radius: 3px;
    padding: 3px 4px;
    background: #ffffff;
}
.csv-info {
    color: #6d5a66;
    font-size: 12px;
}
.insert-hint {
    color: #1565c0;
    font-size: 12px;
}

/* ===== Buttons ===== */
.btn {
    border: 1px solid #d9c3d1;
    background: #ffffff;
    color: #3a3040;
    border-radius: 4px;
    padding: 3px 9px;
    cursor: pointer;
    white-space: nowrap;
}
.btn:hover { background: #fdeaf3; border-color: #f48fb1; }
.btn[disabled], .btn[disabled]:hover {
    color: #b8adb4;
    background: #f4f0f2;
    border-color: #e2d8de;
    cursor: default;
}
.btn-primary { background: #f06292; border-color: #e0457b; color: #ffffff; font-weight: bold; }
.btn-primary:hover { background: #ec407a; }
.btn-save { background: #ffffff; color: #c2185b; font-weight: bold; border-color: #ffffff; }
.btn-run { background: #43a047; border-color: #2e7d32; color: #ffffff; font-weight: bold; }
.btn-run:hover { background: #388e3c; border-color: #1b5e20; }
.btn-stop { color: #c62828; font-weight: bold; }
.btn-danger { background: #e53935; border-color: #c62828; color: #ffffff; }
.btn-danger:hover { background: #c62828; }
.btn-danger-lite { color: #c62828; }
.btn-cmd { border-left-width: 4px; font-weight: bold; }
.file-btn-wrap {
    position: relative;
    display: inline-block;
    overflow: hidden;
}
.file-btn-wrap input[type="file"] {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
    font-size: 60px;
}

/* ===== Command categories (palette buttons, block edge, badge) ===== */
.cat-input  { border-left-color: #1e88e5; }
.cat-wait   { border-left-color: #c0a000; }
.cat-flow   { border-left-color: #fb8c00; }
.cat-var    { border-left-color: #3949ab; }
.cat-mouse  { border-left-color: #00897b; }
.cat-window { border-left-color: #8e24aa; }
.cat-group  { border-left-color: #795548; }
.cat-note   { border-left-color: #43a047; }
.cat-input .badge  { background: #1e88e5; }
.cat-wait .badge   { background: #c0a000; }
.cat-flow .badge   { background: #fb8c00; }
.cat-var .badge    { background: #3949ab; }
.cat-mouse .badge  { background: #00897b; }
.cat-window .badge { background: #8e24aa; }
.cat-group .badge  { background: #795548; }
.cat-note .badge   { background: #43a047; }

/* ===== Macro blocks ===== */
.block {
    display: -ms-flexbox;
    display: flex;
    -ms-flex-align: center;
    align-items: center;
    min-height: 26px;
    margin: 2px 0;
    padding: 2px 4px;
    background: #fbf9fa;
    border: 2px solid transparent;
    border-left: 5px solid #cfc3ca;
    border-radius: 4px;
    -ms-user-select: none;
    -webkit-user-select: none;
    user-select: none;
}
.block.cat-input  { border-left-color: #1e88e5; }
.block.cat-wait   { border-left-color: #c0a000; }
.block.cat-flow   { border-left-color: #fb8c00; }
.block.cat-var    { border-left-color: #3949ab; }
.block.cat-mouse  { border-left-color: #00897b; }
.block.cat-window { border-left-color: #8e24aa; }
.block.cat-group  { border-left-color: #795548; background: #f6f1ee; }
.block.cat-note   { border-left-color: #43a047; background: #f5fbf5; }
.block:hover { background: #fff3f8; }
.block.selected {
    border-top-color: #2196f3;
    border-right-color: #2196f3;
    border-bottom-color: #2196f3;
    background: #e8f3fe;
}
.block.running {
    background: #fff6c2;
    border-top-color: #fbc02d;
    border-right-color: #fbc02d;
    border-bottom-color: #fbc02d;
}
.block.dragging { opacity: 0.4; }
.block.drop-before { box-shadow: inset 0 4px 0 #2196f3; }
.block.drop-after { box-shadow: inset 0 -4px 0 #2196f3; }
.block.hidden { display: none; }
.toggle, .toggle-space {
    display: inline-block;
    width: 18px;
    text-align: center;
    color: #795548;
    -ms-flex: 0 0 auto;
    flex: 0 0 auto;
}
.toggle { cursor: pointer; font-size: 11px; }
.toggle:hover { color: #e91e63; }
.step-no {
    -ms-flex: 0 0 auto;
    flex: 0 0 auto;
    width: 30px;
    text-align: right;
    margin-right: 6px;
    color: #a2939c;
    font-size: 11px;
}
.badge {
    -ms-flex: 0 0 auto;
    flex: 0 0 auto;
    min-width: 74px;
    margin-right: 8px;
    padding: 1px 4px;
    border-radius: 3px;
    text-align: center;
    font-size: 11px;
    font-weight: bold;
    color: #ffffff;
    background: #9e9e9e;
}
.step-main {
    -ms-flex: 1 1 auto;
    flex: 1 1 auto;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}
.step-label { font-weight: bold; }
.step-val {
    margin-left: 10px;
    color: #8a7d85;
    font-family: Consolas, "MS Gothic", monospace;
    font-size: 11px;
}
.comment-text { color: #2e7d32; font-style: italic; }
.group-name { font-weight: bold; color: #5d4037; }
.group-end-text { color: #8d6e63; font-size: 11px; }
.collapsed-count { margin-left: 8px; color: #a1887f; font-size: 11px; }
.actions {
    -ms-flex: 0 0 auto;
    flex: 0 0 auto;
    margin-left: 6px;
}
.icon-btn {
    border: 1px solid transparent;
    background: transparent;
    color: #8a7d85;
    border-radius: 3px;
    padding: 0 6px;
    cursor: pointer;
    font-size: 13px;
}
.icon-btn:hover { border-color: #90caf9; background: #ffffff; color: #1565c0; }
.icon-btn.icon-del:hover { border-color: #ef9a9a; color: #c62828; }
.empty-hint {
    margin: 40px auto;
    text-align: center;
    color: #b08aa0;
    line-height: 2;
}

/* ===== Bottom panel & log ===== */
.bottom-panel { padding-top: 4px; }
.run-row { background: #fff0f6; border-top: 1px solid #f3d3e2; }
.progress {
    font-weight: bold;
    color: #6a1b9a;
}
.bottom-split {
    display: -ms-flexbox;
    display: flex;
}
.var-panel {
    -ms-flex: 0 0 320px;
    flex: 0 0 320px;
    height: 140px;
    overflow: auto;
    padding: 4px 6px;
    border-left: 1px solid #4a4052;
    background: #fbf7fd;
    font-size: 11px;
}
.var-title { margin: 3px 0 1px 0; font-weight: bold; color: #6a1b9a; }
.var-empty { color: #8a7d85; }
.var-table { width: 100%; border-collapse: collapse; }
.var-table th, .var-table td { padding: 1px 4px; border-bottom: 1px solid #eadde4; text-align: left; vertical-align: top; }
.var-table th { width: 40%; color: #4a2340; font-weight: normal; white-space: nowrap; }
.schedule-state { color: #6a1b9a; }
.palette-group { display: inline-block; margin: 0 8px 2px 0; padding: 1px 4px; border-radius: 4px; background: #fbf0f6; }
.palette-label { margin-right: 4px; font-size: 11px; color: #8e3b66; }
.palette-group .btn-cmd { margin: 1px 2px 1px 0; padding: 1px 6px; font-size: 11px; }
.log-area {
    -ms-flex: 1 1 auto;
    flex: 1 1 auto;
    height: 140px;
    overflow-y: auto;
    padding: 4px 8px;
    background: #2d2733;
    color: #ece6f0;
    font-family: Consolas, "MS Gothic", monospace;
    font-size: 12px;
    line-height: 1.45;
    -ms-user-select: text;
    user-select: text;
}
.log-line { white-space: pre-wrap; word-wrap: break-word; }
.log-info  { color: #ece6f0; }
.log-ok    { color: #a5e3a8; }
.log-warn  { color: #ffe082; }
.log-error { color: #ff8a9a; font-weight: bold; }
.log-run   { color: #8fd3ff; }

/* ===== Modal dialog ===== */
.modal-overlay {
    display: none;
    position: fixed;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 100;
    background: rgba(70, 30, 55, 0.35);
}
.modal {
    position: relative;
    width: 560px;
    max-width: 92%;
    margin: 50px auto 0 auto;
    background: #ffffff;
    border-radius: 8px;
    border: 1px solid #f0b8d0;
    box-shadow: 0 8px 28px rgba(80, 20, 60, 0.35);
}
.modal-title {
    padding: 9px 14px;
    border-radius: 8px 8px 0 0;
    background: #fce4ef;
    color: #ad1457;
    font-weight: bold;
    font-size: 14px;
}
.modal-body {
    max-height: 62vh;
    overflow-y: auto;
    padding: 10px 14px;
}
.modal-footer {
    padding: 8px 14px 12px 14px;
    text-align: right;
}
.modal-footer .btn { margin-left: 6px; padding: 5px 14px; }
.form-help {
    margin-bottom: 8px;
    padding: 6px 8px;
    background: #f3f8ff;
    border-left: 3px solid #64b5f6;
    color: #37474f;
    font-size: 12px;
    line-height: 1.6;
}
.form-row { margin: 8px 0; }
.form-label {
    display: block;
    margin-bottom: 3px;
    font-weight: bold;
    color: #6d3a58;
}
.form-input { width: 96%; }
.form-inline {
    display: -ms-flexbox;
    display: flex;
    -ms-flex-align: center;
    align-items: center;
}
.form-inline .form-input { -ms-flex: 1 1 auto; flex: 1 1 auto; width: auto; margin-right: 6px; }
.form-inline select.form-input { -ms-flex: 0 0 auto; flex: 0 0 auto; width: 190px; }
.form-hint { margin-top: 3px; color: #8a7d85; font-size: 11px; }
.form-error {
    display: none;
    margin-top: 8px;
    padding: 5px 8px;
    background: #ffebee;
    color: #c62828;
    border-radius: 3px;
}
.modal-message { line-height: 1.8; white-space: pre-wrap; }
.pick-list { margin: 0; padding: 0; list-style: none; }
.pick-list li {
    margin: 3px 0;
    padding: 5px 8px;
    border: 1px solid #eadde4;
    border-radius: 4px;
    cursor: pointer;
}
.pick-list li:hover { background: #e8f3fe; border-color: #2196f3; }
.block.disabled { opacity: 0.45; }
.block.disabled .step-label,
.block.disabled .group-name { text-decoration: line-through; }
.off-tag, .when-tag {
    margin: 0 6px 0 0;
    padding: 0 5px;
    border-radius: 3px;
    font-size: 11px;
    color: #ffffff;
    background: #9e9e9e;
}
.when-tag { margin-left: 8px; background: #7e57c2; }
.ph-select { margin-top: 3px; max-width: 96%; }
.modal.wide { width: 900px; }
.tpl-toolbar { margin-bottom: 6px; }
.tpl-cat {
    margin: 12px 0 4px 0;
    padding-bottom: 2px;
    border-bottom: 2px solid #f3d3e2;
    color: #ad1457;
    font-weight: bold;
    font-size: 14px;
}
.tpl-card {
    margin: 6px 0;
    padding: 6px 10px;
    border: 1px solid #eadde4;
    border-radius: 6px;
    background: #fffafd;
}
.tpl-head {
    display: -ms-flexbox;
    display: flex;
    -ms-flex-align: center;
    align-items: center;
}
.tpl-name { -ms-flex: 1 1 auto; flex: 1 1 auto; font-weight: bold; color: #4a2340; }
.tpl-level {
    margin-right: 6px;
    padding: 1px 7px;
    border-radius: 9px;
    font-size: 11px;
    background: #e3f2fd;
    color: #1565c0;
}
.tpl-level.lv2 { background: #fff3e0; color: #e65100; }
.tpl-level.lv3 { background: #fce4ec; color: #ad1457; }
.tpl-new { margin-right: 6px; padding: 1px 6px; border-radius: 9px; font-size: 11px; background: #fff59d; color: #6d4c00; }
.tpl-desc { margin-top: 3px; font-size: 12px; line-height: 1.6; color: #4a3f47; }
.tpl-meta { margin-top: 2px; font-size: 11px; color: #8a7d85; }
.diag-table { width: 100%; border-collapse: collapse; font-size: 12px; }
.diag-table td { padding: 4px 6px; border-bottom: 1px solid #f0e6ec; vertical-align: top; }
.diag-ok { color: #2e7d32; font-weight: bold; white-space: nowrap; }
.diag-ng { color: #c62828; font-weight: bold; white-space: nowrap; }
.diag-hint { margin-top: 8px; padding: 6px 8px; background: #fff8e1; border-left: 3px solid #ffb300; line-height: 1.7; white-space: pre-wrap; }
.img-capture-row { margin-top: 5px; }
.img-preview { margin-top: 4px; }
.img-preview img {
    max-width: 100%;
    max-height: 120px;
    border: 1px dashed #f48fb1;
    background: #ffffff;
}
</style>
</head>
<body>
<div class="app" id="app">

    <!-- ===== Top panel (fixed height) ===== -->
    <div class="top-panel">
        <div class="title-bar">
            <span class="app-title">ふじキュン♡のRPAマクロビルダー</span>
            <span class="save-state" id="saveState">✔ 保存済み</span>
            <span class="save-state schedule-state" id="scheduleState" style="display:none"></span>
            <span class="spacer"></span>
            <button class="btn" onclick="showSchedules()" title="決まった時刻にマクロを自動で実行します">⏰ 予定</button>
            <button class="btn" onclick="runDiagnostics()" title="PowerShell・音・クリップボード・文字認識など、この端末で使える機能を調べます">🩺 環境チェック</button>
            <button class="btn btn-save" onclick="saveProduction()" title="fujikyun_macros.json に上書き保存します (Ctrl+S)">💾 本番ファイルに保存</button>
        </div>

        <div class="toolbar-row">
            <span class="field-label">マクロ</span>
            <select id="macroSelect" onchange="onMacroSelectChange()" style="min-width:220px"></select>
            <button class="btn" onclick="addMacro()">＋ 新規</button>
            <button class="btn" onclick="renameMacro()">✎ 名前変更</button>
            <button class="btn" onclick="duplicateMacro()">⧉ 複製</button>
            <button class="btn btn-danger-lite" onclick="deleteMacro()">🗑 削除</button>
            <button class="btn btn-primary" onclick="showTemplateGallery()" title="Excel・Word・起案・財務会計などのお手本マクロから作ります">📚 テンプレート</button>
            <button class="btn" onclick="exportMacro()" title="選択中のマクロを1つのJSONファイルに書き出します（同僚との共有に）">📤 書出</button>
            <span class="file-btn-wrap"><button class="btn" tabindex="-1" title="書き出したマクロJSONを取り込みます">📥 取込</button><input type="file" id="macroImportInput" accept=".json" onchange="importMacroFile(this)"></span>
            <span class="field-label">対象ウィンドウ</span>
            <input type="text" id="targetWindowInput" class="input-md" placeholder="例: GPRIME" onchange="onTargetWindowChange()"
                   title="タイトルバーの文字（完全一致→前方一致→後方一致の順で探します）">
            <button class="btn" onclick="showWindowList()" title="いま開いているウィンドウの一覧から選びます">🔍 一覧</button>
        </div>

        <div class="toolbar-row">
            <span class="field-label">CSV</span>
            <input type="text" id="csvPathInput" class="input-lg" placeholder="CSVファイルのフルパス（📂参照 でも選べるキュン）">
            <span class="file-btn-wrap"><button class="btn" tabindex="-1">📂 参照</button><input type="file" id="csvFileInput" accept=".csv,.txt" onchange="onCsvFileChosen(this)"></span>
            <button class="btn" onclick="loadCsvFromInput()">📥 読込</button>
            <label class="chk"><input type="checkbox" id="csvHeaderCheck" checked onclick="reparseCsv()"> 1行目は見出し</label>
            <select id="csvEncodingSelect" onchange="reloadCsvIfLoaded()" title="文字コード">
                <option value="auto">文字コード自動判定</option>
                <option value="shift_jis">Shift_JIS</option>
                <option value="utf-8">UTF-8</option>
                <option value="unicode">UTF-16</option>
            </select>
            <span class="csv-info" id="csvInfo">CSV未読込</span>
        </div>

        <div class="toolbar-row">
            <span class="field-label">追加</span>
            <span id="paletteButtons"></span>
        </div>

        <div class="toolbar-row">
            <span class="field-label">編集</span>
            <button class="btn" id="undoBtn" onclick="undo()" title="元に戻す (Ctrl+Z)">↩️</button>
            <button class="btn" id="redoBtn" onclick="redo()" title="やり直し (Ctrl+Y)">↪️</button>
            <select id="historySelect" onchange="jumpToHistory()" style="width:260px" title="履歴から好きな時点に戻せます（最大30件）"></select>
            <button class="btn" onclick="moveSelected(-1)" title="選択ブロックを上へ (Alt+↑)">▲</button>
            <button class="btn" onclick="moveSelected(1)" title="選択ブロックを下へ (Alt+↓)">▼</button>
            <button class="btn" onclick="duplicateSelected()" title="選択ブロックを複製 (Ctrl+D)">⧉ 複製</button>
            <button class="btn" onclick="toggleDisabledSelected()" title="選択ブロックを一時的に無効化／有効化（実行時に飛ばします） (Ctrl+/)">⊘ 無効化</button>
            <button class="btn" onclick="setAllCollapsed(false)" title="すべてのブロックを展開">▼ 全展開</button>
            <button class="btn" onclick="setAllCollapsed(true)" title="すべてのブロックを折りたたみ">▶ 全折りたたみ</button>
            <button class="btn" id="recordBtn" onclick="toggleRecording()" title="ふつうに操作すると、クリック・キー・文字入力・ウィンドウの切り替えをコマンドとして記録します（選んだブロックの下に入ります）">⏺ 記録</button>
            <span class="insert-hint" id="insertHint"></span>
        </div>
    </div>

    <!-- ===== Macro command area (the only flexible area) ===== -->
    <div class="macro-container" id="macroContainer"></div>

    <!-- ===== Bottom panel (fixed height) ===== -->
    <div class="bottom-panel">
        <div class="toolbar-row run-row">
            <button class="btn btn-run" id="runBtn" onclick="startRun()">▶ 実行</button>
            <button class="btn" id="pauseBtn" onmousedown="togglePause()" disabled>⏸ 一時停止</button>
            <button class="btn btn-stop" id="stopBtn" onmousedown="stopRun('停止ボタン')" disabled title="Escキーでも止まります">⏹ 停止</button>
            <label>開始行 <input type="text" id="startRowInput" class="input-xs" value="1"></label>
            <label>終了行 <input type="text" id="endRowInput" class="input-xs" placeholder="最後"></label>
            <label>間隔 <input type="text" id="stepIntervalInput" class="input-xs" value="300"> ms</label>
            <label class="chk"><input type="checkbox" id="alarmCheck" checked> アラーム音</label>
            <button class="btn" onclick="playAlarm(true)" title="アラーム音をテスト再生">🔔</button>
            <label class="chk" title="ONにすると入力系コマンドの前に毎回、対象ウィンドウを前面化して確認します"><input type="checkbox" id="safeModeCheck"> 毎ステップ前面化</label>
            <label class="chk" title="全行おわったら完了の音を鳴らします"><input type="checkbox" id="notifyCheck" checked> 完了音</label>
            <button class="btn" onclick="toggleVarPanel()" title="変数・繰り返しの回数・この行のCSVの値をリアルタイムで表示します">📊 変数</button>
            <button class="btn" id="exportResultBtn" onclick="exportResultRows()" title="各行の実行結果と、COPY・RECORD で記録した値をCSVに保存します">↓ 実行結果CSV (0)</button>
            <button class="btn" id="exportErrorBtn" onclick="exportErrorRows()">↓ エラー行をCSV保存 (0)</button>
            <span class="spacer"></span>
            <span class="progress" id="progressText">待機中キュン♡</span>
        </div>
        <div class="bottom-split">
            <div class="log-area" id="logArea"></div>
            <div class="var-panel" id="varPanel"></div>
        </div>
    </div>
</div>

<!-- ===== Modal dialog ===== -->
<div class="modal-overlay" id="modalOverlay">
    <div class="modal" id="modalBox">
        <div class="modal-title" id="modalTitle"></div>
        <div class="modal-body" id="modalBody"></div>
        <div class="modal-footer" id="modalFooter"></div>
    </div>
</div>

<script type="text/javascript">
// =====================================================================
//  Fujikyun RPA Macro Builder  (HTA / ES5 only)
//
//  Sections, in order:
//    Constants / global state
//    Utilities, log, ActiveX / files, per-PC settings, CSV, placeholders
//    Commands      key presets, blocks, conditions, string operations, COMMAND_DEFS, palette
//    Data          data model, undo / redo, macro management
//    Editor        groups, rendering, selection, drag & drop, step operations, dialogs,
//                  step editor, CSV loading, window list / capture helpers
//    Windows       PowerShell bridge and script builders (click, image, OCR), alarm, diagnostics
//    Results       error rows, run results, macro export / import
//    Runner        run loop, per-step execution, run-time commands, variable watch
//    Recording, schedules, built-in templates, keyboard shortcuts, startup
// =====================================================================

// ----- Data version and files (all next to the HTA) -----
var DATA_VERSION = 27;  // 27: reorganised command set (JSON values for multi-setting commands); older files are not migrated
var MACRO_FILE_NAME = "fujikyun_macros.json";
var TEMP_FILE_NAME = "fujikyun_macros_temp.json";
var DISCARDED_TEMP_PREFIX = "fujikyun_macros_temp_discarded";   // + "_<timestamp>.json", one per discard
var BROKEN_FILE_PREFIX = "fujikyun_macros_broken";               // copy of a production file that could not be read
var BACKUP_FILE_NAME = "fujikyun_macros_backup.json";            // previous production version, kept by every save
var SETTINGS_FILE_NAME = "fujikyun_settings.json";
var ERROR_FILE_NAME = "fujikyun_error_list.csv";
var RESULT_FILE_NAME = "fujikyun_result.csv";
var SAMPLE_FOLDER_NAME = "samples";
var EVIDENCE_FOLDER_NAME = "evidence";
var EXPORT_FOLDER_NAME = "macro_export";
var IMAGE_FOLDER_NAME = "rpa_images";

// ----- Editor -----
var HISTORY_LIMIT = 30;
var INDENT_PX = 25;
var LOG_LIMIT = 500;

// ----- Runner -----
var PASTE_SETTLE_MS = 250;      // let the target app take a paste before the clipboard changes
var COPY_WAIT_MS = 400;
var WINDOW_RETRY_MAX = 3;
var WINDOW_RETRY_INTERVAL_MS = 1000;
var STOP_HOLD_POLLS = 8;        // Esc held for 8 polls x 120 ms (about 1 s) stops a run from any window
var CALL_DEPTH_MAX = 10;
var ALARM_WAV_PATH = "C:\\Windows\\Media\\Alarm01.wav";
var NOTIFY_WAV_PATH = "C:\\Windows\\Media\\tada.wav";

// ----- PowerShell, image and text recognition -----
var POWERSHELL_PATH = "%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe";
var PS_TIMEOUT_SEC = 30;
var IMG_DEFAULT_THRESHOLD = 0.9;
var IMG_COLOR_TOLERANCE = 24;   // per RGB channel (0-255)
var IMG_SEARCH_RETRY = 3;       // screen captures per CLICK_IMG (1 second apart)
var IMG_PS_TIMEOUT_SEC = 90;
var IMG_SEARCH_DEADLINE_SEC = 60;
var OCR_RETRY = 3;

// ----- Global state -----
var shell = null;
var fso = null;
var appDir = "";
var appData = { version: DATA_VERSION, macros: [] };
var saveBlockReason = "";       // why saving over the production file needs an explicit confirmation
var startupNotices = [];        // problems found while loading, shown once the window is up
var isDirty = false;
var currentMacroIndex = 0;
var selectedIndex = -1;
var selectedEl = null;
var historyStack = [];
var historyPos = -1;
var dragState = null;
var modalButtons = [];
var modalToken = 0;
var modalDismissFn = null;
var lastWindowTitles = [];
var csvState = { path: "", encoding: "", records: [], header: null, rows: [] };
var csvParseWarnings = [];
var runState = null;
var runHeader = null;           // CSV header snapshot taken at run start (used by the result/error CSV exports)
var errorRows = [];
var resultRows = [];
var resultColumns = [];
var focusCheckTrusted = true;
var alarmPlayer = null;
var notifyPlayer = null;
var alarmVoice = null;
var psSeq = 0;
var pendingTempFiles = [];
var psPreferredLaunch = null;   // launch method confirmed to deliver a result this session
var psLaunchBlocked = false;    // every launch method threw: fail fast until the next diagnostics
var psLangRestricted = false;   // diagnostics found PowerShell in a restricted language mode
var psLastFailed = false;       // the latest PowerShell call did not come back (alarm skips straight to fallbacks)
var activePsJobs = {};          // base path -> job, for PowerShell calls whose files must not be cleaned up yet
var recState = null;            // screen recording in progress
var schedules = [];
var scheduleTimer = null;
var autoRunScheduleId = "";
var autoRunCloseWhenDone = false;

// =====================================================================
//  Utilities
// =====================================================================
function byId(id) {
    return document.getElementById(id);
}

function escapeHtml(s) {
    return String(s == null ? "" : s)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
}

function trimText(s) {
    return String(s == null ? "" : s).replace(/^\s+|\s+$/g, "");
}

function truncateText(s, n) {
    s = String(s == null ? "" : s).replace(/\r\n|\r|\n/g, "⏎");
    return s.length > n ? s.substring(0, n) + "…" : s;
}

function deepCopy(obj) {
    return JSON.parse(JSON.stringify(obj));
}

function toInt(v, def) {
    var n = parseInt(v, 10);
    return isNaN(n) ? def : n;
}

function pad2(n) {
    return (n < 10 ? "0" : "") + n;
}

function timeText(d) {
    d = d || new Date();
    return pad2(d.getHours()) + ":" + pad2(d.getMinutes()) + ":" + pad2(d.getSeconds());
}

function dateTimeText(d) {
    d = d || new Date();
    return d.getFullYear() + "/" + pad2(d.getMonth() + 1) + "/" + pad2(d.getDate()) + " " + timeText(d);
}

function hasClass(el, cls) {
    return !!el && (" " + el.className + " ").indexOf(" " + cls + " ") >= 0;
}

function addClass(el, cls) {
    if (el && !hasClass(el, cls)) {
        el.className = el.className ? el.className + " " + cls : cls;
    }
}

function removeClass(el, cls) {
    if (!el || !el.className) {
        return;
    }
    el.className = trimText((" " + el.className + " ").split(" " + cls + " ").join(" "));
}

function preventEvent(e) {
    if (!e) {
        return false;
    }
    if (e.preventDefault) {
        e.preventDefault();
    }
    e.returnValue = false;
    return false;
}

function generateId() {
    var t = ("0000" + (new Date().getTime() % 65536).toString(16)).slice(-4);
    var r = ("0000" + Math.floor(Math.random() * 65536).toString(16)).slice(-4);
    return t + r;
}

function uniqueMacroId() {
    var id, i, used;
    do {
        id = generateId();
        used = false;
        for (i = 0; i < appData.macros.length; i++) {
            if (appData.macros[i].id === id) {
                used = true;
            }
        }
    } while (used);
    return id;
}

// Quote a string as a PowerShell single-quoted literal (smart quotes are also quote chars in PS)
function psQuote(s) {
    return "'" + String(s == null ? "" : s).replace(/['\u2018\u2019\u201A\u201B]/g, "$&$&") + "'";
}

// WScript.Shell.SendKeys has no {SPACE} code, so translate it to a literal space
function normalizeSendKeys(keys) {
    return String(keys == null ? "" : keys).replace(/\{SPACE(?:\s+(\d+))?\}/gi, function (m, count) {
        var n = count ? parseInt(count, 10) : 1;
        return new Array(n + 1).join(" ");
    });
}

// COM errors may come with an empty message: always show the HRESULT too
function errorText(e) {
    if (!e) {
        return "不明なエラー";
    }
    var msg = e["message"] || e["description"] || "";
    var code = typeof e.number === "number" && e.number !== 0 ? " [0x" + (e.number >>> 0).toString(16).toUpperCase() + "]" : "";
    return (msg || "詳細不明") + code;
}

function safeFileName(s) {
    var name = trimText(String(s == null ? "" : s).replace(/[\\\/:*?"<>|\r\n\t]/g, "_"));
    return name.length > 80 ? name.substring(0, 80) : name;
}

function dateStamp(d) {
    d = d || new Date();
    return d.getFullYear() + pad2(d.getMonth() + 1) + pad2(d.getDate());
}

function timeStamp(d) {
    d = d || new Date();
    return dateStamp(d) + "_" + pad2(d.getHours()) + pad2(d.getMinutes()) + pad2(d.getSeconds());
}

function ensureFolder(path) {
    if (!fso.FolderExists(path)) {
        var parent = fso.GetParentFolderName(path);
        if (parent && !fso.FolderExists(parent)) {
            ensureFolder(parent);
        }
        fso.CreateFolder(path);
    }
    return path;
}

// Japanese era (only the eras a clerk will meet in practice)
function warekiOf(d) {
    var y = d.getFullYear();
    var m = d.getMonth() + 1;
    var era;
    var ey;
    if (y > 2019 || (y === 2019 && m >= 5)) {
        era = "令和"; ey = y - 2018;
    } else if (y > 1989 || (y === 1989 && (m > 1 || d.getDate() >= 8))) {
        era = "平成"; ey = y - 1988;
    } else {
        era = "昭和"; ey = y - 1925;
    }
    return era + (ey === 1 ? "元" : String(ey)) + "年";
}

function fileNameOf(path) {
    return String(path == null ? "" : path).replace(/^.*[\\\/]/, "");
}

function clampThreshold(v) {
    var n = parseFloat(v);
    if (isNaN(n)) {
        return IMG_DEFAULT_THRESHOLD;
    }
    return Math.min(1, Math.max(0.5, n));
}

// Relative image paths are resolved against the HTA folder
function resolveImagePath(p) {
    p = trimText(p).replace(/^"+|"+$/g, "");
    if (p === "") {
        return "";
    }
    if (/^[A-Za-z]:[\\\/]/.test(p) || /^\\\\/.test(p)) {
        return p;
    }
    return appFilePath(p.replace(/\//g, "\\"));
}

// =====================================================================
//  Log
// =====================================================================
function log(message, level) {
    var area = byId("logArea");
    if (!area) {
        return;
    }
    var line = document.createElement("div");
    line.className = "log-line log-" + (level || "info");
    line.appendChild(document.createTextNode("[" + timeText() + "] " + message));
    area.appendChild(line);
    while (area.childNodes.length > LOG_LIMIT) {
        area.removeChild(area.firstChild);
    }
    area.scrollTop = area.scrollHeight;
}

// =====================================================================
//  ActiveX / file system
// =====================================================================
function initActiveX() {
    try {
        shell = new ActiveXObject("WScript.Shell");
    } catch (e1) {
        shell = null;
    }
    try {
        fso = new ActiveXObject("Scripting.FileSystemObject");
    } catch (e2) {
        fso = null;
    }
    return !!(shell && fso);
}

function resolveAppDir() {
    var path = "";
    var m;
    try {
        var hta = byId("fujikyunRPABuilder");
        var cmdLine = hta && hta.commandLine ? String(hta.commandLine) : "";
        m = cmdLine.match(/"([^"]+\.hta)"/i) || cmdLine.match(/(\S+\.hta)/i);
        if (m) {
            path = m[1];
        }
    } catch (e1) {
        path = "";
    }
    if (!path) {
        var href = String(location.href).replace(/[?#].*$/, "");
        try {
            href = decodeURIComponent(href);
        } catch (e2) {
            try { href = unescape(href); } catch (e3) { /* keep raw */ }
        }
        if (/^file:\/\/\/[A-Za-z]:/i.test(href)) {
            path = href.replace(/^file:\/\/\//i, "");
        } else if (/^file:\/\//i.test(href)) {
            path = "//" + href.replace(/^file:\/\/+/i, "");
        } else {
            path = href;
        }
        path = path.replace(/\//g, "\\");
    }
    var dir = "";
    try {
        dir = fso.GetParentFolderName(path);
    } catch (e4) {
        dir = "";
    }
    if (!dir || !fso.FolderExists(dir)) {
        try { dir = shell.CurrentDirectory; } catch (e5) { dir = ""; }
    }
    return dir;
}

function appFilePath(name) {
    return appDir ? appDir.replace(/\\+$/, "") + "\\" + name : name;
}

function readTextFile(path, charset) {
    var text = "";
    try {
        var st = new ActiveXObject("ADODB.Stream");
        st.Type = 2; // adTypeText
        st.Charset = charset || "utf-8";
        st.Open();
        st.LoadFromFile(path);
        text = st.ReadText(-1); // adReadAll
        st.Close();
    } catch (e) {
        // Fallback without ADODB.Stream. writeTextFile's own fallback writes UTF-16 with a BOM, so try
        // Unicode first and keep it when it looks like such a file; otherwise read as system ANSI
        text = readWithFso(path, -1);
        if (charset !== "unicode" && !(text.charCodeAt(0) === 0xFEFF || /^\s*[\[{]/.test(text))) {
            text = readWithFso(path, 0);
        }
    }
    if (text.charCodeAt(0) === 0xFEFF) {
        text = text.substring(1);
    }
    return text;
}

function readWithFso(path, format) {
    var ts = fso.OpenTextFile(path, 1, false, format); // -1 = Unicode, 0 = system ANSI
    var text = ts.AtEndOfStream ? "" : ts.ReadAll();
    ts.Close();
    return text;
}

// The only good copy of the macros is never overwritten in place: write a sibling file, read it
// back, keep the previous version as backupPath, then replace the target
function writeFileSafely(path, text, backupPath) {
    var tmp = path + ".saving";
    writeTextFile(tmp, text, false);
    if (readTextFile(tmp, "utf-8") !== text) {
        deleteFileQuietly(tmp);
        throw new Error("書き込んだ内容を読み直したら一致しなかった（ディスクやネットワークを確認してね）");
    }
    if (backupPath && fso.FileExists(path)) {
        fso.CopyFile(path, backupPath, true);
    }
    fso.CopyFile(tmp, path, true);
    fso.DeleteFile(tmp, true);
}

// Write UTF-8 (BOM is kept only when withBom is true, e.g. CSV for Excel)
function writeTextFile(path, text, withBom) {
    try {
        var st = new ActiveXObject("ADODB.Stream");
        st.Type = 2;
        st.Charset = "utf-8";
        st.Open();
        st.WriteText(text);
        if (withBom) {
            st.SaveToFile(path, 2); // adSaveCreateOverWrite
            st.Close();
            return;
        }
        st.Position = 0;
        st.Type = 1; // adTypeBinary
        st.Position = 3; // skip BOM
        var bin = new ActiveXObject("ADODB.Stream");
        bin.Type = 1;
        bin.Open();
        st.CopyTo(bin);
        bin.SaveToFile(path, 2);
        bin.Close();
        st.Close();
    } catch (e) {
        var ts = fso.CreateTextFile(path, true, true); // Unicode fallback
        ts.Write(text);
        ts.Close();
    }
}

function deleteFileQuietly(path) {
    try {
        if (fso && fso.FileExists(path)) {
            fso.DeleteFile(path, true);
        }
    } catch (e) {
        /* ignore */
    }
}

// Files of PowerShell calls still in flight are kept: deleting their .ps1 or .cancel would break them
function isActivePsFile(path) {
    for (var base in activePsJobs) {
        if (activePsJobs.hasOwnProperty(base) && path.indexOf(base) === 0) {
            return true;
        }
    }
    return false;
}

function cleanupTempFiles() {
    var remain = [];
    for (var i = 0; i < pendingTempFiles.length; i++) {
        if (isActivePsFile(pendingTempFiles[i])) {
            remain.push(pendingTempFiles[i]);
            continue;
        }
        deleteFileQuietly(pendingTempFiles[i]);
        if (fso && fso.FileExists(pendingTempFiles[i])) {
            remain.push(pendingTempFiles[i]);
        }
    }
    pendingTempFiles = remain;
}

// Per-PC settings (schedules, the PowerShell launch route that works here)
function loadSettings() {
    try {
        var path = appFilePath(SETTINGS_FILE_NAME);
        if (fso && appDir && fso.FileExists(path)) {
            var s = JSON.parse(readTextFile(path, "utf-8"));
            if (s && s.schedules instanceof Array) {
                schedules = [];
                for (var k = 0; k < s.schedules.length; k++) {
                    if (s.schedules[k] && s.schedules[k].id && s.schedules[k].time) {
                        schedules.push(s.schedules[k]);
                    }
                }
            }
            if (s && s.psLaunch && LAUNCH_METHOD_NAMES[s.psLaunch.method] && s.psLaunch.exe) {
                // The folder may have been copied to another PC: only trust a PowerShell that exists here
                var exes = powershellCandidates();
                for (var i = 0; i < exes.length; i++) {
                    if (exes[i].toLowerCase() === String(s.psLaunch.exe).toLowerCase()) {
                        psPreferredLaunch = { method: s.psLaunch.method, exe: exes[i] };
                    }
                }
            }
        }
    } catch (e) {
        /* a broken settings file only means the launch routes are probed again */
    }
}

function saveSettings() {
    try {
        if (fso && appDir) {
            writeTextFile(appFilePath(SETTINGS_FILE_NAME), JSON.stringify({ psLaunch: psPreferredLaunch, schedules: schedules }, null, 2), false);
        }
    } catch (e) {
        /* ignore */
    }
}

// =====================================================================
//  CSV
// =====================================================================
// Like Excel / RFC 4180: a quote opens a quoted field only as the field's first character
// (12"モニタ stays text). Blank lines inside the data keep their place so row numbers match the
// file (they are skipped at run time); only trailing blank lines are dropped.
function parseCsv(text) {
    var records = [];
    var row = [];
    var field = "";
    var inQuotes = false;
    var atFieldStart = true;
    var quoteRecord = 0;
    var i = 0;
    var len = text.length;
    var c;
    csvParseWarnings = [];
    for (; i < len; i++) {
        c = text.charAt(i);
        if (inQuotes) {
            if (c === '"') {
                if (text.charAt(i + 1) === '"') {
                    field += '"';
                    i++;
                } else {
                    inQuotes = false;
                }
            } else {
                field += c;
            }
        } else if (c === '"' && atFieldStart) {
            inQuotes = true;
            atFieldStart = false;
            quoteRecord = records.length + 1;
        } else if (c === ",") {
            row.push(field);
            field = "";
            atFieldStart = true;
        } else if (c === "\r" || c === "\n") {
            row.push(field);
            field = "";
            records.push(row);
            row = [];
            atFieldStart = true;
            if (c === "\r" && text.charAt(i + 1) === "\n") {
                i++;
            }
        } else {
            field += c;
            atFieldStart = false;
        }
    }
    if (inQuotes) {
        csvParseWarnings.push(quoteRecord + "件目のレコードで始まった \" が閉じられていないから、ファイルの最後までを1つの値として読んじゃったキュン。CSVを確認してね");
    }
    if (field !== "" || row.length > 0) {
        row.push(field);
        records.push(row);
    }
    while (records.length && isBlankRow(records[records.length - 1])) {
        records.pop();
    }
    return records;
}

function isBlankRow(row) {
    for (var i = 0; i < row.length; i++) {
        if (row[i] !== "") {
            return false;
        }
    }
    return true;
}

function toHalfWidthDigits(s) {
    return String(s == null ? "" : s).replace(/[０-９]/g, function (ch) {
        return String.fromCharCode(ch.charCodeAt(0) - 0xFEE0);
    });
}

function toCsvField(v) {
    v = v == null ? "" : String(v);
    return /[",\r\n]/.test(v) ? '"' + v.replace(/"/g, '""') + '"' : v;
}

function readCsvText(path, encoding) {
    if (encoding && encoding !== "auto") {
        return { text: readTextFile(path, encoding), encoding: encoding };
    }
    var text = readTextFile(path, "utf-8");
    if (text.indexOf("\uFFFD") < 0) {
        return { text: text, encoding: "utf-8" };
    }
    return { text: readTextFile(path, "shift_jis"), encoding: "shift_jis" };
}

function encodingLabel(enc) {
    var map = { "utf-8": "UTF-8", "shift_jis": "Shift_JIS", "unicode": "UTF-16", "auto": "自動" };
    return map[enc] || enc;
}

function csvMaxColumns() {
    var max = csvState.header ? csvState.header.length : 0;
    var limit = Math.min(csvState.rows.length, 200);
    for (var i = 0; i < limit; i++) {
        if (csvState.rows[i].length > max) {
            max = csvState.rows[i].length;
        }
    }
    return max;
}

function csvHeaderName(col) {
    return csvState.header && col >= 1 && col <= csvState.header.length ? trimText(csvState.header[col - 1]) : "";
}

// =====================================================================
//  Placeholders  {{1}} {{列名}} {{$変数}} {{ROW}} {{ROW+1}} {{TODAY}} {{WAREKI}} ...
// =====================================================================
var PLACEHOLDER_HELP = [
    ["{{ROW}}", "CSVの行番号（1始まり）"],
    ["{{$回数}}", "繰り返しの何回目か（変数）"],
    ["{{ROW+1}}", "行番号＋1（Excelの見出し行ぶんずらす時に）"],
    ["{{TODAY}}", "今日 2026/09/30 形式"],
    ["{{TODAY_JP}}", "今日 2026年9月30日 形式"],
    ["{{WAREKI}}", "今日 令和8年9月30日 形式"],
    ["{{WAREKI_YEAR}}", "令和8年 形式"],
    ["{{YYYYMMDD}}", "今日 20260930 形式"],
    ["{{NOW}}", "いまの時刻 14:05 形式"],
    ["{{TIMESTAMP}}", "20260930_140512 形式（ファイル名向け）"],
    ["{{YEAR}}", "西暦の年"],
    ["{{MONTH}}", "月"],
    ["{{DAY}}", "日"]
];

function currentRowForPlaceholders(rs) {
    return rs && rs.rows && rs.rows[rs.rowPos] ? rs.rows[rs.rowPos] : { no: 0, data: [] };
}

function placeholderValue(key, rs) {
    var d = new Date();
    var row = currentRowForPlaceholders(rs);
    var up = key.toUpperCase();
    var m;
    var i;
    if (/^\d+$/.test(key)) {
        var col = toInt(key, 0);
        return col >= 1 && col <= row.data.length ? String(row.data[col - 1]) : "";
    }
    // An exact CSV header wins over the built-in names, so a column called "ROW" or "DAY" works as offered
    if (csvState.header) {
        for (i = 0; i < csvState.header.length; i++) {
            if (trimText(csvState.header[i]) === key) {
                return i < row.data.length ? String(row.data[i]) : "";
            }
        }
    }
    if (key.charAt(0) === "$") {
        var vn = trimText(key.substring(1));
        if (rs && rs.vars && rs.vars.hasOwnProperty(vn)) {
            return String(rs.vars[vn]);
        }
        log("（変数 $" + vn + " にはまだ値が入っていないから、空っぽとして使うね）", "info");
        return "";
    }
    if ((m = up.match(/^ROW\s*([+\-])\s*(\d+)$/))) {
        return String(row.no + (m[1] === "+" ? 1 : -1) * toInt(m[2], 0));
    }
    switch (up) {
    case "ROW": return String(row.no);
    case "TODAY": return d.getFullYear() + "/" + pad2(d.getMonth() + 1) + "/" + pad2(d.getDate());
    case "TODAY_JP": return d.getFullYear() + "年" + (d.getMonth() + 1) + "月" + d.getDate() + "日";
    case "WAREKI": return warekiOf(d) + (d.getMonth() + 1) + "月" + d.getDate() + "日";
    case "WAREKI_YEAR": return warekiOf(d);
    case "YYYYMMDD": return dateStamp(d);
    case "NOW": return pad2(d.getHours()) + ":" + pad2(d.getMinutes());
    case "TIMESTAMP": return timeStamp(d);
    case "YEAR": return String(d.getFullYear());
    case "MONTH": return String(d.getMonth() + 1);
    case "DAY": return String(d.getDate());
    }
    return null;
}

// unsafe (optional array): collects substituted values that contain characters with a meaning in
// a command line (RUN goes through cmd.exe / ShellExecute), so data can never become a command
var COMMAND_UNSAFE_RE = /["&|<>^%\r\n]/;

function expandPlaceholders(text, rs, unsafe) {
    return String(text == null ? "" : text).replace(/\{\{([^{}]+)\}\}/g, function (all, rawKey) {
        var v = placeholderValue(trimText(rawKey), rs);
        if (v === null) {
            log("⚠ 差し込み " + all + " が何か分からなかったから、そのままにしたキュン（列名のつづりを確認してね）", "warn");
            return all;
        }
        if (unsafe && COMMAND_UNSAFE_RE.test(v)) {
            unsafe.push(all + "＝「" + truncateText(v, 20) + "」");
        }
        return v;
    });
}

// Choices for the "差し込み ▼" helper in the editor
function placeholderChoices() {
    var list = [];
    var cols = csvMaxColumns();
    var i;
    for (i = 1; i <= cols; i++) {
        var name = csvHeaderName(i);
        // An all-digit header would be read as a column number, and braces cannot be inside a placeholder
        var byName = name && !/^\d+$/.test(name) && !/[{}]/.test(name);
        list.push([byName ? "{{" + name + "}}" : "{{" + i + "}}", "CSV " + i + "列目" + (name ? "「" + name + "」" : "")]);
    }
    if (cols === 0) {
        list.push(["{{1}}", "CSV 1列目（{{2}}なら2列目…／見出し名 {{氏名}} でもOK）"]);
    }
    var vars = definedVarNames(currentSteps());
    for (i = 0; i < vars.length; i++) {
        list.push(["{{$" + vars[i] + "}}", "変数「" + vars[i] + "」"]);
    }
    return list.concat(PLACEHOLDER_HELP);
}

function insertPlaceholder(select, inputId) {
    var el = byId(inputId);
    if (el && select.value !== "") {
        el.value += select.value;
        try { el.focus(); } catch (e) { /* ignore */ }
    }
    select.selectedIndex = 0;
}

// =====================================================================
//  Commands: key presets
// =====================================================================
var KEY_PRESETS = [
    ["{TAB}", "Tab移動"],
    ["+{TAB}", "Shift+Tabで戻る"],
    ["{ENTER}", "Enterキー"],
    ["{SPACE}", "スペースキー"],
    ["{ESC}", "Escキー"],
    ["{UP}", "↑キー"],
    ["{DOWN}", "↓キー"],
    ["{LEFT}", "←キー"],
    ["{RIGHT}", "→キー"],
    ["{BS}", "BackSpaceキー"],
    ["{DELETE}", "Deleteキー"],
    ["{HOME}", "Homeキー"],
    ["{END}", "Endキー"],
    ["{PGUP}", "PageUpキー"],
    ["{PGDN}", "PageDownキー"],
    ["{F5}", "F5キー"],
    ["{F12}", "名前を付けて保存 (F12)"],
    ["^{HOME}", "先頭へ (Ctrl+Home)"],
    ["^{END}", "末尾へ (Ctrl+End)"],
    ["^g", "ジャンプ (Ctrl+G)"],
    ["^h", "置換 (Ctrl+H)"],
    ["^n", "新規作成 (Ctrl+N)"],
    ["^w", "閉じる (Ctrl+W)"],
    ["^l", "アドレスバーへ (Ctrl+L)"],
    ["^a", "全選択 (Ctrl+A)"],
    ["^c", "コピー (Ctrl+C)"],
    ["^v", "貼り付け (Ctrl+V)"],
    ["^s", "保存 (Ctrl+S)"],
    ["%{F4}", "閉じる (Alt+F4)"],
    ["%y", "はい (Alt+Y)"],
    ["%n", "いいえ (Alt+N)"]
];

function keyDisplayName(key) {
    for (var i = 0; i < KEY_PRESETS.length; i++) {
        if (KEY_PRESETS[i][0].toLowerCase() === String(key).toLowerCase()) {
            return KEY_PRESETS[i][1];
        }
    }
    return String(key);
}

// =====================================================================
//  Commands: blocks, conditions, string operations, definitions, palette
// =====================================================================
// Every block is START ... [MIDDLE] ... END; the editor keeps them balanced and the runner jumps
// between the markers (the step list itself stays flat)
var BLOCK_PAIRS = { GROUP_START: "GROUP_END", LOOP_START: "LOOP_END", IF_START: "IF_END", TRY_START: "TRY_END" };
var BLOCK_ENDS = { GROUP_END: "GROUP_START", LOOP_END: "LOOP_START", IF_END: "IF_START", TRY_END: "TRY_START" };
var BLOCK_MIDDLES = { ELSE: "IF_START", CATCH: "TRY_START" };

function isBlockStart(cmd) {
    return BLOCK_PAIRS.hasOwnProperty(cmd);
}

function isBlockEnd(cmd) {
    return BLOCK_ENDS.hasOwnProperty(cmd);
}

function isBlockMiddle(cmd) {
    return BLOCK_MIDDLES.hasOwnProperty(cmd);
}

// Definition for markers without settings (block ends, ELSE, CATCH, BREAK, CONTINUE)
function blockMarkerDef(title, icon, help) {
    return {
        title: title, icon: icon, defaultVal: "", help: help, fields: [], marker: true,
        parse: function () { return {}; },
        compose: function () { return ""; },
        validate: function () { return ""; },
        autoLabel: function () { return title; }
    };
}

function jsonVal(val, defaults) {
    var obj = {};
    try {
        obj = JSON.parse(String(val || "{}")) || {};
    } catch (e) {
        obj = {};
    }
    var out = {};
    for (var k in defaults) {
        if (defaults.hasOwnProperty(k)) {
            out[k] = obj.hasOwnProperty(k) && obj[k] != null ? String(obj[k]) : defaults[k];
        }
    }
    return out;
}

function jsonCompose(v, keys) {
    var obj = {};
    for (var i = 0; i < keys.length; i++) {
        obj[keys[i]] = v[keys[i]] == null ? "" : String(v[keys[i]]);
    }
    return JSON.stringify(obj);
}

function varNameError(name) {
    name = trimText(name);
    if (name === "") {
        return "名前を入れてね♡";
    }
    return /[\s{}:,$]/.test(name) ? "名前に 空白 { } : , $ は使えないキュン" : "";
}

var COND_OPS = [
    ["EQ", "と等しい"], ["NE", "と違う"], ["CONTAINS", "を含む"], ["NOT_CONTAINS", "を含まない"],
    ["EMPTY", "が空っぽ（くらべる相手は使わない）"], ["NOT_EMPTY", "が空っぽでない（くらべる相手は使わない）"],
    ["GT", "より大きい（数）"], ["GE", "以上（数）"], ["LT", "より小さい（数）"], ["LE", "以下（数）"],
    ["REGEX", "が正規表現に一致する"],
    ["WINDOW", "というウィンドウがある（調べる値にタイトル）"], ["NO_WINDOW", "というウィンドウがない"],
    ["FILE", "というファイルがある（調べる値にパス）"], ["NO_FILE", "というファイルがない"]
];
var COND_UNARY = { EMPTY: "が空っぽ", NOT_EMPTY: "が空っぽでない", WINDOW: "というウィンドウがある", NO_WINDOW: "というウィンドウがない", FILE: "というファイルがある", NO_FILE: "というファイルがない" };
var COND_BINARY = { EQ: "と等しい", NE: "と違う", CONTAINS: "を含む", NOT_CONTAINS: "を含まない", GT: "より大きい", GE: "以上", LT: "より小さい", LE: "以下", REGEX: "の正規表現に一致する" };

function conditionNeedsLeft(op) {
    return op !== "EMPTY" && op !== "NOT_EMPTY";
}

function describeCondition(c) {
    var left = "「" + truncateText(c.left, 20) + "」";
    if (COND_UNARY[c.op]) {
        return left + COND_UNARY[c.op];
    }
    return left + "が「" + truncateText(c.right, 20) + "」" + (COND_BINARY[c.op] || "と等しい");
}

// "1,234" "１２３" " 45 " -> number; anything else -> null
function toNumberOrNull(s) {
    var t = toHalfWidthDigits(trimText(s)).replace(/,/g, "");
    return /^[+\-]?\d+(\.\d+)?$/.test(t) ? parseFloat(t) : null;
}

function evalCondition(c, rs) {
    var l = expandPlaceholders(c.left, rs);
    var r = expandPlaceholders(c.right, rs);
    var ln = toNumberOrNull(l);
    var rn = toNumberOrNull(r);
    var numeric = ln !== null && rn !== null;
    switch (c.op) {
    case "EQ": return numeric ? ln === rn : l === r;
    case "NE": return numeric ? ln !== rn : l !== r;
    case "CONTAINS": return l.indexOf(r) >= 0;
    case "NOT_CONTAINS": return l.indexOf(r) < 0;
    case "EMPTY": return trimText(l) === "";
    case "NOT_EMPTY": return trimText(l) !== "";
    case "GT": return numeric ? ln > rn : l > r;
    case "GE": return numeric ? ln >= rn : l >= r;
    case "LT": return numeric ? ln < rn : l < r;
    case "LE": return numeric ? ln <= rn : l <= r;
    case "REGEX": return new RegExp(r).test(l);
    case "FILE": return !!(fso && fso.FileExists(l));
    case "NO_FILE": return !(fso && fso.FileExists(l));
    case "WINDOW":
    case "NO_WINDOW":
        var found = false;
        try {
            found = shell.AppActivate(l);
        } catch (e) {
            found = false;
        }
        // Checking activates the window: give the focus back to the input target
        if (found && rs && rs.activeTitle) {
            try { shell.AppActivate(rs.activeTitle); } catch (e2) { /* ignore */ }
        }
        return c.op === "WINDOW" ? found : !found;
    }
    return false;
}

// Safe arithmetic (no eval): numbers, + - * / %, parentheses; full-width and commas are accepted
function calcExpression(text) {
    var s = toHalfWidthDigits(String(text == null ? "" : text))
        .replace(/[,，]/g, "").replace(/＋/g, "+").replace(/[－−]/g, "-").replace(/[＊×]/g, "*")
        .replace(/[／÷]/g, "/").replace(/％/g, "%").replace(/（/g, "(").replace(/）/g, ")").replace(/．/g, ".")
        .replace(/\s+/g, "");
    var pos = 0;
    function peek() {
        return s.charAt(pos);
    }
    function number() {
        var m = /^\d+(\.\d+)?/.exec(s.substring(pos));
        if (!m) {
            throw new Error("計算できない文字があるよ: " + (s.substring(pos) || "（式が途中で終わっている）"));
        }
        pos += m[0].length;
        return parseFloat(m[0]);
    }
    function factor() {
        var c = peek();
        if (c === "+") { pos++; return factor(); }
        if (c === "-") { pos++; return -factor(); }
        if (c === "(") {
            pos++;
            var v = expr();
            if (peek() !== ")") {
                throw new Error("かっこが閉じていないよ");
            }
            pos++;
            return v;
        }
        return number();
    }
    function term() {
        var v = factor();
        while (peek() === "*" || peek() === "/" || peek() === "%") {
            var op = s.charAt(pos++);
            var r = factor();
            if (op === "*") {
                v *= r;
            } else {
                if (r === 0) {
                    throw new Error("0で割り算しようとしたよ");
                }
                v = op === "/" ? v / r : v % r;
            }
        }
        return v;
    }
    function expr() {
        var v = term();
        while (peek() === "+" || peek() === "-") {
            var op = s.charAt(pos++);
            var r = term();
            v = op === "+" ? v + r : v - r;
        }
        return v;
    }
    if (s === "") {
        throw new Error("計算式が空っぽだよ");
    }
    var result = expr();
    if (pos < s.length) {
        throw new Error("計算できない文字があるよ: " + s.substring(pos));
    }
    return String(Math.round(result * 1e10) / 1e10);
}

var STR_OPS = [
    ["REPLACE", "置換：A を B に置きかえる"],
    ["REGEX_REPLACE", "正規表現で置換：パターンA を B に（$1 などOK）"],
    ["REGEX_EXTRACT", "正規表現で取り出す：パターンA の一致部分（B＝かっこの番号）"],
    ["SUBSTR", "切り出し：A 文字目から B 文字（Bが空なら最後まで）"],
    ["SPLIT", "区切って取り出す：区切り文字A で分けた B 番目"],
    ["TRIM", "前後の空白（全角も）を消す"],
    ["ZEN2HAN", "全角の英数字・記号を半角にする"],
    ["HAN2ZEN", "半角の英数字・記号を全角にする"],
    ["PAD", "ゼロ埋め：A 桁にそろえる（Bで埋める文字、空なら0）"],
    ["WAREKI", "日付を和暦にする（令和8年10月1日）"],
    ["DATE_ADD", "日付に A 日を足す（マイナスで引く・2026/10/15 形式になる）"],
    ["COMMA", "数字に3桁区切りのカンマを付ける"],
    ["UNCOMMA", "カンマを消す"],
    ["LENGTH", "文字数を数える"]
];

function strOpName(op) {
    for (var i = 0; i < STR_OPS.length; i++) {
        if (STR_OPS[i][0] === op) {
            return STR_OPS[i][1].split("：")[0];
        }
    }
    return op;
}

// "2026/10/1" "2026-10-01" "20261001" "令和8年10月1日" "２０２６年１０月１日" -> Date (or null)
function parseDateText(s) {
    var t = toHalfWidthDigits(trimText(s));
    var m = /(令和|平成|昭和)(\d+|元)年(\d{1,2})月(\d{1,2})日/.exec(t);
    if (m) {
        var base = m[1] === "令和" ? 2018 : m[1] === "平成" ? 1988 : 1925;
        return new Date(base + (m[2] === "元" ? 1 : parseInt(m[2], 10)), parseInt(m[3], 10) - 1, parseInt(m[4], 10));
    }
    m = /^(\d{4})(\d{2})(\d{2})$/.exec(t) || /(\d{4})\D+(\d{1,2})\D+(\d{1,2})/.exec(t);
    if (!m) {
        return null;
    }
    var d = new Date(parseInt(m[1], 10), parseInt(m[2], 10) - 1, parseInt(m[3], 10));
    return d.getMonth() === parseInt(m[2], 10) - 1 ? d : null;
}

function formatDate(d) {
    return d.getFullYear() + "/" + pad2(d.getMonth() + 1) + "/" + pad2(d.getDate());
}

function strOp(op, s, a, b) {
    var i;
    var d;
    switch (op) {
    case "REPLACE":
        return a === "" ? s : s.split(a).join(b);
    case "REGEX_REPLACE":
        return s.replace(new RegExp(a, "g"), b);
    case "REGEX_EXTRACT":
        var m = new RegExp(a).exec(s);
        var g = b === "" ? 0 : toInt(toHalfWidthDigits(b), 0);
        return m && m[g] != null ? m[g] : "";
    case "SUBSTR":
        var start = Math.max(1, toInt(toHalfWidthDigits(a), 1));
        return b === "" ? s.substring(start - 1) : s.substr(start - 1, Math.max(0, toInt(toHalfWidthDigits(b), 0)));
    case "SPLIT":
        var parts = s.split(a === "" ? "," : a);
        var idx = toInt(toHalfWidthDigits(b), 1);
        return idx >= 1 && idx <= parts.length ? parts[idx - 1] : "";
    case "TRIM":
        return s.replace(/^[\s　]+|[\s　]+$/g, "");
    case "ZEN2HAN":
        return s.replace(/[！-～]/g, function (ch) {
            return String.fromCharCode(ch.charCodeAt(0) - 0xFEE0);
        }).replace(/　/g, " ");
    case "HAN2ZEN":
        return s.replace(/[!-~]/g, function (ch) {
            return String.fromCharCode(ch.charCodeAt(0) + 0xFEE0);
        }).replace(/ /g, "　");
    case "PAD":
        var len = toInt(toHalfWidthDigits(a), 0);
        var fill = b === "" ? "0" : b.charAt(0);
        for (i = s.length; i < len; i++) {
            s = fill + s;
        }
        return s;
    case "WAREKI":
        d = parseDateText(s);
        if (!d) {
            throw new Error("日付として読めなかったよ: " + s);
        }
        return warekiOf(d) + (d.getMonth() + 1) + "月" + d.getDate() + "日";
    case "DATE_ADD":
        d = parseDateText(s);
        if (!d) {
            throw new Error("日付として読めなかったよ: " + s);
        }
        d.setDate(d.getDate() + toInt(toHalfWidthDigits(a), 0));
        return formatDate(d);
    case "COMMA":
        var n = toHalfWidthDigits(s).replace(/,/g, "");
        var parts2 = n.split(".");
        parts2[0] = parts2[0].replace(/\B(?=(\d{3})+(?!\d))/g, ",");
        return parts2.join(".");
    case "UNCOMMA":
        return s.replace(/[,，]/g, "");
    case "LENGTH":
        return String(s.length);
    }
    return s;
}

// Index of the first given middle marker (ELSE / CATCH) that belongs to the block starting at startIndex
function findMiddle(steps, startIndex, cmd) {
    var depth = 0;
    for (var i = startIndex + 1; i < steps.length; i++) {
        if (isBlockStart(steps[i].cmd)) {
            depth++;
        } else if (isBlockEnd(steps[i].cmd)) {
            if (depth === 0) {
                return -1;
            }
            depth--;
        } else if (depth === 0 && steps[i].cmd === cmd) {
            return i;
        }
    }
    return -1;
}

// Start index of the block that a middle marker / any step directly belongs to
function findBlockOwner(steps, index) {
    var depth = 0;
    for (var i = index - 1; i >= 0; i--) {
        if (isBlockEnd(steps[i].cmd)) {
            depth++;
        } else if (isBlockStart(steps[i].cmd)) {
            if (depth === 0) {
                return i;
            }
            depth--;
        }
    }
    return -1;
}

// Middle markers that belong to the block [start, end]
function blockMiddles(steps, start, end) {
    var list = [];
    var depth = 0;
    for (var i = start + 1; i < end; i++) {
        if (isBlockStart(steps[i].cmd)) {
            depth++;
        } else if (isBlockEnd(steps[i].cmd)) {
            depth--;
        } else if (depth === 0 && isBlockMiddle(steps[i].cmd)) {
            list.push(i);
        }
    }
    return list;
}

// Variable names a macro defines (for the placeholder helper and the template checker)
function definedVarNames(steps) {
    var names = { "エラー内容": true };
    for (var i = 0; i < steps.length; i++) {
        var def = COMMAND_DEFS[steps[i].cmd];
        if (def && def.definesVar) {
            var name = trimText(def.parse(steps[i].val)[def.definesVar]);
            names[name || (steps[i].cmd === "LOOP_START" ? "回数" : "")] = true;
        }
    }
    var out = [];
    for (var k in names) {
        if (names.hasOwnProperty(k) && k !== "") {
            out.push(k);
        }
    }
    return out;
}

function ocrRectError(v) {
    if (v.area !== "RECT") {
        return "";
    }
    var keys = ["x", "y", "w", "h"];
    for (var i = 0; i < keys.length; i++) {
        if (!/^-?\d+$/.test(toHalfWidthDigits(trimText(v[keys[i]])))) {
            return "範囲を指定するときは、X・Y・幅・高さを整数で入れてね♡（📍 範囲を取得 も使えるよ）";
        }
    }
    return toInt(toHalfWidthDigits(v.w), 0) < 4 || toInt(toHalfWidthDigits(v.h), 0) < 4 ? "幅と高さは4以上にしてね♡" : "";
}

function ocrAreaName(p) {
    return p.area === "FULL" ? "画面全体" : p.area === "RECT" ? "範囲(" + p.x + "," + p.y + " " + p.w + "×" + p.h + ")" : "前面のウィンドウ";
}

function macroNameById(id) {
    for (var i = 0; i < appData.macros.length; i++) {
        if (appData.macros[i].id === id) {
            return appData.macros[i].name;
        }
    }
    return "";
}

// Step values: a command with one setting keeps it as plain text (KEY "{TAB}", TEXT "...");
// a command with several settings keeps them as a JSON object (never comma separated, so commas in
// titles, paths or CSV data are safe). A field with placeholders: true is expanded at run time.
var COMMAND_DEFS = {
    // ------------------------------------------------------------- input
    KEY: {
        title: "キー送信", icon: "⌨", defaultVal: "{TAB}",
        help: "SendKeys形式でキーを送るキュン♡ 例: {TAB} / +{TAB}(Shift+Tab) / {ENTER} / {SPACE} / ^c(Ctrl+C) / ^v(Ctrl+V) / %{F4}(Alt+F4) / {TAB 3}(3回)",
        fields: [{ id: "key", label: "送信キー", type: "keypreset", placeholder: "{TAB}" }],
        parse: function (val) { return { key: val }; },
        compose: function (v) { return v.key; },
        validate: function (v) { return v.key === "" ? "送信キーを入力してね♡" : ""; },
        autoLabel: function (val) { return keyDisplayName(val) === val ? "キー送信 " + val : keyDisplayName(val); }
    },
    TEXT: {
        title: "文字列貼付", icon: "📝", defaultVal: "",
        help: "文字列をクリップボード経由で貼り付けるよ（Ctrl+V）。日本語入力(IME)がONでも化けないキュン。{{氏名}} や {{1}} でCSVの値、{{$合計}} で変数、{{WAREKI}} で今日の和暦…みたいに「差し込み」もできるよ♡",
        fields: [{ id: "text", label: "入力する文字列（差し込み可）", type: "textarea", raw: true, placeholders: true }],
        parse: function (val) { return { text: val }; },
        compose: function (v) { return v.text; },
        validate: function (v) { return v.text === "" ? "文字列を入力してね♡" : ""; },
        autoLabel: function (val) { return "文字列「" + truncateText(val, 20) + "」を貼付"; }
    },
    CSV: {
        title: "CSV列を貼付", icon: "📄", defaultVal: "1",
        help: "実行中のCSV行から、指定した列のデータをクリップボード経由で貼り付けるキュン。列番号は1始まりだよ。",
        fields: [{ id: "col", label: "CSV列番号（1始まり）", type: "csvcol", placeholder: "1" }],
        parse: function (val) { return { col: val }; },
        compose: function (v) { return String(toInt(v.col, 1)); },
        validate: function (v) { return !/^\d+$/.test(v.col) || toInt(v.col, 0) < 1 ? "列番号は1以上の数字で入れてね♡" : ""; },
        autoLabel: function (val) {
            var name = csvHeaderName(toInt(val, 0));
            return "CSV " + val + "列目" + (name ? "「" + name + "」" : "") + "を貼付";
        }
    },
    COPY: {
        title: "コピーして変数へ", icon: "📋", defaultVal: "取得値", definesVar: "name",
        help: "いま選択されている文字を Ctrl+C でコピーして変数に入れるキュン。あとのコマンドで {{$変数名}} として使えるし、［↓ 実行結果CSV］にも同じ名前の列で記録されるよ。直前に KEY ^a（全選択）を入れると確実だよ。",
        fields: [{ id: "name", label: "入れる変数名（実行結果CSVの列名にもなるよ）", type: "text", placeholder: "例: 伝票番号" }],
        parse: function (val) { return { name: val }; },
        compose: function (v) { return v.name; },
        validate: function (v) { return varNameError(v.name); },
        autoLabel: function (val) { return "コピーして $" + val + " に入れる"; }
    },
    // ------------------------------------------------------------- wait & check
    WAIT: {
        title: "待機", icon: "⏳", defaultVal: "1000",
        help: "指定したミリ秒だけロボットをお休みさせるキュン。1000ミリ秒 = 1秒だよ。",
        fields: [{ id: "ms", label: "待機時間（ミリ秒）", type: "text", placeholder: "1000" }],
        parse: function (val) { return { ms: val }; },
        compose: function (v) { return String(toInt(v.ms, 0)); },
        validate: function (v) { return !/^\d+$/.test(v.ms) ? "待機時間は0以上の数字（ミリ秒）で入れてね♡" : ""; },
        autoLabel: function (val) { return val + "ミリ秒待機"; }
    },
    WAIT_FOR: {
        title: "ウィンドウ出現待ち", icon: "👀", hideVal: true,
        defaultVal: '{"title":"","key":"{ENTER}","timeout":"30"}',
        help: "指定タイトルのウィンドウがアクティブにできるか1秒ごとに見張るよ。出てきたらキーを押して次へ。タイムアウトしたら安全停止＋アラームだキュン。",
        fields: [
            { id: "title", label: "待つウィンドウのタイトル（一部・差し込み可）", type: "text", placeholder: "例: 確認", placeholders: true },
            { id: "key", label: "出現したら押すキー（空欄なら押さない）", type: "keypreset", placeholder: "{ENTER}" },
            { id: "timeout", label: "タイムアウト（秒）", type: "text", placeholder: "30" }
        ],
        parse: function (val) { return jsonVal(val, { title: "", key: "", timeout: "30" }); },
        compose: function (v) { return jsonCompose({ title: v.title, key: v.key, timeout: String(toInt(toHalfWidthDigits(v.timeout), 30)) }, ["title", "key", "timeout"]); },
        validate: function (v) {
            if (v.title === "") { return "待つウィンドウのタイトルを入れてね♡"; }
            return !/^\d+$/.test(toHalfWidthDigits(v.timeout)) || toInt(toHalfWidthDigits(v.timeout), 0) < 1 ? "タイムアウトは1以上の秒数で入れてね♡" : "";
        },
        autoLabel: function (val) {
            var p = this.parse(val);
            return "「" + p.title + "」を最大" + p.timeout + "秒待つ" + (p.key ? " → " + keyDisplayName(p.key) : "");
        }
    },
    WINDOW_CHECK: {
        title: "ウィンドウ検知（異常時）", icon: "⚠", hideVal: true,
        defaultVal: '{"title":"","key":"{ENTER}","mode":"STOP"}',
        help: "指定タイトルのウィンドウが今出ているか即チェック！出ていたらキーを押して、STOPなら大音量アラームで緊急停止、SKIPならこのCSV行を打ち切って次の行へ、CONTINUEならそのまま続行（ときどき出るお知らせを閉じるのに便利）だキュン。出ていなければ何もせず次へ進むよ。",
        fields: [
            { id: "title", label: "検知するウィンドウのタイトル（一部・差し込み可）", type: "text", placeholder: "例: エラー", placeholders: true },
            { id: "key", label: "検知したら押すキー（空欄なら押さない）", type: "keypreset", placeholder: "{ENTER}" },
            { id: "mode", label: "検知したときの動き", type: "select", options: [["STOP", "STOP：アラーム＋緊急停止"], ["SKIP", "SKIP：この行を打ち切って次の行へ"], ["CONTINUE", "CONTINUE：キーを押して、そのまま続行"]] }
        ],
        parse: function (val) { var p = jsonVal(val, { title: "", key: "", mode: "STOP" }); p.mode = normalizeCheckMode(p.mode); return p; },
        compose: function (v) { return jsonCompose({ title: v.title, key: v.key, mode: normalizeCheckMode(v.mode) }, ["title", "key", "mode"]); },
        validate: function (v) { return v.title === "" ? "検知するウィンドウのタイトルを入れてね♡" : ""; },
        autoLabel: function (val) {
            var p = this.parse(val);
            return "もし「" + p.title + "」が出たら" + (p.key ? keyDisplayName(p.key) + "→" : "") +
                (p.mode === "SKIP" ? "行スキップ" : p.mode === "CONTINUE" ? "そのまま続行" : "緊急停止");
        }
    },
    CONFIRM: {
        title: "確認ポイント（人が確認）", icon: "✋", defaultVal: "内容を確認してね。よければ［▶ 続行］を押してね♡",
        help: "ロボットをいったん止めて、メッセージを出して人の確認を待つキュン。［続行］［この行をスキップ］［停止］を選べるよ。登録ボタンを押す前の最終チェックや、カーソル位置を手で合わせたい時に使ってね。{{氏名}} などの差し込みもできるよ。",
        fields: [{ id: "message", label: "表示するメッセージ（差し込み可）", type: "textarea", raw: true, placeholders: true }],
        parse: function (val) { return { message: val }; },
        compose: function (v) { return v.message; },
        validate: function (v) { return trimText(v.message) === "" ? "メッセージを入れてね♡" : ""; },
        autoLabel: function (val) { return "確認: " + truncateText(val, 30); }
    },
    // ------------------------------------------------------------- click & read the screen
    CLICK_NAME: {
        title: "名前でクリック", icon: "👆", defaultVal: "",
        help: "【オブジェクト認識・第一推奨】座標じゃなくて、UIAutomationでボタン等の表示名（Nameプロパティ）を探して直接Invoke（押下）するキュン。表示名は完全一致だよ。PowerShellを使うので1〜数秒かかるよ。",
        fields: [{ id: "name", label: "ボタンなどの表示名", type: "text", placeholder: "例: 登録" }],
        parse: function (val) { return { name: val }; },
        compose: function (v) { return v.name; },
        validate: function (v) { return v.name === "" ? "表示名を入れてね♡" : ""; },
        autoLabel: function (val) { return "「" + val + "」をクリック"; }
    },
    CLICK_POS: {
        title: "座標でクリック", icon: "🎯", hideVal: true, defaultVal: '{"x":"0","y":"0","kind":"LEFT"}',
        help: "【座標認識】画面左上を(0,0)として、指定ピクセル位置へマウスを瞬間移動してクリックするキュン（左・ダブル・右クリック）。C#のuser32.dllをPowerShellでコンパイル実行するよ。",
        fields: [
            { id: "x", label: "X座標（ピクセル）", type: "text", placeholder: "100" },
            { id: "y", label: "Y座標（ピクセル）", type: "text", placeholder: "200" },
            { id: "kind", label: "クリックの種類", type: "select", options: [["LEFT", "左クリック"], ["DOUBLE", "ダブルクリック"], ["RIGHT", "右クリック"]] },
            { id: "capture", label: "座標のかんたん取得", type: "capture" }
        ],
        parse: function (val) {
            var p = jsonVal(val, { x: "0", y: "0", kind: "LEFT" });
            p.kind = p.kind === "DOUBLE" || p.kind === "RIGHT" ? p.kind : "LEFT";
            return p;
        },
        compose: function (v) { return jsonCompose({ x: String(toInt(v.x, 0)), y: String(toInt(v.y, 0)), kind: v.kind }, ["x", "y", "kind"]); },
        validate: function (v) { return !/^-?\d+$/.test(v.x) || !/^-?\d+$/.test(v.y) ? "X・Yは整数で入れてね♡" : ""; },
        autoLabel: function (val) {
            var p = this.parse(val);
            return "座標(" + p.x + ", " + p.y + ")を" + (p.kind === "DOUBLE" ? "ダブルクリック" : p.kind === "RIGHT" ? "右クリック" : "クリック");
        }
    },
    CLICK_IMG: {
        title: "画像でクリック", icon: "🖼", hideVal: true, defaultVal: '{"path":"","threshold":"' + IMG_DEFAULT_THRESHOLD + '"}',
        help: "【画像認識】画面全体をスクリーンショットして、参照画像と同じ模様の場所をピクセル検索、見つけた場所の中心をクリックするキュン。Citrix/RDPなど中身が見えない画面に強いよ。外部ソフト不要（PowerShell＋System.Drawing）。見つからないときは1秒おきに" + IMG_SEARCH_RETRY + "回まで探すよ。",
        fields: [
            { id: "path", label: "参照画像ファイル（PNG/BMP/JPG）", type: "imgpath", placeholder: "例: C:\\img\\btn.png",
              hint: "相対パスはこのHTAのフォルダ基準だよ。📷で切り取ると " + IMAGE_FOLDER_NAME + " フォルダに保存されるキュン" },
            { id: "threshold", label: "一致率のしきい値（0.5〜1.0）", type: "text", placeholder: String(IMG_DEFAULT_THRESHOLD),
              hint: "0.9 = 90%以上のピクセルが一致したらクリック。見つからないときは 0.85 などに下げてね" }
        ],
        parse: function (val) { return jsonVal(val, { path: "", threshold: String(IMG_DEFAULT_THRESHOLD) }); },
        compose: function (v) { return jsonCompose({ path: v.path, threshold: String(clampThreshold(v.threshold)) }, ["path", "threshold"]); },
        validate: function (v) {
            if (v.path === "") { return "参照画像ファイルを指定してね♡"; }
            var n = parseFloat(v.threshold);
            return !/^\d*\.?\d+$/.test(v.threshold) || isNaN(n) || n < 0.5 || n > 1 ? "しきい値は0.5〜1.0の数字で入れてね♡" : "";
        },
        autoLabel: function (val) {
            var p = this.parse(val);
            return "画像「" + (fileNameOf(p.path) || "未指定") + "」を探してクリック（一致" + Math.round(clampThreshold(p.threshold) * 100) + "%以上）";
        }
    },
    CLICK_TEXT: {
        title: "文字でクリック（OCR）", icon: "🔎", hideVal: true,
        defaultVal: '{"text":"","area":"WINDOW","x":"","y":"","w":"","h":"","nth":"1"}',
        help: "画面から指定した文字を文字認識（OCR）で探して、その文字の真ん中をクリックするキュン。ボタンに名前がなくてオブジェクト認識が効かない画面でも、文字さえ見えていれば押せるよ。見つからないときは1秒おきに3回まで探すよ。",
        fields: [
            { id: "text", label: "探す文字（差し込み可）", type: "text", placeholder: "例: 登録", placeholders: true },
            { id: "area", label: "探す範囲", type: "select", options: [["WINDOW", "いま前面のウィンドウ"], ["FULL", "画面全体"], ["RECT", "範囲を指定（下の X・Y・幅・高さ）"]] },
            { id: "rect", label: "範囲のかんたん取得", type: "rectcapture" },
            { id: "x", label: "左上のX", type: "text" },
            { id: "y", label: "左上のY", type: "text" },
            { id: "w", label: "幅", type: "text" },
            { id: "h", label: "高さ", type: "text" },
            { id: "nth", label: "同じ文字が複数あるとき、何番目をクリックするか（上から）", type: "text", placeholder: "1" }
        ],
        parse: function (val) { return jsonVal(val, { text: "", area: "WINDOW", x: "", y: "", w: "", h: "", nth: "1" }); },
        compose: function (v) { return jsonCompose(v, ["text", "area", "x", "y", "w", "h", "nth"]); },
        validate: function (v) {
            if (trimText(v.text) === "") { return "探す文字を入れてね♡"; }
            if (!/^\d+$/.test(toHalfWidthDigits(trimText(v.nth || "1"))) || toInt(toHalfWidthDigits(v.nth || "1"), 0) < 1) { return "何番目かは1以上の数字で入れてね♡"; }
            return ocrRectError(v);
        },
        autoLabel: function (val) { var p = this.parse(val); return "🔎 「" + truncateText(p.text, 20) + "」を" + ocrAreaName(p) + "から探してクリック"; }
    },
    READ_TEXT: {
        title: "文字を読み取る（OCR）", icon: "🔤", hideVal: true, definesVar: "name",
        defaultVal: '{"area":"WINDOW","x":"","y":"","w":"","h":"","name":""}',
        help: "画面の文字を Windows に入っている文字認識（OCR）で読み取って変数に入れるキュン。範囲は「前面のウィンドウ」「画面全体」「範囲を指定」から選べるよ。小さい範囲を指定するほど正確だよ。文字をコピーできない画面（Citrix・画像・PDFの表示）から値を取るのに便利！",
        fields: [
            { id: "area", label: "読み取る範囲", type: "select", options: [["WINDOW", "いま前面のウィンドウ"], ["FULL", "画面全体"], ["RECT", "範囲を指定（下の X・Y・幅・高さ）"]] },
            { id: "rect", label: "範囲のかんたん取得", type: "rectcapture" },
            { id: "x", label: "左上のX", type: "text", placeholder: "例: 400" },
            { id: "y", label: "左上のY", type: "text", placeholder: "例: 300" },
            { id: "w", label: "幅", type: "text", placeholder: "例: 200" },
            { id: "h", label: "高さ", type: "text", placeholder: "例: 30" },
            { id: "name", label: "入れる変数名", type: "text", placeholder: "例: 読んだ文字" }
        ],
        parse: function (val) { return jsonVal(val, { area: "WINDOW", x: "", y: "", w: "", h: "", name: "" }); },
        compose: function (v) { return jsonCompose(v, ["area", "x", "y", "w", "h", "name"]); },
        validate: function (v) { return ocrRectError(v) || varNameError(v.name); },
        autoLabel: function (val) { var p = this.parse(val); return "🔤 " + ocrAreaName(p) + " の文字を読む → $" + p.name; }
    },
    // ------------------------------------------------------------- windows, apps, evidence & mail
    SWITCH: {
        title: "ウィンドウ切替", icon: "🪟", defaultVal: "",
        help: "指定した名前のウィンドウを前面化（アクティブ化）して、以降の操作対象にするキュン。タイトルは完全一致→前方一致→後方一致の順で探すよ。",
        fields: [{ id: "title", label: "ウィンドウ名（一部・差し込み可）", type: "text", placeholder: "例: メモ帳", placeholders: true }],
        parse: function (val) { return { title: val }; },
        compose: function (v) { return v.title; },
        validate: function (v) { return v.title === "" ? "ウィンドウ名を入れてね♡" : ""; },
        autoLabel: function (val) { return "「" + val + "」に切替"; }
    },
    RUN: {
        title: "アプリ起動", icon: "🚀", defaultVal: "notepad.exe",
        help: "外部アプリやファイルを開くよ。例: notepad.exe / \"C:\\RPA作業\\台帳.xlsx\" / cmd /c mkdir \"C:\\RPA作業\\{{1}}\"（差し込み可）。スペースを含むパスは \" \" で囲んでね。",
        fields: [{ id: "path", label: "アプリのパス／コマンド（差し込み可）", type: "text", placeholder: "notepad.exe", placeholders: true }],
        parse: function (val) { return { path: val }; },
        compose: function (v) { return v.path; },
        validate: function (v) { return v.path === "" ? "起動するアプリを入れてね♡" : ""; },
        autoLabel: function (val) { return "起動: " + truncateText(val, 30); }
    },
    SCREENSHOT: {
        title: "画面を撮影して保存", icon: "📸", hideVal: true, defaultVal: '{"name":"証跡_{{ROW}}","scope":"WINDOW"}',
        help: "画面をPNGで保存するキュン（証跡・エビデンス用）。保存先は HTAのフォルダ\\" + EVIDENCE_FOLDER_NAME + "\\日付\\ だよ。ファイル名には {{ROW}} や {{氏名}} を差し込めて、最後に時刻が自動で付くよ。",
        fields: [
            { id: "name", label: "ファイル名（差し込み可・拡張子なし）", type: "text", placeholder: "証跡_{{ROW}}", placeholders: true },
            { id: "scope", label: "撮る範囲", type: "select", options: [["WINDOW", "いま前面のウィンドウだけ"], ["FULL", "画面全体（全モニター）"]] }
        ],
        parse: function (val) { var p = jsonVal(val, { name: "", scope: "WINDOW" }); p.scope = p.scope === "FULL" ? "FULL" : "WINDOW"; return p; },
        compose: function (v) { return jsonCompose({ name: v.name, scope: v.scope === "FULL" ? "FULL" : "WINDOW" }, ["name", "scope"]); },
        validate: function (v) { return v.name === "" ? "ファイル名を入れてね♡" : ""; },
        autoLabel: function (val) {
            var p = this.parse(val);
            return "画面を撮影「" + truncateText(p.name, 20) + "」（" + (p.scope === "FULL" ? "全体" : "ウィンドウ") + "）";
        }
    },
    MAIL: {
        title: "メールを作る・送る", icon: "✉", hideVal: true,
        defaultVal: '{"method":"OUTLOOK","mode":"DRAFT","to":"","cc":"","subject":"","body":"","attach":"","server":"","port":"25","from":"","ssl":"NO"}',
        help: "メールを作るキュン。送り方は3つ：Outlook（下書き保存・画面に表示・すぐ送信）／職場のメールサーバーから送信（パスワードは保存せず、Windowsのログオン情報を使う）／メールアプリを開くだけ（mailto）。宛先・件名・本文・添付には {{列名}} などを差し込めるよ。いきなり送信せず「下書き」で試してね。",
        fields: [
            { id: "method", label: "送り方", type: "select", options: [["OUTLOOK", "Outlook を使う"], ["SMTP", "メールサーバーから直接送信（SMTP）"], ["MAILTO", "メールアプリを開くだけ（mailto・添付不可）"]] },
            { id: "mode", label: "Outlook のとき", type: "select", options: [["DRAFT", "下書きに保存する（おすすめ）"], ["DISPLAY", "作成画面を表示する（送信は人が押す）"], ["SEND", "すぐに送信する"]] },
            { id: "to", label: "宛先（複数は ; で区切る・差し込み可）", type: "text", placeholder: "例: {{メールアドレス}}", placeholders: true },
            { id: "cc", label: "CC（差し込み可）", type: "text", placeholders: true },
            { id: "subject", label: "件名（差し込み可）", type: "text", placeholders: true },
            { id: "body", label: "本文（差し込み可）", type: "textarea", raw: true, placeholders: true },
            { id: "attach", label: "添付ファイル（フルパス・複数は ; で区切る・差し込み可）", type: "text", placeholder: "例: C:\\RPA作業\\通知\\{{氏名}}.pdf", placeholders: true },
            { id: "server", label: "SMTPのとき：メールサーバー名", type: "text", placeholder: "例: mail.example.lg.jp" },
            { id: "port", label: "SMTPのとき：ポート番号", type: "text", placeholder: "25" },
            { id: "from", label: "SMTPのとき：差出人アドレス", type: "text", placeholders: true },
            { id: "ssl", label: "SMTPのとき：暗号化（SSL/TLS）", type: "select", options: [["NO", "使わない"], ["YES", "使う"]] }
        ],
        parse: function (val) { return jsonVal(val, { method: "OUTLOOK", mode: "DRAFT", to: "", cc: "", subject: "", body: "", attach: "", server: "", port: "25", from: "", ssl: "NO" }); },
        compose: function (v) { return jsonCompose(v, ["method", "mode", "to", "cc", "subject", "body", "attach", "server", "port", "from", "ssl"]); },
        validate: function (v) {
            if (trimText(v.to) === "") { return "宛先を入れてね♡"; }
            if (v.method === "SMTP" && (trimText(v.server) === "" || trimText(v.from) === "")) { return "SMTPで送るときは、メールサーバー名と差出人アドレスを入れてね♡"; }
            if (v.method === "SMTP" && !/^\d+$/.test(toHalfWidthDigits(trimText(v.port)))) { return "ポート番号は数字で入れてね♡"; }
            return "";
        },
        autoLabel: function (val) {
            var p = this.parse(val);
            var how = p.method === "SMTP" ? "サーバーから送信" : p.method === "MAILTO" ? "メールアプリで作成" : (p.mode === "SEND" ? "Outlookで送信" : p.mode === "DISPLAY" ? "Outlookで作成画面を表示" : "Outlookの下書きに保存");
            return "✉ " + truncateText(p.to, 24) + " へ「" + truncateText(p.subject, 20) + "」（" + how + "）";
        }
    },
    // ------------------------------------------------------------- control flow
    LOOP_START: {
        title: "繰り返し", icon: "🔁", definesVar: "counter", hideVal: true,
        defaultVal: '{"mode":"COUNT","count":"3","left":"","op":"NOT_EMPTY","right":"","counter":"回数","max":"1000"}',
        help: "中のコマンドをくり返すキュン。「決めた回数」なら回数を（{{列名}} などの差し込みもOK）、「条件のあいだ」なら条件を決めてね。何回目かは {{$回数}} で使えるよ。途中で抜けるには「繰り返しを抜ける（BREAK）」を使ってね。終わらない繰り返しにならないよう、上限回数で必ず止まるよ。",
        fields: [
            { id: "mode", label: "くり返し方", type: "select", options: [["COUNT", "決めた回数くり返す（for）"], ["WHILE", "条件を満たすあいだくり返す（while）"]] },
            { id: "count", label: "回数（「決めた回数」のとき・差し込み可）", type: "text", placeholder: "例: 5 / {{ページ数}}", placeholders: true },
            { id: "left", label: "条件：調べる値（「条件のあいだ」のとき・差し込み可）", type: "text", placeholder: "例: {{$件名}}", placeholders: true },
            { id: "op", label: "条件：くらべ方", type: "select", options: null },
            { id: "right", label: "条件：くらべる相手（差し込み可）", type: "text", placeholders: true },
            { id: "counter", label: "何回目かを入れる変数名", type: "text", placeholder: "回数" },
            { id: "max", label: "上限回数（これを超えたら止める）", type: "text", placeholder: "1000" }
        ],
        parse: function (val) { return jsonVal(val, { mode: "COUNT", count: "3", left: "", op: "NOT_EMPTY", right: "", counter: "回数", max: "1000" }); },
        compose: function (v) { return jsonCompose(v, ["mode", "count", "left", "op", "right", "counter", "max"]); },
        validate: function (v) {
            if (v.mode === "COUNT" && trimText(v.count) === "") { return "回数を入れてね♡"; }
            if (v.mode === "WHILE" && conditionNeedsLeft(v.op) && trimText(v.left) === "") { return "調べる値を入れてね♡"; }
            if (!/^\d+$/.test(toHalfWidthDigits(trimText(v.max))) || toInt(toHalfWidthDigits(v.max), 0) < 1) { return "上限回数は1以上の数字で入れてね♡"; }
            return varNameError(v.counter);
        },
        autoLabel: function (val) {
            var p = this.parse(val);
            return p.mode === "WHILE" ? "🔁 " + describeCondition(p) + " あいだくり返す" : "🔁 " + p.count + " 回くり返す";
        }
    },
    LOOP_END: blockMarkerDef("繰り返しここまで", "└", "繰り返しの終わりの目印だよ。ここまで来ると「繰り返し」の先頭に戻るキュン。"),
    BREAK: blockMarkerDef("繰り返しを抜ける", "⤴", "いちばん内側の繰り返しを途中で終わらせて、「繰り返しここまで」の次へ進むキュン（break）。「もし〜なら」と組み合わせて使ってね。"),
    CONTINUE: blockMarkerDef("次の繰り返しへ", "↪", "残りのコマンドを飛ばして、次の回の繰り返しに進むキュン（continue）。"),
    IF_START: {
        title: "もし〜なら", icon: "❓", hideVal: true,
        defaultVal: '{"left":"","op":"EQ","right":""}',
        help: "条件が合うときだけ中のコマンドを実行するキュン（if）。合わないときの手順は「そうでなければ（ELSE）」の後ろに書いてね。値は {{列名}} {{$変数}} などで差し込めるよ。数の比較は全角数字やカンマがあってもOK。",
        fields: [
            { id: "left", label: "調べる値（差し込み可）", type: "text", placeholder: "例: {{金額}}", placeholders: true },
            { id: "op", label: "くらべ方", type: "select", options: null },
            { id: "right", label: "くらべる相手（差し込み可）", type: "text", placeholder: "例: 100000", placeholders: true }
        ],
        parse: function (val) { return jsonVal(val, { left: "", op: "EQ", right: "" }); },
        compose: function (v) { return jsonCompose(v, ["left", "op", "right"]); },
        validate: function (v) { return conditionNeedsLeft(v.op) && trimText(v.left) === "" ? "調べる値を入れてね♡" : ""; },
        autoLabel: function (val) { return "❓ もし " + describeCondition(this.parse(val)) + " なら"; }
    },
    ELSE: blockMarkerDef("そうでなければ", "↔", "「もし〜なら」の条件が合わなかったときに、ここから下を実行するキュン（else）。「もし〜なら」の中に1つだけ置けるよ。"),
    IF_END: blockMarkerDef("もし〜ならここまで", "└", "「もし〜なら」の終わりの目印だよ。"),
    TRY_START: {
        title: "エラー時の処理", icon: "🧯", hideVal: true, defaultVal: "エラーが出ても止めずに記録する",
        help: "この中でエラーが起きても止めずに、「エラーのとき（CATCH）」から下を実行するキュン（try-catch）。エラーの内容は {{$エラー内容}} で使えるよ。ウィンドウ検知の STOP（緊急停止）と ⏹ 停止は受け止めないよ。",
        fields: [{ id: "name", label: "表示名", type: "text", placeholder: "例: 登録でエラーが出たら記録して次へ" }],
        parse: function (val) { return { name: val }; },
        compose: function (v) { return v.name; },
        validate: function (v) { return v.name === "" ? "表示名を入れてね♡" : ""; },
        autoLabel: function (val) { return "🧯 " + val; }
    },
    CATCH: blockMarkerDef("エラーのとき", "⚠", "「エラー時の処理」の中でエラーが起きたら、ここから下を実行するキュン。エラーの内容は {{$エラー内容}} だよ。"),
    TRY_END: blockMarkerDef("エラー時の処理ここまで", "└", "「エラー時の処理」の終わりの目印だよ。"),
    CALL_MACRO: {
